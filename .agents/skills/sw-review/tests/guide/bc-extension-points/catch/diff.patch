+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Content\Product\SalesChannel\DeliveryEstimate;
+
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Struct\ArrayStruct;
+use Shopware\Core\System\SalesChannel\StoreApiResponse;
+
+/**
+ * @extends StoreApiResponse<ArrayStruct<string, int|string|null>>
+ */
+#[Package('inventory')]
+class ProductDeliveryEstimateRouteResponse extends StoreApiResponse
+{
+    public function __construct(?int $min, ?int $max, ?string $unit)
+    {
+        parent::__construct(new ArrayStruct(['min' => $min, 'max' => $max, 'unit' => $unit], 'product_delivery_estimate'));
+    }
+}
