+<?php declare(strict_types=1);
+
+namespace Shopware\Tests\Migration\Core\V6_7;
+
+use Doctrine\DBAL\Connection;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Test\TestCaseBase\KernelLifecycleManager;
+use Shopware\Core\Framework\Util\Database\TableHelper;
+use Shopware\Core\Migration\V6_7\Migration1791537247AddIsSystemToProductSorting;
+
+/**
+ * @internal
+ */
+#[Package('inventory')]
+#[CoversClass(Migration1791537247AddIsSystemToProductSorting::class)]
+class Migration1791537247AddIsSystemToProductSortingTest extends TestCase
+{
+    private Connection $connection;
+
+    protected function setUp(): void
+    {
+        $this->connection = KernelLifecycleManager::getConnection();
+    }
+
+    public function testGetCreationTimestamp(): void
+    {
+        static::assertSame(1791537247, (new Migration1791537247AddIsSystemToProductSorting())->getCreationTimestamp());
+    }
+
+    public function testAddsColumnAndIndexAndCanRunTwice(): void
+    {
+        if (TableHelper::indexExists($this->connection, 'product_sorting', 'idx.product_sorting.is_system')) {
+            $this->connection->executeStatement('ALTER TABLE `product_sorting` DROP INDEX `idx.product_sorting.is_system`');
+        }
+
+        if (TableHelper::columnExists($this->connection, 'product_sorting', 'is_system')) {
+            $this->connection->executeStatement('ALTER TABLE `product_sorting` DROP COLUMN `is_system`');
+        }
+
+        $migration = new Migration1791537247AddIsSystemToProductSorting();
+        $migration->update($this->connection);
+        $migration->update($this->connection);
+
+        static::assertTrue(TableHelper::columnExists($this->connection, 'product_sorting', 'is_system'));
+        static::assertTrue(TableHelper::indexExists($this->connection, 'product_sorting', 'idx.product_sorting.is_system'));
+
+        $unmarkedLockedSortings = (int) $this->connection->fetchOne(
+            'SELECT COUNT(*) FROM `product_sorting` WHERE `locked` = 1 AND `is_system` = 0'
+        );
+        static::assertSame(0, $unmarkedLockedSortings);
+    }
+}
