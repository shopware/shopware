+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Migration\V6_7;
+
+use Doctrine\DBAL\Connection;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\Migration\MigrationStep;
+use Shopware\Core\Framework\Util\Database\TableHelper;
+
+/**
+ * Adds `product_sorting.is_system`, which will mark the sortings shipped by Shopware. The `locked` column stays.
+ *
+ * @internal
+ */
+#[Package('inventory')]
+class Migration1791537247AddIsSystemToProductSorting extends MigrationStep
+{
+    public function getCreationTimestamp(): int
+    {
+        return 1791537247;
+    }
+
+    public function update(Connection $connection): void
+    {
+        $this->addColumn($connection, 'product_sorting', 'is_system', 'TINYINT(1)', false, '0');
+
+        if (!TableHelper::indexExists($connection, 'product_sorting', 'idx.product_sorting.is_system')) {
+            $this->executeDdlStatement(
+                $connection,
+                'ALTER TABLE `product_sorting` ADD INDEX `idx.product_sorting.is_system` (`is_system`)'
+            );
+        }
+
+        $connection->executeStatement(
+            'UPDATE `product_sorting` SET `is_system` = 1 WHERE `locked` = 1 AND `is_system` = 0'
+        );
+    }
+}
