+    public function testTemporarySmtpFailureIsRetriedWithLongerDelay(): void
+    {
+        $mail = new Email();
+
+        $this->fileSystem->expects($this->once())
+            ->method('read')
+            ->with('mail-data/test')
+            ->willReturn(serialize($mail));
+
+        $this->fileSystem->expects($this->never())->method('delete');
+
+        $transport = static::createStub(TransportInterface::class);
+        $transport->method('send')->willThrowException(new UnexpectedResponseException('Greylisted', 451));
+
+        try {
+            $this->createHandler(transport: $transport)->__invoke(new SendMailMessage('mail-data/test'));
+            static::fail('Expected a recoverable exception');
+        } catch (RecoverableMessageHandlingException $e) {
+            static::assertSame(300_000, $e->getRetryDelay());
+            static::assertSame(451, $e->getCode());
+        }
+    }
+
+    public function testPermanentSmtpFailureIsRethrown(): void
