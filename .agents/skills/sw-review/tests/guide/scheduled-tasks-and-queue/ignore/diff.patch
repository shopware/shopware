@@ -0,0 +1,52 @@
+<?php declare(strict_types=1);
+
+namespace Shopware\Tests\Unit\Core\System\User\Recovery;
+
+use Doctrine\DBAL\Connection;
+use Doctrine\DBAL\ParameterType;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\TestCase;
+use Psr\Log\NullLogger;
+use Shopware\Core\Framework\DataAbstractionLayer\EntityRepository;
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\System\User\Recovery\CleanupUserRecoveryTask;
+use Shopware\Core\System\User\Recovery\CleanupUserRecoveryTaskHandler;
+use Symfony\Component\Clock\MockClock;
+
+/**
+ * @internal
+ */
+#[Package('fundamentals@framework')]
+#[CoversClass(CleanupUserRecoveryTaskHandler::class)]
+#[CoversClass(CleanupUserRecoveryTask::class)]
+class CleanupUserRecoveryTaskHandlerTest extends TestCase
+{
+    public function testDeletesEntriesOlderThan48HoursInBatches(): void
+    {
+        $connection = $this->createMock(Connection::class);
+        $connection->expects($this->exactly(3))
+            ->method('executeStatement')
+            ->with(
+                'DELETE FROM user_recovery WHERE created_at <= :timestamp LIMIT :limit',
+                ['timestamp' => '2026-10-07 12:00:00.000', 'limit' => 1000],
+                ['limit' => ParameterType::INTEGER]
+            )
+            ->willReturnOnConsecutiveCalls(1000, 1000, 3);
+
+        $handler = new CleanupUserRecoveryTaskHandler(
+            static::createStub(EntityRepository::class),
+            new NullLogger(),
+            $connection,
+            new MockClock('2026-10-09 12:00:00'),
+        );
+
+        $handler->run();
+    }
+
+    public function testTaskRunsDailyAndReschedulesOnFailure(): void
+    {
+        static::assertSame('user.cleanup_user_recovery', CleanupUserRecoveryTask::getTaskName());
+        static::assertSame(CleanupUserRecoveryTask::DAILY, CleanupUserRecoveryTask::getDefaultInterval());
+        static::assertTrue(CleanupUserRecoveryTask::shouldRescheduleOnFailure());
+    }
+}
