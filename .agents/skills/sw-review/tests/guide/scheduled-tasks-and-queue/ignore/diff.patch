@@ -0,0 +1,25 @@
+<?php declare(strict_types=1);
+
+namespace Shopware\Core\System\User\Recovery;
+
+use Shopware\Core\Framework\Log\Package;
+use Shopware\Core\Framework\MessageQueue\ScheduledTask\ScheduledTask;
+
+#[Package('fundamentals@framework')]
+class CleanupUserRecoveryTask extends ScheduledTask
+{
+    public static function getTaskName(): string
+    {
+        return 'user.cleanup_user_recovery';
+    }
+
+    public static function getDefaultInterval(): int
+    {
+        return self::DAILY;
+    }
+
+    public static function shouldRescheduleOnFailure(): bool
+    {
+        return true;
+    }
+}
diff --git a/src/Core/System/User/Recovery/CleanupUserRecoveryTaskHandler.php b/src/Core/System/User/Recovery/CleanupUserRecoveryTaskHandler.php
