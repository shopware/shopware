@@ -0,0 +1,30 @@
+<?php declare(strict_types=1);
+
+namespace Shopware\Core\Checkout\Cart\Price;
+
+use Shopware\Core\Framework\DataAbstractionLayer\Pricing\CashRoundingConfig;
+use Shopware\Core\Framework\Log\Package;
+
+/**
+ * Rounds price totals to the decimals of the given rounding config.
+ */
+#[Package('checkout')]
+final class PriceRoundingHelper
+{
+    private function __construct()
+    {
+    }
+
+    public static function roundTotal(float $amount, CashRoundingConfig $config): float
+    {
+        $rounded = round($amount, $config->getDecimals()) + 0;
+
+        if ($config->getDecimals() > 2) {
+            return $rounded;
+        }
+
+        $multiplier = 100 / ($config->getInterval() * 100);
+
+        return round($rounded * $multiplier, 0) / $multiplier;
+    }
+}
