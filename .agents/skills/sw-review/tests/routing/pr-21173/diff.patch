diff --git a/tests/unit/Core/Framework/DataAbstractionLayer/Dbal/ForeignKeyConstraintViolationExceptionHandlerTest.php b/tests/unit/Core/Framework/DataAbstractionLayer/Dbal/ForeignKeyConstraintViolationExceptionHandlerTest.php
