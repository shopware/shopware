{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shopware/shopware/trunk/.claude/skills/review/assets/review-output.schema.json",
  "title": "Shopware AI Review — Output",
  "description": "Output shape emitted by the Shopware `review` skill. The skill emits one of two shapes depending on its role: persona-worker mode emits PerPersonaReview; orchestrator mode emits MergedReview after fan-out + dedup.",
  "oneOf": [
    { "$ref": "#/$defs/PerPersonaReview" },
    { "$ref": "#/$defs/MergedReview" }
  ],
  "$defs": {
    "PersonaSlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Slug of a persona file under `personas/`, e.g. `security`, `architecture`."
    },
    "Severity": {
      "type": "string",
      "enum": ["blocking", "major", "minor", "nit"]
    },
    "Category": {
      "type": "string",
      "enum": [
        "security",
        "correctness",
        "tests",
        "maintainability",
        "performance",
        "compatibility",
        "docs",
        "supply_chain",
        "privacy"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "Decision": {
      "type": "string",
      "enum": ["comment", "request_changes", "block", "needs_human_review"]
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Persona's subjective probability that a senior Shopware reviewer would agree. Anchor bands: low < 0.50, medium 0.50–0.79, high ≥ 0.80. See references/CLASSIFICATION.md §Confidence for the anti-overconfidence cap."
    },
    "BaseFinding": {
      "type": "object",
      "required": [
        "severity",
        "category",
        "file",
        "line",
        "claim",
        "evidence",
        "impact",
        "suggested_fix",
        "confidence",
        "requires_human"
      ],
      "properties": {
        "severity": { "$ref": "#/$defs/Severity" },
        "category": { "$ref": "#/$defs/Category" },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path that appears in the PR diff."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "1-indexed line in the post-change file (right-hand side of the diff)."
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Verbatim quote from the diff or shell output. Never paraphrased."
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "requires_human": {
          "type": "boolean",
          "description": "True only when a human reviewer must validate before merge."
        }
      }
    },
    "PerPersonaFinding": {
      "$ref": "#/$defs/BaseFinding"
    },
    "MergedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona",
        "concurring_personas",
        "severity",
        "category",
        "file",
        "line",
        "claim",
        "evidence",
        "impact",
        "suggested_fix",
        "confidence",
        "requires_human"
      ],
      "properties": {
        "persona": { "$ref": "#/$defs/PersonaSlug" },
        "concurring_personas": {
          "type": "array",
          "items": { "$ref": "#/$defs/PersonaSlug" },
          "uniqueItems": true,
          "description": "Other personas that raised the same (file, line, normalised claim). Sorted alphabetically. Empty when only one persona raised the finding."
        },
        "severity": { "$ref": "#/$defs/Severity" },
        "category": { "$ref": "#/$defs/Category" },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path that appears in the PR diff."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "1-indexed line in the post-change file (right-hand side of the diff)."
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Verbatim quote from the diff or shell output. Never paraphrased."
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "requires_human": {
          "type": "boolean",
          "description": "True only when a human reviewer must validate before merge."
        }
      }
    },
    "PerPersonaReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "persona",
        "summary",
        "risk_level",
        "decision",
        "findings"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1" },
        "persona": { "$ref": "#/$defs/PersonaSlug" },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "risk_level": { "$ref": "#/$defs/RiskLevel" },
        "decision": { "$ref": "#/$defs/Decision" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/PerPersonaFinding" },
          "description": "Empty array is valid and correct when the persona has nothing to say."
        }
      }
    },
    "MergedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pr",
        "personas_run",
        "personas_skipped",
        "summary",
        "risk_level",
        "decision",
        "requires_human",
        "persona_summaries",
        "findings"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1" },
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "head_sha"],
          "properties": {
            "number": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "null" }
              ],
              "description": "Positive integer in PR mode; null in local-diff mode (review of a branch with no associated PR yet)."
            },
            "head_sha": { "type": "string", "minLength": 7 }
          }
        },
        "personas_run": {
          "type": "array",
          "items": { "$ref": "#/$defs/PersonaSlug" },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Personas that produced a review. Sorted alphabetically."
        },
        "personas_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["persona", "reason"],
            "properties": {
              "persona": { "$ref": "#/$defs/PersonaSlug" },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              }
            }
          },
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "risk_level": { "$ref": "#/$defs/RiskLevel" },
        "decision": { "$ref": "#/$defs/Decision" },
        "requires_human": {
          "type": "boolean",
          "description": "True iff any merged finding has requires_human: true."
        },
        "persona_summaries": {
          "type": "object",
          "description": "Map from persona slug to that persona-worker's `summary` text.",
          "propertyNames": { "$ref": "#/$defs/PersonaSlug" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/MergedFinding" },
          "description": "Deduped flat list across all personas. Sorted by severity desc, then file asc, then line asc."
        }
      }
    }
  }
}
