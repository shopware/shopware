{
  "name": "reproduce-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tooling and tests for the issue-reproduction CI action (see README.md).",
  "scripts": {
    "test": "node --test $(find . -path ./node_modules -prune -o -name '*.test.mjs' -print)",
    "test:coverage": "node --test --experimental-test-coverage $(find . -path ./node_modules -prune -o -name '*.test.mjs' -print)",
    "test:bash": "bash tests/bash/run.sh",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "globals": "^15.15.0"
  }
}
