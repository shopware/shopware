{
	# Disable admin interface - not needed for CI
	admin off
}

:8000 {
	root * {$DOCUMENT_ROOT:/var/www/html/public}
	encode zstd gzip

	# Efficient cache policy for static assets (1 year, immutable)
	@static path /bundles/* /theme/* /media/* /thumbnail/* /css/* /fonts/* /js/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# PHP-FPM via Unix socket (use environment variable for socket path)
	php_fastcgi unix/{$PHP_FPM_SOCKET:/run/php/php-fpm.sock}

	file_server
}
