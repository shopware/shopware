# yamlfmt configuration — https://github.com/google/yamlfmt
# Scoped to GitHub Actions workflows and composite actions so a bare
# `yamlfmt` / `yamlfmt -lint` only touches CI YAML, not unrelated files.
doublestar: true

include:
  - .github/workflows/*.yml
  - .github/workflows/*.yaml
  - .github/actions/**/*.yml
  - .github/actions/**/*.yaml
  - .github/actionlint.yaml

exclude:
  # Generated by gh-aw ("DO NOT EDIT", linguist-generated). Recompiled via
  # `gh aw compile`; formatting them here would be overwritten and is noise.
  - .github/workflows/*.lock.yml
  - .github/workflows/agentics-maintenance.yml

formatter:
  type: basic
  # Keep author-placed blank lines (collapsing runs to a single blank line)
  # instead of stripping them — preserves readability and keeps diffs small.
  retain_line_breaks_single: true
