<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Acme\AcmePlugin\Tax\AcmeTaxProvider">
            <tag name="shopware.tax.provider" priority="200"/>
        </service>

        <service id="Acme\AcmePlugin\Subscriber\OrderFulfillmentSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Acme\AcmePlugin\Subscriber\AcmeLogTriggerSubscriber">
            <argument type="service" id="monolog.logger"/>
            <tag name="kernel.event_subscriber"/>
            <tag name="monolog.logger" channel="acme"/>
        </service>

        <service id="Acme\AcmePlugin\Mcp\AcmeStatusTool">
            <argument type="service" id="Acme\AcmePlugin\Tax\AcmeTaxProvider"/>
            <tag name="mcp.tool"/>
        </service>

        <!--
            EventReflectTool — live PHP reflection for any Shopware event class.
            Powers Demo 2 "reflection-verified getter names" via the MCP bridge.
            Tool name: acme-event-reflect
            Usage: call_tool("acme-event-reflect", {"event_class": "FQN"})
        -->
        <service id="Acme\AcmePlugin\Mcp\EventReflectTool">
            <tag name="mcp.tool"/>
        </service>

        <!--
            AcmeSyncController — three Admin API endpoints for Demo 3.
            These paths do NOT appear in Shopware documentation and are
            discoverable only via live spec comparison (shopware_api_spec_compare).
            Routes loaded from: Resources/config/routes.xml
        -->
        <service id="Acme\AcmePlugin\Controller\AcmeSyncController" public="true">
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Acme\AcmePlugin\Command\DemoSeedCommand">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="tax.repository"/>
            <tag name="console.command"/>
        </service>

    </services>

</container>
