{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2020",
            "DOM",
            "ES2023"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "baseUrl": ".",
        "paths": {
            "src/*": ["../../../src/Administration/Resources/app/administration/src/*"],
            "vue": ["../../../src/Administration/Resources/app/administration/node_modules/vue"],
            "@vue/test-utils": ["../../../src/Administration/Resources/app/administration/node_modules/@vue/test-utils"],
            "@shopware-ag/*": ["../../../src/Administration/Resources/app/administration/node_modules/@shopware-ag/*"]
        },
        "typeRoots": [
            "../../../src/Administration/Resources/app/administration/node_modules/@types"
        ],
        "types": [
            "jest",
            "node"
        ],
        "allowJs": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noErrorTruncation": false
    },
    "files": [
        "../../../src/Administration/Resources/app/administration/src/html-shim.d.ts",
        "../../../src/Administration/Resources/app/administration/src/global.types.ts",
        "../../../src/Administration/Resources/app/administration/src/entity-schema-definition.d.ts",
        "../../../src/Administration/Resources/app/administration/build/vue-setup-transform/shopware-setup-macros.d.ts"
    ],
    "include": [
        "src/Resources/app/administration/src/**/*.ts",
        "src/Resources/app/administration/src/**/*.vue"
    ],
    "exclude": [
        "src/Resources/app/administration/src/**/*.spec.ts",
        "src/Resources/app/administration/src/**/*.spec.js"
    ]
}
