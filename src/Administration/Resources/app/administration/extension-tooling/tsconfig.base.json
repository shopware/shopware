{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        // Classic Node resolution ignores the "exports" field, which is what makes the
        // exports-gated subpaths of @shopware-ag/meteor-* resolve through the filesystem.
        // Measured against a real extension: "Bundler" leaves 82 unresolved modules
        // (TS2307), "node" leaves 0. It is also the resolver the Administration itself
        // compiles with, so this is consistency rather than a special case.
        "moduleResolution": "node",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        // No ambient @types are pulled in implicitly; the type surface an extension sees
        // is exactly what admin-types.d.ts declares.
        "types": []
        // Deliberately no "paths": with classic Node resolution every host package is
        // found through node_modules, so "paths" belongs entirely to the extension. That
        // is what keeps tsconfig inheritance — which replaces "paths" wholesale — from
        // ever destroying host resolution.
    }
}
