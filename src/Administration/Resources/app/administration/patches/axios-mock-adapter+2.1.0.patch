+// axios >= 0.32 builds merged config objects (headers, params, ...) with
+// Object.create(null) as prototype-pollution hardening. Both the AxiosHeaders
+// detection below and fast-deep-equal (used by findHandler) read `.constructor`,
+// which is undefined on such objects - the first throws, the second never
+// matches. Re-attach Object.prototype before handing the values to findHandler.
+function withObjectPrototype(value) {
+  if (!value || typeof value !== "object") {
+    return value;
+  }
+
+  if (Array.isArray(value)) {
+    return value.map(withObjectPrototype);
+  }
+
+  if (Object.getPrototypeOf(value) !== null) {
+    return value;
+  }
+
+  const normalized = {};
+  Object.keys(value).forEach(function (key) {
+    normalized[key] = withObjectPrototype(value[key]);
+  });
+
+  return normalized;
+}
