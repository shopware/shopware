            <sw-pagination :page="page" :limit="limit" :total="total" @page-change="onPageChange" />

            <button class="sw-mixin-listing-scaffold__refresh" @click="onRefresh">Refresh</button>
        </div>
    </sw-block>
</template>

<script setup>
// TODO(sfc-migration) VERIFY: useListing() replaces the 'listing' mixin
// Nothing is missing from the draft; what the codemod cannot decide is whether it behaves the same — check:
// - getList() is passed to useListing() and still resolves everything it reads and writes
// - the initial load runs on mounted now, one hook later than the mixin loaded it
// - route parameter handling, which the composable owns from here on
// - these were routed into the composable options instead of staying state: limit, sortBy, searchConfigEntity

import { ref, computed, inject } from 'vue';
import useListing from 'src/app/composables/use-listing';

const repositoryFactory = inject('repositoryFactory');

const {
    page,
    limit,
    total,
    sortBy,
    sortDirection,
    naturalSorting,
    entitySearchable,
    selectionCount,
    currentSortBy,
    onPageChange,
    onSwitchFilter,
    onSortColumn,
    onRefresh,
} = useListing({
    filters: () => filters.value,
    getList: (...args) => getList(...args),
    limit: 10,
    sortBy: 'createdAt',
    searchConfigEntity: 'product',
});

const getList = // The member the mixin called but never implemented.
    async function () {
        isLoading.value = true;

        const result = await repository.value.search(listCriteria.value, Shopware.Context.api);

        items.value = result;
        total.value = result.total;
        isLoading.value = false;
    };

const onSaved = function () {
    getList();
};

const repository = computed(function () {
    return repositoryFactory.create('product');
});

const listCriteria = computed(function () {
    const criteria = new Criteria(page.value, limit.value);

    criteria.addSorting(Criteria.sort(sortBy.value, sortDirection.value, naturalSorting.value));

    return criteria;
});

const filters = computed(
    // The mixin's own computed defaulted to an empty list and invited this override.
    function () {
        return [
            {
                name: 'active-filter',
                active: entitySearchable.value,
            },
        ];
    },
);

const items = ref(null);
const isLoading = ref(false);

// TODO(sfc-migration): array inject declaration requires runtime ref-unwrapping verification — original code:
// inject: ['repositoryFactory']

swDefinePublic({
    repositoryFactory,
    page,
    limit,
    total,
    sortBy,
    sortDirection,
    naturalSorting,
    entitySearchable,
    selectionCount,
    currentSortBy,
    onPageChange,
    onSwitchFilter,
    onSortColumn,
    onRefresh,
    items,
    isLoading,
    repository,
    listCriteria,
    filters,
    getList,
    onSaved,
});
</script>
",
}
`;

