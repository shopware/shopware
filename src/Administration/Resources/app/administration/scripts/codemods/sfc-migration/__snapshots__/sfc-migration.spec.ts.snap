exports[`scripts/codemods/sfc-migration fixture snapshots (outcome, reasons and generated SFC per fixture) converts sw-shadowed-locals 1`] = `
{
  "outcome": "partial",
  "reasons": [
    "this.currentPage is shadowed by a local binding",
    "this.perPage is shadowed by a local binding",
    "this.iconSvgData is shadowed by a local binding",
    "this.$route is shadowed by a local binding",
    "this.focussed is shadowed by a local binding",
    "template ref 'modalContent' is shadowed by a local binding",
  ],
  "sfc": "<template>
    <sw-block name="sw_shadowed_locals">
        <div ref="modalContent" class="sw-shadowed-locals">
            <h2>{{ heading }}</h2>
            <p>{{ countItems() }} / {{ displayedPages.length }}</p>
            <button @click="setFocus(true)">{{ currentLocation().name }}</button>
        </div>
    </sw-block>
</template>

<script setup>
import { ref, computed } from 'vue';

const props = defineProps({
    title: {
        type: String,
        required: true,
    },
});

const onPageSizeChange = // The parameter shadows the data key: \`perPage.value = …\` would target the argument.
    function (perPage) {
        this.perPage = Number(perPage);
    };

const loadIcon = // The arrow inherits the component \`this\` and its parameter shadows — this is the silent
    // case, because assigning \`.value\` on the resolved object throws nothing.
    function () {
        return Promise.resolve({}).then((iconSvgData) => {
            this.iconSvgData = iconSvgData.default;
        });
    };

const currentLocation = // The INSTANCE_PROPS replacement identifier is what has to be free here, not \`$route\`.
    function () {
        const route = { name: this.$route.name };

        return route;
    };

const setFocus = function (focussed) {
    this.focussed = focussed;
};

const countItems = // A binding in a sibling nested function must not block the outer rewrite.
    function () {
        const total = [].map((items) => items.length);

        return items.value.length + total.length;
    };

const toggle = // Block scope is modelled: a binding the reference never reaches is not shadowing.
    function () {
        if (props.title) {
            const hidden = true;

            return hidden;
        }

        return hidden.value;
    };

const openModal = function (modalContent) {
    this.$refs.modalContent.focus();

    return modalContent;
};

const displayedPages = computed(
    // A \`const\` declared after the reference still shadows it — reading it would be a temporal
    // dead zone error, not a fallback to the setup binding.
    function () {
        const currentPage = this.currentPage;

        return [currentPage];
    },
);

const heading = computed(
    // Only \`props\` can shadow a prop reference, so a local named after the prop is harmless.
    function () {
        const title = 'fallback';

        return props.title || title;
    },
);

const perPage = ref(25);
const currentPage = ref(1);
const iconSvgData = ref(null);
const focussed = ref(false);
const hidden = ref(false);
const items = ref([]);

// TODO(sfc-migration): this.currentPage is shadowed by a local binding

// TODO(sfc-migration): this.perPage is shadowed by a local binding

// TODO(sfc-migration): this.iconSvgData is shadowed by a local binding

// TODO(sfc-migration): this.$route is shadowed by a local binding

// TODO(sfc-migration): this.focussed is shadowed by a local binding

// TODO(sfc-migration): template ref 'modalContent' is shadowed by a local binding — original code:
// this.$refs.modalContent

swDefinePublic({
    perPage,
    currentPage,
    iconSvgData,
    focussed,
    hidden,
    items,
    displayedPages,
    heading,
    onPageSizeChange,
    loadIcon,
    currentLocation,
    setFocus,
    countItems,
    toggle,
    openModal,
});
</script>
",
}
`;

exports[`scripts/codemods/sfc-migration fixture snapshots (outcome, reasons and generated SFC per fixture) converts sw-simple-card 1`] = `
{
  "outcome": "partial",
  "reasons": [
    "array inject declaration requires runtime ref-unwrapping verification",
  ],
  "sfc": "<script data-sfc-migration-module>
/**
 * @sw-package framework
 */
</script>

<template>
    <sw-block name="sw_simple_card">
        <div class="sw-simple-card">
            <sw-block name="sw_simple_card_header">
                <h1>{{ headline }}</h1>
            </sw-block>

            <sw-block name="sw_simple_card_content">
                <button :disabled="isLoading" @click="onSave">
                    {{ $t('global.default.save') }}
                </button>
            </sw-block>
        </div>
    </sw-block>
</template>

<script setup>
import { ref, computed, inject } from 'vue';

const repositoryFactory = inject('repositoryFactory');
const acl = inject('acl');

const props = defineProps({
    title: {
        type: String,
        required: false,
        default: 'Default Title',
    },
});

const emit = defineEmits(['save']);

const loadItems = async function () {
    isLoading.value = true;
    items.value = await repository.value.search(new Shopware.Data.Criteria(1, 25));
    isLoading.value = false;
};

const onSave = function () {
    emit('save', items.value);
};

const headline = computed(function () {
    return \`\${props.title} (\${items.value.length})\`;
});

const repository = computed(function () {
    return repositoryFactory.create('product');
});

const isLoading = ref(false);
const items = ref([]);

// TODO(sfc-migration): array inject declaration requires runtime ref-unwrapping verification — original code:
// inject: ['repositoryFactory', 'acl']

swDefinePublic({
    repositoryFactory,
    acl,
    isLoading,
    items,
    headline,
    repository,
    loadItems,
    onSave,
});
</script>
",
}
`;

