import useRuleBetweenOperator from 'src/app/composables/use-rule-between-operator';

const props = defineProps({
    condition: {
        type: Object,
        required: true,
    },
});

const { isBetween, betweenValue } = useRuleBetweenOperator({
    condition: () => props.condition,
    ensureValueExist: (...args) => ensureValueExist(...args),
});

const ensureValueExist = // The method the mixin called on its host before writing the pair back.
    function () {
        if (!props.condition.value) {
            props.condition.value = {};
        }
    };

swDefinePublic({
    isBetween,
    betweenValue,
    ensureValueExist,
});
</script>
