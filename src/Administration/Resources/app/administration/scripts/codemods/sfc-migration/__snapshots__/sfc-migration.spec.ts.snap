exports[`scripts/codemods/sfc-migration fixture snapshots (outcome, reasons and generated SFC per fixture) converts sw-instance-api 1`] = `
{
  "outcome": "full",
  "reasons": [],
  "sfc": "<template>
    <sw-block name="sw_instance_api">
        <div v-if="active" ref="modalContent" class="sw-instance-api" tabindex="-1">
            <p>{{ successMessage() }}</p>
            <button @click="closeModal">{{ $t('global.default.close') }}</button>
        </div>
    </sw-block>
</template>

<script setup>
import { ref, nextTick } from 'vue';
import { useI18n } from 'vue-i18n';
import { useRouter, useRoute } from 'vue-router';

const { t } = useI18n();
const router = useRouter();
const route = useRoute();

const props = defineProps({});

const emit = defineEmits(['modal-close']);

const openModal = function () {
    active.value = true;

    nextTick(() => {
        modalContent.value.focus();
    });
};

const closeModal = function () {
    active.value = false;
    emit('modal-close');

    if (props.active === undefined) {
        router.push({ name: 'sw.dashboard.index', params: route.params });
    }
};

const successMessage = function () {
    return t('global.default.success');
};

const active = ref(false);

const modalContent = ref(null);

swDefinePublic({
    active,
    modalContent,
    openModal,
    closeModal,
    successMessage,
});
</script>
",
}
`;

exports[`scripts/codemods/sfc-migration fixture snapshots (outcome, reasons and generated SFC per fixture) converts sw-legacy-i18n 1`] = `
{
  "outcome": "partial",
  "reasons": [
    "this.$t(key, locale) is left as authored and does not run in setup",
    "this.$tc(key, choice, values) is left as authored and does not run in setup",
  ],
  "sfc": "<script data-sfc-migration-module>
/**
 * @sw-package framework
 */
</script>

<template>
    <sw-block name="sw_legacy_i18n">
        <div class="sw-legacy-i18n">
            <h2>{{ title }} / {{ fallbackTitle }}</h2>
            <p>{{ itemLabel }} / {{ namedItemLabel }} / {{ toggleLabel }}</p>
        </div>
    </sw-block>
</template>

<script setup>
import { computed } from 'vue';
import { useI18n } from 'vue-i18n';

const { t } = useI18n();

const props = defineProps({
    itemCount: {
        type: Number,
        required: true,
    },

    collapsed: {
        type: Boolean,
        required: true,
    },
});

const title = computed(
    // Both shapes mean the same to legacy \`$t\`/\`$tc\` and to Composition \`t()\`.
    function () {
        return t('sw-legacy-i18n.title', { name: 'demo' });
    },
);

const itemLabel = computed(function () {
    return t('sw-legacy-i18n.items', props.itemCount);
});

const toggleLabel = computed(
    // A plural count does not have to be a literal to be portable.
    function () {
        return t('sw-legacy-i18n.toggle', props.collapsed ? 0 : 1);
    },
);

const fallbackTitle = computed(
    // Both shapes are read differently by Composition \`t()\`.
    function () {
        return this.$t('sw-legacy-i18n.title', Shopware.Context.app.fallbackLocale);
    },
);

const namedItemLabel = computed(function () {
    return this.$tc('sw-legacy-i18n.items', props.itemCount, { name: 'demo' });
});

// TODO(sfc-migration) FIX: this.$t(key, locale) is left as authored and does not run in setup
// Composition t() would read the locale as a default message; rewrite the call as t(key, values, { locale }) — original code:
// this.$t('sw-legacy-i18n.title', Shopware.Context.app.fallbackLocale)

// TODO(sfc-migration) FIX: this.$tc(key, choice, values) is left as authored and does not run in setup
// Composition t() expects options in the third argument; rewrite the call as t(key, values, choice) — original code:
// this.$tc('sw-legacy-i18n.items', this.itemCount, { name: 'demo' })

swDefinePublic({
    title,
    itemLabel,
    toggleLabel,
    fallbackTitle,
    namedItemLabel,
});
</script>
",
}
`;

