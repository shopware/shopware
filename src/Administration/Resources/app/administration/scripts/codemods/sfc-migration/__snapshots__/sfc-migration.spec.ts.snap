exports[`scripts/codemods/sfc-migration fixture snapshots (outcome, reasons and generated SFC per fixture) converts sw-watcher-demo 1`] = `
{
  "outcome": "partial",
  "reasons": [
    "watch source '$route' has exact $route semantics that need runtime verification",
  ],
  "sfc": "<template>
    <sw-block name="sw_watcher_demo">
        <input v-model="term" class="sw-watcher-demo" />
    </sw-block>
</template>

<script setup>
import { ref, watch } from 'vue';

const props = defineProps({
    productId: {
        type: String,
        required: true,
    },
});

const onTermChange = function () {};

const loadProduct = function () {};

const term = ref('');
const config = ref({ limit: 25 });

watch(term, function (newTerm, oldTerm) {
    onTermChange(newTerm, oldTerm);
});

watch(
    () => props.productId,
    function () {
        loadProduct();
    },
    { immediate: true },
);

watch(() => config.value.limit, loadProduct, { deep: true });

// TODO(sfc-migration): watch source '$route' has exact $route semantics that need runtime verification — original code:
// $route() {
//             this.term = '';
//         }

swDefinePublic({
    term,
    config,
    onTermChange,
    loadProduct,
});
</script>
",
}
`;

