        <div class="sw-module-level-code">{{ label }}</div>
    </sw-block>
</template>

<script setup lang="ts">
import { ref } from 'vue';

const cache = function (): Map<string, Row> {
    return sharedCache;
};

const criteria = function (): unknown {
    return buildCriteria();
};

const label = ref(LABEL);

swDefinePublic({
    label,
    cache,
    criteria,
});
</script>
