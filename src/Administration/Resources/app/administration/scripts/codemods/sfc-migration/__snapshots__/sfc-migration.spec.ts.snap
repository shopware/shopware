</template>

<script setup>
import { ref, onMounted, onBeforeUnmount, onBeforeMount } from 'vue';

const fetchEntries = async function () {
    entries.value = [];
};

const observer = ref(null);
const entries = ref([]);

onBeforeMount(async function () {
    await fetchEntries();
});

onMounted(function () {
    observer.value = 'attached';
});

onBeforeUnmount(function () {
    observer.value = null;
});

swDefinePublic({
    observer,
    entries,
    fetchEntries,
});
</script>
",
}
`;

