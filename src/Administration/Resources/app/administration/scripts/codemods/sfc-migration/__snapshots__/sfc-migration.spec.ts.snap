{
  "outcome": "full",
  "reasons": [],
  "sfc": "<template>
    <sw-block name="sw_lifecycle_demo">
        <ul class="sw-lifecycle-demo">
            <li v-for="entry in entries" :key="entry">{{ entry }}</li>
        </ul>
    </sw-block>
</template>

<script setup>
import { ref, onMounted, onBeforeUnmount } from 'vue';

const fetchEntries = async function () {
    entries.value = [];
};

const observer = ref(null);
const entries = ref([]);

onMounted(function () {
    observer.value = 'attached';
});

onBeforeUnmount(function () {
    observer.value = null;
});

void (async function () {
    await fetchEntries();
})();

swDefinePublic({
    observer,
    entries,
    fetchEntries,
});
</script>
",
}
`;

