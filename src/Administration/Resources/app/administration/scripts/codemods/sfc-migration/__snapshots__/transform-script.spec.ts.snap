exports[`scripts/codemods/sfc-migration/transform-script block-component: converts props, emits, data init from prop, computed, watch (prop+data), methods with $emit and $refs, and lifecycle matches the complete converted script snapshot 1`] = `
"const props = defineProps({
        initialCount: {
            type: Number,
            required: false,
            default: 0,
        },
        readOnly: {
            type: Boolean,
            required: false,
            default: false,
        },
    });
const emit = defineEmits(['action', 'reset']);

import { ref, computed, inject, watch, onMounted } from 'vue';

const cardWrapper = ref(null);

const acl = inject('acl');

const title = ref('Block Card');
const description = ref('A card with extensible blocks');
const count = ref(props.initialCount);

const canEdit = computed(() => {
return !props.readOnly && acl.can('product.editor');
});
const label = computed({
get: () => {
return title.value;
},
set: (val) => {
title.value = val;
},
});

const onAction = () => {
count.value += 1;
emit('action', count.value);
};
const onReset = () => {
count.value = props.initialCount;
title.value = 'Block Card';
cardWrapper.value.focus();
emit('reset');
};

watch(() => count.value, (newVal) => {
if (newVal > 10) {
    title.value = 'Limit reached';
}
});
watch(() => props.readOnly, (newVal) => {
if (newVal) {
    title.value = 'Read-only mode';
}
});

onMounted(() => {
count.value = props.initialCount;
});

swDefinePublic({
    acl,
    title,
    description,
    count,
    canEdit,
    label,
    onAction,
    onReset,
});"
`;

exports[`scripts/codemods/sfc-migration/transform-script composables-component: rewrites $router, $route, $slots, $nextTick, $t, and $tc to their Composition API equivalents matches the complete converted script snapshot 1`] = `
"import { ref, computed, nextTick, useSlots, useAttrs } from 'vue';
import { useRouter, useRoute } from 'vue-router';
import { useI18n } from 'vue-i18n';

const router = useRouter();
const route = useRoute();
const slots = useSlots();
const attrs = useAttrs();
const { t } = useI18n();

const value = ref('');

const currentRoute = computed(() => {
return route.name;
});
const hasSlot = computed(() => {
return !!slots.default;
});
const label = computed(() => {
return t('sw.composables.label', 2);
});

const goBack = () => {
router.back();
};
const update = async () => {
value.value = 'new';
await nextTick();
};
const getTitle = () => {
return t('sw.composables.title');
};
const getAttrsClass = () => {
return attrs.class ?? '';
};

swDefinePublic({
    value,
    currentRoute,
    hasSlot,
    label,
    goBack,
    update,
    getTitle,
    getAttrsClass,
});"
`;

exports[`scripts/codemods/sfc-migration/transform-script computed-spread-component: expands the statically analysable computed spreads matches the complete converted script snapshot 1`] = `
"const { Store } = Shopware;
const { mapPropertyErrors, mapCollectionPropertyErrors, mapState } = Shopware.Component.getComponentHelper();

import { ref, computed } from 'vue';

const product = ref(null);
const lineItems = ref([]);

// from the ...mapPropertyErrors('product', …) computed spread
const productNameError = computed(() => {
const entity = product.value;
const isEntity = entity && typeof entity.getEntityName === 'function';
if (!isEntity) { return null; }
return Shopware.Store.get('error').getApiError(entity, 'name');
});
// from the ...mapPropertyErrors('product', …) computed spread
const productStockError = computed(() => {
const entity = product.value;
const isEntity = entity && typeof entity.getEntityName === 'function';
if (!isEntity) { return null; }
return Shopware.Store.get('error').getApiError(entity, 'stock');
});
// from the ...mapCollectionPropertyErrors('lineItems', …) computed spread
const lineItemsQuantityError = computed(() => {
const entityCollection = lineItems.value;
if (!Array.isArray(entityCollection)) { return null; }
return entityCollection.map((entity) => Shopware.Store.get('error').getApiError(entity, 'quantity'));
});
// from the ...mapState(() => Store.get('swProductDetail'), …) computed spread
const loading = computed(() => {
return Store.get('swProductDetail').loading;
});

swDefinePublic({
    product,
    lineItems,
    productNameError,
    productStockError,
    lineItemsQuantityError,
    loading,
});"
`;

exports[`scripts/codemods/sfc-migration/transform-script created-component: created() runs as direct setup code; beforeUnmount/unmounted use correct hooks matches the complete converted script snapshot 1`] = `
"const props = defineProps({
        selector: {
            type: String,
            required: false,
            default: 'body',
        },
    });
const emit = defineEmits(['ready']);

import { ref, inject, onMounted, onBeforeUnmount, onUnmounted } from 'vue';

const shortcutService = inject('shortcutService');

const initialized = ref(false);

const reset = () => {
initialized.value = false;
};

shortcutService.stopEventListener();
emit('ready');

onMounted(() => {
initialized.value = true;
});
onBeforeUnmount(() => {
shortcutService.startEventListener();
});
onUnmounted(() => {
initialized.value = false;
});

swDefinePublic({
    shortcutService,
    initialized,
    reset,
});"
`;

