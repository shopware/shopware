"import './module-level-component.scss';
const { cloneDeep } = Shopware.Utils.object;
const COLORS = ['#FF0000', '#00FF00', '#0000FF'];

const props = defineProps({
        name: {
            type: String,
            required: true,
        },
        items: {
            type: Array,
            required: false,
            default: () => [],
        },
    });

import { computed } from 'vue';

const clonedItems = computed(() => {
return cloneDeep(props.items);
});
const nameColor = computed(() => {
return COLORS[props.name.length % COLORS.length];
});

swDefinePublic({
    clonedItems,
    nameColor,
});"
`;

exports[`scripts/codemods/sfc-migration/transform-script provide-component: converts provide() into provide(key, value) calls matches the complete converted script snapshot 1`] = `
"const emit = defineEmits(['item-register']);

import { ref, computed, provide } from 'vue';

const items = ref([]);
const scopeName = ref('sw-provider-card');

const itemCount = computed(() => {
return items.value.length;
});

const registerCardItem = (item) => {
items.value.push(item);
emit('item-register', item);
};

provide('registerCardItem', registerCardItem);
provide('card-scope', scopeName.value);

swDefinePublic({
    items,
    scopeName,
    itemCount,
    registerCardItem,
});"
`;

