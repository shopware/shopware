"const emit = defineEmits(['save']);

import { ref, computed, inject } from 'vue';

const repositoryFactory = inject('repositoryFactory');

const title = ref('Default Title');
const isLoading = ref(false);

const description = computed(() => {
return \`This is: \${title.value}\`;
});

const onSave = () => {
isLoading.value = true;
emit('save', title.value);
};

swDefinePublic({
    repositoryFactory,
    title,
    isLoading,
    description,
    onSave,
});"
`;

exports[`scripts/codemods/sfc-migration/transform-script watch-path-component: converts dotted watch keys into optional-chained getters matches the complete converted script snapshot 1`] = `
"const props = defineProps({
        item: {
            type: Object,
            required: true,
        },
    });

import { ref, watch } from 'vue';
import { useRoute } from 'vue-router';

const route = useRoute();

const entity = ref(null);
const netPrice = ref(0);
const label = ref('');

const applyLabel = (name) => {
label.value = name ?? '';
};

watch(() => props.item?.price?.net, (value) => {
netPrice.value = value;
});
watch(() => entity.value?.name, (...args) => applyLabel(...args), { immediate: true });
watch(() => entity.value?.customFields, (value) => {
label.value = value?.title ?? '';
}, { deep: true });
watch(() => route?.name, () => {
label.value = '';
});

swDefinePublic({
    entity,
    netPrice,
    label,
    applyLabel,
});"
`;
