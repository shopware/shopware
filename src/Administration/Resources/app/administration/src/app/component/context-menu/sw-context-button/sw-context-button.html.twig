{% block sw_context_button %}
<button
    ref="swContextButton"
    class="sw-context-button"
    :class="contextClass"
    :aria-label="ariaLabel && $t(ariaLabel)"
    @click="onClickButton"
    @keydown.enter="onClickButton"
>
    {% block sw_context_button_button %}
    <slot name="button">
        <div
            class="sw-context-button__button"
            :class="contextButtonClass"
            tabindex="-1"
        >
            <mt-icon
                :name="icon"
                :size="iconSize"
                decorative
            />
        </div>
    </slot>
    {% endblock %}

    {# @bc-change OpenIfChainRemoval version:v6.8.0
    The block will end with the popover. Overrides check showMenu themselves instead of adding a v-else. #}
    {% block sw_context_button_menu %}
    <mt-floating-ui
        class="sw-context-button__menu-position sw-context-button__menu-popover"
        :is-opened="showMenu"
        :anchor-element="$refs.swContextButton"
        :offset="10"
        :floating-ui-options="menuFloatingUiOptions"
    >
        <sw-context-menu
            ref="swContextMenu"
            :class="contextMenuClass"
            :style="menuStyles"
        >
            <slot>
            {% block sw_context_button_menu_slot_default %}{% endblock %}
            </slot>
        </sw-context-menu>
    </mt-floating-ui>
    <template v-if="showMenu">
        <!-- Keeps the v-if chain open for overrides that add a v-else after this block -->
    </template>
    {% endblock %}
</button>
{% endblock %}
