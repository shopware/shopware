{% block sw_context_button %}
<button
    ref="swContextButton"
    class="sw-context-button"
    :class="contextClass"
    :aria-label="ariaLabel && $t(ariaLabel)"
    @click="onClickButton"
    @keydown.enter="onClickButton"
>
    {% block sw_context_button_button %}
    <slot name="button">
        <div
            class="sw-context-button__button"
            :class="contextButtonClass"
            tabindex="-1"
        >
            <mt-icon
                :name="icon"
                :size="iconSize"
                decorative
            />
        </div>
    </slot>
    {% endblock %}

    {% block sw_context_button_menu %}
    {# Mounted only while open: sw-modal moves its element to the body, which breaks a teleport inside it when the modal closes #}
    <mt-floating-ui
        v-if="showMenu"
        class="sw-context-button__menu-position sw-context-button__menu-popover"
        :is-opened="true"
        :anchor-element="$refs.swContextButton"
        :offset="10"
        :floating-ui-options="menuFloatingUiOptions"
    >
        <sw-context-menu
            ref="swContextMenu"
            :class="contextMenuClass"
            :style="menuStyles"
        >
            <slot>
            {% block sw_context_button_menu_slot_default %}{% endblock %}
            </slot>
        </sw-context-menu>
    </mt-floating-ui>
    {% endblock %}
</button>
{% endblock %}
