{% block mt_tabs %}
<div
    v-bind="rootAttributes"
    class="mt-tabs-wrapper"
>
    <mt-tabs-original
        ref="mtTabsOriginal"
        :default-item="activeItemName"
        :items="mergedItems"
        :small="small"
        :vertical="vertical"
        @new-item-active="onNewItemActive"
    />
</div>

<div
    v-if="hasCustomContent"
    class="mt-tabs__custom-content"
>
    <slot
        name="content"
        v-bind="{ active: activeItem }"
    ></slot>

    <sw-extension-component-section
        v-if="activeTabExtension && !extensionTabsUseRoutes"
        :position-identifier="activeTabExtension.componentSectionId"
    />
</div>
{% endblock %}
