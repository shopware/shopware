{% block sw_condition_delivery_container %}
<div
    class="condition-delivery-container"
    :class="containerRowClass"
>
    <template
        v-for="(child, index) in children"
        :key="`condition-delivery-child--${index}`"
    >
        <sw-condition-tree-node
            :parent-condition="condition"
            :condition="child"
            :disabled="disabled || undefined"
            :level="level + 1"
            :insert-before="onInsertBefore"
            :insert-after="onInsertAfter"
        />
    </template>
</div>
{% endblock %}
