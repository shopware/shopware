{% block sw_condition_tree %}
<div class="sw-condition-tree">
    <sw-condition-tree-node
        v-if="conditionTree"
        :disabled="disabled"
        :parent-condition="rootCondition"
        :condition="conditionTree"
        :level="0"
    />
    <mt-loader
        v-else
        :backdrop="false"
    />
</div>
{% endblock %}
