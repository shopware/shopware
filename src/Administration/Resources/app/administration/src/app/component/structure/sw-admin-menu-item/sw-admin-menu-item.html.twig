{% block sw_admin_menu_item %}
<!-- eslint-disable vuejs-accessibility/mouse-events-have-key-events, vuejs-accessibility/no-static-element-interactions -->
<mt-collapsible
    v-if="showMenuItem && usesCollapsible"
    as="li"
    :class="collapsibleLiClass"
    :aria-current="rowActive ? 'page' : 'false'"
    :open="collapsibleOpen"
    @update:open="onCollapsibleOpenUpdate"
    @mouseenter="$emit('menu-item-hover', entry, $event.currentTarget)"
    @keydown="onCollapsedParentKeydown"
>
    <div class="sw-admin-menu__navigation-item-row">
        <template v-if="entryPath">
            <router-link
                class="sw-admin-menu__navigation-link"
                :to="getLinkToProp"
                :class="{ 'router-link-active': rowActive }"
                :active-class="routerLinkActiveClass"
                :exact-active-class="routerLinkExactActiveClass"
                :aria-expanded="collapsibleOpen"
                v-bind="collapsedFlyoutAria"
                @click="toggleSubmenu"
            >
                {% block sw_admin_menu_item_icon_linked %}
                <mt-icon
                    v-if="displayIcon"
                    :size="iconSize"
                    class="sw-admin-menu__navigation-link-icon"
                    :name="navigationIconName"
                />
                {% endblock %}

                {% block sw_admin_menu_item_text_linked %}
                <span
                    class="sw-admin-menu__navigation-link-label"
                    :class="collapsibleText ? 'collapsible-text hide-on-collapse' : ''"
                    :title="getEntryLabel"
                >
                    {{ getEntryLabel }}
                </span>
                {% endblock %}

                <slot name="additional-text"></slot>

                {% block sw_admin_menu_item_expand_indicator_linked %}
                <span class="sw-admin-menu__navigation-link-expand-icon-box">
                    <mt-icon
                        :name="expandIcon"
                        size="8"
                        class="sw-admin-menu__navigation-link-expand-icon collapsible-text hide-on-collapse"
                    />
                </span>
                {% endblock %}
            </router-link>
        </template>

        <mt-collapsible-trigger
            v-else
            type="button"
            class="sw-admin-menu__navigation-link"
            :class="{ 'router-link-active': rowActive }"
            v-bind="collapsedFlyoutAria"
        >
            {% block sw_admin_menu_item_navigation_icon_fold %}
            <mt-icon
                v-if="displayIcon"
                :size="iconSize"
                class="sw-admin-menu__navigation-link-icon"
                :name="navigationIconName"
            />
            {% endblock %}

            {% block sw_admin_menu_item_navigation_text_fold %}
            <span
                class="sw-admin-menu__navigation-link-label"
                :class="collapsibleText ? 'collapsible-text hide-on-collapse' : ''"
                :title="getEntryLabel"
            >
                {{ getEntryLabel }}
            </span>
            {% endblock %}

            <slot name="additional-text"></slot>

            {% block sw_admin_menu_item_expand_indicator_fold %}
            <span
                v-if="children.length"
                class="sw-admin-menu__navigation-link-expand-icon-box"
            >
                <mt-icon
                    :name="expandIcon"
                    size="8"
                    class="sw-admin-menu__navigation-link-expand-icon collapsible-text hide-on-collapse"
                />
            </span>
            {% endblock %}
        </mt-collapsible-trigger>
    </div>

    {% block sw_sidebar_sub_items_collapsible %}
    <mt-collapsible-content
        as="ul"
        class="sw-admin-menu__sub-navigation-list"
    >
        <sw-admin-menu-item
            v-for="(childEntry, subMenuIndex) in children"
            :key="getStableSubMenuItemKey(childEntry, subMenuIndex)"
            :entry="childEntry"
            :menu-depth="menuDepth + 1"
            :display-icon="false"
            :sidebar-expanded="sidebarExpanded"
            :collapsible-text="collapsibleText"
            :icon-size="iconSize"
            @menu-item-hover="forwardMenuItemHover"
            @branch-toggle="forwardBranchToggle"
        />
    </mt-collapsible-content>
    {% endblock %}
</mt-collapsible>

<li
    v-else-if="showMenuItem"
    :class="leafLiClass"
    :aria-current="rowActive ? 'page' : 'false'"
    @mouseenter="$emit('menu-item-hover', entry, $event.target)"
>
    <mt-tooltip
        :content="getEntryLabel"
        placement="right"
    >
        <template #default="{ ...tooltipProps }">
            <div
                class="sw-admin-menu__navigation-item-row"
                v-bind="collapsedTooltipTriggerProps(tooltipProps)"
            >

                <router-link
                    v-if="entryPath"
                    class="sw-admin-menu__navigation-link"
                    :to="getLinkToProp"
                    :class="{ 'router-link-active': rowActive }"
                    :active-class="routerLinkActiveClass"
                    :exact-active-class="routerLinkExactActiveClass"
                >
                    <mt-icon
                        v-if="displayIcon"
                        :size="iconSize"
                        class="sw-admin-menu__navigation-link-icon"
                        :name="navigationIconName"
                    />

                    <span
                        class="sw-admin-menu__navigation-link-label"
                        :class="collapsibleText ? 'collapsible-text hide-on-collapse' : ''"
                        :title="getEntryLabel"
                    >
                        {{ getEntryLabel }}
                    </span>

                    <slot name="additional-text"></slot>
                </router-link>

                <a
                    v-else-if="entry.link"
                    :href="entry.link"
                    :target="entry.target"
                    :title="$t(entry.label)"
                    class="sw-admin-menu__navigation-link"
                >
                    <mt-icon
                        v-if="displayIcon"
                        :size="iconSize"
                        class="sw-admin-menu__navigation-link-icon"
                        :name="navigationIconName"
                    />

                    <span
                        class="sw-admin-menu__navigation-link-label"
                        :class="collapsibleText ? 'collapsible-text hide-on-collapse' : ''"
                        :title="getEntryLabel"
                    >
                        {{ getEntryLabel }}
                    </span>

                    <slot name="additional-text"></slot>
                </a>

                <span
                    v-else
                    class="sw-admin-menu__navigation-link"
                    :class="{ 'router-link-active': rowActive }"
                >
                    <mt-icon
                        v-if="displayIcon"
                        :size="iconSize"
                        class="sw-admin-menu__navigation-link-icon"
                        :name="navigationIconName"
                    />

                    <span
                        class="sw-admin-menu__navigation-link-label"
                        :class="collapsibleText ? 'collapsible-text hide-on-collapse' : ''"
                        :title="getEntryLabel"
                    >
                        {{ getEntryLabel }}
                    </span>

                    <slot name="additional-text"></slot>
                </span>
            </div>
        </template>
    </mt-tooltip>
</li>
{% endblock %}
