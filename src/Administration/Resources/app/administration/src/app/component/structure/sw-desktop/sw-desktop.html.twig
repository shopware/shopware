{% block sw_desktop %}
<div
    class="sw-desktop"
    :class="desktopClasses"
>
    <div
        v-if="isStaging"
        class="sw-staging-bar"
    >
        {{ $t('global.sw-desktop.stagingBarText') }}
    </div>

    {% block sw_desktop_sidebar %}
    <sw-admin-menu v-if="!noNavigation" />
    {% endblock %}

    {% block sw_desktop_content %}
    <div class="sw-desktop__content">
        {% block sw_desktop_content_view %}
        <sw-error-boundary>
            <router-view />
        </sw-error-boundary>
        {% endblock %}

        <sw-app-shop-id-change-modal
            v-if="shopIdCheck !== null"
            :shop-id-check="shopIdCheck"
            @modal-close="closeModal"
        />
        <sw-app-wrong-app-url-modal v-if="showWrongAppUrlModal" />
        <sw-request-consent-modal />
        {# @deprecated tag:v6.9.0 - Will be removed together with the one-time ui-shell-update-2026 announcement modal #}
        <sw-ui-shell-update-2026-modal />
        <sw-settings-services-grant-permissions-modal />
        <sw-settings-usage-data-consent-modal-data-provider
            v-if="showUsageDataConsentModalDataProvider"
        />

        {# Temporarily disabled: the NPS card is not rendered until the parent integration is implemented.
        {% block sw_desktop_nps_card %}
        <sw-admin-nps-card
            v-if="isNpsCardVisible"
            v-model:visible="isNpsCardVisible"
            @submit="onNpsSubmit"
            @not-now="onNpsNotNow"
            @close="onNpsClose"
        />
        {% endblock %}
        #}
    </div>
    {% endblock %}

    <sw-sidebar-renderer />
</div>
{% endblock %}
