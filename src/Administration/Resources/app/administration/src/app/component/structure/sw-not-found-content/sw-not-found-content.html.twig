{% block sw_not_found_content %}
<div class="sw-not-found-content">
    <mt-empty-state
        centered
        icon="regular-search"
        :headline="$t('sw-not-found.title')"
        :description="$t('sw-not-found.description')"
    >
        <template #button>
            {% block sw_not_found_content_back_button %}
            <mt-button
                class="sw-not-found-content__back-button"
                variant="primary"
                @click="goBack"
            >
                {{ $t('global.default.back') }}
            </mt-button>
            {% endblock %}
        </template>
    </mt-empty-state>
</div>
{% endblock %}
