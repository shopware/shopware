{% block sw_not_found %}
<sw-page
    class="sw-not-found"
    :show-smart-bar="false"
>
    <template #content>
        {% block sw_not_found_page_content %}
        <div class="sw-not-found__content">
            <mt-empty-state
                centered
                icon="regular-search"
                :headline="$t('sw-not-found.title')"
                :description="$t('sw-not-found.description')"
            >
                <template #button>
                    {% block sw_not_found_back_button %}
                    <mt-button
                        class="sw-not-found__back-button"
                        variant="primary"
                        @click="goBack"
                    >
                        {{ $t('global.default.back') }}
                    </mt-button>
                    {% endblock %}
                </template>
            </mt-empty-state>
        </div>
        {% endblock %}
    </template>
</sw-page>
{% endblock %}
