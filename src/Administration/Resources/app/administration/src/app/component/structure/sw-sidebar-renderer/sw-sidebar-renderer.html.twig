<template
    v-for="sidebar in sidebars"
    :key="sidebar.locationId"
>
    <transition name="sw-sidebar-renderer-backdrop">
        <!-- eslint-disable-next-line vuejs-accessibility/no-static-element-interactions, vuejs-accessibility/click-events-have-key-events -->
        <div
            v-if="activeSidebar && activeSidebar.locationId === sidebar.locationId && sidebarDisplayOptions.isOverlayMode && closingSidebar !== sidebar.locationId"
            class="sw-sidebar-renderer-backdrop"
            :class="{ 'is-resizing': sidebarDisplayOptions.isResizing }"
            @click="closeSidebar(sidebar.locationId)"
        ></div>
    </transition>

    <aside
        :ref="(element) => setSidebarElement(sidebar.locationId, element)"
        class="sw-sidebar-renderer"
        tabindex="-1"
        :role="isOverlayModal(sidebar.locationId) ? 'dialog' : null"
        :aria-modal="isOverlayModal(sidebar.locationId) ? 'true' : null"
        :aria-label="isOverlayModal(sidebar.locationId) ? $t(sidebar.title) : null"
        :class="{
            'is-active': activeSidebar && activeSidebar.locationId === sidebar.locationId,
            'is-closing': closingSidebar === sidebar.locationId,
            'is-switched': switchedWhileOpen && activeSidebar && activeSidebar.locationId === sidebar.locationId,
            'is-resizing': sidebarDisplayOptions.isResizing,
            'is-overlay': activeSidebar && sidebarDisplayOptions.isOverlayMode,
        }"
        :style="{
            '--sw-sidebar-width': sidebarDisplayOptions.currentWidth,
            '--sw-sidebar-max-width': sidebarDisplayOptions.availableWidth,
            '--sw-sidebar-panel-width': sidebarDisplayOptions.panelWidth,
            '--sw-sidebar-switch-width': previousSidebarWidth
        }"
    >
        <div
            class="sw-sidebar-renderer__overlay"
            :class="{
                'sw-sidebar-renderer__overlay-resizable': activeSidebar && (activeSidebar.resizable || sidebarDisplayOptions.isOverlayMode),
            }"
        >
            <!-- eslint-disable-next-line vuejs-accessibility/no-static-element-interactions -->
            <div
                v-if="activeSidebar && activeSidebar.resizable"
                class="sw-sidebar-renderer__resize-handle"
                @mousedown="startSidebarResize"
            ></div>
            <header class="sw-sidebar-renderer__header">
                <div class="sw-sidebar-renderer__header-content">
                    <h3 class="sw-sidebar-renderer__title">
                        {{ $t(sidebar.title) }}
                    </h3>
                </div>

                <div class="sw-sidebar-renderer__header-actions">
                    <mt-button
                        v-if="sidebarDisplayOptions.isOverlayMode && sidebarDisplayOptions.isCollapsable"
                        class="sw-sidebar-renderer__button-collapse"
                        :aria-label="$t('sidebar.ariaLabelButtonCollapse')"
                        variant="tertiary"
                        size="default"
                        square
                        @click="collapseSidebar"
                    >
                        <mt-icon
                            name="regular-panel-right"
                            size="16px"
                        />
                    </mt-button>

                    <mt-button
                        class="sw-sidebar-renderer__button-close"
                        :aria-label="$t('sidebar.ariaLabelButtonClose')"
                        variant="tertiary"
                        size="default"
                        square
                        @click="closeSidebar(sidebar.locationId)"
                    >
                        <mt-icon
                            name="solid-times"
                            size="12px"
                        />
                    </mt-button>
                </div>
            </header>

            <section class="sw-sidebar-renderer__content">
                <sw-iframe-renderer
                    :src="sidebar.baseUrl"
                    :location-id="sidebar.locationId"
                    :full-screen="false"
                />
            </section>
        </div>
    </aside>
</template>
