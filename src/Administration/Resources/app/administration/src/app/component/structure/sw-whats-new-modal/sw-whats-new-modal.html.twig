<mt-modal-root
    :is-open="isOpen"
    @change="onModalChange"
>
    <mt-modal
        class="sw-whats-new-modal"
        width="m"
        :title="$t('sw-whats-new-modal.title')"
        inset
    >
        <div class="sw-whats-new-modal__content">
            <div
                class="sw-whats-new-modal__media"
                :class="`sw-whats-new-modal__media--${activePage.id}`"
            >
                <img
                    class="sw-whats-new-modal__media-image sw-whats-new-modal__media-image--light"
                    :src="backgroundSrc"
                    alt=""
                    aria-hidden="true"
                >

                <img
                    class="sw-whats-new-modal__media-image sw-whats-new-modal__media-image--dark"
                    :src="darkBackgroundSrc"
                    alt=""
                    aria-hidden="true"
                >

                <div class="sw-whats-new-modal__glass">
                    <!-- Decorative: rests at an even split until it is dragged -->
                    <!-- eslint-disable-next-line vuejs-accessibility/no-static-element-interactions -->
                    <div
                        ref="compare"
                        class="sw-whats-new-modal__compare"
                        :class="{
                            'sw-whats-new-modal__compare--settled': splitPosition !== null,
                            'sw-whats-new-modal__compare--eased': isSplitEased,
                            'sw-whats-new-modal__compare--pinned': isSplitPinned,
                            'sw-whats-new-modal__compare--dragging': isDragging,
                        }"
                        :style="compareStyle"
                        @pointerdown="onDragStart"
                    >
                        <img
                            class="sw-whats-new-modal__compare-image"
                            :src="beforeSrc"
                            alt=""
                            aria-hidden="true"
                        >

                        <img
                            class="sw-whats-new-modal__compare-image sw-whats-new-modal__compare-image--after sw-whats-new-modal__compare-image--after-light"
                            :src="afterSrc"
                            alt=""
                            aria-hidden="true"
                        >

                        <img
                            class="sw-whats-new-modal__compare-image sw-whats-new-modal__compare-image--after sw-whats-new-modal__compare-image--after-dark"
                            :src="darkAfterSrc"
                            alt=""
                            aria-hidden="true"
                        >

                        {% block sw_whats_new_modal_compare_handle %}
                        <div
                            v-if="!isSplitPinned"
                            class="sw-whats-new-modal__compare-handle"
                            aria-hidden="true"
                        ></div>
                        {% endblock %}
                    </div>
                </div>
            </div>

            <div class="sw-whats-new-modal__text">
                <mt-text
                    as="h3"
                    size="m"
                    weight="semibold"
                    class="sw-whats-new-modal__headline"
                >
                    {{ activePage.headline }}

                    <mt-badge
                        v-if="activePage.badge"
                        variant="attention"
                    >
                        {{ activePage.badge }}
                    </mt-badge>
                </mt-text>

                <mt-text
                    as="p"
                    size="s"
                    color="color-text-secondary-default"
                    class="sw-whats-new-modal__description"
                >
                    {{ $t(activePage.descriptionKey) }}
                </mt-text>

                <template v-if="activePage.hasThemeSelect">
                    <mt-theme-select
                        v-model="userTheme"
                        name="sw-field--whats-new-theme"
                        class="sw-whats-new-modal__theme-select"
                        :label="$t('sw-whats-new-modal.pages.darkMode.themeSelectLabel')"
                    />

                    <mt-text
                        as="p"
                        size="s"
                        color="color-text-tertiary-default"
                        class="sw-whats-new-modal__theme-hint"
                    >
                        <i18n-t keypath="sw-whats-new-modal.pages.darkMode.themeSelectHint">
                            <template #profileSettingsLink>
                                <mt-link
                                    class="sw-whats-new-modal__inline-link"
                                    type="internal"
                                    :to="{ name: 'sw.profile.index.general' }"
                                    @click="onFinish"
                                >
                                    {{ $t('sw-whats-new-modal.pages.darkMode.profileSettingsLink') }}
                                </mt-link>
                            </template>
                        </i18n-t>
                    </mt-text>
                </template>
            </div>
        </div>

        <template #footer>
            <div class="sw-whats-new-modal__footer">
                <div class="sw-whats-new-modal__footer-left">
                    <mt-button
                        v-if="!isFirstPage"
                        variant="secondary"
                        @click="onPreviousPage"
                    >
                        {{ $t('global.default.back') }}
                    </mt-button>
                </div>

                <sw-wizard-dot-navigation
                    :pages="pages"
                    :active-page="currentPage"
                />

                <div class="sw-whats-new-modal__footer-right">
                    <mt-button
                        v-if="!isLastPage"
                        variant="primary"
                        @click="onNextPage"
                    >
                        {{ $t('sw-whats-new-modal.nextButton') }}
                    </mt-button>

                    <mt-button
                        v-else
                        variant="primary"
                        @click="onFinish"
                    >
                        {{ $t('sw-whats-new-modal.finishButton') }}
                    </mt-button>
                </div>
            </div>
        </template>
    </mt-modal>
</mt-modal-root>
