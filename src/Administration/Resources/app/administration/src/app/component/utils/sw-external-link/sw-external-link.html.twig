{% block sw_external_link %}
<mt-external-link
    v-bind="$attrs"
>
    <template
        v-for="(_, name) in getSlots()"
        #[name]="data"
    >
        <slot
            :name="name"
            v-bind="data"
        >
        </slot>
    </template>
    <slot></slot>
</mt-external-link>
{% endblock %}

{% block sw_external_link_deprecated %}
{% endblock %}
