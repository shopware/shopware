{% block sw_shortcut_overview %}
<div class="sw-shortcut-overview">
    {% block sw_shortcut_overview_modal %}
    <sw-modal
        v-if="showShortcutOverviewModal"
        class="sw-shortcut-overview--modal"
        :title="$t('sw-shortcut-overview.modalTitle')"
        variant="full"
        @modal-close="onCloseShortcutOverviewModal"
    >
        {% block sw_shortcut_overview_modal_section_general_shortcuts %}
        <section class="sw-shortcut-overview__section sw-shortcut-overview__section-general-shortcuts">
            <h3>{{ $t('sw-shortcut-overview.sectionGeneralShortcuts') }}</h3>

            <sw-shortcut-overview-item
                v-for="section in sections.generalShortcuts"
                :key="section.id"
                :title="section.title"
                :content="section.content"
                :privilege="section.privilege"
            />
        </section>
        {% endblock %}

        {% block sw_shortcut_overview_modal_section_adding_items %}
        <section class="sw-shortcut-overview__section sw-shortcut-overview__section-adding-items">
            <h3>{{ $t('sw-shortcut-overview.sectionAddingItems') }}</h3>

            <sw-shortcut-overview-item
                v-for="section in sections.addingItems"
                :key="section.id"
                :title="section.title"
                :content="section.content"
                :privilege="section.privilege"
            />
        </section>
        {% endblock %}

        {% block sw_shortcut_overview_modal_section_navigation %}
        <section class="sw-shortcut-overview__section sw-shortcut-overview__section-navigation">
            <h3>{{ $t('sw-shortcut-overview.sectionNavigation') }}</h3>

            <sw-shortcut-overview-item
                v-for="section in sections.navigation"
                :key="section.id"
                :title="section.title"
                :content="section.content"
                :privilege="section.privilege"
            />
        </section>
        {% endblock %}

        {% block sw_shortcut_overview_modal_section_special_shortcuts %}
        {% block sw_shortcut_overview_modal_section_accessibility %}
        <section class="sw-shortcut-overview__section sw-shortcut-overview__section-accessibility">
            <h3>{{ $t('sw-shortcut-overview.sectionAccessibility') }}</h3>

            <sw-shortcut-overview-item
                v-for="section in sections.accessibility"
                :key="section.id"
                :title="section.title"
                :content="section.content"
                :privilege="section.privilege"
            />
        </section>
        {% endblock %}
        {% endblock %}

        {% block sw_shortcut_overview_modal_footer %}
        <template #modal-footer>
            {% block sw_shortcut_overview_modal_footer_disable_shortcuts %}
            <mt-switch
                class="sw-shortcut-overview__disable-shortcuts-toggle"
                :model-value="shortcutsDisabled"
                :label="$t('sw-shortcut-overview.disableShortcuts')"
                @update:model-value="onToggleShortcutsDisabled"
            />
            {% endblock %}

            {% block sw_shortcut_overview_modal_footer_close %}
            <mt-button
                size="small"
                variant="secondary"
                @click="onCloseShortcutOverviewModal"
            >
                {{ $t('global.default.close') }}
            </mt-button>
            {% endblock %}
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
