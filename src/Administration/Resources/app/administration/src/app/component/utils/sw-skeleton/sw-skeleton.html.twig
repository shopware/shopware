{% block sw_skeleton %}
<div
    class="sw-skeleton"
    :class="classList"
>
    <template v-if="variant === 'detail'">
        <mt-skeleton-bar
            class="sw-skeleton-bar"
            style="width: 170px"
        />

        <div class="sw-skeleton__detail-container">
            <mt-skeleton-bar
                class="sw-skeleton-bar"
                style="width: 359px"
            />
            <mt-skeleton-bar
                class="sw-skeleton-bar"
                style="width: 323px"
            />
        </div>

        <mt-skeleton-bar
            class="sw-skeleton-bar"
            style="width: 443px"
        />
        <mt-skeleton-bar
            class="sw-skeleton-bar"
            style="width: 234px"
        />
    </template>

    <template v-if="variant === 'detail-bold'">
        <mt-skeleton-bar
            class="sw-skeleton-bar"
            style="width: 520px"
        />

        <div class="sw-skeleton__detail-container">
            <mt-skeleton-bar
                class="sw-skeleton-bar"
                style="width: 359px"
            />
            <mt-skeleton-bar
                class="sw-skeleton-bar"
                style="width: 323px"
            />
        </div>

        <mt-skeleton-bar
            class="sw-skeleton-bar"
            style="height: 122px"
        />
    </template>

    <template v-if="variant === 'gallery'">
        <mt-skeleton-bar class="sw-skeleton-bar" />
    </template>

    <template v-if="variant === 'media'">
        <mt-skeleton-bar class="sw-skeleton-bar sw-skeleton__media-preview" />
        <mt-skeleton-bar class="sw-skeleton-bar sw-skeleton__media-subtitle" />
    </template>

    <template v-if="['tree-item', 'tree-item-nested'].includes(variant)">
        <mt-skeleton-bar class="sw-skeleton-bar sw-skeleton__tree-item-checkbox" />
        <mt-skeleton-bar class="sw-skeleton-bar sw-skeleton__tree-item-text" />
    </template>

    <template v-if="variant === 'listing'">
        <mt-skeleton-bar class="sw-skeleton-bar" />
    </template>

    <template v-if="variant === 'extension-apps'">
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
    </template>

    <template v-if="variant === 'extension-themes'">
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
        <mt-skeleton-bar class="sw-skeleton-bar" />
    </template>
</div>
{% endblock %}
