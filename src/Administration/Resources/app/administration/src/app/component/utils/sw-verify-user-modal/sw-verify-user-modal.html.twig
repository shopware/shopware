{% block sw_settings_user_detail_content_confirm_password_modal %}
<sw-modal
    :title="title"
    variant="small"
    :is-loading="isLoading"
    @modal-close="onCloseConfirmPasswordModal"
>

    {% block sw_verify_user_modal_sso_text %}
    <p
        v-if="ssoSession"
        class="sw-verify-user-modal__sso-text"
    >
        {{ $t('global.sw-verify-user-modal.textVerifyWithSso') }}
    </p>
    {% endblock %}

    {% block sw_settings_user_detail_content_confirm_password_modal_input__confirm_password %}
    <mt-password-field
        v-if="!ssoSession"
        v-model="confirmPassword"
        class="sw-settings-user-detail__confirm-password"
        name="sw-field--confirm-password"
        :password-toggle-able="true"
        autocomplete="current-password"
        :label="$t('sw-users-permissions.users.user-detail.passwordConfirmation.labelConfirmPassword')"
        :placeholder="$t('sw-users-permissions.users.user-detail.passwordConfirmation.placeholderConfirmPassword')"
        @keypress.enter="onSubmitConfirmPassword"
    />
    {% endblock %}

    {% block sw_settings_user_detail_content_confirm_password_modal_footer %}
    <template #modal-footer>
        {% block sw_settings_user_detail_content_confirm_password_modal_actions_sso %}
        <mt-button
            v-if="ssoLoginUrl"
            class="sw-verify-user-modal__verify-with-sso"
            size="small"
            :variant="ssoSession ? 'primary' : 'secondary'"
            @click="onVerifyWithSso"
        >
            {{ $t('global.sw-verify-user-modal.buttonVerifyWithSso') }}
        </mt-button>
        {% endblock %}

        {% block sw_settings_user_detail_content_confirm_password_modal_actions_cancel %}
        <mt-button
            size="small"
            variant="secondary"
            @click="onCloseConfirmPasswordModal"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_settings_user_detail_content_confirm_password_modal_actions_change %}
        <mt-button
            v-if="!ssoSession"
            variant="primary"
            :disabled="!confirmPassword"
            size="small"
            @click="onSubmitConfirmPassword"
        >
            {{ $t('global.default.confirm') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}
</sw-modal>
{% endblock %}
