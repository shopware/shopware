/**
 * @package admin
 */
import { types } from '../service/util.service';

// eslint-disable-next-line sw-deprecation-rules/private-feature-declarations
export type State = {
    api: {
        [k: string]: ShopwareHttpError | {
            [k: string]: ShopwareHttpError | {
                [k: string]: ShopwareHttpError | {
                    [k: string]: ShopwareHttpError;
                };
            };
        };
    };
    system: Record<string, unknown>;
    field?: string;
}

/**
 * @module core/data/ErrorStore
 */

/**
 * Stores an Error from the api
 */
function addApiError(
    expression: string,
    error: ShopwareHttpError,
    state: State,
    // eslint-disable-next-line @typescript-eslint/unbound-method
    setReactive: ObjectConstructor['defineProperty'] = Object.defineProperty,
) {
    if (typeof setReactive !== 'function') {
        throw new Error('[ErrorStore] createApiError: setReactive is not a function');
    }

    const { store, field } = createPathToError(expression, state.api, setReactive);
    setReactive(store, field, error);
}

/**
 * @private
 */
function createPathToError(
    expression: string,
    state: State['api'],
    setReactive: ObjectConstructor['defineProperty'],
): { store: unknown, field: PropertyKey } {
    const path = expression.split('.');
    const field = path.pop()!;

    const store = path.reduce((currentStore, next) => {
        if (!currentStore.hasOwnProperty(next)) {
            setReactive(currentStore, next, {});
        }
        return currentStore[next];
    }, state);

    return { store, field };
}

/**
 * Removes the error for a given
 */
function removeApiError(
    expression: string,
    state: State,
    deleteReactive: ((target: unknown, propertyName: string) => void) | null = null,
) {
    const path = expression.split('.');
    const field = path.pop()!;

    const store = path.reduce((currentStore, next) => {
        if (currentStore?.[next]) {
            return currentStore[next];
        }

        return null;
    }, state.api);

    if (store === null || store === undefined) {
        return;
    }

    if (typeof deleteReactive === 'function') {
        deleteReactive(store, field);
    } else {
        // @ts-expect-error - Unimportant to type
        delete store.field;
    }

    if (path.length <= 0) {
        return;
    }

    if (types.isEmpty(store)) {
        removeApiError(path.join('.'), state, deleteReactive);
    }
}

/**
 * removes all api errors
 */
function resetApiErrors(state: State) {
    state.api = {};
}

/**
 * stores an system error
 */
function addSystemError(
    error: ShopwareHttpError,
    id: string,
    state: State,
    // eslint-disable-next-line @typescript-eslint/unbound-method
    setReactive: ObjectConstructor['defineProperty'] = Object.defineProperty,
) {
    if (typeof setReactive !== 'function') {
        throw new Error('[ErrorStore] createApiError: setReactive is not a function');
    }

    setReactive(state.system, id, error);
}

/**
 * removes a system error by a given id
 */
function removeSystemError(
    id: string,
    state: State,
    deleteReactive: ((target: $TSFixMe, propertyName: string) => void) | null = null,
) {
    if (typeof deleteReactive === 'function') {
        deleteReactive(state.system, id);
    } else {
        delete state.system[id];
    }
}

// eslint-disable-next-line sw-deprecation-rules/private-feature-declarations
export default {
    addApiError,
    removeApiError,
    resetApiErrors,
    addSystemError,
    removeSystemError,
};
