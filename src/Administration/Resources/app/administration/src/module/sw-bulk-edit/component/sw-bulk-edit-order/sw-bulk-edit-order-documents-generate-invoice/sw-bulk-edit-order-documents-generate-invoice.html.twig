{% block sw_bulk_edit_order_documents_generate_invoice %}
<div class="sw-bulk-edit-order-documents-generate-invoice">
    {% block sw_bulk_edit_order_documents_generate_invoice_file_formats %}
    <mt-select
        v-if="feature.isActive('DOCUMENT_GENERATION_REWORK')"
        v-model="generateData.fileFormats"
        class="sw-bulk-edit-order-documents-generate-invoice__item"
        label-property="label"
        value-property="value"
        :label="$t('sw-bulk-edit.order.documents.generateInvoice.labelFileFormats')"
        :placeholder="$t('sw-bulk-edit.order.documents.generateInvoice.placeholderFileFormats')"
        :options="fileFormatOptions"
        :enable-multi-selection="true"
        required
    />
    {% endblock %}

    {% block sw_bulk_edit_order_documents_generate_invoice_datepicker %}
    <mt-datepicker
        v-model="generateData.documentDate"
        class="sw-bulk-edit-order-documents-generate-invoice__item"
        hide-hint
        :label="$t('sw-bulk-edit.order.documents.generateInvoice.labelDatePicker')"
        :placeholder="$t('sw-datepicker.date.placeholder')"
    />
    {% endblock %}

    {% block sw_bulk_edit_order_documents_generate_invoice_textarea %}
    <mt-textarea
        v-model="generateData.documentComment"
        :label="$t('sw-bulk-edit.order.documents.generateInvoice.labelTextarea')"
    />
    {% endblock %}

    {% block sw_bulk_edit_order_documents_generate_invoice_toggle_skip %}

    <mt-switch
        v-model="generateData.forceDocumentCreation"
        :label="$t('sw-bulk-edit.order.documents.forceDocumentCreation')"
        :help-text="$t('sw-bulk-edit.order.documents.forceDocumentCreationHelpText')"
    />
    {% endblock %}

    {% block sw_bulk_edit_order_documents_generate_invoice_placeholder %}
    {% endblock %}
</div>
{% endblock %}
