{% block sw_bulk_edit_save_modal_error %}
<div class="sw-bulk-edit-save-modal-error">
    {% block sw_bulk_edit_save_modal_error_icon %}
    <sw-label
        class="sw-bulk-edit-save-modal__icon"
        appearance="pill"
        variant="danger"
    >
        <mt-icon
            name="regular-times-hexagon"
            size="30px"
        />
    </sw-label>
    {% endblock %}

    {% block sw_bulk_edit_save_modal_error_content %}
    <p class="sw-bulk-edit-save-modal__help-text">
        {{ $t('sw-bulk-edit.modal.error.description') }}
    </p>

    <template v-if="failedItems.length > 0">
        <p class="sw-bulk-edit-save-modal-error__failed-status-description">
            {{ $t('sw-bulk-edit.modal.error.failedStatusChanges', {
                count: failedItems.length
            }, failedItems.length) }}
        </p>

        <ul class="sw-bulk-edit-save-modal-error__failed-status-list">
            <li
                v-for="(failedItem, index) in failedItems"
                :key="`${failedItem.orderId}-${failedItem.field}-${index}`"
            >
                {{ failedItem.orderNumber }} — {{ failedItem.fieldLabel ?? failedItem.field }}
            </li>
        </ul>
    </template>
    {% endblock %}

</div>
{% endblock %}
