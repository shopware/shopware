{% block sw_category_seo_form %}
<div class="sw-category-seo-form">
    {% block sw_category_seo_form_meta_title %}

    <mt-text-field
        :model-value="category.metaTitle ?? ''"
        :max-length="255"
        :disabled="!acl.can('category.editor')"
        :label="$t('sw-category.base.seo.labelMetaTitle')"
        :help-text="$t('sw-landing-page.base.seo.helpTextMetaTitle')"
        :placeholder="$t('sw-category.base.seo.placeholderMetaTitle')"
        @update:model-value="category.metaTitle = $event"
    >
        {% block sw_category_seo_form_meta_title_hint %}
        <template #hint>
            <span
                class="sw-category-seo-form__recommended-length"
                :class="{ 'is--exceeded': isMetaTitleExceeded }"
            >
                {{ metaTitleHint }}
            </span>
        </template>
        {% endblock %}
    </mt-text-field>
    {% endblock %}

    {% block sw_category_seo_form_meta_description %}
    <mt-textarea
        v-model="category.metaDescription"
        :max-length="255"
        :disabled="!acl.can('category.editor')"
        :label="$t('sw-category.base.seo.labelMetaDescription')"
        :help-text="$t('sw-landing-page.base.seo.helpTextMetaDescription')"
        :placeholder="$t('sw-category.base.seo.placeholderMetaDescription')"
    >
        {% block sw_category_seo_form_meta_description_hint %}
        <template #hint>
            <span
                class="sw-category-seo-form__recommended-length"
                :class="{ 'is--exceeded': isMetaDescriptionExceeded }"
            >
                {{ metaDescriptionHint }}
            </span>
        </template>
        {% endblock %}
    </mt-textarea>
    {% endblock %}

    {% block sw_category_seo_form_keywords %}

    <mt-text-field
        :model-value="category.keywords ?? ''"
        :max-length="255"
        :disabled="!acl.can('category.editor')"
        :label="$t('sw-category.base.seo.labelKeywords')"
        :placeholder="$t('sw-category.base.seo.placeholderKeywords')"
        @update:model-value="category.keywords = $event"
    />
    {% endblock %}
</div>
{% endblock %}
