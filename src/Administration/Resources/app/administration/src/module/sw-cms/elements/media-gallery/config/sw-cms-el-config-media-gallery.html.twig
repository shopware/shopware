{% block sw_cms_element_media_gallery_config %}
<div class="sw-cms-el-config-media-gallery">
    {% block sw_cms_element_media_gallery_config_tabs %}
    <sw-tabs
        position-identifier="sw-cms-element-config-media-gallery"
        class="sw-cms-el-config-media-gallery__tabs"
        default-item="content"
    >
        <template #default="{ active }">
            {% block sw_cms_element_media_gallery_config_tab_content %}
            <sw-tabs-item
                :title="$tc('sw-cms.elements.general.config.tab.content')"
                name="content"
                :active-tab="active"
            >
                {{ $tc('sw-cms.elements.general.config.tab.content') }}
            </sw-tabs-item>
            {% endblock %}

            {% block sw_cms_element_media_gallery_config_tab_settings %}
            <sw-tabs-item
                :title="$tc('sw-cms.elements.general.config.tab.settings')"
                name="settings"
                :active-tab="active"
            >
                {{ $tc('sw-cms.elements.general.config.tab.settings') }}
            </sw-tabs-item>
            {% endblock %}
        </template>

        <template #content="{ active }">
            {% block sw_cms_element_media_gallery_config_content %}
            <sw-container
                v-if="active === 'content'"
                class="sw-cms-el-config-media-gallery__tab-content"
            >
                {% block sw_cms_element_media_gallery_config_media_selection %}
                <sw-cms-inherit-wrapper
                    field="sliderItems"
                    :element="element"
                    :label="$tc('sw-cms.elements.mediaGallery.label')"
                    @inheritance:restore="initGalleryItems"
                >
                    <template #default="{ isInherited }">
                        <sw-cms-mapping-field
                            v-model:config="element.config.sliderItems"
                            entity="product_media"
                            value-types="entity"
                            :disabled="isInherited"
                        >
                            {% block sw_cms_element_media_gallery_config_media_list_selection %}
                            <sw-media-list-selection-v2
                                :entity-media-items="mediaItems"
                                :entity="entity"
                                :upload-tag="uploadTag"
                                :default-folder-name="defaultFolderName"
                                :disabled="isInherited"
                                @upload-finish="onImageUpload"
                                @item-remove="onItemRemove"
                                @open-sidebar="onOpenMediaModal"
                                @item-sort="onItemSort"
                            />
                            {% endblock %}

                            {% block sw_cms_element_media_gallery_config_media_mapping_preview %}
                            <template #preview="{ demoValue }">
                                {% block sw_cms_element_media_gallery_config_media_preview_list %}
                                <div
                                    v-if="demoValue && demoValue.length"
                                    class="sw-cms-el-config-media-gallery__mapping-preview"
                                >
                                    {% block sw_cms_element_media_gallery_config_media_preview_item %}
                                    <div
                                        v-for="demo in demoValue"
                                        :key="demo.id"
                                        class="sw-cms-el-config-media-gallery__preview-image"
                                    >
                                        <img
                                            :src="demo.media.url"
                                            alt=""
                                        >
                                    </div>
                                    {% endblock %}
                                </div>
                                {% endblock %}

                                {% block sw_cms_element_media_gallery_config_media_preview_info %}
                                <mt-banner
                                    v-else
                                    class="sw-cms-el-config-media-gallery__preview-info"
                                    variant="info"
                                >
                                    {{ $tc('sw-cms.detail.label.mappingEmptyPreview') }}
                                </mt-banner>
                                {% endblock %}
                            </template>
                            {% endblock %}
                        </sw-cms-mapping-field>
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}

                {% block sw_cms_element_media_gallery_config_upload_listener %}
                <sw-upload-listener
                    :upload-tag="uploadTag"
                    auto-upload
                    @media-upload-finish="onImageUpload"
                />
                {% endblock %}

                {% block sw_cms_element_media_gallery_config_media_modal %}
                <sw-media-modal-v2
                    v-if="mediaModalIsOpen"
                    variant="full"
                    :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                    :entity-context="cmsPageState.entityName"
                    :initial-folder-id="cmsPageState.defaultMediaFolderId"
                    @media-upload-remove-image="onItemRemove"
                    @media-modal-selection-change="onMediaSelectionChange"
                    @modal-close="onCloseMediaModal"
                />
                {% endblock %}
            </sw-container>
            {% endblock %}

            {% block sw_cms_element_media_gallery_config_settings %}
            <sw-container
                v-if="active === 'settings'"
                class="sw-cms-el-config-media-gallery__tab-settings"
            >
                <div class="sw-cms-el-config-media-gallery__settings-options">

                    {% block sw_cms_element_media_gallery_config_settings_display_mode %}
                    <sw-cms-inherit-wrapper
                        field="displayMode"
                        :element="element"
                        :label="$tc('sw-cms.elements.mediaGallery.config.label.displayMode')"
                    >
                        <template #default="{ isInherited }">
                            <mt-select
                                v-model="element.config.displayMode.value"
                                :options="displayModeOptions"
                                :disabled="isInherited"
                                @update:model-value="emitUpdateEl"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}

                    {% block sw_cms_element_media_gallery_config_settings_max_height %}
                    <sw-cms-inherit-wrapper
                        v-if="isFixedHeight"
                        field="maxHeight"
                        :element="element"
                        :label="$tc('sw-cms.elements.mediaGallery.config.label.maxHeight')"
                    >
                        <template #default="{ isInherited }">
                            <mt-number-field
                                v-model="element.config.maxHeight.value"
                                number-type="int"
                                :min="1"
                                :disabled="isInherited"
                                @update:model-value="emitUpdateEl"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}

                    {% block sw_cms_element_media_gallery_config_settings_thumbnail_position %}
                    <sw-cms-inherit-wrapper
                        field="thumbnailPosition"
                        :element="element"
                        :label="$tc('sw-cms.elements.mediaGallery.config.label.thumbnailPosition')"
                    >
                        <template #default="{ isInherited }">
                            <mt-select
                                v-model="element.config.thumbnailPosition.value"
                                :options="thumbnailPositionOptions"
                                :disabled="isInherited"
                                @update:model-value="emitUpdateEl"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}

                    <div class="sw-cms-el-config-media-gallery__toggles">
                        {% block sw_cms_element_media_gallery_config_settings_toggle_navigation_arrows %}
                        <sw-cms-inherit-wrapper
                            field="showNavigationArrows"
                            :element="element"
                        >
                            <template #default="{ isInherited }">
                                <mt-switch
                                    v-model="element.config.showNavigationArrows.value"
                                    :label="$tc('sw-cms.elements.mediaGallery.config.label.showNavigationArrows')"
                                    :disabled="isInherited"
                                />
                            </template>
                        </sw-cms-inherit-wrapper>
                        {% endblock %}

                        {% block sw_cms_element_media_gallery_config_settings_toggle_show_magnifier %}
                        <sw-cms-inherit-wrapper
                            field="showMagnifier"
                            :element="element"
                        >
                            <template #default="{ isInherited }">
                                <mt-switch
                                    v-model="element.config.showMagnifier.value"
                                    :label="$tc('sw-cms.elements.mediaGallery.config.label.showMagnifier')"
                                    :disabled="isInherited"
                                />
                            </template>
                        </sw-cms-inherit-wrapper>
                        {% endblock %}

                        {% block sw_cms_element_media_gallery_config_settings_toggle_lightbox %}
                        <sw-cms-inherit-wrapper
                            field="showFullScreenGallery"
                            :element="element"
                        >
                            <template #default="{ isInherited }">
                                <mt-switch
                                    v-model="element.config.showFullScreenGallery.value"
                                    :label="$tc('sw-cms.elements.mediaGallery.config.label.showFullScreenGallery')"
                                    :disabled="isInherited"
                                />
                            </template>
                        </sw-cms-inherit-wrapper>
                        {% endblock %}
                    </div>
                </div>
            </sw-container>
            {% endblock %}
        </template>
    </sw-tabs>
    {% endblock %}
</div>
{% endblock %}
