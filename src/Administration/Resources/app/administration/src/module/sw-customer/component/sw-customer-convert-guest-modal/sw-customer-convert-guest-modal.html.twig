{% block sw_customer_guest_convert_customer_modal %}
<sw-modal
    :title="$t('sw-customer.convertGuest.modalTitle')"
    class="sw-customer-guest-convert-customer-modal"
    @modal-close="onCancel"
>
    {% block sw_customer_guest_convert_customer_modal_content %}
    <div class="sw-customer-guest-convert-customer-modal__content">
        {% block sw_customer_guest_convert_customer_modal_option_reset %}
        <div class="sw-customer-guest-convert-customer-modal__option sw-customer-guest-convert-customer-modal__option--reset">
            <p class="sw-customer-guest-convert-customer-modal__title">
                {{ $tc('sw-customer.convertGuest.mail.title') }}
            </p>
            <p class="sw-customer-guest-convert-customer-modal__description">
                {{ $tc('sw-customer.convertGuest.mail.description') }}
            </p>
            <mt-button
                class="sw-customer-guest-convert-customer-modal__action"
                size="default"
                variant="primary"
                @click="sendRecoveryEmail"
            >
                {{ $tc('sw-customer.convertGuest.mail.button') }}
            </mt-button>
        </div>
        {% endblock %}

        {% block sw_customer_guest_convert_customer_modal_option_manual %}
        <div class="sw-customer-guest-convert-customer-modal__option sw-customer-guest-convert-customer-modal__option--manual">
            <p class="sw-customer-guest-convert-customer-modal__title">
                {{ $tc('sw-customer.convertGuest.manual.title') }}
            </p>
            <p class="sw-customer-guest-convert-customer-modal__description">
                {{ $tc('sw-customer.convertGuest.manual.description') }}
            </p>

            <div class="sw-customer-guest-convert-customer-modal__manual-form">
                <form @submit.prevent="convert">
                    <mt-password-field
                        v-model="password"
                        class="sw-customer-guest-convert-customer-modal__input"
                        :label="$t('sw-customer.convertGuest.manual.passwordLabel')"
                        type="password"
                        :error="customerConvertError"
                    />
                    <mt-button
                        class="sw-customer-guest-convert-customer-modal__action"
                        size="default"
                        variant="secondary"
                        type="submit"
                        :disabled="!password"
                    >
                        {{ $tc('sw-customer.convertGuest.manual.button') }}
                    </mt-button>
                </form>
            </div>
        </div>
        {% endblock %}
    </div>
    {% endblock %}
</sw-modal>
{% endblock %}
