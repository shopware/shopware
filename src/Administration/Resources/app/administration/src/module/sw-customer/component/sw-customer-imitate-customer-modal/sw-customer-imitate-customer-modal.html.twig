{% block sw_customer_imitate_customer_modal %}
<mt-modal-root
    is-open
    @change="onModalRootChange"
>
    <mt-modal
        :title="modalTitle"
        :subtitle="modalSubtitle"
    >
        <div class="sw-customer-imitate-customer-modal">
            <mt-loader v-if="isLoading" />

    {% block sw_customer_imitate_customer_modal_alert %}
            <mt-banner
                v-if="!isLoading && hasSalesChannelDomains"
                variant="attention"
            >
                <i18n-t
                    keypath="sw-customer.imitateCustomerModal.modalInfo"
                    tag="p"
                    scope="local"
                >
                    <template #logout>
                        <b>{{ $t('sw-customer.imitateCustomerModal.modalInfoLogout') }}</b>
                    </template>
                </i18n-t>
            </mt-banner>

            <mt-banner
                v-else-if="!isLoading"
                variant="info"
            >
                {{ $t('sw-customer.imitateCustomerModal.modalInfoNoDomains') }}
            </mt-banner>
    {% endblock %}

    {% block sw_customer_imitate_customer_modal_description %}
            <div
                v-if="!isLoading && hasSalesChannelDomains"
                class="imitate-customer-modal-description"
            >
                {{ modalDescription }}
            </div>
    {% endblock %}

    {% block sw_customer_imitate_customer_modal_sales_channel_select %}
            <mt-select
                v-if="!isLoading && hasSalesChannelDomains"
                v-model="selectedSalesChannelId"
                class="imitate-customer-modal-sales-channel-select"
                :options="salesChannelOptions"
                hide-clearable-button
                :label="$t('sw-customer.imitateCustomerModal.labelSalesChannel')"
                :placeholder="$t('sw-customer.imitateCustomerModal.placeholderSalesChannel')"
            />
    {% endblock %}

    {% block sw_customer_imitate_customer_modal_body %}
            <div
                v-if="!isLoading && selectedSalesChannelDomains.length > 0"
                class="imitate-customer-modal-container"
            >
        {% block sw_customer_imitate_customer_modal_domains_headline %}
                <h3 class="imitate-customer-modal-domains-headline">
                    {{ $t('sw-customer.imitateCustomerModal.labelDomains') }}
                </h3>
        {% endblock %}

        {% block sw_customer_imitate_customer_modal_sales_channel_domain_items %}
                <button
                    v-for="salesChannelDomain of selectedSalesChannelDomains"
                    :key="salesChannelDomain.id"
                    type="button"
                    class="imitate-customer-modal-item"
                    @click="onSalesChannelDomainMenuItemClick(salesChannelDomain.salesChannelId, salesChannelDomain.url)"
                >
                    <span class="imitate-customer-modal-item-content">
                        <span class="imitate-customer-modal-item-title">
                            <span class="imitate-customer-modal-item-header">
                                {{ salesChannelDomain.language?.name }}
                            </span>

                            <span class="imitate-customer-modal-item-url">
                                {{ salesChannelDomain.url }}
                            </span>
                        </span>

                        <mt-icon
                            name="regular-external-link-s"
                            size="14px"
                            aria-hidden="true"
                        />
                    </span>
                </button>
        {% endblock %}
            </div>
    {% endblock %}

        </div>

    {% block sw_customer_imitate_customer_modal_footer %}
        <template #footer>
            <div class="sw-customer-imitate-customer-modal__footer">
            {% block sw_customer_imitate_customer_modal_footer_cancel %}
                <mt-modal-close
                    as="mt-button"
                    size="small"
                    variant="secondary"
                >
                    {{ $t('global.default.close') }}
                </mt-modal-close>
            {% endblock %}
            </div>
        </template>
    {% endblock %}
    </mt-modal>
</mt-modal-root>
{% endblock %}
