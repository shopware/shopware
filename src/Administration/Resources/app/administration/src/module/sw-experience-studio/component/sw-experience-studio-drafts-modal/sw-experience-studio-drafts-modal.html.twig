{% block sw_experience_studio_drafts_modal %}
<sw-confirm-modal
    v-if="draftPendingDiscard"
    class="sw-experience-studio-drafts-modal__discard-modal"
    type="discard"
    :title="$t('sw-experience-studio.detail.discardDraftModal.title')"
    :text="$t('sw-experience-studio.draftsModal.discardText')"
    @confirm="onConfirmDiscard"
    @cancel="onCancelDiscard"
    @close="onCancelDiscard"
/>

<sw-modal
    v-else
    class="sw-experience-studio-drafts-modal"
    variant="large"
    :title="title"
    @modal-close="onClose"
>
    {% block sw_experience_studio_drafts_modal_content %}
    <sw-loader v-if="isLoading && drafts.length === 0" />

    <mt-empty-state
        v-else-if="drafts.length === 0"
        class="sw-experience-studio-drafts-modal__empty-state"
        icon="regular-file"
        :headline="$t('sw-experience-studio.draftsModal.emptyStateTitle')"
        :description="$t('sw-experience-studio.draftsModal.emptyStateSubline')"
    />

    <sw-data-grid
        v-else
        class="sw-experience-studio-drafts-modal__grid"
        :data-source="rows"
        :columns="columns"
        :is-loading="isLoading"
        :show-selection="false"
        :show-settings="false"
        :allow-inline-edit="false"
        :allow-column-edit="false"
        plain-appearance
    >
        <template #column-createdAt="{ item }">
            {{ formatDate(item.createdAt) }}
        </template>

        <template #column-updatedAt="{ item }">
            {{ formatDate(item.updatedAt || item.createdAt) }}
        </template>

        <template #column-versionId="{ item }">
            <code class="sw-experience-studio-drafts-modal__version-id">
                {{ shortVersionId(item.versionId) }}
            </code>
        </template>

        <template #actions="{ item }">
            <sw-context-menu-item
                class="sw-experience-studio-drafts-modal__open-action"
                @click="onOpenDraft(item.versionId)"
            >
                {{ $t('global.default.open') }}
            </sw-context-menu-item>

            <sw-context-menu-item
                v-tooltip.bottom="{
                    message: $t('sw-privileges.tooltip.warning'),
                    disabled: allowDiscard,
                    showOnDisabledElements: true,
                    zIndex: 9050,
                }"
                class="sw-experience-studio-drafts-modal__discard-action"
                variant="danger"
                :disabled="!allowDiscard || undefined"
                @click="onDiscardDraft(item.versionId)"
            >
                {{ $t('global.default.discard') }}
            </sw-context-menu-item>
        </template>
    </sw-data-grid>
    {% endblock %}

    {% block sw_experience_studio_drafts_modal_footer %}
    <template #modal-footer>
        <mt-button
            size="small"
            variant="secondary"
            @click="onClose"
        >
            {{ $t('global.default.close') }}
        </mt-button>
    </template>
    {% endblock %}
</sw-modal>
{% endblock %}
