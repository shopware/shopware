{% block sw_experience_studio_element_settings %}
<div class="sw-experience-studio-element-settings">
    <div class="sw-experience-studio-element-settings__content">
        <mt-empty-state
            v-if="!hasSelectedElement"
            icon="regular-sliders-xs"
            :description="$t('sw-experience-studio.detail.elementSettings.emptyState')"
        />

        <mt-empty-state
            v-else-if="isLoadingSettings"
            icon="regular-hourglass"
            :description="$t('sw-experience-studio.detail.elementSettings.loading')"
        />

        <mt-empty-state
            v-else-if="hasTypeLoadError"
            icon="regular-exclamation-triangle"
            :description="$t('sw-experience-studio.detail.elementSettings.typeLoadError')"
        />

        <mt-empty-state
            v-else-if="!hasSelectedElementType"
            icon="regular-puzzle-piece"
            :description="$t('sw-experience-studio.detail.elementSettings.typeMissing')"
        />

        <div
            v-else
            :key="selectedElementId"
            class="sw-experience-studio-element-settings__tabs-area"
        >
            <mt-banner
                v-if="isLoadingMappingCandidates"
                variant="info"
                role="status"
                aria-live="polite"
            >
                {{ $t('sw-experience-studio.detail.elementSettings.mapping.loadingCandidates') }}
            </mt-banner>

            <mt-banner
                v-else-if="hasMappingCandidateLoadError"
                variant="critical"
                role="alert"
            >
                <p>{{ $t('sw-experience-studio.detail.elementSettings.mapping.loadError') }}</p>
                <mt-button
                    size="small"
                    variant="secondary"
                    @click="onRetryMappingCandidates"
                >
                    {{ $t('sw-experience-studio.detail.elementSettings.mapping.retryAction') }}
                </mt-button>
            </mt-banner>

            <mt-tabs
                class="sw-experience-studio-element-settings__tabs"
                position-identifier="sw-experience-studio-element-settings"
                :items="settingsTabItems"
                default-item="element"
                @new-item-active="onSettingsTabChange"
            />

            <div
                v-if="activeSettingsTab === 'element'"
                class="sw-experience-studio-element-settings__tab-panel"
            >
                <mt-empty-state
                    v-if="showElementEmptyState"
                    icon="regular-sliders-horizontal"
                    :description="$t('sw-experience-studio.detail.elementSettings.noEditableProperties')"
                />

                <sw-experience-studio-settings-fields
                    v-else
                    :fields="elementFields"
                    :values="elementPropertyValues"
                    :allow-edit="allowEdit"
                    :selected-element-type="selectedElementType"
                    :mapping-candidates="mappingCandidates"
                    :is-loading-mapping-candidates="isLoadingMappingCandidates"
                    :mapping-candidate-load-error="mappingCandidateLoadError"
                    :mappings="elementMappings"
                    :violations="violations"
                    show-panels
                    @update-field="onUpdateElementField"
                    @update-mapping="onUpdateElementMapping"
                    @retry-mapping-candidates="onRetryMappingCandidates"
                />
            </div>

            <div
                v-else-if="activeSettingsTab === 'layout'"
                class="sw-experience-studio-element-settings__tab-panel"
            >
                <mt-empty-state
                    v-if="hasStyleOptionLoadError"
                    icon="regular-exclamation-triangle"
                    :description="$t('sw-experience-studio.detail.elementSettings.styleLoadError')"
                />

                <mt-empty-state
                    v-else-if="showLayoutEmptyState"
                    icon="regular-sliders-horizontal"
                    :description="$t('sw-experience-studio.detail.elementSettings.noEditableStyleOptions')"
                />

                <sw-experience-studio-settings-fields
                    v-else
                    :fields="layoutFields"
                    :values="elementStyleValues"
                    :allow-edit="allowEdit"
                    @update-field="onUpdateLayoutField"
                />
            </div>
        </div>
    </div>
</div>
{% endblock %}
