{% block sw_experience_studio_element_settings %}
<div class="sw-experience-studio-element-settings">
    <div class="sw-experience-studio-element-settings__header">
        <h3>{{ $t('sw-experience-studio.detail.elementSettings.title') }}</h3>
    </div>

    <div class="sw-experience-studio-element-settings__content">
        <mt-empty-state
            v-if="!hasSelectedElement"
            icon="regular-sliders-xs"
            :description="$t('sw-experience-studio.detail.elementSettings.emptyState')"
        />

        <mt-empty-state
            v-else-if="isLoadingTypes"
            icon="regular-hourglass"
            :description="$t('sw-experience-studio.detail.elementSettings.loading')"
        />

        <mt-empty-state
            v-else-if="hasTypeLoadError"
            icon="regular-exclamation-triangle"
            :description="$t('sw-experience-studio.detail.elementSettings.typeLoadError')"
        />

        <mt-empty-state
            v-else-if="!hasSelectedElementType"
            icon="regular-puzzle-piece"
            :description="$t('sw-experience-studio.detail.elementSettings.typeMissing')"
        />

        <mt-empty-state
            v-else-if="editableProperties.length === 0"
            icon="regular-sliders-horizontal"
            :description="$t('sw-experience-studio.detail.elementSettings.noEditableProperties')"
        />

        <div
            v-else
            class="sw-experience-studio-element-settings__properties"
        >
            <div
                v-for="entry in editableProperties"
                :key="entry.key"
                class="sw-experience-studio-element-settings__property"
            >
                <mt-switch
                    v-if="getControlType(entry.property) === 'switch'"
                    v-bind="getControlProps(entry.property)"
                    :label="entry.property.title"
                    :help-text="entry.property.description"
                    :model-value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:model-value="onUpdateProperty(entry.key, $event)"
                />

                <div
                    v-else-if="getControlType(entry.property) === 'responsive-number'"
                    class="sw-experience-studio-element-settings__responsive-control"
                >
                    <div class="sw-experience-studio-element-settings__responsive-slider">
                        <mt-slider
                            class="sw-experience-studio-element-settings__responsive-slider-input"
                            :label="entry.property.title"
                            :min="getResponsiveLimits(entry.property).min"
                            :max="getResponsiveLimits(entry.property).max"
                            :step="getResponsiveLimits(entry.property).step"
                            :mark-count="0"
                            :disabled="!allowEdit || isResponsiveViewportMode(entry.key) || undefined"
                            :model-value="getResponsiveGlobalValue(entry.key, entry.property)"
                            @update:model-value="onUpdateResponsiveGlobalProperty(entry.key, entry.property, $event)"
                        />
                    </div>

                    <button
                        type="button"
                        class="sw-experience-studio-element-settings__viewport-toggle"
                        :disabled="!allowEdit"
                        @click="onToggleResponsiveViewportMode(entry.key, entry.property)"
                    >
                        Viewport settings
                    </button>

                    <div
                        v-if="isResponsiveViewportMode(entry.key)"
                        class="sw-experience-studio-element-settings__viewport-settings"
                    >
                        <div
                            v-for="viewport in getResponsiveViewports()"
                            :key="viewport"
                            class="sw-experience-studio-element-settings__viewport-row"
                        >
                            <mt-icon
                                :name="getViewportIcon(viewport)"
                                size="16px"
                                class="sw-experience-studio-element-settings__viewport-icon"
                            />
                            <span class="sw-experience-studio-element-settings__viewport-label">{{ viewport.toUpperCase() }}</span>
                            <mt-slider
                                class="sw-experience-studio-element-settings__responsive-slider-input"
                                label=""
                                :min="getResponsiveLimits(entry.property).min"
                                :max="getResponsiveLimits(entry.property).max"
                                :step="getResponsiveLimits(entry.property).step"
                                :mark-count="0"
                                :disabled="!allowEdit || undefined"
                                :model-value="getResponsiveViewportValue(entry.key, viewport, entry.property)"
                                @update:model-value="onUpdateResponsiveViewportProperty(entry.key, entry.property, viewport, $event)"
                            />
                        </div>
                    </div>
                </div>

                <mt-number-field
                    v-else-if="getControlType(entry.property) === 'number'"
                    v-bind="getControlProps(entry.property)"
                    :label="entry.property.title"
                    :help-text="entry.property.description"
                    :model-value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:model-value="onUpdateProperty(entry.key, $event)"
                />

                <mt-select
                    v-else-if="getControlType(entry.property) === 'select'"
                    v-bind="getControlProps(entry.property)"
                    :label="entry.property.title"
                    :help-text="entry.property.description"
                    :model-value="getPropertyValue(entry.key, entry.property)"
                    :options="getSelectOptions(entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:model-value="onUpdateProperty(entry.key, $event)"
                />

                <div
                    v-else-if="getControlType(entry.property) === 'radio-panel'"
                    class="sw-experience-studio-element-settings__radio-panel-group"
                >
                    <div class="sw-experience-studio-element-settings__radio-panel-headline">
                        {{ entry.property.title }}
                    </div>
                    <div
                        v-if="entry.property.description"
                        class="sw-experience-studio-element-settings__radio-panel-description"
                    >
                        {{ entry.property.description }}
                    </div>

                    <sw-button-group class="sw-experience-studio-element-settings__radio-panel-options">
                        <mt-button
                            v-for="option in getRadioPanelOptions(entry.property)"
                            :key="option.value"
                            square
                            size="small"
                            class="sw-experience-studio-element-settings__radio-panel-option"
                            :variant="String(getPropertyValue(entry.key, entry.property) ?? '') === option.value ? 'primary' : 'secondary'"
                            :disabled="!allowEdit || option.disabled || undefined"
                            :aria-label="option.label"
                            :title="option.label"
                            @click="onUpdateRadioPanelProperty(entry.key, option.value)"
                        >
                            <mt-icon
                                :name="option.icon || 'regular-square'"
                                size="16px"
                            />
                        </mt-button>
                    </sw-button-group>
                </div>

                <sw-entity-single-select
                    v-else-if="getControlType(entry.property) === 'entity' && getEntityName(entry.property)"
                    v-bind="getControlProps(entry.property)"
                    :entity="getEntityName(entry.property)"
                    :label="entry.property.title"
                    :help-text="entry.property.description"
                    :value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:value="onUpdateProperty(entry.key, $event)"
                />

                <sw-media-field
                    v-else-if="getControlType(entry.property) === 'media'"
                    v-bind="getControlProps(entry.property)"
                    :label="entry.property.title"
                    :value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:value="onUpdateProperty(entry.key, $event)"
                />

                <mt-text-editor
                    v-else-if="getControlType(entry.property) === 'richtext'"
                    v-bind="getControlProps(entry.property)"
                    :model-value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:model-value="onUpdateProperty(entry.key, $event)"
                />

                <mt-text-field
                    v-else
                    v-bind="getControlProps(entry.property)"
                    :label="entry.property.title"
                    :help-text="entry.property.description"
                    :model-value="getPropertyValue(entry.key, entry.property)"
                    :disabled="!allowEdit || undefined"
                    @update:model-value="onUpdateProperty(entry.key, $event)"
                />
            </div>
        </div>
    </div>
</div>
{% endblock %}
