<div class="sw-experience-studio-grid-editor">
    <div
        class="sw-experience-studio-grid-editor__breakpoint-heading"
    >
        <h3>{{ $t('sw-experience-studio.gridEditor.breakpoints') }}</h3>
        <mt-link
            v-if="breakpoint !== 'xs'"
            as="button"
            class="sw-experience-studio-grid-editor__inheritance"
            :disabled="!allowEdit || (inherited && breakpointInvalid(breakpoint))"
            :title="$t(inherited ? 'sw-experience-studio.gridEditor.breakInheritance' : 'sw-experience-studio.gridEditor.restoreInheritance')"
            @click="inherited ? breakInheritance() : showRestoreModal = true"
        >
            <mt-icon
                :name="inherited ? 'regular-link-horizontal' : 'regular-link-horizontal-slash'"
                size="16px"
                decorative
            />
            {{ $t(inherited ? 'sw-experience-studio.gridEditor.inherited' : 'sw-experience-studio.gridEditor.own') }}
        </mt-link>
    </div>
    <sw-button-group
        class="sw-experience-studio-grid-editor__breakpoints"
        role="group"
        :aria-label="$t('sw-experience-studio.gridEditor.breakpoints')"
    >
        <mt-button
            v-for="tab in tabs"
            :key="tab.name"
            size="small"
            :aria-pressed="breakpoint === tab.name"
            :variant="breakpoint === tab.name ? 'primary' : 'secondary'"
            @click="setBreakpoint(tab.name)"
        >
            {{ tab.label }}
            <span
                v-if="tab.name !== 'xs' && patterns[tab.name]"
                class="sw-experience-studio-grid-editor__breakpoint-indicator"
                aria-hidden="true"
            ></span>
        </mt-button>
    </sw-button-group>
    <p>
        {{ $t('sw-experience-studio.gridEditor.breakpointInheritanceDescription') }}
    </p>
    <mt-collapsible
        v-model:open="columnsOpen"
        :keep-mounted="false"
    >
        <h3>
            <mt-collapsible-trigger
                class="sw-experience-studio-grid-editor__section-toggle"
            >
                <mt-icon
                    name="regular-chevron-right-xs"
                    size="12px"
                    :class="{ 'is--expanded': columnsOpen }"
                    decorative
                />
                {{ $t('sw-experience-studio.gridEditor.columns') }}
            </mt-collapsible-trigger>
        </h3>
        <mt-collapsible-content class="sw-experience-studio-grid-editor__column-list">
            <transition-group
                name="sw-experience-studio-grid-editor__column"
                tag="div"
            >
                <div
                    v-for="(column, index) in pattern.columns"
                    :key="column.id"
                    v-draggable="{ disabled: !canMove, dragGroup: 'grid-columns', data: column.id, onDragStart: onColumnDragStart, cancelOnUnmount: true }"
                    class="sw-experience-studio-grid-editor__column-entry"
                    :data-column-id="column.id"
                >
                    <div class="sw-experience-studio-grid-editor__column">
                        <button
                            type="button"
                            class="sw-experience-studio-grid-editor__handle"
                            :disabled="!canMove"
                            :title="$t('sw-experience-studio.gridEditor.move')"
                        >
                            <mt-icon
                                name="regular-grip-vertical"
                                size="16px"
                                decorative
                            />
                        </button>
                        <div
                            class="sw-experience-studio-grid-editor__column-fields"
                            :class="{ 'has-value': column.type !== 'auto' }"
                            @mousedown.stop
                            @touchstart.stop
                        >
                            <mt-text-field
                                v-if="column.type === 'px' || column.type === 'percent'"
                                v-numeric-input
                                size="small"
                                :class="{ 'has--error': focusedColumnId !== column.id && invalidColumn(column) }"
                                :model-value="column.value"
                                :disabled="!editable"
                                :label="`${$t('sw-experience-studio.gridEditor.width')} ${index + 1}`"
                                @focus="focusedColumnId = column.id"
                                @blur="focusedColumnId = null"
                                @update:model-value="setColumnValue(index, $event)"
                            />
                            <mt-select
                                v-if="column.type === 'fraction'"
                                small
                                :enable-search="false"
                                hide-clearable-button
                                :model-value="column.value === null ? null : Number(column.value)"
                                :options="fractionOptions"
                                :disabled="!editable"
                                :aria-label="$t('sw-experience-studio.gridEditor.width')"
                                @update:model-value="setColumnValue(index, $event)"
                            />
                            <mt-select
                                class="sw-experience-studio-grid-editor__column-type"
                                small
                                :enable-search="false"
                                hide-clearable-button
                                :model-value="column.type"
                                :options="typeOptions(index)"
                                :disabled="!editable"
                                :aria-label="$t('sw-experience-studio.gridEditor.type')"
                                @update:model-value="setColumnType(index, $event)"
                            >
                                <template #result-label-property="{ item }">
                                    <span class="sw-experience-studio-grid-editor__unit-option">{{ item.label }}</span>
                                </template>
                            </mt-select>
                        </div>
                        <mt-dropdown-menu-root :modal="false">
                            <mt-dropdown-menu-trigger as-child>
                                <mt-button
                                    variant="tertiary"
                                    size="small"
                                    square
                                    :aria-label="$t('sw-experience-studio.gridEditor.columnActions')"
                                    @mousedown.stop
                                    @touchstart.stop
                                >
                                    <mt-icon
                                        name="solid-ellipsis-h-s"
                                        decorative
                                    />
                                </mt-button>
                            </mt-dropdown-menu-trigger>
                            <mt-dropdown-menu-portal>
                                <mt-action-menu align="end">
                                    <mt-action-menu-item
                                        icon="regular-long-arrow-up"
                                        :disabled="!canMove || index === 0"
                                        @select="moveColumn(index, index - 1)"
                                    >
                                        {{ $t('sw-experience-studio.gridEditor.moveUp') }}
                                    </mt-action-menu-item>
                                    <mt-action-menu-item
                                        icon="regular-long-arrow-down"
                                        :disabled="!canMove || index === pattern.columns.length - 1"
                                        @select="moveColumn(index, index + 1)"
                                    >
                                        {{ $t('sw-experience-studio.gridEditor.moveDown') }}
                                    </mt-action-menu-item>
                                    <mt-action-menu-item
                                        variant="critical"
                                        icon="regular-trash"
                                        :disabled="!canRemoveColumn(index)"
                                        @select="removeColumn(index)"
                                    >
                                        {{ $t('global.default.remove') }}
                                    </mt-action-menu-item>
                                </mt-action-menu>
                            </mt-dropdown-menu-portal>
                        </mt-dropdown-menu-root>
                    </div>
                    <mt-text
                        v-if="(column.type === 'px' || column.type === 'percent') && focusedColumnId !== column.id && invalidColumn(column)"
                        class="sw-experience-studio-grid-editor__column-error"
                        size="xs"
                        color="color-text-critical-default"
                        as="div"
                        role="alert"
                    >
                        {{ $t(column.type === 'percent' ? 'sw-experience-studio.gridEditor.invalidPercentWidth' : 'sw-experience-studio.gridEditor.invalidPixelWidth') }}
                    </mt-text>
                </div>
            </transition-group>
            <div class="sw-experience-studio-grid-editor__add">
                <mt-button
                    size="small"
                    variant="tertiary"
                    :disabled="!editable || pattern.columns.length >= 12"
                    @click="addColumn"
                >
                    <mt-icon
                        name="regular-plus-s"
                        size="12px"
                        decorative
                    />
                    {{ $t('sw-experience-studio.gridEditor.addColumn') }}
                </mt-button>
            </div>
            <p
                v-if="relativeUnits > 300"
                class="sw-experience-studio-grid-editor__warning"
            >
                {{ $t('sw-experience-studio.gridEditor.tooMuch') }}
            </p>
            <p
                v-else-if="relativeUnits === 300 && hasAuto"
                class="sw-experience-studio-grid-editor__warning"
            >
                {{ $t('sw-experience-studio.gridEditor.noAutoSpace') }}
            </p>
        </mt-collapsible-content>
    </mt-collapsible>
    <mt-collapsible
        v-model:open="patternOpen"
        :keep-mounted="false"
    >
        <h3>
            <mt-collapsible-trigger
                class="sw-experience-studio-grid-editor__section-toggle"
            >
                <mt-icon
                    name="regular-chevron-right-xs"
                    size="12px"
                    :class="{ 'is--expanded': patternOpen }"
                    decorative
                />
                {{ $t('sw-experience-studio.gridEditor.pattern') }}
            </mt-collapsible-trigger>
        </h3>
        <mt-collapsible-content>
            <p>{{ $t('sw-experience-studio.gridEditor.patternHelp') }}</p>
            <div class="sw-experience-studio-grid-editor__pattern-wrap">
                <div
                    class="sw-experience-studio-grid-editor__grid"
                    :style="{ gridTemplateColumns: `repeat(${pattern.columns.length}, minmax(0, 1fr))`, gridTemplateRows: `repeat(${pattern.cells.length}, 56px)` }"
                >
                    <button
                        v-for="area in areas"
                        :key="area.id"
                        type="button"
                        :data-area-id="area.id"
                        class="sw-experience-studio-grid-editor__area"
                        :class="{ 'is-selected': selected.includes(area.id) }"
                        :style="{ gridColumn: `${area.column + 1} / span ${area.columnSpan}`, gridRow: `${area.row + 1} / span ${area.rowSpan}` }"
                        :aria-pressed="selected.includes(area.id)"
                        :aria-label="$t('sw-experience-studio.gridEditor.areaLabel', { number: area.number, row: area.row + 1, column: area.column + 1, rows: area.rowSpan, columns: area.columnSpan })"
                        :disabled="!editable"
                        @click="toggleArea(area.id)"
                    >
                        {{ area.number }}
                    </button>
                </div>
                <div class="sw-experience-studio-grid-editor__rows">
                    <mt-link
                        v-for="(row, index) in pattern.cells"
                        :key="index"
                        as="button"
                        variant="critical"
                        :disabled="!editable || pattern.cells.length <= 1"
                        :aria-label="$t('sw-experience-studio.gridEditor.removeRow', { number: index + 1 })"
                        @click="removeRow(index)"
                    >
                        <mt-icon
                            name="regular-trash"
                            size="12px"
                            decorative
                        />
                    </mt-link>
                </div>
            </div>
            <div class="sw-experience-studio-grid-editor__add">
                <mt-button
                    size="small"
                    variant="tertiary"
                    :disabled="!editable || pattern.cells.length >= 12"
                    @click="addRow"
                >
                    <mt-icon
                        name="regular-plus-s"
                        size="12px"
                        decorative
                    />
                    {{ $t('sw-experience-studio.gridEditor.addRow') }}
                </mt-button>
            </div>
            <div class="sw-experience-studio-grid-editor__actions">
                <mt-button
                    v-if="!selectedArea || selectedArea.columnSpan === 1 || selectedArea.rowSpan === 1"
                    size="small"
                    variant="secondary"
                    :disabled="!editable || !selectedArea || (selectedArea.columnSpan === 1 && selectedArea.rowSpan === 1)"
                    @click="split(selectedArea && selectedArea.columnSpan > 1 ? 'columns' : 'rows')"
                >
                    {{ $t('sw-experience-studio.gridEditor.split') }}
                </mt-button>
                <mt-dropdown-menu-root
                    v-else
                    :modal="false"
                >
                    <mt-dropdown-menu-trigger as-child>
                        <mt-button
                            size="small"
                            variant="secondary"
                            :disabled="!editable"
                        >
                            {{ $t('sw-experience-studio.gridEditor.split') }}
                        </mt-button>
                    </mt-dropdown-menu-trigger>
                    <mt-dropdown-menu-portal><mt-action-menu align="end">
                        <mt-action-menu-item
                            @select="split('all')"
                        >
                            {{ $t('sw-experience-studio.gridEditor.split') }}
                        </mt-action-menu-item>
                        <mt-action-menu-item
                            v-if="selectedArea && selectedArea.rowSpan > 1"
                            @select="split('rows')"
                        >
                            {{ $t('sw-experience-studio.gridEditor.splitRows') }}
                        </mt-action-menu-item>
                        <mt-action-menu-item
                            v-if="selectedArea && selectedArea.columnSpan > 1"
                            @select="split('columns')"
                        >
                            {{ $t('sw-experience-studio.gridEditor.splitColumns') }}
                        </mt-action-menu-item>
                    </mt-action-menu></mt-dropdown-menu-portal>
                </mt-dropdown-menu-root>
                <mt-button
                    size="small"
                    variant="secondary"
                    :disabled="!editable || !canMerge"
                    @click="merge"
                >
                    {{ $t('sw-experience-studio.gridEditor.merge') }}
                </mt-button>
            </div>
        </mt-collapsible-content>
    </mt-collapsible>
    <mt-modal-root
        :is-open="showRestoreModal"
        @change="showRestoreModal = $event"
    >
        <mt-modal :title="$t('sw-experience-studio.gridEditor.restoreInheritance')" width="s">
            <p>{{ $t('sw-experience-studio.gridEditor.restoreConfirmation') }}</p>
            <template #footer>
                <div class="sw-experience-studio-grid-editor__modal-footer">
                    <mt-button
                        variant="secondary"
                        @click="showRestoreModal = false"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>
                    <mt-button
                        variant="primary"
                        @click="restoreInheritance"
                    >
                        {{ $t('sw-experience-studio.gridEditor.restoreInheritance') }}
                    </mt-button>
                </div>
            </template>
        </mt-modal>
    </mt-modal-root>
</div>
