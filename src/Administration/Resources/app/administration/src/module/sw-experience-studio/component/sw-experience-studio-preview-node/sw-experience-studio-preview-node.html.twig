{% block sw_experience_studio_preview_node %}
<article class="sw-experience-studio-preview-node">
    <header class="sw-experience-studio-preview-node__header">
        <h4 class="sw-experience-studio-preview-node__title">
            {{ element.component }}
        </h4>
    </header>

    <dl
        v-if="primitiveProperties.length > 0"
        class="sw-experience-studio-preview-node__properties"
    >
        <template
            v-for="property in primitiveProperties"
            :key="`${element.id}-${property.key}`"
        >
            <dt class="sw-experience-studio-preview-node__property-key">{{ property.key }}</dt>
            <dd class="sw-experience-studio-preview-node__property-value">{{ property.value }}</dd>
        </template>
    </dl>

    <div
        v-for="slot in slotEntries"
        :key="`${element.id}-${slot.name}`"
        class="sw-experience-studio-preview-node__slot"
    >
        <div class="sw-experience-studio-preview-node__slot-name">{{ slot.name }}</div>

        <div
            v-if="slot.elements.length > 0"
            class="sw-experience-studio-preview-node__slot-elements"
        >
            <sw-experience-studio-preview-node
                v-for="slotElement in slot.elements"
                :key="slotElement.id"
                :element="slotElement"
            />
        </div>

        <p
            v-else
            class="sw-experience-studio-preview-node__slot-empty"
        >
            {{ $t('sw-experience-studio.detail.preview.emptySlot') }}
        </p>
    </div>
</article>
{% endblock %}
