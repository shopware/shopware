{% block sw_experience_studio_settings_fields %}
<div class="sw-experience-studio-settings-fields">
    <sw-collapse
        v-for="panel in fieldPanels"
        :key="panel.key"
        class="sw-experience-studio-settings-fields__panel"
        :class="{ 'is--plain': !showPanels }"
        :expand-on-loading="isPanelExpandedByDefault(panel)"
    >
        <template
            v-if="showPanels"
            #header="{ expanded }"
        >
            <div class="sw-experience-studio-settings-fields__panel-header">
                <span class="sw-experience-studio-settings-fields__panel-title">
                    {{ getPanelTitle(panel) }}
                </span>
                <mt-icon
                    name="regular-chevron-right-xs"
                    size="12px"
                    class="sw-experience-studio-settings-fields__panel-indicator"
                    :class="{ 'is--expanded': expanded }"
                />
            </div>
        </template>

        <template #content>
            <div class="sw-experience-studio-settings-fields__panel-content">
                <div
                    v-for="field in panel.fields"
                    :key="field.key"
                    class="sw-experience-studio-settings-fields__field"
                    :class="{
                        'is--error': getFieldViolation(field)?.severity === 'error',
                        'has--language-label': field.property.translatable && languageName,
                    }"
                >
                    <div
                        v-if="field.property.translatable && languageName"
                        class="sw-experience-studio-settings-fields__language-label"
                    >
                        <span aria-hidden="true">{{ getPropertyTitle(field.property) }}</span>
                        <mt-badge
                            class="sw-experience-studio-settings-fields__language-badge"
                            variant="neutral"
                            size="s"
                            icon="regular-globe"
                            role="img"
                            :aria-label="$t('sw-experience-studio.detail.elementSettings.editingLanguage', { language: languageName })"
                            :title="$t('sw-experience-studio.detail.elementSettings.editingLanguage', { language: languageName })"
                        >
                            {{ languageName }}
                        </mt-badge>
                        <mt-help-text
                            v-if="getPropertyHelpText(field.property)"
                            :text="getPropertyHelpText(field.property)"
                        />
                    </div>

                    <div
                        v-if="isFieldMapped(field)"
                        class="sw-experience-studio-settings-fields__mapping mt-field"
                    >
                        <span class="sw-experience-studio-settings-fields__mapping-label mt-field__label label">
                            {{ getPropertyTitle(field.property) }}
                        </span>

                        <div class="sw-experience-studio-settings-fields__mapping-chip">
                            <button
                                type="button"
                                class="sw-experience-studio-settings-fields__mapping-value"
                                :disabled="!allowEdit || !allowMapping"
                                :title="getFieldMappingPath(field)"
                                @click="onOpenMappingModal(field)"
                            >
                                <mt-icon
                                    name="regular-variables-xs"
                                    size="12px"
                                />
                                <span class="sw-experience-studio-settings-fields__mapping-name">
                                    {{ getFieldMappingLabel(field) }}
                                </span>
                            </button>

                            <button
                                v-if="allowMapping"
                                type="button"
                                class="sw-experience-studio-settings-fields__mapping-remove"
                                :disabled="!allowEdit"
                                :title="$t('sw-experience-studio.detail.elementSettings.mapping.unmapAction')"
                                :aria-label="$t('sw-experience-studio.detail.elementSettings.mapping.unmapAction')"
                                @click="onUnmapField(field)"
                            >
                                <mt-icon
                                    name="regular-times-xs"
                                    size="10px"
                                />
                            </button>
                        </div>
                    </div>

                    <div
                        v-else-if="isBreakpointAwareField(field)"
                        class="sw-experience-studio-settings-fields__responsive-control"
                    >
                        <div class="sw-experience-studio-settings-fields__viewport-heading">
                            <span class="mt-field__label label">{{ getPropertyTitle(field.property) }}</span>
                            <breakpoint-select
                                :model-value="getSelectedBreakpoint(field.key)"
                                :overrides="getResponsiveOverrides(field.key)"
                                :can-reset="allowEdit"
                                @update:model-value="selectedBreakpoints[field.key] = $event"
                                @reset="onUpdateResponsiveProperty(field, null)"
                            />
                        </div>
                        <div
                            v-if="getControlType(field.property) === 'responsive-number'"
                            class="sw-experience-studio-settings-fields__responsive-slider"
                        >
                            <mt-slider
                                class="sw-experience-studio-settings-fields__responsive-slider-input sw-experience-studio-settings-fields__responsive-input"
                                :label="getPropertyTitle(field.property)"
                                :min="getResponsiveLimits(field.property).min"
                                :max="getResponsiveLimits(field.property).max"
                                :step="getResponsiveLimits(field.property).step"
                                :mark-count="0"
                                :disabled="!allowEdit || undefined"
                                :model-value="getResponsiveValue(field)"
                                @update:model-value="onUpdateResponsiveProperty(field, $event)"
                            />
                        </div>

                        <mt-switch
                            v-else-if="getControlType(field.property) === 'switch'"
                            v-bind="getControlProps(field.property)"
                            label=""
                            :aria-label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getResponsiveValue(field)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateResponsiveProperty(field, $event)"
                        />

                        <mt-select
                            v-else-if="getControlType(field.property) === 'select'"
                            v-bind="getControlProps(field.property)"
                            class="sw-experience-studio-settings-fields__responsive-input"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getResponsiveValue(field)"
                            :options="getSelectOptions(field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateResponsiveProperty(field, $event)"
                        />

                        <div
                            v-else-if="getControlType(field.property) === 'radio-panel'"
                            class="sw-experience-studio-settings-fields__radio-panel-group mt-field"
                        >
                            <sw-button-group
                                class="sw-experience-studio-settings-fields__radio-panel-options"
                                role="group"
                                :aria-label="getPropertyTitle(field.property)"
                            >
                                <mt-button
                                    v-for="option in getRadioPanelOptions(field.property)"
                                    :id="getRadioPanelOptionId(field.key, option.value)"
                                    :key="option.value"
                                    square
                                    size="small"
                                    class="sw-experience-studio-settings-fields__radio-panel-option"
                                    :variant="String(getResponsiveValue(field) ?? '') === option.value ? 'primary' : 'secondary'"
                                    :disabled="!allowEdit || option.disabled || undefined"
                                    :aria-label="option.label"
                                    :title="option.label"
                                    @click="onUpdateResponsiveProperty(field, getRadioPanelEmitValue(field.key, field.property, option.value))"
                                >
                                    <span
                                        v-if="option.cornerRadius"
                                        class="sw-experience-studio-settings-fields__corner-radius-preview"
                                        :style="{ borderRadius: option.cornerRadius }"
                                    ></span>
                                    <mt-icon
                                        v-else
                                        :name="option.icon || 'regular-square'"
                                        size="16px"
                                    />
                                </mt-button>
                            </sw-button-group>
                        </div>

                        <sw-experience-studio-box-spacing-field
                            v-else-if="getControlType(field.property) === 'box-spacing'"
                            :field-key="getFieldControlKey(field.key)"
                            class="sw-experience-studio-settings-fields__responsive-input"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="String(getResponsiveValue(field) ?? '')"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateResponsiveProperty(field, $event)"
                        />

                        <mt-text-field
                            v-else
                            v-bind="getControlProps(field.property)"
                            class="sw-experience-studio-settings-fields__responsive-input"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getResponsiveValue(field)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateResponsiveProperty(field, $event)"
                        />
                    </div>

                    <template v-else>
                        <sw-experience-studio-inline-text-field
                            v-if="isInlineMappableField(field)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :value="String(getPropertyValue(field.key, field.property) ?? '')"
                            :candidates="inlineMappingCandidates"
                            :disabled="!allowEdit"
                            @update:value="onUpdateField(field.key, $event)"
                        />

                        <mt-switch
                            v-else-if="getControlType(field.property) === 'switch'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :mark-count="0"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <mt-number-field
                            v-else-if="getControlType(field.property) === 'number'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <mt-slider
                            v-else-if="getControlType(field.property) === 'slider'"
                            v-bind="getControlProps(field.property)"
                            class="sw-experience-studio-settings-fields__responsive-slider-input"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <mt-colorpicker
                            v-else-if="getControlType(field.property) === 'color'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <mt-select
                            v-else-if="getControlType(field.property) === 'select'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :options="getSelectOptions(field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <sw-experience-studio-grid-editor
                            v-else-if="getControlType(field.property) === 'grid-editor'"
                            :breakpoint-fallbacks="breakpointFallbacks"
                            :label="getPropertyTitle(field.property)"
                            :grid-layout="getRawPropertyValue(field.key)"
                            :allow-edit="allowEdit"
                            @update:grid-layout="onUpdateField(field.key, $event)"
                        />

                        <div
                            v-else-if="getControlType(field.property) === 'radio-panel'"
                            class="sw-experience-studio-settings-fields__radio-panel-group mt-field"
                        >
                            <label
                                class="sw-experience-studio-settings-fields__radio-panel-label mt-field__label label"
                                :for="getRadioPanelLabelTargetId(field.key, field.property)"
                            >{{ getPropertyTitle(field.property) }}</label>

                            <sw-button-group class="sw-experience-studio-settings-fields__radio-panel-options">
                                <mt-button
                                    v-for="option in getRadioPanelOptions(field.property)"
                                    :id="getRadioPanelOptionId(field.key, option.value)"
                                    :key="option.value"
                                    square
                                    size="small"
                                    class="sw-experience-studio-settings-fields__radio-panel-option"
                                    :variant="String(getPropertyValue(field.key, field.property) ?? '') === option.value ? 'primary' : 'secondary'"
                                    :disabled="!allowEdit || option.disabled || undefined"
                                    :aria-label="option.label"
                                    :aria-describedby="String(getPropertyValue(field.key, field.property) ?? '') === option.value && getRadioPanelDescription(field.property, getPropertyValue(field.key, field.property)) ? getRadioPanelDescriptionId(field.key) : undefined"
                                    :title="option.label"
                                    @click="onUpdateRadioPanelProperty(field.key, field.property, option.value)"
                                >
                                    <span
                                        v-if="option.cornerRadius"
                                        class="sw-experience-studio-settings-fields__corner-radius-preview"
                                        :style="{ borderRadius: option.cornerRadius }"
                                    ></span>
                                    <mt-icon
                                        v-else
                                        :name="option.icon || 'regular-square'"
                                        size="16px"
                                    />
                                </mt-button>
                            </sw-button-group>

                            <p
                                v-show="getRadioPanelDescription(field.property, getPropertyValue(field.key, field.property))"
                                :id="getRadioPanelDescriptionId(field.key)"
                                aria-live="polite"
                            >
                                {{ getRadioPanelDescription(field.property, getPropertyValue(field.key, field.property)) }}
                            </p>
                        </div>

                        <sw-entity-single-select
                            v-else-if="getControlType(field.property) === 'entity' && getEntityName(field.property)"
                            v-bind="getControlProps(field.property)"
                            :entity="getEntityName(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:value="onUpdateField(field.key, $event)"
                        />

                        <sw-entity-multi-id-select
                            v-else-if="getControlType(field.property) === 'entity-multi' && getEntityName(field.property) && getEntityMultiCodec(field)"
                            v-bind="getControlProps(field.property)"
                            :repository="getEntityRepository(getEntityName(field.property))"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :value="getEntityMultiValue(field.key)"
                            :disabled="!allowEdit || undefined"
                            @update:value="onUpdateEntityMultiField(field, $event)"
                        />

                        <sw-media-field
                            v-else-if="getControlType(field.property) === 'media'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:value="onUpdateField(field.key, $event)"
                        />

                        <sw-experience-studio-media-collection-field
                            v-else-if="getControlType(field.property) === 'media-collection'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :value="getRawPropertyValue(field.key)"
                            :disabled="!allowEdit || undefined"
                            @update:value="onUpdateField(field.key, $event)"
                        />

                        <mt-text-editor
                            v-else-if="getControlType(field.property) === 'richtext'"
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <sw-experience-studio-box-spacing-field
                            v-else-if="getControlType(field.property) === 'box-spacing'"
                            :field-key="getFieldControlKey(field.key)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="String(getPropertyValue(field.key, field.property) ?? '')"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />

                        <mt-text-field
                            v-else
                            v-bind="getControlProps(field.property)"
                            :label="getPropertyTitle(field.property)"
                            :help-text="getPropertyHelpText(field.property)"
                            :model-value="getPropertyValue(field.key, field.property)"
                            :disabled="!allowEdit || undefined"
                            @update:model-value="onUpdateField(field.key, $event)"
                        />
                    </template>

                    <div
                        v-if="getFieldViolation(field)"
                        class="sw-experience-studio-settings-fields__violation"
                        role="alert"
                    >
                        {{ getFieldViolation(field).message }}
                    </div>

                    <button
                        v-if="canMapField(field)"
                        type="button"
                        class="sw-experience-studio-settings-fields__mapping-trigger"
                        :disabled="!allowEdit"
                        @click="onOpenMappingModal(field)"
                    >
                        <mt-icon
                            name="regular-variables-xs"
                            size="12px"
                        />
                        {{ $t('sw-experience-studio.detail.elementSettings.mapping.mapAction') }}
                    </button>
                </div>
            </div>
        </template>
    </sw-collapse>

    <sw-experience-studio-mapping-modal
        v-if="mappingModalField"
        :candidates="mappingModalCandidates"
        :is-loading="isLoadingMappingCandidates"
        :load-error="mappingCandidateLoadError"
        :property-title="getPropertyTitle(mappingModalField.property)"
        :current-path="getFieldMappingPath(mappingModalField)"
        @select="onSelectMapping"
        @close="onCloseMappingModal"
        @retry="onRetryMappingCandidates"
    />
</div>
{% endblock %}
