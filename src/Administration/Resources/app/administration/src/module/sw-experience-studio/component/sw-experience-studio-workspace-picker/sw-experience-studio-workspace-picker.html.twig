{% block sw_experience_studio_workspace_picker %}
{# Keep an in-page anchor when the modal moves to body and the dropdown's focus guards are removed. #}
<div class="sw-experience-studio-workspace-picker">
    <mt-modal-root
        :is-open="true"
        @change="onModalRootChange"
    >
        <mt-modal :title="$t('sw-experience-studio.workspace.manager.manage')">
            <mt-text-field
                :label="$t('sw-experience-studio.workspace.manager.search')"
                :model-value="term"
                @update:model-value="onSearch"
            />
            <mt-banner
                v-if="workspaceStore.loadError"
                variant="critical"
            >
                {{ $t('sw-experience-studio.workspace.manager.loadError') }}
                <mt-button
                    variant="secondary"
                    @click="workspaceStore.load(page, term)"
                >
                    {{ $t('sw-experience-studio.workspace.manager.retry') }}
                </mt-button>
            </mt-banner>
            <sw-loader v-if="workspaceStore.isLoading" />
            <ul
                v-else
                class="sw-experience-studio-workspace-picker__list"
            >
                <li
                    v-for="workspace in workspaceStore.workspaces"
                    :key="workspace.id"
                    class="sw-experience-studio-workspace-picker__row"
                >
                    <button
                        class="sw-experience-studio-workspace-picker__item"
                        type="button"
                        @click="$emit('select', workspace.id)"
                    >
                        <mt-icon
                            name="regular-layout"
                            size="16px"
                            decorative
                        />
                        <span class="sw-experience-studio-workspace-picker__name">{{ workspace.name }}</span>
                        <span class="sw-experience-studio-workspace-picker__creator">
                            {{ $t('sw-experience-studio.workspace.manager.createdBy', { name: workspace.createdBy ? `${workspace.createdBy.firstName} ${workspace.createdBy.lastName}` : $t('sw-experience-studio.workspace.manager.deletedUser') }) }}
                        </span>
                        <sw-avatar
                            :image-url="workspace.createdBy?.avatarMedia?.url"
                            :first-name="workspace.createdBy?.firstName"
                            :last-name="workspace.createdBy?.lastName"
                            size="24px"
                        />
                    </button>
                    <mt-dropdown-menu-root :modal="false">
                        <mt-dropdown-menu-trigger as-child>
                            <mt-button
                                class="sw-experience-studio-workspace-picker__actions"
                                variant="tertiary"
                                size="small"
                                square
                                :aria-label="$t('global.sw-data-grid.actionsMenu')"
                            >
                                <mt-icon
                                    name="solid-ellipsis-h-s"
                                    decorative
                                />
                            </mt-button>
                        </mt-dropdown-menu-trigger>
                        {# Keep row action menus inside the modal's focus trap. #}
                        <mt-dropdown-menu-portal disabled>
                            <mt-action-menu>
                                <mt-action-menu-item
                                    icon="regular-pencil-s"
                                    @select="$emit('rename', workspace)"
                                >
                                    {{ $t('sw-experience-studio.workspace.manager.rename') }}
                                </mt-action-menu-item>
                                <mt-action-menu-item
                                    icon="regular-trash"
                                    variant="critical"
                                    @select="$emit('delete', workspace)"
                                >
                                    {{ $t('global.default.delete') }}
                                </mt-action-menu-item>
                            </mt-action-menu>
                        </mt-dropdown-menu-portal>
                    </mt-dropdown-menu-root>
                </li>
            </ul>
            <p v-if="!workspaceStore.isLoading && !workspaceStore.loadError && !workspaceStore.total">
                {{ $t('sw-experience-studio.workspace.manager.empty') }}
            </p>
            <sw-pagination
                v-if="workspaceStore.total > 25"
                :page="page"
                :limit="25"
                :total="workspaceStore.total"
                @page-change="onPageChange"
            />
            <template #footer>
                <div class="sw-experience-studio-workspace-picker__footer">
                    <mt-button
                        variant="secondary"
                        @click="$emit('close')"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>
                    <mt-button
                        variant="primary"
                        @click="$emit('create')"
                    >
                        {{ $t('sw-experience-studio.workspace.manager.create') }}
                    </mt-button>
                </div>
            </template>
        </mt-modal>
    </mt-modal-root>
</div>
{% endblock %}
