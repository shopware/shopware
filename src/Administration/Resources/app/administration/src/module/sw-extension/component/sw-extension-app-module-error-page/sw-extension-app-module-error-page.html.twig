{% block sw_extension_app_module_error_page %}
<div class="sw-extension-app-module-error-page">
    <mt-empty-state
        :centered="true"
        icon="regular-search"
        :headline="$t('sw-extension.sw-extension-app-module-error-page.error.heading')"
        :description="$t('sw-extension.sw-extension-app-module-error-page.error.description')"
    >
        <template #button>
            <mt-button
                variant="primary"
                @click="goBack"
            >
                {{ $t('global.default.back') }}
            </mt-button>
        </template>
    </mt-empty-state>
</div>
{% endblock %}
