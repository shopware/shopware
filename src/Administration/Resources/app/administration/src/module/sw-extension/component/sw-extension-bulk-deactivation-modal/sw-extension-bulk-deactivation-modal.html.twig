<sw-modal
    class="sw-extension-bulk-deactivation-modal"
    :title="title"
    variant="small"
    @modal-close="emitClose"
>
    <template #default>
        <p>
            {{ $t('sw-extension.my-extensions.bulk.deactivationModal.description') }}
        </p>

        <ul class="sw-extension-bulk-deactivation-modal__list">
            <li
                v-for="extension in extensions"
                :key="extension.name"
            >
                {{ extension.label }}
            </li>
        </ul>

        <p class="sw-extension-bulk-deactivation-modal__bold-paragraph">
            {{ $t('sw-extension.my-extensions.bulk.deactivationModal.alert') }}
        </p>
    </template>

    <template #modal-footer>
        <mt-button
            size="small"
            :disabled="isLoading"
            variant="secondary"
            @click="emitClose"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>

        <mt-button
            variant="primary"
            size="small"
            :is-loading="isLoading"
            @click="emitConfirm"
        >
            {{ $t('sw-extension.my-extensions.bulk.deactivationModal.buttonLabel') }}
        </mt-button>
    </template>
</sw-modal>
