<div class="sw-extension-my-extensions-listing">
    <sw-skeleton
        v-if="isLoading"
        :variant="skeletonVariant"
    />

    <div
        v-else
        class="sw-extension-my-extensions-listing__listing-grid"
    >
        <mt-banner
            v-if="!isAppUrlReachable"
            class="sw-extension-my-extensions-listing__app-url-warning"
            variant="attention"
            :title="$t('sw-app.component.sw-app-wrong-app-url-modal.title')"
        >
            <div>
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.explanation') }}
            </div>

            <mt-button
                class="sw-app-wrong-app-url-modal__content-link-button"
                variant="secondary"
                :link="$t('sw-app.component.sw-app-wrong-app-url-modal.linkToDocsArticle')"
            >
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.labelLearnMoreButton') }}
            </mt-button>
        </mt-banner>

        <mt-banner
            v-if="extensionManagementDisabled"
            class="sw-extension-my-extensions-listing__runtime-extension-warning"
            variant="attention"
            :title="$t('sw-extension-store.component.sw-extension-my-extensions-listing.alertExtensionManagement.title')"
        >
            <div>
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.alertExtensionManagement.description') }}
            </div>

            <mt-link
                type="external"
                href="https://developer.shopware.com/docs/guides/hosting/installation-updates/extension-managment.html"
            >
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.labelLearnMoreButton') }}
            </mt-link>
        </mt-banner>

        {% block sw_extension_my_extensions_list_empty_state %}

        <sw-meteor-card
            v-if="!extensionListPaginated.length && !filterByActiveState"
            class="sw-extension-my-extensions-listing__empty-state"
        >
            <mt-empty-state
                :headline="listingEmptyStateHeadline"
                :description="listingEmptyStateDescription"
                icon="regular-plug"
                centered
            >
                <template #button>
                    <mt-button
                        ghost
                        variant="secondary"
                        @click="isThemeRoute ? openThemesStore() : openStore()"
                    >
                        {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.btnOpenStore') }}
                    </mt-button>
                </template>
            </mt-empty-state>
        </sw-meteor-card>

        {% endblock %}

        <template v-else>
            <div class="sw-extension-my-extensions-listing__container">
                <sw-extension-my-extensions-listing-controls
                    @update:active-state="changeActiveState"
                    @update:sorting-option="changeSortingOption"
                />

                <sw-extension-component-section
                    v-if="isThemeRoute"
                    position-identifier="sw-extension-my-extensions-listing__before-content"
                />

                <sw-meteor-card
                    v-if="!extensionListPaginated.length && filterByActiveState"
                    class="sw-extension-my-extensions-listing__empty-state"
                >
                    <mt-empty-state
                        :headline="pluginsEmptyStateHeadline"
                        :description="pluginsEmptyStateDescription"
                        icon="regular-plug"
                        centered
                    />
                </sw-meteor-card>

                <template v-else>
                    <template
                        v-for="entry in extensionListPaginated"
                        :key="entry.name"
                    >
                        <component
                            :is="entry.storeLicense ? 'sw-extension-card-bought' : 'sw-self-maintained-extension-card'"
                            :extension="entry"
                            @update-list="updateList"
                        />
                    </template>

                    <sw-pagination
                        :total="total"
                        :limit="limit"
                        :page="page"
                        @page-change="changePage"
                    />
                </template>
            </div>
        </template>
    </div>
</div>
