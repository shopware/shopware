<div class="sw-extension-my-extensions-listing">
    <sw-skeleton
        v-if="isLoading"
        :variant="skeletonVariant"
    />

    <div
        v-else
        class="sw-extension-my-extensions-listing__listing-grid"
    >
        <mt-banner
            v-if="!isAppUrlReachable"
            class="sw-extension-my-extensions-listing__app-url-warning"
            variant="attention"
            :title="$t('sw-app.component.sw-app-wrong-app-url-modal.title')"
        >
            <div>
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.explanation') }}
            </div>

            <mt-button
                class="sw-app-wrong-app-url-modal__content-link-button"
                variant="secondary"
                :link="$t('sw-app.component.sw-app-wrong-app-url-modal.linkToDocsArticle')"
            >
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.labelLearnMoreButton') }}
            </mt-button>
        </mt-banner>

        <mt-banner
            v-if="extensionManagementDisabled"
            class="sw-extension-my-extensions-listing__runtime-extension-warning"
            variant="attention"
            :title="$t('sw-extension-store.component.sw-extension-my-extensions-listing.alertExtensionManagement.title')"
        >
            <div>
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.alertExtensionManagement.description') }}
            </div>

            <mt-link
                type="external"
                href="https://developer.shopware.com/docs/guides/hosting/installation-updates/extension-managment.html"
            >
                {{ $t('sw-app.component.sw-app-wrong-app-url-modal.labelLearnMoreButton') }}
            </mt-link>
        </mt-banner>

        {% block sw_extension_my_extensions_list_empty_state %}

        <sw-meteor-card
            v-if="!extensionListPaginated.length && !filterByActiveState"
            class="sw-extension-my-extensions-listing__empty-state"
        >
            <img
                :src="assetFilter('administration/administration/static/img/empty-states/extensions-empty-state.svg')"
                alt=""
            >

            <h3 v-if="isThemeRoute">
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.themes.titleEmptyState') }}
            </h3>
            <h3 v-else>
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.apps.titleEmptyState') }}
            </h3>

            <p v-if="isThemeRoute">
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.themes.textEmptyState') }}
            </p>
            <p v-else>
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.apps.textEmptyState') }}
            </p>

            <mt-button
                variant="secondary"
                @click="isThemeRoute ? openThemesStore() : openStore()"
            >
                {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.btnOpenStore') }}
            </mt-button>
        </sw-meteor-card>

        {% endblock %}

        <template v-else>
            <div class="sw-extension-my-extensions-listing__container">
                <div class="sw-extension-my-extensions-listing__controls-row">
                    <sw-extension-my-extensions-listing-controls
                        v-if="!hasSelection"
                        :sorting-option="sortingOption"
                        @update:active-state="changeActiveState"
                        @update:sorting-option="changeSortingOption"
                    />

                    <sw-extension-bulk-actions-bar
                        v-else
                        class="sw-extension-my-extensions-listing__bulk-bar"
                        :selected-count="selectedExtensions.length"
                        :applicable-counts="applicableCounts"
                        :disabled="isBulkRunning"
                        @select-all="selectAllVisible"
                        @clear="clearSelection"
                        @run-action="runBulkAction"
                    />
                </div>

                <sw-extension-component-section
                    v-if="isThemeRoute"
                    position-identifier="sw-extension-my-extensions-listing__before-content"
                />

                <sw-meteor-card
                    v-if="!extensionListPaginated.length && filterByActiveState"
                    class="sw-extension-my-extensions-listing__empty-state"
                >
                    <img
                        :src="assetFilter('administration/administration/static/img/empty-states/extensions-empty-state.svg')"
                        alt=""
                    >

                    <h3 v-if="isThemeRoute">
                        {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.themes.noActivePlugins') }}
                    </h3>
                    <h3 v-else>
                        {{ $t('sw-extension-store.component.sw-extension-my-extensions-listing.apps.noActivePlugins') }}
                    </h3>
                </sw-meteor-card>

                <template v-else>
                    <template
                        v-for="entry in extensionListPaginated"
                        :key="entry.name"
                    >
                        <component
                            :is="entry.storeLicense ? 'sw-extension-card-bought' : 'sw-self-maintained-extension-card'"
                            :extension="entry"
                            :selected="isSelected(entry)"
                            :bulk-loading="bulkProcessingNames.includes(entry.name)"
                            @select-change="onSelectChange(entry, $event)"
                            @update-list="updateList"
                        />
                    </template>

                    <sw-pagination
                        :total="total"
                        :limit="limit"
                        :page="page"
                        @page-change="changePage"
                    />
                </template>
            </div>
        </template>

        <sw-extension-permissions-modal
            v-if="showBulkConsentModal && bulkConsent"
            :title="bulkConsentTitle"
            :description="bulkConsentDescription"
            :action-label="bulkConsentActionLabel"
            :extension-label="bulkConsentExtensionLabel"
            :permissions="bulkConsent.permissions"
            :domains="bulkConsent.domains"
            @modal-close="onBulkConsentCancel"
            @close-with-action="onBulkConsentAccept"
        />

        <sw-extension-bulk-uninstall-modal
            v-if="showBulkUninstallModal"
            :extensions="bulkUninstallItems"
            @modal-close="cancelBulkUninstall"
            @confirm="confirmBulkUninstall"
        />

        <sw-extension-bulk-deactivation-modal
            v-if="showBulkDeactivationModal"
            :extensions="rentedBulkDeactivationItems"
            @modal-close="cancelBulkDeactivation"
            @confirm="confirmBulkDeactivation"
        />
    </div>
</div>
