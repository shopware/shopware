{% block sw_flow_generate_document_modal %}
<sw-modal
    class="sw-flow-generate-document-modal"
    :title="$t('sw-flow.modals.document.titleCreateDocument')"
    :closable="false"
    @modal-close="onClose"
>
    {% block sw_flow_generate_document_modal_document_type_multiple %}
    <sw-multi-select
        v-if="!isDocumentGenerationReworkActive"
        v-model:value="documentTypesSelected"
        name="sw-field--documentTypesSelected"
        required
        class="sw-flow-generate-document-modal__type-multi-select"
        label-property="translated.name"
        value-property="technicalName"
        :options="documentTypes"
        :label="$t('sw-flow.modals.document.labelDocumentType')"
        :placeholder="$t('sw-flow.modals.document.placeholderDocumentType')"
        :error="fieldError"
    />
    {% endblock %}

    {% block sw_flow_generate_document_modal_document_type_single %}
    <mt-select
        v-if="isDocumentGenerationReworkActive"
        :model-value="documentTypeSelected"
        name="sw-field--documentTypeSelected"
        required
        class="sw-flow-generate-document-modal__type-select"
        label-property="label"
        value-property="value"
        :is-loading="isLoadingSupportedDocumentTypes"
        :options="documentTypeOptions"
        :label="$t('sw-flow.modals.document.labelDocumentTypeSingle')"
        :placeholder="$t('sw-flow.modals.document.placeholderDocumentTypeSingle')"
        :error="fieldError"
        @update:model-value="onDocumentTypeSelectedChange"
    />
    {% endblock %}

    {% block sw_flow_generate_document_modal_file_formats %}
    <mt-select
        v-if="isDocumentGenerationReworkActive"
        v-model="fileFormatsSelected"
        name="sw-field--fileFormatsSelected"
        required
        class="sw-flow-generate-document-modal__file-formats-select"
        label-property="label"
        value-property="value"
        :enable-multi-selection="true"
        :disabled="!documentTypeSelected"
        :options="fileFormatOptions"
        :label="$t('sw-flow.modals.document.labelFileFormats')"
        :placeholder="$t('sw-flow.modals.document.placeholderFileFormats')"
        :error="fileFormatsFieldError"
    />
    {% endblock %}

    {% block sw_flow_generate_document_modal_footer %}
    <template #modal-footer>
        {% block sw_flow_generate_document_modal_footer_cancel_button %}
        <mt-button
            class="sw-flow-generate-document-modal__cancel-button"
            size="small"
            variant="secondary"
            @click="onClose"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_flow_generate_document_modal_footer_save_button %}
        <mt-button
            class="sw-flow-generate-document-modal__save-button"
            variant="primary"
            size="small"
            @click="onAddAction"
        >
            {{ sequence.id ? $t('sw-flow.modals.buttonSaveAction') : $t('sw-flow.modals.buttonAddAction') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}
</sw-modal>
{% endblock %}
