{% block sw_oauth_client_list %}
<sw-page class="sw-oauth-client-list">
    <template #smart-bar-header>
        <h2>
            <span>{{ $t('sw-settings.index.title') }}</span>
            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />
            <span>{{ $t('sw-integration.general.headlineIntegrations') }}</span>
        </h2>
    </template>
    <template #smart-bar-actions>
        <mt-button
            variant="primary"
            size="default"
            :disabled="!acl.can('oauth_client.creator') || isLoading || isSaving"
            @click="onCreate"
        >
            {{ $t('sw-oauth-client.create') }}
        </mt-button>
    </template>
    <template #content>
        <sw-card-view>
            <sw-integration-tabs />
            <mt-banner
                variant="info"
                class="sw-oauth-client-list__notice"
            >
                {{ $t('sw-oauth-client.permissionsHint') }}
            </mt-banner>
            <mt-card
                class="sw-oauth-client-list__overview"
                position-identifier="sw-oauth-client-list"
                :title="$t('sw-oauth-client.title')"
                :subtitle="$t('sw-oauth-client.description')"
                :is-loading="isLoading"
            >
                <sw-data-grid
                    v-if="clients && clients.length > 0"
                    :data-source="clients"
                    :columns="columns"
                    :show-selection="false"
                    :allow-inline-edit="false"
                >
                    <template #column-id="{ item }">
                        <span class="sw-oauth-client-list__client-id">oauth-{{ item.id }}</span>
                    </template>
                    <template #column-active="{ item }">
                        <mt-badge :variant="item.active ? 'positive' : 'neutral'">
                            {{ $t(item.active ? 'sw-oauth-client.active' : 'sw-oauth-client.inactive') }}
                        </mt-badge>
                    </template>
                    <template #actions="{ item }">
                        <sw-context-menu-item @click="onEdit(item)">
                            {{ $t('sw-oauth-client.details') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            :disabled="!acl.can('oauth_client.deleter')"
                            @click="deleteClient = item"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
                <mt-empty-state
                    v-else-if="!isLoading && clients"
                    icon="regular-key"
                    :headline="$t('sw-oauth-client.emptyTitle')"
                    :description="$t('sw-oauth-client.emptyDescription')"
                />
                <sw-pagination
                    v-if="total > limit"
                    :page="page"
                    :limit="limit"
                    :total="total"
                    @page-change="onPageChange"
                />
            </mt-card>
        </sw-card-view>

        {% block sw_oauth_client_detail %}
        <sw-modal
            v-if="currentClient"
            :title="isNew ? $t('sw-oauth-client.create') : currentClient.name"
            :is-loading="isSaving"
            class="sw-oauth-client-list__detail"
            @modal-close="onClose"
        >
            <mt-text-field
                v-model="currentClient.name"
                :label="$t('sw-oauth-client.name')"
                :disabled="!canSave || isSaving"
                required
            />
            <mt-text-field
                :model-value="'oauth-' + currentClient.id"
                :label="$t('sw-oauth-client.clientId')"
                :help-text="$t('sw-oauth-client.clientIdHelp')"
                disabled
                copyable
            />
            <mt-textarea
                v-model="redirectUrisText"
                class="sw-oauth-client-list__redirects"
                :label="$t('sw-oauth-client.redirectUris')"
                :help-text="$t('sw-oauth-client.redirectHelp')"
                :disabled="!canSave || isSaving"
                placeholder="https://example.com/callback"
                aria-describedby="oauth-client-redirect-hint"
                required
            />
            <p
                id="oauth-client-redirect-hint"
                class="sw-oauth-client-list__redirect-hint"
            >
                {{ $t('sw-oauth-client.redirectHint') }}
            </p>
            <mt-switch
                v-model="currentClient.active"
                :label="$t('sw-oauth-client.active')"
                :help-text="$t('sw-oauth-client.activeHelp')"
                :disabled="!canSave || isSaving"
            />
            <mt-banner variant="attention">
                {{ $t('sw-oauth-client.permissionsHint') }}
            </mt-banner>
            <template #modal-footer>
                <mt-button
                    :disabled="isSaving"
                    variant="secondary"
                    @click="onClose"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="primary"
                    :disabled="!canSave || isSaving"
                    :is-loading="isSaving"
                    @click="onSave"
                >
                    {{ $t('global.default.save') }}
                </mt-button>
            </template>
        </sw-modal>
        {% endblock %}

        <sw-modal
            v-if="deleteClient"
            :title="$t('global.default.delete')"
            @modal-close="!isSaving && (deleteClient = null)"
        >
            <p>{{ $t('sw-oauth-client.deleteConfirm', { name: deleteClient.name }) }}</p>
            <template #modal-footer>
                <mt-button
                    :disabled="isSaving"
                    variant="secondary"
                    @click="deleteClient = null"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="critical"
                    :disabled="isSaving || !acl.can('oauth_client.deleter')"
                    :is-loading="isSaving"
                    @click="onDelete"
                >
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
</sw-page>
{% endblock %}
