{% block sw_login_login %}
<form
    class="sw-login-v2-credentials"
    @submit.prevent="onSubmit"
>
    {% block sw_login_login_form_headline %}
    <h1 class="sw-login-v2-credentials__title">
        {{ $t('sw-login-v2.credentials.title') }}
    </h1>
    {% endblock %}

    <mt-banner
        v-if="isRateLimited"
        class="sw-login-v2-credentials__warning"
        variant="attention"
    >
        {{ $t('sw-login-v2.credentials.warningTooManyAttemptsCountdown', { time: countdownLabel }) }}
    </mt-banner>

    <div
        v-if="showSso"
        class="sw-login-v2-credentials__sso"
    >
        <mt-button
            class="sw-login-v2-credentials__sso-button"
            type="button"
            variant="secondary"
            size="small"
            block
            :disabled="isDisabled"
            @click="forwardToSso"
        >
            <template #iconFront>
                <mt-icon
                    class="sw-login-v2-credentials__sso-button-icon"
                    name="shopware"
                    mode="solid"
                    size="var(--scale-size-16)"
                />
            </template>

            {{ $t('sw-login-v2.credentials.buttonSsoLogin') }}
        </mt-button>

        <div class="sw-login-v2-credentials__sso-separator">
            <span class="sw-login-v2-credentials__sso-separator-text">
                {{ $t('sw-login-v2.credentials.orContinueWith') }}
            </span>
        </div>
    </div>

    {% block sw_login_login_user_field %}
    <mt-text-field
        v-model="username"
        v-autofocus
        class="sw-login-v2-credentials__username"
        :label="$t('sw-login-v2.credentials.labelUsername')"
        name="username"
        autocomplete="username"
        :disabled="isDisabled"
        required
    />
    {% endblock %}

    {% block sw_login_login_password_field %}
    <mt-password-field
        ref="passwordField"
        v-model="password"
        class="sw-login-v2-credentials__password"
        :label="$t('sw-login-v2.credentials.labelPassword')"
        name="current-password"
        autocomplete="current-password"
        :disabled="isDisabled"
        required
    />
    {% endblock %}

    {% block sw_login_login_alert %}
    <mt-banner
        v-if="error"
        class="sw-login-v2-credentials__error"
        variant="critical"
    >
        {{ $t('sw-login-v2.credentials.errorInvalidCredentials') }}
    </mt-banner>
    {% endblock %}

    {% block sw_login_login_submit %}
    <mt-checkbox
        v-model:checked="rememberMe"
        class="sw-login-v2-credentials__remember-me"
        :label="$t('sw-login-v2.credentials.labelKeepLoggedIn')"
        :disabled="isDisabled"
    />

    {% block sw_login_login_submit_button %}
    <mt-button
        class="sw-login-v2-credentials__login-button"
        type="submit"
        variant="primary"
        size="default"
        block
        :is-loading="isLoggingIn"
        :disabled="isDisabled || !canSubmit"
    >
        {{ $t('sw-login-v2.credentials.buttonLogin') }}
    </mt-button>
    {% endblock %}

    {% block sw_login_login_forgot_password %}
    <mt-link
        class="sw-login-v2-credentials__forgot-password"
        :to="{ name: 'sw.login.v2.index.recovery' }"
    >
        {{ $t('sw-login-v2.credentials.forgotPassword') }}
    </mt-link>
    {% endblock %}
    {% endblock %}
</form>
{% endblock %}
