{% block sw_login_recovery_recovery %}
<form
    class="sw-login-v2-reset"
    @submit.prevent
>
    {% block sw_login_recovery_recovery_headline %}
    <div class="sw-login-v2-reset__content">
        <h1 class="sw-login-v2-reset__title">
            {{ $t('sw-login-v2.reset.title') }}
        </h1>

        <p class="sw-login-v2-reset__description">
            {{ $t('sw-login-v2.reset.description') }}
        </p>
    </div>
    {% endblock %}

    {% block sw_login_recovery_recovery_form %}
    {% block sw_login_recovery_recovery_form_new_password_field %}
    <mt-password-field
        class="sw-login-v2-reset__password"
        :label="$t('sw-login-v2.reset.labelNewPassword')"
        autocomplete="new-password"
        required
    />
    {% endblock %}

    {% block sw_login_recovery_recovery_form_password_confirm_field %}
    <mt-password-field
        class="sw-login-v2-reset__repeat-password"
        :label="$t('sw-login-v2.reset.labelRepeatPassword')"
        autocomplete="new-password"
        required
    />
    {% endblock %}

    {% block sw_login_recovery_recovery_form_submit %}
    <mt-button
        class="sw-login-v2-reset__reset"
        type="submit"
        variant="primary"
        size="default"
        block
    >
        {{ $t('sw-login-v2.reset.buttonSubmit') }}
    </mt-button>
    {% endblock %}
    {% endblock %}
</form>
{% endblock %}
