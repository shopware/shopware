{% block sw_login_recovery %}
<form
    class="sw-login-v2-recovery"
    @submit.prevent
>
    <div class="sw-login-v2-recovery__content">
        {% block sw_login_recovery_headline %}
        <h1 class="sw-login-v2-recovery__title">
            {{ $t('sw-login-v2.recovery.title') }}
        </h1>
        {% endblock %}

        {% block sw_login_recovery_text %}
        <p class="sw-login-v2-recovery__description">
            {{ $t('sw-login-v2.recovery.description') }}
        </p>
        {% endblock %}
    </div>

    <mt-banner
        v-if="error"
        class="sw-login-v2-recovery__error"
        variant="critical"
    >
        {{ $t('sw-login-v2.recovery.errorLinkExpired') }}
    </mt-banner>

    <mt-banner
        v-if="warning"
        class="sw-login-v2-recovery__warning"
        variant="attention"
    >
        {{ $t('sw-login-v2.recovery.warningTooManyAttempts') }}
    </mt-banner>

    {% block sw_login_recovery_form %}
    {% block sw_login_recovery_form_email_field %}
    <mt-email-field
        class="sw-login-v2-recovery__email"
        :label="$t('sw-login-v2.recovery.labelEmail')"
        autocomplete="email"
        required
    />
    {% endblock %}

    {% block sw_login_recovery_form_submit %}
    <mt-button
        class="sw-login-v2-recovery__submit"
        type="submit"
        variant="primary"
        size="default"
        block
    >
        {{ $t('sw-login-v2.recovery.buttonSubmit') }}
    </mt-button>
    {% endblock %}
    {% endblock %}
</form>
{% endblock %}
