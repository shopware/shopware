<div class="sw-login-v2-credentials">
    <h1 class="sw-login-v2-credentials__title">
        {{ $t('sw-login-v2.credentials.title') }}
    </h1>

    <mt-banner
        v-if="warning"
        class="sw-login-v2-credentials__warning"
        variant="attention"
    >
        {{ $t('sw-login-v2.credentials.warningTooManyAttempts') }}
    </mt-banner>

    <div
        v-if="showSso"
        class="sw-login-v2-credentials__sso"
    >
        <mt-button
            class="sw-login-v2-credentials__sso-button"
            variant="secondary"
            size="small"
            block
        >
            <template #iconFront>
                <mt-icon
                    class="sw-login-v2-credentials__sso-button-icon"
                    name="shopware"
                    mode="solid"
                    size="var(--scale-size-16)"
                />
            </template>

            {{ $t('sw-login-v2.credentials.buttonSsoLogin') }}
        </mt-button>

        <div class="sw-login-v2-credentials__sso-separator">
            <span class="sw-login-v2-credentials__sso-separator-text">
                {{ $t('sw-login-v2.credentials.orContinueWith') }}
            </span>
        </div>
    </div>

    <mt-text-field
        class="sw-login-v2-credentials__username"
        :label="$t('sw-login-v2.credentials.labelUsername')"
        required
    />

    <mt-password-field
        class="sw-login-v2-credentials__password"
        :label="$t('sw-login-v2.credentials.labelPassword')"
        required
    />

    <mt-banner
        v-if="error"
        class="sw-login-v2-credentials__error"
        variant="critical"
    >
        {{ $t('sw-login-v2.credentials.errorInvalidCredentials') }}
    </mt-banner>

    <mt-checkbox
        class="sw-login-v2-credentials__remember-me"
        :label="$t('sw-login-v2.credentials.labelKeepLoggedIn')"
    />

    <mt-button
        class="sw-login-v2-credentials__login-button"
        variant="primary"
        size="default"
        block
    >
        {{ $t('sw-login-v2.credentials.buttonLogin') }}
    </mt-button>

    <mt-link
        class="sw-login-v2-credentials__forgot-password"
    >
        {{ $t('sw-login-v2.credentials.forgotPassword') }}
    </mt-link>
</div>
