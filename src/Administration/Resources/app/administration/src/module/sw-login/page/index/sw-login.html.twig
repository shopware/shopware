{% block sw_login %}
<div
    v-show="shouldRenderDOM"
    class="sw-login"
    :class="{ 'is--login-success' : isLoginSuccess }"
>
    {% block sw_login_container %}
    <div class="sw-login__container">
        {% block sw_login_logo %}
        <img
            class="sw-login__logo"
            :src="assetFilter('administration/administration/static/img/shopware_logo_blue.svg')"
            :alt="$t('sw-login.general.logoAlt')"
        >
        {% endblock %}

        {% block sw_login_form %}
        <div
            class="sw-login__card"
            :class="{ 'is--login-error': isLoginError }"
            :aria-busy="isLoading ? 'true' : 'false'"
        >
            {% block sw_login_view %}
            <router-view
                v-slot="{Component}"
            >
                <component
                    :is="Component"
                    :hash="hash"
                    :inert="isLoading"
                    @is-loading="setLoading(true)"
                    @is-not-loading="setLoading(false)"
                    @login-error="loginError"
                    @login-success="loginSuccess"
                    @config-loaded="setLoginConfig"
                />
            </router-view>
            {% endblock %}

            {% block sw_login_loader %}
            <mt-loader
                v-if="isLoading"
                role="status"
                :aria-label="$t('sw-login.general.loadingLabel')"
            />
            {% endblock %}
        </div>
        {% endblock %}

        {% block sw_login_back_link %}
        <mt-link
            v-if="showBackToLoginLink"
            class="sw-login__back-link"
            :to="{ name: 'sw.login.index.login' }"
        >
            {{ $t('sw-login.general.linkBackToLogin') }}
        </mt-link>
        {% endblock %}

        {% block sw_login_forgot_password_link %}
        <mt-link
            v-if="showForgotPasswordLink"
            class="sw-login__forgot-password-action"
            :to="{ name: 'sw.login.index.recovery' }"
        >
            {{ $t('sw-login.index.forgottenPasswordLink') }}
        </mt-link>
        {% endblock %}
    </div>
    {% endblock %}
</div>
{% endblock %}
