{% block sw_login_recovery_info %}
<div class="sw-login-recovery-info">
    {% block sw_login_recovery_info_info %}
    <div class="sw-login__status">
        {% block sw_login_recovery_info_icon %}
        <span class="sw-login__status-icon">
            <mt-icon
                name="solid-check-circle"
                size="24px"
                decorative
            />
        </span>
        {% endblock %}

        {% block sw_login_recovery_info_headline %}
        <h1 class="sw-login__status-headline">
            {{ $t('sw-login.recovery.info.headline') }}
        </h1>
        {% endblock %}

        {% block sw_login_recovery_info_text %}
        <p class="sw-login__content-description">
            {{ $t('sw-login.recovery.info.info', { email: email ?? $t('sw-login.recovery.info.emailFallback') }) }}
        </p>
        {% endblock %}
    </div>
    {% endblock %}
</div>
{% endblock %}
