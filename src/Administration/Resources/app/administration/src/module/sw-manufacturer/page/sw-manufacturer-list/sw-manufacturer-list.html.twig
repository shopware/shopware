{% block sw_manufacturer_list %}
<sw-page class="sw-manufacturer-list">
    {% block sw_manufacturer_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="product_manufacturer"
            :initial-search="term"
            @search="onSearch"
        />
    </template>
    {% endblock %}

    {% block sw_manufacturer_list_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_manufacturer_list_smart_bar_header_title %}
        <h2>
            {% block sw_manufacturer_list_smart_bar_header_title_text %}
            {{ $t('sw-manufacturer.list.textManufacturerOverview') }}
            {% endblock %}

            {% block sw_manufacturer_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >
                ({{ total }})
            </span>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_manufacturer_list_actions %}
    <template #smart-bar-actions>
        {% block sw_manufacturer_list_smart_bar_actions %}
        <mt-button
            v-tooltip.bottom="{
                message: $t('sw-privileges.tooltip.warning'),
                disabled: acl.can('product_manufacturer.creator'),
                showOnDisabledElements: true
            }"
            :disabled="!acl.can('product_manufacturer.creator') || undefined"
            class="sw-manufacturer-list__add-manufacturer"
            variant="primary"
            size="default"
            @click="$router.push({ name: 'sw.manufacturer.create' })"
        >
            {{ $t('sw-manufacturer.list.buttonAddManufacturer') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_manufacturer_list_language_switch %}
    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    {% endblock %}

    <template #content>
        {% block sw_manufacturer_list_content %}
        <div class="sw-manufacturer-list__content">
            {% block sw_manufacturer_list_empty_state %}
            <mt-empty-state
                v-if="!isLoading && !total"
                :centered="true"
                :icon="$route.meta.$module.icon"
                :headline="isValidTerm(term) ? $t('sw-empty-state.messageNoResultTitle') : $t('sw-empty-state.messageNoResultTitle')"
                :description="isValidTerm(term) ? $t('sw-empty-state.messageNoResultSubline') : $t($route.meta.$module.description)"
                :link-text="isValidTerm(term) ? $t('sw-empty-state.messageNoResultLink') : ''"
                :link-href="isValidTerm(term) ? $router.resolve({ name: 'sw.profile.index.searchPreferences' }).href : ''"
            />
            {% endblock %}

            {% block sw_manufacturer_list_grid %}
            <sw-meteor-entity-data-table
                v-else-if="entitySearchable"
                ref="manufacturerTable"
                class="sw-manufacturer-list__grid"
                detail-route="sw.manufacturer.detail"
                :columns="manufacturerColumns"
                :repository="manufacturerRepository"
                :criteria-resolver="resolveManufacturerCriteria"
                :initial-page="page"
                :initial-limit="limit"
                :initial-search-term="term"
                :initial-sort-by="currentSortBy"
                :initial-sort-direction="sortDirection"
                :initial-natural-sorting="naturalSorting"
                :allow-edit="acl.can('product_manufacturer.editor')"
                :allow-inline-edit="acl.can('product_manufacturer.editor')"
                :allow-delete="acl.can('product_manufacturer.deleter')"
                :show-selections="acl.can('product_manufacturer.deleter')"
                :disable-search="true"
                @load-success="onTableLoadSuccess"
                @load-error="onTableLoadError"
                @pagination-change="onPageChange"
                @sort-change="onSortColumn"
            >
                {% block sw_manufacturer_list_grid_columns_name_preview %}
                <template #preview-name="{ data }">
                    <sw-media-preview-v2 :source="data?.mediaId" />
                </template>
                {% endblock %}
            </sw-meteor-entity-data-table>
            {% endblock %}

        </div>
        {% endblock %}

    </template>
</sw-page>
{% endblock %}
