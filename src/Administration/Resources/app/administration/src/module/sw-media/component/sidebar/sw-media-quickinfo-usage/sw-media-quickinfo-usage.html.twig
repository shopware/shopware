{% block sw_media_quickinfo_usage %}
<sw-media-collapse
    v-if="getUsages.length > 0"
    class="sw-media-quickinfo-usage"
    :expand-on-loading="true"
    :title="$t('sw-media.sidebar.sections.usage')"
    storage-key="usage"
>
    <template #content>
        {% block sw_media_quickinfo_usage_loader %}
        <sw-loader
            v-if="isLoading"
            size="30px"
            class="sw-media-quickinfo-usage__loading-indicator"
        />
        {% endblock %}

        {% block sw_media_quickinfo_usage_list %}
        <ul
            v-else
            class="sw-media-quickinfo-usage__list"
        >
            {% block sw_media_quickinfo_usage_item %}
            <li
                v-for="usage in getUsages"
                :key="usage.link.id"
                class="sw-media-quickinfo-usage__item"
            >
                <router-link
                    v-tooltip="{
                        showDelay: 300,
                        hideDelay: 5,
                        message: usage.tooltip
                    }"
                    class="sw-media-quickinfo-usage__link"
                    :to="{ name: usage.link.name, params: { id: usage.link.id } }"
                    :target="routerLinkTarget"
                    :aria-label="usageAriaLabel(usage)"
                >
                    {% block sw_media_quickinfo_usage_item_icon %}
                    <span class="sw-media-quickinfo-usage__icon">
                        <mt-icon
                            :name="usage.icon.name"
                            :color="usage.icon.color"
                            size="16px"
                        />
                    </span>
                    {% endblock %}

                    {% block sw_media_quickinfo_usage_item_label %}
                    <span class="sw-media-quickinfo-usage__content">
                        <span class="sw-media-quickinfo-usage__name">
                            {{ usage.name }}
                        </span>
                        <span class="sw-media-quickinfo-usage__type">
                            {{ usage.typeLabel }}
                        </span>
                    </span>
                    {% endblock %}
                </router-link>
            </li>
            {% endblock %}
        </ul>
        {% endblock %}
    </template>
</sw-media-collapse>
{% endblock %}
