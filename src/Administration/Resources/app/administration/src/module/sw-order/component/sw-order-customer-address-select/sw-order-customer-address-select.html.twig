{% block sw_order_customer_address_select %}
<template v-if="feature.isActive('v6.8.0.0')">
    {% block sw_order_customer_address_select_entity_select %}
    <sw-entity-single-select
        :key="customer?.id"
        v-model:value="addressId"
        v-bind="$attrs"
        class="sw-order-customer-address-select"
        entity="customer_address"
        required
        :criteria="customerAddressCriteria"
        :label-callback="getCustomerAddress"
        :disabled="disabled"
    >
        <template #selection-label-property="{ item }">
            {{ getSelectionLabel(item) }}
        </template>
    </sw-entity-single-select>
    {% endblock %}
</template>

<template v-else>
    <sw-single-select
        v-model:value="addressId"
        v-bind="$attrs"
        class="sw-order-customer-address-select"
        value-property="id"
        required
        :is-loading="isLoading"
        :options="customerAddresses"
        :disabled="disabled"
        :search-function="searchAddressResults"
        @search="searchAddress"
    >
        <template #selection-label-property="{ item }">
            {{ getSelectionLabel(item) }}
        </template>

        <template #result-item="{ item, index, searchTerm, highlightSearchTerm, isSelected, setValue, getKey }">
            <sw-select-result
                :selected="isSelected(item)"
                v-bind="{ item, index }"
                @item-select="setValue"
            >
                <sw-highlight-text
                    v-if="highlightSearchTerm && !isSelected(item)"
                    :text="getCustomerAddress(item)"
                    :search-term="searchTerm"
                />

                <template v-else>
                    {{ getCustomerAddress(item) }}
                </template>
            </sw-select-result>
        </template>
    </sw-single-select>
</template>
{% endblock %}
