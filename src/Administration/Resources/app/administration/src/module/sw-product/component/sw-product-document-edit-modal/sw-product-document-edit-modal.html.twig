{% block sw_product_document_edit_modal %}
<mt-modal-root

    :is-open="true"
    @change="!$event && $emit('close')"
>
    <mt-modal
        :title="$t('sw-product.documentForm.editTitle')"
        width="m"
    >
        <div class="sw-product-document-form__edit-content">
        {% block sw_product_document_form_title_input %}
            <mt-text-field
                :model-value="documentTitle"
                class="sw-product-document-form__name-input"
                :label="$t('sw-product.documentForm.columnTitle')"
                :hint="$t('sw-product.documentForm.nameHint')"
                :error="documentNameError"
                :disabled="!canEdit || isSavingDocument"
                required
                :maxlength="255"
                @update:model-value="$emit('update:documentTitle', $event)"
            />
        {% endblock %}
        {% block sw_product_document_form_replace_file %}
            <sw-upload-listener
                :upload-tag="uploadTag"
                auto-upload
                @media-upload-finish="$emit('upload', $event)"
            />
            <div>
                <div
                    v-if="editingMedia"
                    role="group"
                    :aria-labelledby="`document-file-label-${documentId}`"
                >
                    <mt-text
                        :id="`document-file-label-${documentId}`"
                        size="xs"
                        class="sw-product-document-form__file-label"
                    >
                        {{ $t('sw-product.documentForm.columnFileName') }}
                        <span class="sw-product-document-form__required">*</span>
                    </mt-text>
                    <div class="sw-product-document-form__selected-file">
                        <div class="sw-product-document-form__file-preview">
                            <mt-icon
                                name="regular-file-text"
                                size="var(--scale-size-16)"
                            />
                        </div>
                        <span
                            class="sw-product-document-form__file-name"
                            :title="editingFileName"
                        >
                            {{ editingFileName }}
                        </span>
                        <mt-text
                            size="xs"
                            color="color-text-secondary-default"
                        >
                            {{ fileSizeFilter(editingMedia.fileSize) }}
                        </mt-text>
                        <mt-button
                            class="sw-product-document-form__remove-file"
                            square
                            size="small"
                            variant="tertiary"
                            :aria-label="$t('global.default.remove')"
                            :disabled="!canEdit || isSavingDocument"
                            @click="$emit('remove-file')"
                        >
                            <mt-icon
                                name="regular-times-xs"
                                size="var(--scale-size-12)"
                            />
                        </mt-button>
                    </div>
                </div>
                <sw-media-upload-v2
                    v-else
                    :upload-tag="uploadTag"
                    variant="regular"
                    :label="$t('sw-product.documentForm.columnFileName')"
                    required
                    default-folder="product_document"
                    :allow-multi-select="false"
                    :extension-accept="allowedExtensions.join(',')"
                    :max-file-size="maxFileSize"
                    :disabled="!canEdit || isSavingDocument"
                    @media-upload-sidebar-open="$emit('select-media')"
                />
                {% block sw_product_document_form_file_error %}
                <sw-field-error
                    v-if="documentFileError"
                    class="sw-product-document-form__file-error"
                    :error="documentFileError"
                    role="alert"
                />
                {% endblock %}
                <mt-text
                    v-if="!documentFileError"
                    size="xs"
                    color="color-text-secondary-default"
                    class="sw-product-document-form__upload-hint"
                >
                    <mt-icon
                        name="solid-info-circle"
                        size="var(--scale-size-12)"
                    />
                    {{ uploadHint }}
                </mt-text>
            </div>
        {% endblock %}

        {% block sw_product_document_form_apply_to_variants %}
            <mt-checkbox
                v-if="hasVariants"
                :checked="applyToVariants"
                class="sw-product-document-form__apply-to-variants"
                :label="$t('sw-product.documentForm.applyToVariants')"
                :help-text="$t('sw-product.documentForm.applyToVariantsHelp')"
                :disabled="!canEdit || isSavingDocument"
                @update:checked="$emit('update:applyToVariants', $event)"
            />
        {% endblock %}
            <mt-text
                size="xs"
            >
                {{ $t('sw-product.documentForm.draftHint') }}
            </mt-text>
        </div>
        <template #footer>
            <div class="sw-product-document-form__upload-footer">
                <mt-button
                    size="small"
                    variant="secondary"
                    @click="$emit('close')"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    class="sw-product-document-form__save-document"
                    variant="primary"
                    size="small"
                    :disabled="!canEdit || isSavingDocument"
                    @click="$emit('save')"
                >
                    {{ $t('global.default.apply') }}
                </mt-button>
            </div>
        </template>
    </mt-modal>
</mt-modal-root>
{% endblock %}
