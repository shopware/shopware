{% block sw_product_document_form %}
<div
    v-if="documents"
    class="sw-product-document-form-wrapper"
    :class="{ 'is--disabled': disabled }"
>
    <mt-card
        class="sw-product-document-form"
        position-identifier="sw-product-detail-base-documents"
        :subtitle="$t('sw-product.documentForm.cardSubtitle')"
        :class="{ 'sw-card__inherited': isInherited }"
    >
        <template #title>
        {% block sw_product_document_form_title %}
            <slot name="title">
                <mt-text
                    as="h3"
                    weight="semibold"
                    size="m"
                    class="mt-card__title"
                >
                    {{ $t('sw-product.documentForm.cardTitle', { count: documents.length }) }}
                </mt-text>
            </slot>
        {% endblock %}
        </template>

        <template #headerRight>
        {% block sw_product_document_form_add %}
            <mt-button
                v-if="documents.length"
                class="sw-product-document-form__add-button"
                :disabled="!canAddDocuments"
                size="small"
                variant="secondary"
                @click="showUploadModal = true"
            >
                {{ $t('sw-product.documentForm.buttonAdd') }}
            </mt-button>
        {% endblock %}
        </template>

        <template #grid>
        {% block sw_product_document_form_language_hint %}
            <mt-banner
                v-if="!isDefaultLanguage"
                variant="info"
                class="sw-product-document-form__language-hint"
            >
                {{ $t('sw-product.documentForm.languageHint') }}
            </mt-banner>
        {% endblock %}
        {% block sw_product_document_form_empty %}
            <div
                v-if="!documents.length"
                class="sw-product-document-form__empty-state"
            >
                <mt-empty-state
                    centered
                    icon="regular-file-text"
                    :headline="$t('sw-product.documentForm.emptyState')"
                    :description="$t('sw-product.documentForm.emptyDescription')"
                >
                    <template #button>
                        <mt-button
                            :disabled="!canAddDocuments"
                            size="small"
                            variant="secondary"
                            @click="showUploadModal = true"
                        >
                            {{ $t('sw-product.documentForm.buttonAdd') }}
                        </mt-button>
                    </template>
                </mt-empty-state>
            </div>
        {% endblock %}

        {% block sw_product_document_form_grid %}
            <sw-data-grid
                v-if="documents.length"
                :data-source="documents"
                :columns="documentColumns"
                :show-selection="true"
                :show-settings="true"
                :allow-inline-edit="false"
                :allow-column-edit="false"
                :compact-mode="true"
                :plain-appearance="false"
            >
            {% block sw_product_document_form_number %}
                <template #column-number="{ itemIndex }">
                    {{ itemIndex + 1 }}
                </template>
            {% endblock %}
            {% block sw_product_document_form_position %}
                <template #column-position="{ item, itemIndex }">
                    <sw-button-group class="sw-product-document-form__position">
                        <mt-button
                            square
                            size="x-small"
                            :aria-label="$t('sw-product.documentForm.contextMoveDown')"
                            :disabled="!canEdit || isInherited || itemIndex === documents.length - 1"
                            variant="secondary"
                            @click="moveDocument(item, 1)"
                        ><mt-icon
                            name="regular-chevron-down-xs"
                            size="var(--scale-size-12)"
                        /></mt-button>
                        <mt-button
                            square
                            size="x-small"
                            :aria-label="$t('sw-product.documentForm.contextMoveUp')"
                            :disabled="!canEdit || isInherited || itemIndex === 0"
                            variant="secondary"
                            @click="moveDocument(item, -1)"
                        ><mt-icon
                            name="regular-chevron-up-xs"
                            size="var(--scale-size-12)"
                        /></mt-button>
                    </sw-button-group>
                </template>
            {% endblock %}
            {% block sw_product_document_form_name %}
                <template #column-title="{ item }">
                    <span
                        class="sw-data-grid__cell-value"
                        :title="getTitle(item)"
                    >{{ getTitle(item) }}</span>
                </template>
            {% endblock %}
            {% block sw_product_document_form_file %}
                <template #column-fileName="{ item }">
                    <span
                        class="sw-data-grid__cell-value"
                        :title="getFileName(item)"
                    >{{ getFileName(item) }}</span>
                </template>
            {% endblock %}
            {% block sw_product_document_form_type %}
                <template #column-fileType="{ item }">
                    {{ getMedia(item)?.fileExtension?.toUpperCase() }}
                </template>
            {% endblock %}
            {% block sw_product_document_form_size %}
                <template #column-fileSize="{ item }">
                    {{ getFileSize(item) }}
                </template>
            {% endblock %}
            {% block sw_product_document_form_actions %}
                <template #actions="{ item }">
                    <sw-context-menu-item
                        :disabled="!canEdit || isInherited"
                        @click="editDocument(item)"
                    >
                        {{ $t('global.default.edit') }}
                    </sw-context-menu-item>
                    {% block sw_product_document_form_action_download %}
                    <sw-context-menu-item
                        class="sw-product-document-form__download"
                        :disabled="!acl.can('media.viewer') || !getMedia(item)"
                        @click="downloadDocument(item)"
                    >
                        {{ $t('sw-product.documentForm.contextDownload') }}
                    </sw-context-menu-item>
                    {% endblock %}
                    <sw-context-menu-item
                        variant="danger"
                        :disabled="!canEdit || isInherited"
                        @click="confirmRemoveDocument(item)"
                    >
                        {{ $t('global.default.remove') }}
                    </sw-context-menu-item>
                </template>
            {% endblock %}
            </sw-data-grid>
        {% endblock %}

        </template>
    </mt-card>

{% block sw_product_document_form_upload_listener %}
    <sw-upload-listener
        :upload-tag="uploadTag"
        auto-upload
        @media-upload-finish="successfulUpload"
    />
{% endblock %}

{% block sw_product_document_form_upload_modal %}
    <mt-modal-root
        v-if="showUploadModal"
        :is-open="showUploadModal"
        @change="showUploadModal = $event"
    >
        <mt-modal
            class="sw-product-document-form__upload-modal"
            :title="$t('sw-product.documentForm.buttonAdd')"
            width="m"
        >
            {% block sw_product_document_form_upload_input %}
            <sw-media-upload-v2
                :upload-tag="uploadTag"
                variant="regular"
                :allow-multi-select="false"
                :label="$t('sw-product.documentForm.fileUploadLabel')"
                required
                :extension-accept="allowedExtensions.join(',')"
                :max-file-size="maxFileSize"
                default-folder="product_document"
                :disabled="!canAddDocuments"
                @media-upload-sidebar-open="showMediaModal = true; showUploadModal = false"
            />
            {% endblock %}
            <mt-text
                size="xs"
                color="color-text-secondary-default"
                class="sw-product-document-form__upload-hint"
            >
                <mt-icon
                    name="solid-info-circle"
                    size="var(--scale-size-12)"
                />
                {{ uploadHint }}
            </mt-text>
            <template #footer>
                <div class="sw-product-document-form__upload-footer">
                    <mt-button
                        size="small"
                        variant="secondary"
                        @click="showUploadModal = false"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>
                </div>
            </template>
        </mt-modal>
    </mt-modal-root>
{% endblock %}

{% block sw_product_document_form_media_modal %}
    <sw-media-modal-v2
        v-if="showMediaModal"
        entity-context="product_document"
        :file-accept="fileAccept"
        @media-modal-selection-change="addDocuments($event, editingDocument)"
        @modal-close="showMediaModal = false"
    />
{% endblock %}

{% block sw_product_document_form_edit_modal %}
    <sw-product-document-edit-modal
        v-if="editingDocument"
        v-model:document-title="documentTitle"
        v-model:apply-to-variants="applyToVariants"
        :document-id="editingDocument.id"
        :editing-media="editingMedia"
        :document-name-error="documentNameError"
        :document-file-error="documentFileError"
        :upload-tag="`${uploadTag}-replace-${editingDocument.id}-${documentEditSession}`"
        :upload-hint="uploadHint"
        :allowed-extensions="allowedExtensions"
        :max-file-size="maxFileSize"
        :can-edit="canEdit"
        :is-saving-document="isSavingDocument"
        :has-variants="hasVariants"
        @close="closeDocumentEditor"
        @save="saveDocument"
        @upload="successfulUpload($event, editingDocument)"
        @remove-file="removeEditingFile"
        @select-media="showMediaModal = true"
    />
{% endblock %}

{% block sw_product_document_form_remove_modal %}
    <sw-product-document-remove-modal
        v-if="removingDocument"
        v-model:remove-from-variants="removeFromVariants"
        :document-title="getTitle(removingDocument)"
        :can-edit="canEdit"
        :is-removing-document="isRemovingDocument"
        :has-variants="hasVariants"
        @close="removingDocument = null"
        @remove="removeDocument"
    />
{% endblock %}

</div>
{% endblock %}
