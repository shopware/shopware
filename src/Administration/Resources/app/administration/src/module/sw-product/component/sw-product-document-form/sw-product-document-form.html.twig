{% block sw_product_document_form %}
<div
    class="sw-product-document-form"
    :class="{ 'is--disabled': disabled }"
>
    <sw-upload-listener
        v-if="!isLoading"
        :upload-tag="uploadTag"
        auto-upload
        @media-upload-finish="successfulUpload"
        @media-upload-fail="onUploadFailed"
    />

    <sw-card-section
        v-if="!isLoading && acl.can('product.editor')"
        secondary
        slim
        divider="bottom"
    >
        <sw-media-upload-v2
            variant="regular"
            :upload-tag="uploadTag"
            :private-filesystem="true"
            :extension-accept="fileAccept"
            :disabled="disabled"
            :label="$t('sw-product.documentForm.documentsLabel')"
            default-folder="product_document"
            @media-upload-sidebar-open="onOpenMedia"
        />
    </sw-card-section>

    <div
        v-if="!isLoading"
        class="sw-product-document-form__content"
    >
        <sw-card-section v-if="!hasDocuments">
            <mt-empty-state
                class="sw-product-document-form__empty-state"
                :headline="$t('sw-product.documentForm.emptyState')"
                description=""
                :absolute="false"
            />
        </sw-card-section>

        <sw-data-grid
            v-else
            class="sw-product-document-form__grid"
            :data-source="productDocuments"
            :columns="documentColumns"
            :full-page="false"
            :show-selection="false"
            :show-settings="false"
            :show-actions="true"
            :allow-inline-edit="false"
            :allow-column-edit="false"
            :compact-mode="true"
            :plain-appearance="true"
        >
            <template #column-title="{ item }">
                <div class="sw-product-document-form__title-cell">
                    <mt-text-field
                        class="sw-product-document-form__title-field"
                        :model-value="item.title"
                        :placeholder="$t('sw-product.documentForm.placeholderTitle')"
                        :disabled="disabled || !acl.can('product.editor')"
                        @update:model-value="onChangeTitle(item, $event)"
                    />
                </div>
            </template>

            <template #column-fileName="{ item }">
                <span
                    v-tooltip="{
                        message: getFileName(item),
                        disabled: false,
                        width: 'auto'
                    }"
                    class="sw-product-document-form__file-name"
                >
                    {{ getFileName(item) }}
                </span>
            </template>

            <template #column-fileType="{ item }">
                {{ getFileType(item) }}
            </template>

            <template #column-fileSize="{ item }">
                {{ getFileSize(item) }}
            </template>

            <template #column-uploadedAt="{ item }">
                {{ createdAt(item) }}
            </template>

            <template #actions="{ item }">
                <sw-context-menu-item
                    :disabled="isFirstDocument(item) || disabled || !acl.can('product.editor')"
                    @click="onMoveDocument(item, -1)"
                >
                    {{ $t('sw-product.documentForm.contextMoveUp') }}
                </sw-context-menu-item>

                <sw-context-menu-item
                    :disabled="isLastDocument(item) || disabled || !acl.can('product.editor')"
                    @click="onMoveDocument(item, 1)"
                >
                    {{ $t('sw-product.documentForm.contextMoveDown') }}
                </sw-context-menu-item>

                <sw-context-menu-item
                    variant="danger"
                    :disabled="disabled || !acl.can('product.editor')"
                    @click="onRemoveDocument(item)"
                >
                    {{ $t('global.default.remove') }}
                </sw-context-menu-item>
            </template>
        </sw-data-grid>
    </div>

    <sw-loader v-else />
</div>
{% endblock %}
