{% block sw_product_document_remove_modal %}
<mt-modal-root
    :is-open="true"
    @change="!$event && $emit('close')"
>
    <mt-modal
        :title="languageName ? $t('sw-product.documentForm.removeLanguageVersionTitle', { language: languageName, name: documentTitle }) : $t('sw-product.documentForm.removeTitle', { name: documentTitle })"
        width="m"
    >
        <div class="sw-product-document-form__remove-content">
        {% block sw_product_document_form_remove_description %}
            <mt-text size="xs">
                {{ languageName ? $t('sw-product.documentForm.removeLanguageVersionDescription', { language: languageName }) : $t('sw-product.documentForm.removeDescription') }}
            </mt-text>
        {% endblock %}

        {% block sw_product_document_form_remove_from_variants %}
            <mt-checkbox
                v-if="hasVariants"
                :checked="removeFromVariants"
                class="sw-product-document-form__remove-from-variants"
                :label="$t('sw-product.documentForm.removeFromVariants')"
                :help-text="$t('sw-product.documentForm.applyToVariantsHelp')"
                :disabled="isDisabled"
                @update:checked="$emit('update:removeFromVariants', $event)"
            />
        {% endblock %}
            <mt-text
                size="xs"
            >
                {{ $t('sw-product.documentForm.draftHint') }}
            </mt-text>
        </div>
        <template #footer>
            <div class="sw-product-document-form__remove-footer">
                <mt-button
                    size="small"
                    variant="secondary"
                    @click="$emit('close')"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    class="sw-product-document-form__confirm-remove"
                    :variant="languageName ? 'primary' : 'critical'"
                    size="small"
                    :disabled="isDisabled"
                    @click="$emit('remove')"
                >
                    {{ $t('global.default.remove') }}
                </mt-button>
            </div>
        </template>
    </mt-modal>
</mt-modal-root>
{% endblock %}
