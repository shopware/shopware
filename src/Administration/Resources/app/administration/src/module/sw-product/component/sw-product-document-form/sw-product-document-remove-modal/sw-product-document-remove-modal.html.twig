{% block sw_product_document_remove_modal %}
<mt-modal-root
    :is-open="true"
    @change="!$event && !isRemoving && $emit('close')"
>
    <mt-modal
        :title="modalTitle"
        width="m"
    >
        <div class="sw-product-document-form__remove-content">
        {% block sw_product_document_form_remove_description %}
            <mt-text size="xs">
                {{ modalDescription }}
            </mt-text>
        {% endblock %}

        {% block sw_product_document_form_remove_from_variants %}
            <mt-checkbox
                v-if="hasVariants"
                v-model:checked="removeFromVariants"
                class="sw-product-document-form__remove-from-variants"
                :label="$t('sw-product.documentForm.removeFromVariants')"
                :help-text="$t('sw-product.documentForm.removeFromVariantsHelp')"
                :disabled="isDisabled"
            />
        {% endblock %}
            <mt-text
                size="xs"
            >
                {{ $t('sw-product.documentForm.draftHint') }}
            </mt-text>
        </div>
        <template #footer>
            <div class="sw-product-document-form__remove-footer">
                <mt-button
                    size="small"
                    variant="secondary"
                    :disabled="isRemoving"
                    @click="$emit('close')"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    class="sw-product-document-form__confirm-remove"
                    :variant="isSystemDefaultLanguage ? 'critical' : 'primary'"
                    size="small"
                    :disabled="isDisabled"
                    @click="remove"
                >
                    {{ $t('global.default.remove') }}
                </mt-button>
            </div>
        </template>
    </mt-modal>
</mt-modal-root>
{% endblock %}
