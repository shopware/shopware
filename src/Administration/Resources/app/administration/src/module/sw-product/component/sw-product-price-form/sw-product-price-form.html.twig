{% block sw_product_price_form %}
<div class="sw-product-price-form">
    {% block sw_product_price_form_tax_field %}
    <sw-container columns="1fr var(--scale-size-56) 1fr">
        <sw-inherit-wrapper
            v-if="!isLoading"
            ref="taxIdInheritation"
            v-model:value="product.taxId"
            :inherited-value="parentProduct.taxId"
            :disabled="!allowEdit"
            :has-parent="!!parentProduct.id"
            :help-text="taxRateHelpText"
            :label="$t('sw-product.priceForm.labelTaxRate')"
            class="sw-product-price-form__tax-rate"
            required
        >
            <template #content="{ currentValue, updateCurrentValue, isInherited }">
                <mt-select
                    name="sw-field--product-taxId"
                    :placeholder="$t('sw-product.priceForm.placeholderTaxRate')"
                    validation="required"
                    :disabled="isInherited || !allowEdit || undefined"
                    :model-value="currentValue"
                    :error="productTaxIdError"
                    :options="taxRateOptions"
                    @update:model-value="updateCurrentValue"
                />
            </template>
        </sw-inherit-wrapper>
    </sw-container>
    {% endblock %}

    {% block sw_product_price_form_display_prices %}
    <sw-inherit-wrapper
        v-if="!isLoading"
        v-model:value="product.price"
        label=" "
        class="sw-product-price-form__display-prices"
        :has-parent="!!parentProduct.id"
        :inherited-value="parentProduct.price"
        :disabled="!allowEdit"
        :custom-remove-inheritance-function="copyDefaultPrice"
        :custom-inheritation-check-function="isPriceInherited"
    >
        <template #content="{ currentValue, isInherited }">
            <h3 class="sw-product-price-form__section-title">
                {{ $t('sw-product.priceForm.displayPrices.title') }}
            </h3>
            <p class="sw-product-price-form__section-description">
                {{ $t('sw-product.priceForm.displayPrices.description') }}
            </p>

            <sw-list-price-field
                vertical
                hide-purchase-prices
                :price="currentValue || []"
                :tax-rate="productTaxRate"
                :disabled="isInherited || !allowEdit || undefined"
                :error="productPriceError ? productPriceError[0] : null"
                :currency="defaultCurrency"
                :show-setting-price="showModeSetting"
            />
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {% block sw_product_price_form_currency_link %}
    <a
        v-if="product.price"
        class="sw-product-price-form__currency-link"
        role="button"
        tabindex="0"
        @click.prevent="displayMaintainCurrencies = true"
        @keydown.enter.prevent="displayMaintainCurrencies = true"
    >
        {{ $t('sw-product.detailBase.linkMaintainCurrencyPrices') }}
        <mt-icon
            name="regular-long-arrow-right"
            size="var(--scale-size-16)"
        />
    </a>
    {% endblock %}

    {% block sw_product_price_form_purchase_prices %}
    <sw-inherit-wrapper
        v-if="!isLoading && showModeSetting"
        v-model:value="product.purchasePrices"
        label=" "
        class="sw-product-price-form__purchase-prices"
        :has-parent="!!parentProduct.id"
        :inherited-value="parentProduct.purchasePrices"
        :disabled="!allowEdit"
        :custom-remove-inheritance-function="copyDefaultPrice"
        :custom-inheritation-check-function="isPriceInherited"
    >
        <template #content="{ currentValue, updateCurrentValue, isInherited }">
            <h3 class="sw-product-price-form__section-title">
                {{ $t('sw-product.priceForm.purchasePrices.title') }}
            </h3>
            <p class="sw-product-price-form__section-description">
                {{ $t('sw-product.priceForm.purchasePrices.description') }}
            </p>

            <sw-purchase-price-field
                class="sw-product-price-form__purchase-prices-field"
                :error="productPurchasePricesError ? productPurchasePricesError[0] : null"
                :price="currentValue || []"
                :tax-rate="productTaxRate"
                :disabled="isInherited || !allowEdit || undefined"
                :currency="defaultCurrency"
                @update:value="updateCurrentValue"
            />
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {# @deprecated tag:v6.9.0 - Blocks will be removed #}
    {% block sw_product_price_form_fields %}
        {% block sw_product_price_form_price_field %}{% endblock %}
    {% endblock %}

    {# @deprecated tag:v6.9.0 - Blocks will be removed #}
    {% block sw_product_price_form_link %}
        {% block sw_product_price_form_advanced_prices_link %}{% endblock %}
        {% block sw_product_price_form_maintain_currencies_link %}{% endblock %}
    {% endblock %}

    {% block sw_product_price_form_maintain_currencies_modal %}
    <sw-maintain-currencies-modal
        v-if="displayMaintainCurrencies"
        variant="full"
        :currencies="currencies"
        :prices="product.price"
        :default-price="defaultPrice"
        :tax-rate="productTaxRate"
        :disabled="!allowEdit || undefined"
        @modal-close="onMaintainCurrenciesClose"
        @update-prices="updatePrices"
    />
    {% endblock %}
</div>
{% endblock %}
