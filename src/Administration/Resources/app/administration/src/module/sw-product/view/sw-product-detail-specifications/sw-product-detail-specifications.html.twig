{% block sw_product_detail_specifications %}
<div v-if="isLoading">
    <sw-skeleton />
    <sw-skeleton />
</div>

<div v-else>
    {% block sw_product_detail_specifications_measurement %}
    <mt-card
        v-if="showProductCard('measurement') && !isDigitalProduct"
        class="sw-product-detail-specification__measurement"
        position-identifier="sw-product-detail-specifications-measurement"
        :title="$t('sw-product.specifications.cardTitleMeasurement')"
    >
        {% block sw_product_detail_specifications_measurement_content %}
        <sw-product-measurement-form
            :allow-edit="acl.can('product.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_measures_packaging %}
    <mt-card
        v-if="showProductCard('selling_packaging') && !isDigitalProduct"
        class="sw-product-detail-specification__selling-packaging"
        position-identifier="sw-product-detail-specifications-measures-packaging"
        :title="$t('sw-product.specifications.cardTitleSellingPackaging')"
    >
        {% block sw_product_detail_specifications_measures_packaging_content %}
        <sw-product-packaging-form
            :show-setting-packaging="showModeSetting"
            :allow-edit="acl.can('product.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_property %}
    <sw-product-properties
        v-show="showProductCard('properties')"
    />
    {% endblock %}

    {% block sw_product_detail_specifications_documents %}
    <sw-inherit-wrapper
        ref="productDocumentInheritance"
        v-model:value="product.documents"
        class="sw-product-detail-specification__documents"
        :inherited-value="parentProduct.documents"
        :custom-restore-inheritance-function="documentsRestoreInheritanceFunction"
        :custom-remove-inheritance-function="documentsRemoveInheritanceFunction"
        is-association
    >
        <template #content="{ isInherited, isInheritField, restoreInheritance, removeInheritance }">
            <mt-card
                class="sw-product-detail-specification__documents-card"
                position-identifier="sw-product-detail-specifications-documents"
                :title="$t('sw-product.specifications.cardTitleDocuments')"
                :subtitle="$t('sw-product.specifications.cardSubtitleDocuments')"
                :class="{ 'sw-card__inherited': isInherited }"
            >
                <template #title>
                    <div
                        class="sw-inherit-wrapper__card-title"
                        :class="{ 'sw-inherit-wrapper__card-title--inherited': isInherited }"
                    >
                        <sw-inheritance-switch
                            v-if="isInheritField"
                            class="sw-inherit-wrapper__inheritance-icon"
                            :is-inherited="isInherited"
                            :disabled="!acl.can('product.editor')"
                            @inheritance-restore="restoreInheritance"
                            @inheritance-remove="removeInheritance"
                        />
                        <h3 class="mt-card__title">
                            {{ $t('sw-product.specifications.cardTitleDocuments') }}
                        </h3>
                    </div>
                </template>

                <sw-product-document-form
                    :key="isInherited"
                    :is-inherited="isInherited"
                    :disabled="isInherited || !acl.can('product.editor')"
                    @add-back="onDocumentAddBack"
                />
            </mt-card>
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {% block sw_product_detail_specifications_essential_characteristics %}
    <mt-card
        v-show="showProductCard('essential_characteristics')"
        class="sw-product-detail-specification__essential-characteristics"
        position-identifier="sw-product-detail-specifications-essential-characteristics"
        :title="$t('sw-product.specifications.cardTitleEssentialCharacteristics')"
    >
        {% block sw_product_detail_specifications_essential_characteristics_content %}
        <sw-product-feature-set-form :allow-edit="acl.can('product.editor')" />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_custom_products %}
    {% endblock %}

    {% block sw_product_detail_specifications_custom_fields %}
    <mt-card
        v-show="showCustomFieldsCard"
        class="sw-product-detail-specification__custom-fields"
        position-identifier="sw-product-detail-specifications-custom-fields"
        :title="$t('sw-product.specifications.cardTitleCustomFields')"
    >
        {% block sw_product_detail_specifications_custom_fields_content %}
        <sw-custom-field-set-renderer
            show-custom-field-set-selection
            :entity="product"
            :parent-entity="parentProduct"
            :sets="customFieldSets"
            :disabled="!acl.can('product.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}
</div>
{% endblock %}
