{% block sw_promotion_v2_settings_rule_selection %}
<div class="sw-promotion-v2-settings-rule-selection">

    {% block sw_promotion_v2_settings_rule_selection_description %}
    <sw-promotion-v2-wizard-description class="sw-promotion-v2-settings-rule-selection__description">
        {{ $t('sw-promotion-v2.detail.discounts.settings.ruleSelection.description') }}
    </sw-promotion-v2-wizard-description>
    {% endblock %}

    {% block sw_promotion_v2_settings_rule_selection_selection %}
    <sw-select-rule-create
        v-model:rules="discount.discountRules"
        :rule-filter="feature.isActive('v6.8.0.0') ? undefined : ruleCriteria"
        :rule-scope="['cart']"
        local-mode
        :label="$t('sw-promotion-v2.detail.discounts.settings.ruleSelection.labelSelection')"
        :placeholder="$t('sw-promotion-v2.detail.discounts.settings.ruleSelection.placeholderSelection')"
        :disabled="!acl.can('promotion.editor')"
    />
    {% endblock %}

</div>
{% endblock %}
