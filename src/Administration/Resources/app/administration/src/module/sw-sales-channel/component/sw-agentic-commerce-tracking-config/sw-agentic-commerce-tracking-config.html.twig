{% block sw_agentic_commerce_tracking_config %}
<mt-card
    :title="$tc('sw-sales-channel.agenticCommerceTracking.cardTitle')"
    class="sw-agentic-commerce-tracking-config"
    position-identifier="sw-agentic-commerce-tracking-config"
>
    {% block sw_agentic_commerce_tracking_config_description %}
    <p class="sw-agentic-commerce-tracking-config__description">
        {{ $tc('sw-sales-channel.agenticCommerceTracking.description') }}
    </p>
    {% endblock %}

    {% block sw_agentic_commerce_tracking_config_inherit %}
    <mt-switch
        :model-value="trackingConfig.inheritStorefrontTrackingCodes"
        :label="$tc('sw-sales-channel.agenticCommerceTracking.inheritLabel')"
        :help-text="$tc('sw-sales-channel.agenticCommerceTracking.inheritHelpText')"
        :disabled="disabled || undefined"
        @update:model-value="onInheritToggle"
    />
    {% endblock %}

    {% block sw_agentic_commerce_tracking_config_affiliate %}
    <mt-text-field
        :model-value="trackingConfig.affiliateCode"
        :label="$tc('sw-sales-channel.agenticCommerceTracking.affiliateCodeLabel')"
        :placeholder="$tc('sw-sales-channel.agenticCommerceTracking.affiliateCodePlaceholder')"
        :disabled="codesDisabled || undefined"
        @update:model-value="onAffiliateCodeChange"
    />
    {% endblock %}

    {% block sw_agentic_commerce_tracking_config_campaign %}
    <mt-text-field
        :model-value="trackingConfig.campaignCode"
        :label="$tc('sw-sales-channel.agenticCommerceTracking.campaignCodeLabel')"
        :placeholder="$tc('sw-sales-channel.agenticCommerceTracking.campaignCodePlaceholder')"
        :disabled="codesDisabled || undefined"
        @update:model-value="onCampaignCodeChange"
    />
    {% endblock %}
</mt-card>
{% endblock %}
