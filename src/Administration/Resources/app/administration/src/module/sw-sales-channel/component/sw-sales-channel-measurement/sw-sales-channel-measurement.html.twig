<sw-container
    columns="1fr 1fr 1fr"
    gap="0 30px"
>
    <sw-entity-single-select
        ref="measurementSystemSelect"
        v-model:value="salesChannel.measurementUnits.system"
        entity="measurement_system"
        :label="labelUnitSystem"
        :criteria="measurementSystemCriteria"
        @update:value="onMeasurementSystemChange"
    />

    <sw-entity-single-select
        v-model:value="salesChannel.measurementUnits.units.length"
        entity="measurement_display_unit"
        :popover-classes="['sw-sales-channel-measurement__selection-popover']"
        :label="labelLengthUnit"
        :label-callback="formatUnitLabel"
        :criteria="lengthUnitCriteria"
    >
        <template #selection-label-property="{ item }">
            {{ formatUnitLabel(item) }}
        </template>

        <template #result-label-property="{ item, searchTerm, highlightSearchTerm }">
            <sw-highlight-text
                :text="item.translated.name || item.name"
                :search-term="searchTerm"
            />
            <span class="sw-sales-channel-measurement__length-unit-short-name"> {{ item.shortName }}</span>
        </template>
    </sw-entity-single-select>

    <sw-entity-single-select
        v-model:value="salesChannel.measurementUnits.units.width"
        entity="measurement_display_unit"
        :popover-classes="['sw-sales-channel-measurement__selection-popover']"
        :label="labelWeightUnit"
        :criteria="weightUnitCriteria"
    >
        <template #selection-label-property="{ item }">
            {{ formatUnitLabel(item) }}
        </template>

        <template #result-label-property="{ item, searchTerm, highlightSearchTerm }">
            <sw-highlight-text
                :text="item.translated.name || item.name"
                :search-term="searchTerm"
            />
            <span class="sw-sales-channel-measurement__mass-unit-short-name"> {{ item.shortName }}</span>
        </template>
    </sw-entity-single-select>
</sw-container>
