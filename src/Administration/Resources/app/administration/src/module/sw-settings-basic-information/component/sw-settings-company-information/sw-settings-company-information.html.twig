{% block sw_settings_company_information %}
<div class="sw-settings-company-information">
    <div class="sw-settings-company-information__logo-row">
        <sw-media-compact-upload-v2
            class="sw-settings-company-information__media"
            name="sw-field--companyInfo-logoId"
            :source="currentValue.logoId"
            :label="$t('sw-settings-document.detail.labelCompanyLogo')"
            @media-upload-remove-image="currentValue.logoId = null"
            @selection-change="onChangeCompanyLogo"
        />
    </div>

    <sw-container
        class="sw-settings-company-information__form"
        columns="repeat(auto-fit, minmax(250px, 1fr))"
        gap="0px 30px"
    >

        <mt-text-field
            v-model="currentValue.companyName"
            name="companyInfoCompanyName"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyName')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyName')"
            required
        />

        <mt-text-field
            v-model="currentValue.companyEmail"
            name="companyInfoCompanyEmail"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyEmail')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyEmail')"
        />

        <mt-text-field
            v-model="currentValue.companyPhone"
            name="companyInfoCompanyPhone"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyPhone')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyPhone')"
        />

        <mt-text-field
            v-model="currentValue.companyStreet"
            name="companyInfoCompanyStreet"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyStreet')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyStreet')"
            required
        />

        <sw-entity-single-select
            v-model:value="currentValue.companyCountryId"
            name="companyInfoCompanyCountryId"
            entity="country"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyCountry')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyCountry')"
            required
            show-clearable-button
        />

        <mt-text-field
            v-model="currentValue.companyZipcode"
            name="companyInfoCompanyZipcode"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyZipcode')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyZipcode')"
            required
        />

        <mt-text-field
            v-model="currentValue.companyCity"
            name="companyInfoCompanyCity"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyCity')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyCity')"
            required
        />

        <mt-url-field
            v-model="currentValue.companyUrl"
            name="companyInfoCompanyUrl"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelCompanyUrl')"
            :placeholder="$t('sw-settings-document.detail.placeholderCompanyUrl')"
        />

        <mt-text-field
            v-model="currentValue.taxNumber"
            name="companyInfoTaxNumber"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelTaxNumber')"
            :placeholder="$t('sw-settings-document.detail.placeholderTaxNumber')"
        />

        <mt-text-field
            v-model="currentValue.taxOffice"
            name="companyInfoTaxOffice"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelTaxOffice')"
            :placeholder="$t('sw-settings-document.detail.placeholderTaxOffice')"
        />

        <mt-text-field
            v-model="currentValue.vatId"
            name="companyInfoVatId"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelVatId')"
            :placeholder="$t('sw-settings-document.detail.placeholderVatId')"
        />

        <mt-text-field
            v-model="currentValue.bankName"
            name="companyInfoBankName"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelBankName')"
            :placeholder="$t('sw-settings-document.detail.placeholderBankName')"
        />

        <mt-text-field
            v-model="currentValue.bankIban"
            name="companyInfoBankIban"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelBankIban')"
            :placeholder="$t('sw-settings-document.detail.placeholderBankIban')"
        />

        <mt-text-field
            v-model="currentValue.bankBic"
            name="companyInfoBankBic"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelBankBic')"
            :placeholder="$t('sw-settings-document.detail.placeholderBankBic')"
        />

        <mt-text-field
            v-model="currentValue.placeOfJurisdiction"
            name="companyInfoPlaceOfJurisdiction"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelPlaceOfJurisdiction')"
            :placeholder="$t('sw-settings-document.detail.placeholderPlaceOfJurisdiction')"
        />

        <mt-text-field
            v-model="currentValue.placeOfFulfillment"
            name="companyInfoPlaceOfFulfillment"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelPlaceOfFulfillment')"
            :placeholder="$t('sw-settings-document.detail.placeholderPlaceOfFulfillment')"
        />

        <mt-text-field
            v-model="currentValue.executiveDirector"
            name="companyInfoExecutiveDirector"
            :disabled="disabled"
            :label="$t('sw-settings-document.detail.labelExecutiveDirector')"
            :placeholder="$t('sw-settings-document.detail.placeholderExecutiveDirector')"
        />
    </sw-container>
</div>
{% endblock %}
