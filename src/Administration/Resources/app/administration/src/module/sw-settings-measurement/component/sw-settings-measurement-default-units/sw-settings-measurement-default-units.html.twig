<mt-card
    class="sw-settings-measurement-default-units"
    position-identifier="sw-settings-measurement-default-units"
    :title="$t('sw-settings-measurement.defaultUnits.title')"
>
    <p class="sw-settings-measurement-default-units__description">
        {{ $t('sw-settings-measurement.defaultUnits.description') }}
    </p>

    <sw-container
        columns="1fr 1fr 1fr"
        gap="0 32px"
    >
        <sw-entity-single-select
            v-model:value="measurementSystem.typeId"
            entity="measurement_system"
            :label="$t('sw-settings-measurement.defaultUnits.config.type')"
            :label-callback="labelSystemCallback"
            @update:value="onChangeMeasurementSystem"
        >
            <template #selection-label-property="{ item }">
                {{ labelSystemCallback(item) }}
            </template>
        </sw-entity-single-select>

        <sw-entity-single-select
            v-model:value="measurementSystem.lengthUnitId"
            entity="measurement_display_unit"
            :criteria="lengthUnitCriteria"
            :label="$t('sw-settings-measurement.defaultUnits.config.lengthUnit')"
            :label-callback="labelUnitCallback"
        >
            <template #selection-label-property="{ item }">
                {{ labelUnitCallback(item) }}
            </template>
        </sw-entity-single-select>

        <sw-entity-single-select
            v-model:value="measurementSystem.massUnitId"
            entity="measurement_display_unit"
            :criteria="massUnitCriteria"
            :label="$t('sw-settings-measurement.defaultUnits.config.massUnit')"
            :label-callback="labelUnitCallback"
        >
            <template #selection-label-property="{ item }">
                {{ labelUnitCallback(item) }}
            </template>
        </sw-entity-single-select>
    </sw-container>
</mt-card>
