{% block sw_settings_message_stats %}
<sw-page class="sw-settings-message-stats">
    <template #smart-bar-header>
        <h2>{{ $tc('sw-settings-message-stats.general.mainMenuItemGeneral') }}</h2>
    </template>

    <template #smart-bar-actions>
        <mt-button
            :is-loading="isLoading"
            :disabled="isLoading"
            variant="primary"
            @click="loadStats"
        >
            {{ $tc('sw-settings-message-stats.general.refreshButton') }}
        </mt-button>
    </template>

    <template #content>
        <mt-banner
            v-if="!isBannerHidden"
            :title="$tc('sw-settings-message-stats.general.bannerTitle')"
            variant="info"
            :closable="true"
            @close="onCloseBanner"
        >
            <p style="white-space: pre-line">
                {{ $tc('sw-settings-message-stats.general.bannerDescription') }}
            </p>
        </mt-banner>

        <sw-card-view>
            <template v-if="isLoading">
                <sw-skeleton />
                <sw-skeleton />
            </template>

            <template v-else-if="!hasStats">
                <sw-empty-state
                    :title="$tc('sw-settings-message-stats.general.emptyStateTitle')"
                    :subline="$tc('sw-settings-message-stats.general.emptyStateSubline')"
                    icon="regular-chart-line"
                >
                    <template #actions>
                        <mt-button
                            variant="primary"
                            @click="loadStats"
                        >
                            {{ $tc('sw-settings-message-stats.general.refreshButton') }}
                        </mt-button>
                    </template>
                </sw-empty-state>
            </template>

            <template v-else>
                <mt-card
                    position-identifier="sw-settings-message-stats-overview"
                    :title="$tc('sw-settings-message-stats.general.statsCardTitle')"
                    :is-loading="isLoading"
                >
                    <div class="sw-settings-message-stats__stats-grid">
                        <div
                            class="sw-settings-message-stats__stat-item"
                            v-tooltip="{
                                message: $tc('sw-settings-message-stats.general.totalMessagesHelp'),
                                width: 400,
                            }"
                        >
                            <div class="sw-settings-message-stats__stat-header">
                                <mt-icon name="regular-analytics" />
                                {{ $tc('sw-settings-message-stats.general.totalMessages') }}
                                <mt-icon name="solid-question-circle" size="16" color="#189eff" />
                            </div>
                            <p class="sw-settings-message-stats__value">
                                {{ stats.totalMessagesProcessed }}
                            </p>
                        </div>

                        <div
                            class="sw-settings-message-stats__stat-item"
                            v-tooltip="{
                                message: $tc('sw-settings-message-stats.general.averageTimeHelp'),
                                width: 400,
                            }"
                        >
                            <div class="sw-settings-message-stats__stat-header">
                                <mt-icon name="regular-clock" />
                                {{ $tc('sw-settings-message-stats.general.averageTime') }}
                                <mt-icon name="solid-question-circle" size="16" color="#189eff" />
                            </div>
                            <p class="sw-settings-message-stats__value">
                                {{ stats.averageTimeInQueue }}
                            </p>
                        </div>

                        <div
                            class="sw-settings-message-stats__stat-item"
                            v-tooltip="{
                                message: $tc('sw-settings-message-stats.general.processingWindowHelp'),
                                width: 400,
                            }"
                        >
                            <div class="sw-settings-message-stats__stat-header">
                                <mt-icon name="regular-calendar" />
                                {{ $tc('sw-settings-message-stats.general.processingWindow') }}
                                <mt-icon name="solid-question-circle" size="16" color="#189eff" />
                            </div>
                            <p class="sw-settings-message-stats__value">
                                {{ formattedProcessedSince }}
                            </p>
                        </div>
                    </div>
                </mt-card>

                <mt-card
                    position-identifier="sw-settings-message-stats-types"
                    :title="$tc('sw-settings-message-stats.general.messageTypes')"
                    :is-loading="isLoading"
                >
                    <template #headerRight>
                        <sw-help-text :text="$tc('sw-settings-message-stats.general.messageTypesHelp')" />
                    </template>
                    <sw-data-grid
                        :data-source="stats.messageTypeStats"
                        :columns="columns"
                        :show-selection="false"
                        :show-actions="false"
                    >
                        <template #column-type="{ item }">
                            <div>
                                {{ item.type }}
                            </div>
                        </template>
                        <template #column-count="{ item }">
                            <div>
                                {{ item.count }}
                            </div>
                        </template>
                    </sw-data-grid>
                </mt-card>
            </template>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
