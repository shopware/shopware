{% block sw_settings_search_view_live_search_card %}
<mt-card
    class="sw-settings-search-live-search"
    position-identifier="sw-settings-search-live-search"
    :title="$t('sw-settings-search.liveSearchTab.titleCard')"
>
    {% block sw_settings_search_view_live_search_rebuild_index_row %}
    <div class="sw-settings-search-live-search__rebuild-index-row">
        {% block sw_settings_search_view_live_search_description %}
        <div class="sw-settings-search-live-search__description">
            {{ $t('sw-settings-search.liveSearchTab.textDescription') }}
        </div>
        {% endblock %}

        {% block sw_settings_search_view_live_search_show_example_link %}
        <mt-link
            as="button"
            class="sw-settings-search-live-search__show-example-link"
            @click="onShowExampleModal"
        >
            {{ $t('sw-settings-search.generalTab.linkExample') }}
        </mt-link>
        {% endblock %}

        {% block sw_settings_search_searchable_show_example_modal %}
        <sw-settings-search-example-modal
            v-if="showExampleModal"
            @modal-close="onCloseExampleModal"
        />
        {% endblock %}
    </div>
    {% endblock %}

    {% block sw_settings_search_view_live_search_sales_channel %}
    <sw-single-select
        class="sw-settings-search-live-search__sales-channel-select"
        value-property="id"
        label-property="translated.name"
        :placeholder="$t('sw-settings-search.liveSearchTab.textPlaceholderSalesChannel')"
        :label="$t('sw-settings-search.liveSearchTab.labelSalesChannelSelect')"
        :value="salesChannelId"
        :options="salesChannels"
        show-clearable-button
        @update:value="changeSalesChannel"
    />
    {% endblock %}

    {% block sw_settings_search_view_live_search_input %}
    <sw-container
        class="sw-settings-search-live-search__search-container"
        columns="1fr calc(var(--scale-size-224) + var(--scale-size-26))"
        gap="var(--scale-size-16)"
    >
        <sw-simple-search-field
            v-model:value="liveSearchTerm"
            class="sw-settings-search-live-search__search_box"
            variant="form"
            :delay="1000"
            :disabled="!isSearchEnable || undefined"
            @search-term-change="searchOnStorefront"
        >
            {# @deprecated tag:v6.8.0 - Will be removed. #}
            {% block sw_settings_search_view_live_search_search_icon_wrapper %}
            <template #sw-simple-search-field-icon>
                {# @deprecated tag:v6.8.0 - Will be removed. #}
                {% block sw_settings_search_view_live_search_search_icon %}
                {% endblock %}
            </template>
            {% endblock %}

        </sw-simple-search-field>

        <mt-select
            v-model="productSortingKey"
            class="sw-settings-search-live-search__sorting-select"
            value-property="key"
            label-property="translated.label"
            :placeholder="$t('sw-settings-search.liveSearchTab.textPlaceholderSorting')"
            :options="productSortings"
            :disabled="!isSearchEnable || undefined"
            @update:model-value="searchOnStorefront"
        />
    </sw-container>
    {% endblock %}

    {% block sw_settings_search_view_live_search_results %}
    <div class="sw-settings-search-live-search__search-results">
        {% block sw_search_bar_results_empty_state %}
        <div
            v-if="searchInProgress"
            class="sw-settings-search-live-search__search-results-loader"
        >
            <mt-loader />
        </div>
        {% endblock %}

        {% block sw_settings_search_view_live_search_results_search_grid %}
        <sw-data-grid
            v-else-if="products && products.length > 0"
            class="sw-settings-search-live-search__grid-result"
            :show-selection="false"
            :show-actions="false"
            :data-source="products"
            :is-loading="searchInProgress"
            :columns="searchColumns"
        >
            {% block sw_settings_search_view_live_search_results_search_grid_columns %}
            {% block sw_settings_search_view_live_search_results_search_grid_score_label %}
            <template #column-label-score="{ column }">
                <span class="sw-settings-search-live-search__score-label">
                    {{ column.label }}
                    <sw-help-text
                        class="sw-settings-search-live-search__score-help"
                        :text="$t('sw-settings-search.liveSearchTab.scoreHelpText')"
                    />
                </span>
            </template>
            {% endblock %}

            {% block sw_settings_search_view_live_search_results_search_grid_name %}
            <template #column-name="{ item }">
                <sw-product-variant-info
                    :variations="item.variation"
                    :show-tooltip="false"
                >
                    <sw-settings-search-live-search-keyword
                        :text="(item.name || item.translated.name)"
                        :search-term="liveSearchTerm"
                    />
                </sw-product-variant-info>
            </template>
            {% endblock %}

            {% block sw_settings_search_view_live_search_results_search_grid_score %}
            <template #column-score="{ item }">
                <component
                    :is="hasExplain(item) ? 'button' : 'div'"
                    type="button"
                    class="sw-settings-search-live-search__score"
                    :class="{ 'is--clickable': hasExplain(item), 'is--open': isExplainOpen(item) }"
                    @click="hasExplain(item) && toggleExplain(item)"
                >
                    <span class="sw-settings-search-live-search__score-rank">#{{ getRank(item) }}</span>
                    <span class="sw-settings-search-live-search__score-bar">
                        <span
                            class="sw-settings-search-live-search__score-bar-fill"
                            :style="{ width: getScoreBarWidth(item) }"
                        ></span>
                    </span>
                    <span class="sw-settings-search-live-search__score-value">{{ formatScore(getScoreValue(item)) }}</span>
                    <mt-icon
                        v-if="hasExplain(item)"
                        class="sw-settings-search-live-search__score-caret"
                        :name="isExplainOpen(item) ? 'regular-chevron-up-xs' : 'regular-chevron-down-xs'"
                        size="12px"
                    />
                </component>
            </template>
            {% endblock %}
            {% endblock %}
        </sw-data-grid>
        {% endblock %}

        {% block sw_settings_search_view_live_search_results_no_result %}
        <mt-empty-state
            v-else
            class="sw-settings-search-live-search__no-result"
            :icon="$route.meta.$module.icon"
            :headline="$t('sw-settings-search.liveSearchTab.textNoResult')"
            :description="$t('sw-settings-search.liveSearchTab.textNoResultDescription')"
        />
        {% endblock %}

        {% block sw_settings_search_view_live_search_results_explain %}
        <div
            v-if="selectedExplainBreakdown"
            class="sw-settings-search-live-search__explain"
        >
            <div class="sw-settings-search-live-search__explain-header">
                <span class="sw-settings-search-live-search__explain-title">
                    {{ $t('sw-settings-search.liveSearchTab.explainTitle') }}<template v-if="selectedExplainName"> · {{ selectedExplainName }}</template>
                </span>
                <span class="sw-settings-search-live-search__explain-total">
                    {{ $t('sw-settings-search.liveSearchTab.totalScore') }}: {{ formatScore(selectedExplainBreakdown.total) }}
                    <sw-help-text
                        class="sw-settings-search-live-search__explain-total-help"
                        :text="$t('sw-settings-search.liveSearchTab.scoreHelpText')"
                    />
                </span>
            </div>

            <p
                v-if="scoresAreUniform"
                class="sw-settings-search-live-search__explain-hint"
            >
                {{ $t('sw-settings-search.liveSearchTab.uniformScoresHint') }}
            </p>

            <div
                v-for="(section, sectionIndex) in selectedExplainBreakdown.sections"
                :key="sectionIndex"
                class="sw-settings-search-live-search__explain-section"
            >
                <h5 class="sw-settings-search-live-search__explain-section-title">{{ section.label }}</h5>

                <div
                    v-for="(row, rowIndex) in section.rows"
                    :key="rowIndex"
                    class="sw-settings-search-live-search__explain-row"
                >
                    <div class="sw-settings-search-live-search__explain-row-head">
                        <span class="sw-settings-search-live-search__explain-row-label">{{ fieldLabel(row.label) }}</span>
                        <span
                            v-if="row.ranking !== null && row.ranking !== undefined"
                            class="sw-settings-search-live-search__explain-row-weight"
                        >{{ $t('sw-settings-search.liveSearchTab.weight') }} {{ row.ranking }}</span>
                    </div>

                    <div
                        v-for="(signal, signalIndex) in row.signals"
                        :key="signalIndex"
                        class="sw-settings-search-live-search__explain-signal"
                    >
                        <span class="sw-settings-search-live-search__explain-signal-label">
                            <span
                                v-if="signal.type"
                                v-tooltip="explainTypeTooltip(signal.type)"
                                class="sw-settings-search-live-search__explain-row-type"
                            >{{ explainTypeLabel(signal.type) }}</span>
                            <span
                                v-if="signal.term"
                                class="sw-settings-search-live-search__explain-signal-term"
                            >“{{ signal.term }}”</span>
                            <span
                                v-if="signal.context"
                                class="sw-settings-search-live-search__explain-signal-context"
                            >{{ signal.context.whole
                                ? $t('sw-settings-search.liveSearchTab.partialContextWhole', { word: signal.context.word })
                                : $t('sw-settings-search.liveSearchTab.partialContext', { fragment: signal.context.fragment, word: signal.context.word }) }}</span>
                        </span>
                        <span class="sw-settings-search-live-search__explain-signal-bar">
                            <span
                                class="sw-settings-search-live-search__explain-signal-bar-fill"
                                :style="{ width: signal.barWidth }"
                            ></span>
                        </span>
                        <span class="sw-settings-search-live-search__explain-signal-score">{{ signal.score }}</span>
                    </div>
                </div>
            </div>
        </div>
        {% endblock %}
    </div>
    {% endblock %}
</mt-card>
{% endblock %}
