<li
    v-if="variant === 'card'"
    class="sw-settings-services-service-card"
>
    <div class="sw-settings-services-service-card__header">
        <img
            :src="service.icon"
            :alt="`Icon for ${service.name}`"
            class="sw-settings-services-service-card__icon"
        >

        <div>
            <h4>{{ service.name }}</h4>
            <sw-status
                :color="serviceStatus"
            >
                {{ $t(statusText) }}
            </sw-status>
        </div>
    </div>

    <div class="sw-settings-services-service-card__description">
        {{  service.description }}
    </div>

    <div class="sw-settings-services-service-card__footer">
        {{  $t('sw-settings-services.service-card.updatedAtLabel', { updatedAt: service.lastUpdatedAt.toLocaleDateString() }) }}
        •
        {{ $t('sw-settings-services.service-card.version', { version: service.version }) }}
    </div>
</li>
<li
    v-else-if="variant === 'list'"
    class="sw-settings-services-service-card__list-item"
>
    <h4 class="sw-settings-services__list-item-name">
        {{ service.name }}
    </h4>

    <sw-status :color="serviceStatus">
        {{ $t(statusText) }}
    </sw-status>

    <div class="sw-settings-services__list-item-meta-data">
        {{  $t('sw-settings-services.service-card.updatedAtLabel', { updatedAt: service.lastUpdatedAt.toLocaleDateString() }) }}
        •
        {{ $t('sw-settings-services.service-card.version', { version: service.version }) }}
    </div>
</li>