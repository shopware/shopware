<sw-page class="sw-settings-services-index">
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings.index.tabSystem') }}
            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />
            {{ $t('sw-settings-services.general.title') }}
        </h2>
    </template>

    <template
        v-if="!suspended"
        #content
    >
        <sw-extension-component-section
            position-identifier="sw-settings-services-header"
        />

        <sw-settings-services-hero
            :documentation-link="currentRevision.links['docs-url']"
            :feedback-link="currentRevision.links['feedback-url']"
        />

        <sw-extension-component-section
            position-identifier="sw-settings-services-content__before"
        />

        <div class="sw-settings-services-index__content">
            <sw-settings-services-grant-permissions-card
                v-if="!consentGiven && !config.disabled && services.length > 0"
                :docs-link="currentRevision.links['docs-url']"
            />

            <div class="sw-settings-services__listing-section">
                <h3>
                    {{ $t('sw-settings-services.index.available-services') }}
                </h3>

                <mt-banner
                    v-if="loadingError !== ''"
                    variant="critical"
                >
                    <p><b>{{ $t('sw-settings-services.exception.service-list') }}</b></p>

                    <p>{{ loadingError }}</p>
                </mt-banner>

                <mt-banner
                    v-if="!servicesEnabled"
                    class="sw-settings-services-index__services-turned-off-banner"
                    variant="attention"
                >
                    <p><b>{{ $t('sw-settings-services.index.turned-off.title') }}</b></p>

                    <i18n-t
                        v-if="servicesAutoEnabled"
                        keypath="sw-settings-services.index.turned-off.reason-auto"
                        tag="p"
                    >
                        <template #enableServices>
                            <code>ENABLE_SERVICES=auto</code>
                        </template>

                        <template #requiredAppEnv>
                            <code>APP_ENV=prod</code>
                        </template>

                        <template #appEnv>
                            <code>APP_ENV={{ status.appEnv }}</code>
                        </template>
                    </i18n-t>

                    <i18n-t
                        v-else
                        keypath="sw-settings-services.index.turned-off.reason-disabled"
                        tag="p"
                    >
                        <template #enableServices>
                            <code>ENABLE_SERVICES={{ status.enableServices }}</code>
                        </template>
                    </i18n-t>

                    <p>{{ $t('sw-settings-services.index.turned-off.options-intro') }}</p>

                    <ul class="sw-settings-services-index__debug-options">
                        <i18n-t
                            keypath="sw-settings-services.index.turned-off.option-enable"
                            tag="li"
                        >
                            <template #enableServices>
                                <code>ENABLE_SERVICES=true</code>
                            </template>
                        </i18n-t>

                        <i18n-t
                            v-if="servicesAutoEnabled"
                            keypath="sw-settings-services.index.turned-off.option-prod"
                            tag="li"
                        >
                            <template #requiredAppEnv>
                                <code>APP_ENV=prod</code>
                            </template>
                        </i18n-t>
                    </ul>

                    <i18n-t
                        keypath="sw-settings-services.index.turned-off.install-hint"
                        tag="p"
                    >
                        <template #command>
                            <code>bin/console services:install</code>
                        </template>
                    </i18n-t>
                </mt-banner>

                <mt-banner
                    v-if="servicesEnabled && config.disabled"
                    class="sw-settings-services-index__services-deactivated-banner"
                    variant="attention"
                >
                    <p><b>{{ $t('sw-settings-services.index.services-are-disabled') }}</b></p>

                    <p>{{ $t('sw-settings-services.index.services-are-disabled-cta') }}</p>

                    <mt-button
                        variant="primary"
                        size="small"
                        @click="activateServices"
                    >
                        {{ $t('sw-settings-services.index.services-are-disabled-button-label') }}
                    </mt-button>
                </mt-banner>

                <mt-banner
                    v-if="installationStalled && installing"
                    class="sw-settings-services-index__installation-stalled-banner"
                    variant="info"
                >
                    <p><b>{{ $t('sw-settings-services.index.installation-stalled.title') }}</b></p>

                    <p>{{ $t('sw-settings-services.index.installation-stalled.description') }}</p>

                    <ul class="sw-settings-services-index__debug-options">
                        <i18n-t
                            keypath="sw-settings-services.index.installation-stalled.option-workers"
                            tag="li"
                        >
                            <template #command>
                                <code>bin/console messenger:consume async</code>
                            </template>
                        </i18n-t>

                        <i18n-t
                            keypath="sw-settings-services.index.installation-stalled.option-install"
                            tag="li"
                        >
                            <template #command>
                                <code>bin/console services:install</code>
                            </template>
                        </i18n-t>
                    </ul>

                    <mt-button
                        variant="secondary"
                        size="small"
                        @click="checkInstallationProgress"
                    >
                        {{ $t('sw-settings-services.index.installation-stalled.button-check-again') }}
                    </mt-button>
                </mt-banner>

                <div
                    v-if="installing && services.length === 0 && pendingServices.length === 0"
                    class="sw-settings-services-index__installing-card"
                >
                    <div class="sw-settings-services-index__installing-card-loader">
                        <mt-loader size="var(--scale-size-32)" />
                    </div>

                    <p class="sw-settings-services-index__installing-card-title">
                        {{ $t('sw-settings-services.index.installing-services-title') }}
                    </p>

                    <p>{{ $t('sw-settings-services.index.installing-services-description') }}</p>
                </div>

                <ul
                    v-if="services.length > 0 || pendingServices.length > 0"
                    class="sw-settings-services__available-services"
                >
                    <sw-settings-services-service-card
                        v-for="service in services"
                        :key="service.name"
                        :service="service"
                    />

                    <li
                        v-for="pendingService in pendingServices"
                        :key="pendingService.name"
                        class="sw-settings-services-index__pending-service"
                    >
                        <div class="sw-settings-services-index__pending-service-loader">
                            <mt-loader size="var(--scale-size-24)" />
                        </div>

                        <div>
                            <h4>{{ pendingService.label }}</h4>

                            <p>{{ $t('sw-settings-services.index.pending-service-description') }}</p>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="sw-settings-services__footer">
                <a
                    class="mt-link--external"
                    :href="currentRevision.links['docs-url']"
                    target="_blank"
                >
                    {{ $t('sw-settings-services.index.label-documentation-link') }}
                </a>

                <a
                    class="mt-link--external"
                    :href="currentRevision.links['tos-url']"
                    target="_blank"
                >
                    {{ $t('sw-settings-services.index.label-tos-link') }}
                </a>

                <sw-settings-services-revoke-permissions-modal
                    v-if="!config.disabled && config.permissionsConsent"
                    :services-with-account-requirement="servicesWithAccountRequirement"
                />

                <sw-settings-services-deactivate-modal
                    v-if="!config.disabled"
                    :services-with-account-requirement="servicesWithAccountRequirement"
                    :feedback-link="currentRevision.links['feedback-url']"
                />
            </div>
        </div>

        <sw-extension-component-section
            position-identifier="sw-settings-services-footer"
        />
    </template>
</sw-page>
