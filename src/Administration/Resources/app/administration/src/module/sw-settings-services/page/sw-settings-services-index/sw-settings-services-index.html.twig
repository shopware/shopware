<sw-page class="sw-settings-services-index">
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings.index.tabSystem') }}
            <mt-icon
                    name="regular-chevron-right-xs"
                    size="12px"
            />
            {{ $t('sw-settings-services.general.title') }}
        </h2>
    </template>

    <template
        v-if="!suspended"
        #content
    >
        <sw-settings-services-hero
            :documentation-link="legalDocuments.documentationLink"
            :feedback-link="legalDocuments.feedbackLink"
        />

        <div style="padding: 40px">
            <mt-card
                v-if="!consentGiven"
                class="sw-settings-services-index__grant-permission-card"
            >
                <div class="sw-settings-services-index__image">
                    <img
                        :src="grantPermissionsCardBackground"
                        alt=""
                    >
                </div>

                <h3>{{ $t("sw-settings-services.grant-permissions.title") }}</h3>

                <p>{{ $t("sw-settings-services.grant-permissions.description") }}</p>

                <mt-button
                    variant="primary"
                    @click="grantPermissions"
                >
                    {{  $t("sw-settings-services.grant-permissions.label-button-grant-permissions") }}
                </mt-button>

                <mt-link
                    variant="primary"
                    as="a"
                    type="external"
                    :href="legalDocuments.tosLink"
                    target="_blank"
                >
                    {{ $t("sw-settings-services.grant-permissions.label-link-more-information") }}
                </mt-link>
            </mt-card>

            <mt-banner
                v-if="areServicesDeactivated"
                class="sw-settings-services-index__services-deactivated-banner"
                variant="attention"
            >
                <p><b>Shopware Services are deactivated</b></p>

                <p>You are currently missing out on all Shopware Services, including advanced AI tools and much more. Activate Shopware Services to take advantage of all the current and future Services we have to offer.</p>

                <mt-button
                    variant="primary"
                    size="small"
                    @click="activateServices"
                >
                    Activate Services
                </mt-button>
            </mt-banner>

            <div class="sw-settings-services__listing-section">
                <h3>
                    {{ $t('sw-settings-services.index.optional-services') }}

                    <sw-help-text :text="$t('sw-settings-services.index.optional-services-tooltip')" />
                </h3>

                <ul class="sw-settings-services__optional-services">
                    <sw-settings-services-service-card
                        v-for="service in optionalServices"
                        :key="service.name"
                        :service="service"
                        :consent-given="consentGiven"
                        variant="card"
                    />
                </ul>

                <h3>
                    {{ $t('sw-settings-services.index.default-services') }}

                    <sw-help-text :text="$t('sw-settings-services.index.default-services-tooltip')" />
                </h3>

                <ul class="sw-settings-services__default-services">
                    <sw-settings-services-service-card
                        v-for="service in defaultServices"
                        :key="service.name"
                        :service="service"
                        :consent-given="consentGiven"
                        variant="list"
                    />
                </ul>
            </div>

            <div class="sw-settings-services__footer">
                <a
                    class="mt-link--external"
                    :href="legalDocuments.documentationLink"
                    target="_blank"
                >
                    {{ $t('sw-settings-services.index.label-documentation-link') }}
                </a>

                <a
                    class="mt-link--external"
                    :href="legalDocuments.tosLink"
                    target="_blank"
                >
                    {{ $t('sw-settings-services.index.label-tos-link') }}
                </a>

                <sw-settings-services-revoke-permissions-modal :optional-services="optionalServices" />

                <sw-settings-services-deactivate-modal :feedback-link="legalDocuments.feedbackLink" />
            </div>
        </div>
    </template>
</sw-page>