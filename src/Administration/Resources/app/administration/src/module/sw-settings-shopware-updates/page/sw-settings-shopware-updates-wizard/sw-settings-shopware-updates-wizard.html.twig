{% block sw_settings_shopware_updates_wizard %}
<sw-page class="sw-settings-shopware-updates-wizard">
    {% block sw_settings_shopware_updates_wizard_smart_bar_header %}
    <template #smart-bar-header>
        <h2 v-if="updateInfo.version">
            {{ $t('sw-settings-shopware-updates.general.title', {version: updateInfo.version }) }}
        </h2>
        <h2 v-if="!updateInfo.version">
            {{ $t('sw-settings-shopware-updates.general.emptyTitle') }}
        </h2>
    </template>
    {% endblock %}

    {% block sw_settings_shopware_updates_wizard_smart_bar_actions %}
    <template #smart-bar-actions>
        <div
            :key="updatePossible"
            v-tooltip="updateButtonTooltip"
        >
            <mt-button
                v-if="updateInfo.version"
                :disabled="!updatePossible"
                :is-loading="updaterIsRunning"
                variant="primary"
                class="sw-settings-shopware-updates-wizard__start-update"
                size="default"
                @click="updateModalShown = true"
            >
                {{ $t('sw-settings-shopware-updates.infos.startUpdate') }}
            </mt-button>
        </div>
    </template>
    {% endblock %}

    <template #content>
        <div class="sw-settings-shopware-updates-wizard__content">
        {% block sw_settings_shopware_updates_wizard_content %}
            <sw-card-view v-if="isLoading || updateInfo.version">
                <sw-settings-shopware-updates-info
                    v-if="updateInfo"
                    :is-loading="isLoading"
                    :changelog="updateInfo.body"
                />
                <sw-settings-shopware-updates-requirements
                    :is-loading="isLoading"
                    :update-info="updateInfo"
                    :requirements="requirements"
                />
                <sw-settings-shopware-updates-plugins
                    :plugins="plugins"
                    :is-loading="isLoading"
                />
            </sw-card-view>

            <mt-empty-state
                v-if="!isLoading && !updateInfo.version"
                :centered="true"
                :icon="$route.meta.$module.icon"
                :headline="$t('sw-settings-shopware-updates.general.emptyState')"
            />

            <sw-modal
                v-if="updaterIsRunning"
                :title="$t('sw-settings-shopware-updates.cards.updating')"
                variant="small"
                class="sw-shopware-updates-progressbar"
            >
                <div class="progress-wrapper">
                    <mt-progress-bar
                        :model-value="progressbarValue"
                        :max-value="100"
                    />
                    <span class="progress-title">
                        <p v-if="step === 'download'">{{ $t('sw-settings-shopware-updates.infos.progress.download') }}</p>
                        <p v-if="step === 'unpack'">{{ $t('sw-settings-shopware-updates.infos.progress.unpack') }}</p>
                        <p v-if="step === 'deactivate'">{{ $t('sw-settings-shopware-updates.infos.progress.deactivate') }}</p>
                    </span>
                </div>
            </sw-modal>

            <sw-modal
                v-if="updateModalShown"
                class="sw-settings-shopware-updates-check__start-update"
                :title="$t('sw-settings-shopware-updates.methodModal.title')"
                :subtitle="$t('sw-settings-shopware-updates.methodModal.subtitle')"
                @modal-close="updateModalShown = false"
            >
                {% block sw_settings_shopware_updates_wizard_method_warnings %}
                <mt-banner
                    v-if="displayUnknownPluginsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-shopware-updates.updateModal.messageNotInStore') }}
                </mt-banner>

                <mt-banner
                    v-if="displayIncompatiblePluginsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-shopware-updates.updateModal.messageIncompatible') }}
                </mt-banner>
                {% endblock %}

                {% block sw_settings_shopware_updates_wizard_method_options %}
                <div
                    class="sw-settings-shopware-updates-method-options"
                    role="radiogroup"
                    :aria-label="$t('sw-settings-shopware-updates.methodModal.title')"
                >
                    {% block sw_settings_shopware_updates_wizard_method_option_cli %}
                    <label
                        class="sw-settings-shopware-updates-method-option sw-settings-shopware-updates-method-option--cli"
                        :class="{ 'is--selected': isCliUpdateSelected }"
                        for="sw-settings-shopware-updates-method-cli"
                    >
                        <input
                            id="sw-settings-shopware-updates-method-cli"
                            v-model="chosenUpdateMethod"
                            class="sw-settings-shopware-updates-method-option__input"
                            type="radio"
                            name="sw-settings-shopware-updates-method"
                            value="cli"
                        >

                        <span
                            class="sw-settings-shopware-updates-method-option__icon"
                            aria-hidden="true"
                        >
                            <mt-icon
                                name="regular-window-terminal"
                                size="20px"
                            />
                        </span>

                        <span class="sw-settings-shopware-updates-method-option__content">
                            <span class="sw-settings-shopware-updates-method-option__title">
                                {{ $t('sw-settings-shopware-updates.methodModal.cliTitle') }}
                            </span>
                            <span class="sw-settings-shopware-updates-method-option__recommended">
                                {{ $t('sw-settings-shopware-updates.methodModal.cliRecommended') }}
                            </span>
                            <span class="sw-settings-shopware-updates-method-option__description">
                                {{ $t('sw-settings-shopware-updates.methodModal.cliDescription') }}
                            </span>
                            <span class="sw-settings-shopware-updates-method-option__hint">
                                {{ $t('sw-settings-shopware-updates.methodModal.cliInstallHint') }}
                            </span>
                            <span class="sw-settings-shopware-updates-method-option__command">
                                <code>{{ cliUpgradeCommand }}</code>
                                <sw-field-copyable
                                    :copyable-text="cliUpgradeCommand"
                                    :tooltip="true"
                                />
                            </span>
                            <sw-external-link
                                class="sw-settings-shopware-updates-method-option__install-link"
                                :href="cliInstallUrl"
                            >
                                {{ $t('sw-settings-shopware-updates.methodModal.cliInstallLink') }}
                            </sw-external-link>
                        </span>

                        <span
                            class="sw-settings-shopware-updates-method-option__radio"
                            aria-hidden="true"
                        ></span>
                    </label>
                    {% endblock %}

                    {% block sw_settings_shopware_updates_wizard_method_option_web %}
                    <label
                        class="sw-settings-shopware-updates-method-option sw-settings-shopware-updates-method-option--web"
                        :class="{ 'is--selected': !isCliUpdateSelected }"
                        for="sw-settings-shopware-updates-method-web"
                    >
                        <input
                            id="sw-settings-shopware-updates-method-web"
                            v-model="chosenUpdateMethod"
                            class="sw-settings-shopware-updates-method-option__input"
                            type="radio"
                            name="sw-settings-shopware-updates-method"
                            value="web"
                        >

                        <span
                            class="sw-settings-shopware-updates-method-option__icon"
                            aria-hidden="true"
                        >
                            <mt-icon
                                name="regular-globe"
                                size="20px"
                            />
                        </span>

                        <span class="sw-settings-shopware-updates-method-option__content">
                            <span class="sw-settings-shopware-updates-method-option__title">
                                {{ $t('sw-settings-shopware-updates.methodModal.webTitle') }}
                            </span>
                        </span>

                        <span
                            class="sw-settings-shopware-updates-method-option__radio"
                            aria-hidden="true"
                        ></span>
                    </label>
                    {% endblock %}
                </div>
                {% endblock %}

                {% block sw_settings_shopware_updates_wizard_method_plugin_options %}
                <sw-radio-field
                    v-if="showWebInstallerPluginOptions"
                    v-model:value="chosenPluginBehaviour"
                    :options="[
                        {'value': 'all', 'name': optionDeactivateAllTranslation },
                        {'value': 'notCompatible', 'name': optionDeactivateIncompatibleTranslation },
                        {'value': '', 'name': $t('sw-settings-shopware-updates.plugins.actions.deactivateNone')}]"
                />
                {% endblock %}

                <template #modal-footer>
                    <mt-checkbox
                        v-if="!isCliUpdateSelected"
                        v-model:checked="checkedBackupCheckbox"
                        class="sw-settings-shopware-updates-check__start-update-backup-checkbox"
                        :label="$t('sw-settings-shopware-updates.updateModal.backupLabel')"
                    />

                    <div class="sw-settings-shopware-updates-check__start-update-actions">
                        <mt-button
                            size="small"
                            variant="secondary"
                            @click="updateModalShown = false"
                        >
                            {{ $t(isCliUpdateSelected ? 'global.default.close' : 'global.default.cancel') }}
                        </mt-button>

                        <mt-button
                            v-if="!isCliUpdateSelected"
                            :disabled="!checkedBackupCheckbox"
                            variant="primary"
                            size="small"
                            class="sw-settings-shopware-updates-check__start-update-button"
                            @click="startUpdateProcess()"
                        >
                            {{ $t('sw-settings-shopware-updates.methodModal.actions.continue') }}
                        </mt-button>
                    </div>
                </template>
            </sw-modal>
        {% endblock %}
        </div>
    </template>
</sw-page>
{% endblock %}
