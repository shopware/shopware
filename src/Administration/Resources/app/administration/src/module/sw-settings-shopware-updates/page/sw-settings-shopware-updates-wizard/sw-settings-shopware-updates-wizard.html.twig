{% block sw_settings_shopware_updates_wizard %}
<sw-page class="sw-settings-shopware-updates-wizard">
    {% block sw_settings_shopware_updates_wizard_smart_bar_header %}
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings-shopware-updates.general.title') }}
        </h2>
    </template>
    {% endblock %}

    <template #content>
        <div class="sw-settings-shopware-updates-wizard__content">
        {% block sw_settings_shopware_updates_wizard_content %}
            <sw-card-view>
                {% block sw_settings_shopware_updates_wizard_version_card %}
                <mt-card
                    class="sw-settings-shopware-updates-wizard__version-card"
                    position-identifier="sw-settings-shopware-updates-version"
                    :title="$t('sw-settings-shopware-updates.versionCard.title')"
                    :is-loading="isLoading"
                >
                    {% block sw_settings_shopware_updates_wizard_license_banner %}
                    <mt-banner
                        v-if="licenseCheckFailed"
                        class="sw-settings-shopware-updates-wizard__license-banner"
                        variant="critical"
                        :title="$t('sw-settings-shopware-updates.license.bannerTitle')"
                    >
                        <span v-html="$t('sw-settings-shopware-updates.license.bannerMessage')"></span>
                    </mt-banner>
                    {% endblock %}

                    <template #headerRight>
                        <mt-badge
                            v-if="!isLoading"
                            class="sw-settings-shopware-updates-version__status-badge"
                            :variant="updateStatusBadgeVariant"
                            size="m"
                        >
                            {{ updateStatusBadgeLabel }}
                        </mt-badge>
                    </template>

                    <div
                        v-if="isUpdateAvailable"
                        class="sw-settings-shopware-updates-version"
                    >
                        <div class="sw-settings-shopware-updates-version__content">
                            <dl class="sw-settings-shopware-updates-version__versions">
                                <dt>{{ $t('sw-settings-shopware-updates.versionCard.currentVersionLabel') }}</dt>
                                <dd class="sw-settings-shopware-updates-version__current-version">
                                    {{ currentVersion }}
                                </dd>
                                <dt>{{ $t('sw-settings-shopware-updates.versionCard.newVersionLabel') }}</dt>
                                <dd class="sw-settings-shopware-updates-version__new-version">
                                    {{ updateInfo.version }}
                                </dd>
                            </dl>

                            <sw-external-link
                                class="sw-settings-shopware-updates-version__changelog-link"
                                :href="changelogUrl"
                            >
                                {{ $t('sw-settings-shopware-updates.versionCard.changelogLink') }}
                            </sw-external-link>
                        </div>
                    </div>

                    {% block sw_settings_shopware_updates_wizard_up_to_date %}
                    <div
                        v-else-if="!isLoading"
                        class="sw-settings-shopware-updates-up-to-date"
                    >
                        <span class="sw-settings-shopware-updates-up-to-date__icon">
                            <mt-icon
                                name="solid-check-circle"
                                size="32px"
                            />
                        </span>

                        <span class="sw-settings-shopware-updates-up-to-date__title">
                            {{ $t('sw-settings-shopware-updates.versionCard.upToDateTitle') }}
                        </span>

                        <span class="sw-settings-shopware-updates-up-to-date__description">
                            {{ $t('sw-settings-shopware-updates.versionCard.upToDateDescription', { version: currentVersion }) }}
                        </span>
                    </div>
                    {% endblock %}

                    {% block sw_settings_shopware_updates_wizard_cli_method %}
                    <div
                        v-if="isUpdateAvailable"
                        class="sw-settings-shopware-updates-cli-method"
                    >
                        <span class="sw-settings-shopware-updates-cli-method__title">
                            {{ $t('sw-settings-shopware-updates.methodModal.cliTitle') }}
                        </span>

                        <span class="sw-settings-shopware-updates-cli-method__description">
                            {{ $t('sw-settings-shopware-updates.methodModal.cliDescription') }}
                            {{ $t('sw-settings-shopware-updates.methodModal.cliInstallHint') }}
                        </span>

                        <span class="sw-settings-shopware-updates-cli-method__command">
                            <code>{{ cliUpgradeCommand }}</code>
                            <mt-button
                                class="sw-settings-shopware-updates-cli-method__copy-button"
                                size="small"
                                variant="secondary"
                                square
                                :aria-label="$t('global.default.copy')"
                                @click="copyCliCommand"
                            >
                                <template #iconFront="{ size }">
                                    <mt-icon
                                        name="regular-copy"
                                        :size="`${size}px`"
                                    />
                                </template>
                            </mt-button>
                        </span>

                        <sw-external-link
                            class="sw-settings-shopware-updates-cli-method__install-link"
                            :href="cliInstallUrl"
                        >
                            {{ $t('sw-settings-shopware-updates.methodModal.cliInstallLink') }}
                        </sw-external-link>
                    </div>
                    {% endblock %}

                    {% block sw_settings_shopware_updates_wizard_method_divider %}
                    <div
                        v-if="isUpdateAvailable"
                        class="sw-settings-shopware-updates-method-divider"
                        role="separator"
                    >
                        <span>{{ $t('sw-settings-shopware-updates.versionCard.methodDivider') }}</span>
                    </div>
                    {% endblock %}

                    {% block sw_settings_shopware_updates_wizard_web_installer %}
                    <div
                        v-if="isUpdateAvailable"
                        class="sw-settings-shopware-updates-web-installer"
                    >
                        <div class="sw-settings-shopware-updates-web-installer__content">
                            <span class="sw-settings-shopware-updates-web-installer__title">
                                {{ $t('sw-settings-shopware-updates.versionCard.webInstallerTitle') }}
                            </span>
                            <span class="sw-settings-shopware-updates-web-installer__description">
                                {{ $t('sw-settings-shopware-updates.versionCard.webInstallerDescription') }}
                            </span>
                        </div>

                        <div
                            :key="updatePossible"
                            v-tooltip="updateButtonTooltip"
                            class="sw-settings-shopware-updates-web-installer__action"
                        >
                            <mt-button
                                :disabled="!updatePossible"
                                :is-loading="updaterIsRunning"
                                variant="secondary"
                                class="sw-settings-shopware-updates-wizard__start-update"
                                size="default"
                                @click="updateModalShown = true"
                            >
                                {{ $t('sw-settings-shopware-updates.infos.startUpdate') }}
                            </mt-button>
                        </div>
                    </div>
                    {% endblock %}
                </mt-card>
                {% endblock %}

                <sw-settings-shopware-updates-extensions
                    v-if="isUpdateAvailable"
                    :extensions="extensions"
                    :is-loading="isLoading"
                />
            </sw-card-view>

            <sw-modal
                v-if="updaterIsRunning"
                :title="$t('sw-settings-shopware-updates.cards.updating')"
                variant="small"
                class="sw-shopware-updates-progressbar"
            >
                <div class="progress-wrapper">
                    <mt-progress-bar
                        :model-value="progressbarValue"
                        :max-value="100"
                    />
                    <span class="progress-title">
                        <p v-if="step === 'download'">{{ $t('sw-settings-shopware-updates.infos.progress.download') }}</p>
                        <p v-if="step === 'unpack'">{{ $t('sw-settings-shopware-updates.infos.progress.unpack') }}</p>
                        <p v-if="step === 'deactivate'">{{ $t('sw-settings-shopware-updates.infos.progress.deactivate') }}</p>
                    </span>
                </div>
            </sw-modal>

            <sw-modal
                v-if="updateModalShown"
                class="sw-settings-shopware-updates-check__start-update"
                :title="$t('sw-settings-shopware-updates.methodModal.title')"
                :subtitle="$t('sw-settings-shopware-updates.methodModal.subtitle')"
                @modal-close="updateModalShown = false"
            >
                {% block sw_settings_shopware_updates_wizard_method_warnings %}
                <mt-banner
                    v-if="displayUnknownExtensionsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-shopware-updates.updateModal.messageNotInStore') }}
                </mt-banner>

                <mt-banner
                    v-if="displayIncompatibleExtensionsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-shopware-updates.updateModal.messageIncompatible') }}
                </mt-banner>
                {% endblock %}

                {% block sw_settings_shopware_updates_wizard_method_plugin_options %}
                <sw-radio-field
                    v-if="displayIncompatibleExtensionsWarning"
                    v-model:value="chosenExtensionBehaviour"
                    :options="[
                        {'value': 'all', 'name': optionDeactivateAllTranslation },
                        {'value': 'notCompatible', 'name': optionDeactivateIncompatibleTranslation },
                        {'value': '', 'name': $t('sw-settings-shopware-updates.extensions.actions.deactivateNone')}]"
                />
                {% endblock %}

                <template #modal-footer>
                    <mt-checkbox
                        v-model="checkedBackupCheckbox"
                        class="sw-settings-shopware-updates-check__start-update-backup-checkbox"
                        :label="$t('sw-settings-shopware-updates.updateModal.backupLabel')"
                    />

                    <div class="sw-settings-shopware-updates-check__start-update-actions">
                        <mt-button
                            size="small"
                            variant="secondary"
                            @click="updateModalShown = false"
                        >
                            {{ $t('global.default.cancel') }}
                        </mt-button>

                        <mt-button
                            :disabled="!checkedBackupCheckbox"
                            variant="primary"
                            size="small"
                            class="sw-settings-shopware-updates-check__start-update-button"
                            @click="startUpdateProcess()"
                        >
                            {{ $t('sw-settings-shopware-updates.methodModal.actions.continue') }}
                        </mt-button>
                    </div>
                </template>
            </sw-modal>
        {% endblock %}
        </div>
    </template>
</sw-page>
{% endblock %}
