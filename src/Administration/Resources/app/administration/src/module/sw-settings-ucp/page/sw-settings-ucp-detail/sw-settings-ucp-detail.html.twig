{% block sw_settings_ucp_detail %}
<sw-page class="sw-settings-ucp-detail">

    {% block sw_settings_ucp_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings-ucp.detail.headline') }}
            <span v-if="salesChannelName"> — {{ salesChannelName }}</span>
        </h2>
    </template>
    {% endblock %}

    {% block sw_settings_ucp_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        <sw-button-process
            class="sw-settings-ucp-detail__save-action"
            variant="primary"
            :is-loading="isSaving"
            :process-success="false"
            @click="save"
        >
            {{ $t('sw-settings-ucp.detail.save') }}
        </sw-button-process>
    </template>
    {% endblock %}

    {% block sw_settings_ucp_detail_content %}
    <template #content>
        <sw-card-view v-if="config">
            {% block sw_settings_ucp_detail_general_card %}
            <mt-card
                position-identifier="sw-settings-ucp-general"
                :title="$t('sw-settings-ucp.detail.general')"
            >

                <!-- TODO Codemod: Converted from sw-switch-field - please check if everything works correctly -->
                <mt-switch
                    v-model="config.active"
                    :label="$t('sw-settings-ucp.detail.active')"
                    :help-text="$t('sw-settings-ucp.detail.activeHelp')"
                />

                <!-- TODO Codemod: Converted from sw-text-field - please check if everything works correctly -->
                <mt-text-field
                    v-model="config.ucpVersion"
                    :label="$t('sw-settings-ucp.detail.version')"
                    :help-text="$t('sw-settings-ucp.detail.versionHelp')"
                    placeholder="2026-01-23"
                />

                <!-- TODO Codemod: Converted from sw-text-field - please check if everything works correctly -->
                <mt-text-field
                    v-model="config.continueUrlTemplate"
                    :label="$t('sw-settings-ucp.detail.continueUrlTemplate')"
                    :help-text="$t('sw-settings-ucp.detail.continueUrlTemplateHelp')"
                    placeholder="{domainUrl}/checkout/confirm?ucp_token={cartToken}"
                />
            </mt-card>
            {% endblock %}

            {% block sw_settings_ucp_detail_capabilities_card %}
            <mt-card
                position-identifier="sw-settings-ucp-capabilities"
                :title="$t('sw-settings-ucp.detail.capabilities')"
            >

                <mt-banner
                    variant="info"
                >
                    {{ $t('sw-settings-ucp.detail.capabilitiesIntro') }}
                </mt-banner>

                <div
                    v-for="group in capabilityGroups"
                    :key="group.id"
                    class="sw-settings-ucp-detail__capability-group"
                >
                    <h3>{{ $t(`sw-settings-ucp.detail.capabilityGroups.${group.id}.title`) }}</h3>
                    <p>{{ $t(`sw-settings-ucp.detail.capabilityGroups.${group.id}.description`) }}</p>

                    <div
                        v-for="cap in group.items"
                        :key="cap.id"
                        class="sw-settings-ucp-detail__capability-row"
                    >
                        <!-- TODO Codemod: Converted from sw-switch-field - please check if everything works correctly -->
                        <mt-switch
                            :model-value="isEnabled(cap.id)"
                            :label="$t(`sw-settings-ucp.detail.capabilityLabels.${cap.labelKey}`)"
                            :help-text="$t(`sw-settings-ucp.detail.capabilityHelp.${cap.helpKey}`)"
                            @update:value="toggleCapability(cap.id)"
                        />
                        <sw-label
                            v-if="cap.type === 'extension'"
                            size="small"
                            variant="neutral"
                        >
                            {{ $t('sw-settings-ucp.detail.extensionLabel') }}
                        </sw-label>
                    </div>
                </div>
            </mt-card>
            {% endblock %}

            {% block sw_settings_ucp_detail_transports_card %}
            <mt-card
                position-identifier="sw-settings-ucp-transports"
                :title="$t('sw-settings-ucp.detail.transports')"
            >
                <mt-banner
                    variant="info"
                >
                    {{ $t('sw-settings-ucp.detail.transportsHelp') }}
                </mt-banner>

                <sw-multi-select
                    v-model:value="config.enabledTransports"
                    :options="localizedTransports"
                    label-property="label"
                    value-property="id"
                    :label="$t('sw-settings-ucp.detail.transportsLabel')"
                />
            </mt-card>
            {% endblock %}

            {% block sw_settings_ucp_detail_security_card %}
            <mt-card
                position-identifier="sw-settings-ucp-security"
                :title="$t('sw-settings-ucp.detail.security')"
            >

                <sw-single-select
                    v-model:value="config.signaturePolicy"
                    :options="localizedSignaturePolicyOptions"
                    label-property="label"
                    value-property="id"
                    :label="$t('sw-settings-ucp.detail.signaturePolicy')"
                    :help-text="$t('sw-settings-ucp.detail.signaturePolicyHelp')"
                />

                <mt-banner
                    v-if="config.signaturePolicy !== 'strict'"
                    variant="attention"
                    class="sw-settings-ucp-detail__signature-warning"
                >
                    {{ $t('sw-settings-ucp.detail.signaturePolicyNonStrictWarning') }}
                </mt-banner>

                <!-- TODO Codemod: Converted from sw-switch-field - please check if everything works correctly -->
                <mt-switch
                    v-model="config.idempotencyRequired"
                    :label="$t('sw-settings-ucp.detail.idempotencyRequired')"
                    :help-text="$t('sw-settings-ucp.detail.idempotencyRequiredHelp')"
                />
            </mt-card>
            {% endblock %}

            {% block sw_settings_ucp_detail_keys_card %}
            <mt-card
                position-identifier="sw-settings-ucp-keys"
                :title="$t('sw-settings-ucp.detail.signingKeys')"
            >
                <template #toolbar>
                    <mt-button
                        variant="primary"
                        size="small"
                        :is-loading="isRotatingKey"
                        :disabled="!canRotateKey"
                        @click="rotateKey"
                    >
                        {{ $t('sw-settings-ucp.detail.rotateKey') }}
                    </mt-button>
                </template>

                <mt-banner
                    v-if="!canRotateKey"
                    variant="attention"
                >
                    {{ $t('sw-settings-ucp.detail.noKeyPrivilege') }}
                </mt-banner>

                <mt-banner
                    variant="info"
                >
                    {{ $t('sw-settings-ucp.detail.signingKeysHelp') }}
                </mt-banner>

                <sw-data-grid
                    :data-source="keys"
                    :columns="[
                        { property: 'kid', label: 'Key ID' },
                        { property: 'algorithm', label: 'Algorithm' },
                        { property: 'status', label: 'Status' },
                        { property: 'activatedAt', label: 'Activated' },
                    ]"
                    :show-actions="canRotateKey"
                    :show-selection="false"
                    plain-appearance
                >
                    <template #column-status="{ item }">
                        <sw-label
                            size="small"
                            :variant="item.status === 'active' ? 'positive' : 'neutral'"
                        >
                            {{ item.status }}
                        </sw-label>
                    </template>
                    <template #actions="{ item }">
                        <sw-context-menu-item
                            v-if="item.status === 'active'"
                            @click="retireKey(item.kid)"
                        >
                            {{ $t('sw-settings-ucp.detail.retireKey') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>
            {% endblock %}

            {% block sw_settings_ucp_detail_preview_card %}
            <mt-card
                position-identifier="sw-settings-ucp-preview"
                :title="$t('sw-settings-ucp.detail.profilePreview')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        @click="loadProfilePreview"
                    >
                        {{ $t('sw-settings-ucp.detail.loadPreview') }}
                    </mt-button>
                </template>

                <pre
                    v-if="profilePreview"
                    class="sw-settings-ucp-detail__preview"
                >{{ JSON.stringify(profilePreview, null, 2) }}</pre>
                <mt-banner
                    v-else
                    variant="info"
                >
                    {{ $t('sw-settings-ucp.detail.previewHint') }}
                </mt-banner>
            </mt-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
