{% block sw_settings_webhook_secret_modal %}
<mt-modal-root
    :is-open="isOpen"
    @change="onModalRootChange"
>
    <mt-modal
        width="m"
        :title="$t('sw-settings-webhook.secret.title', { name: webhook.name })"
    >
        <template #default>
            <div class="sw-settings-webhook-secret-modal__content">
                <p class="sw-settings-webhook-secret-modal__description">
                    {{ $t('sw-settings-webhook.secret.description') }}
                </p>

                <div class="sw-settings-webhook-secret-modal__secret">
                    <mt-text-field
                        v-model="secret"
                        name="sw-field--webhook-secret"
                        :label="$t('sw-settings-webhook.secret.labelSecret')"
                        :placeholder="$t('sw-settings-webhook.secret.placeholderSecret')"
                        :copyable="!!secret"
                        :copyable-tooltip="true"
                        :error="secretError"
                    />

                    <mt-button
                        class="sw-settings-webhook-secret-modal__generate"
                        size="large"
                        variant="secondary"
                        @click="generateSecret"
                    >
                        {{ $t('sw-settings-webhook.secret.buttonGenerate') }}
                    </mt-button>
                </div>

                <mt-banner
                    v-if="secret"
                    variant="attention"
                >
                    {{ $t('sw-settings-webhook.secret.hintShownOnce') }}
                </mt-banner>
            </div>
        </template>

        <template #footer>
            <div class="sw-settings-webhook-secret-modal__footer">
                <mt-button
                    size="small"
                    variant="secondary"
                    @click="$emit('modal-close')"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>

                <mt-button
                    class="sw-settings-webhook-secret-modal__save"
                    size="small"
                    variant="primary"
                    :disabled="!canSave"
                    :is-loading="isSaving"
                    @click="onSave"
                >
                    {{ $t('global.default.save') }}
                </mt-button>
            </div>
        </template>
    </mt-modal>
</mt-modal-root>
{% endblock %}
