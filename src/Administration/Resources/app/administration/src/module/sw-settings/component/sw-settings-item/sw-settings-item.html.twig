{% block sw_settings_item %}
<router-link
    :to="to"
    class="sw-settings-item"
    :class="classes"
>
    {% block sw_settings_item_icon %}
    <div class="sw-settings-item__icon">
        <slot name="icon"></slot>
    </div>
    {% endblock %}

    {% block sw_settings_item_label %}
    <div class="sw-settings-item__label">
        <slot name="label">
            {{ label }}
        </slot>

        {% block sw_settings_item_new_badge %}
        <mt-promo-badge
            v-if="showNewBadge"
            class="sw-settings-item__new-badge"
            variant="new"
            size="s"
        />
        {% endblock %}
    </div>
    {% endblock %}
</router-link>
{% endblock %}
