{% block sw_sso_error %}
<div class="sw-sso-error">
    <div class="sw-sso-error__container">
        <img
            class="sw-sso-error__logo"
            :src="assetFilter('administration/administration/static/img/shopware_logo_blue.svg')"
            :alt="$t('global.sw-sso-error.error-card.logoAltText')"
        >

        <div class="sw-sso-error__card">
            <div class="sw-sso-error__status">
                <span class="sw-sso-error__status-icon">
                    <mt-icon
                        name="solid-lock"
                        size="24px"
                        decorative
                    />
                </span>

                <h1 class="sw-sso-error__title">
                    {{ $t('global.sw-sso-error.error-card.title') }}
                </h1>

                <p class="sw-sso-error__description">
                    {{ $t('global.sw-sso-error.error-card.text') }}
                </p>

                <div class="sw-sso-error__button-container">
                    <div
                        v-if="isLoading"
                        class="sw-sso-error__loading-indicator"
                        role="status"
                        :aria-label="$t('global.sw-sso-error.error-card.loadingLabel')"
                    >
                        <mt-loader size="24px" />
                    </div>

                    <mt-button
                        v-else
                        variant="primary"
                        size="default"
                        :link="url"
                        target="_self"
                    >
                        {{ $t('global.sw-sso-error.error-card.button') }}
                    </mt-button>
                </div>

                <p
                    v-if="email"
                    class="sw-sso-error__logged-in-as"
                >
                    <span class="sw-sso-error__logged-in-as-text">{{ $t('global.sw-sso-error.error-card.loggedInAsPrefix') }}</span>
                    <span class="sw-sso-error__logged-in-as-email">{{ email }}</span>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
