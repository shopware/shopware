{% block sw_users_permissions_included_access_modal %}
<mt-modal-root
    :is-open="true"
    @change="onModalChange"
>
    <mt-modal
        width="l"
        :title="title"
        :subtitle="subtitle"
    >
        <div class="sw-users-permissions-included-access-modal">
            {% block sw_users_permissions_included_access_modal_description %}
            <p
                v-if="description"
                class="sw-users-permissions-included-access-modal__description"
            >
                {{ description }}
            </p>
            {% endblock %}

            {% block sw_users_permissions_included_access_modal_matrix %}
            <table class="sw-users-permissions-included-access-modal__matrix">
                <colgroup>
                    <col>
                    <col
                        v-for="column in columns"
                        :key="column.operation"
                        class="sw-users-permissions-included-access-modal__operation-column"
                    >
                </colgroup>

                {% block sw_users_permissions_included_access_modal_matrix_head %}
                <thead>
                    <tr>
                        <th scope="col">
                            {{ $t('sw-users-permissions.roles.included-access.columnArea') }}
                        </th>
                        <th
                            v-for="column in columns"
                            :key="column.operation"
                            scope="col"
                            class="sw-users-permissions-included-access-modal__operation-head"
                        >
                            {{ $t(`sw-privileges.roles.${column.role}`) }}
                        </th>
                    </tr>
                </thead>
                {% endblock %}

                <template
                    v-for="(group, groupIndex) in groups"
                    :key="group.tier"
                >
                    {% block sw_users_permissions_included_access_modal_matrix_group %}
                    <tbody
                        class="sw-users-permissions-included-access-modal__group"
                        :class="{ 'is--first': groupIndex === 0 }"
                    >
                        <tr>
                            <th
                                colspan="5"
                                scope="colgroup"
                            >
                                {{ $t(`sw-users-permissions.roles.included-access.tiers.${group.tier}`) }}
                            </th>
                        </tr>
                    </tbody>
                    {% endblock %}

                    {% block sw_users_permissions_included_access_modal_matrix_areas %}
                    <sw-users-permissions-included-access-area
                        v-for="area in group.areas"
                        :key="area.key"
                        :area="area"
                        :columns="columns"
                        :show-granted-by="withSources"
                    />
                    {% endblock %}
                </template>
            </table>
            {% endblock %}
        </div>

        <template #footer>
            {% block sw_users_permissions_included_access_modal_footer %}
            <div class="sw-users-permissions-included-access-modal__footer">
                <mt-modal-close
                    as="mt-button"
                    size="small"
                    variant="secondary"
                >
                    {{ $t('global.default.close') }}
                </mt-modal-close>
            </div>
            {% endblock %}
        </template>
    </mt-modal>
</mt-modal-root>
{% endblock %}
