{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "Bundler",
        // Preserve the legacy check's deep imports into packages without matching exports.
        "resolvePackageJsonExports": false,
        "resolvePackageJsonImports": false,
        "baseUrl": null,
        "paths": {
            "*": ["./*"],
            "src": ["./src"],
            "@shopware-ag/dive/quickview": ["./node_modules/@shopware-ag/dive/build/plugins/quickview/index.d.ts"],
            "@shopware-ag/dive/toolbox": ["./node_modules/@shopware-ag/dive/build/plugins/toolbox/index.d.ts"],
            "@shopware-ag/dive/orbitcontroller": [
                "./node_modules/@shopware-ag/dive/build/plugins/orbitcontroller/index.d.ts"
            ],
            "@shopware-ag/dive/assetexporter": ["./node_modules/@shopware-ag/dive/build/plugins/assetexporter/index.d.ts"],
            "three/webgpu": ["./node_modules/@types/three/build/three.webgpu.d.ts"],
            "@tiptap/vue-3": [
                "./node_modules/@tiptap/vue-3/dist/index.d.ts",
                "./node_modules/@shopware-ag/meteor-component-library/node_modules/@tiptap/vue-3/dist/index.d.ts"
            ],
            "@tiptap/extension-link": [
                "./node_modules/@tiptap/extension-link/dist/index.d.ts",
                "./node_modules/@shopware-ag/meteor-component-library/node_modules/@tiptap/extension-link/dist/index.d.ts"
            ]
        }
    }
}
