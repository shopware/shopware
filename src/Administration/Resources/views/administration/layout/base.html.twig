<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block administration_title %}
        <title>
            Shopware Administration (c) shopware AG
        </title>
    {% endblock %}

    {% block administration_meta %}
        <meta name="robots" content="noindex, nofollow" />
    {% endblock %}

    {% block administration_favicons %}
        {# @deprecated tag:v6.8.0 - Raster fallback for Safari < 26, which cannot render SVG favicons.
           Remove this link together with `static/img/favicon/favicon-32x32.png` once Safari < 26 usage
           is negligible. Must stay BEFORE the SVG link: Firefox picks the last supported candidate. #}
        <link rel="icon" href="{{ asset('administration/static/img/favicon/favicon-32x32.png', '@Administration') }}" sizes="32x32">

        {# Swapped at runtime to the icon of the active module. Must stay the LAST `rel="icon"` link,
           browsers pick one icon out of all declared ones. #}
        <link rel="icon" type="image/svg+xml" sizes="any" href="{{ asset('administration/static/img/favicon/favicon.svg', '@Administration') }}" id="dynamic-favicon">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('administration/static/img/favicon/apple-touch-icon.png', '@Administration') }}">
        <meta name="theme-color" content="#0870ff">
        <meta name="referrer" content="always">
    {% endblock %}

    {% block administration_head_scripts %}{% endblock %}

    {{ vite_entry_link_tags('app') }}
</head>
<body>

{% block administration_content %}{% endblock %}

</body>
</html>
