<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block administration_title %}
        <title>
            Shopware Administration (c) shopware AG
        </title>
    {% endblock %}

    {% block administration_meta %}
        <meta name="robots" content="noindex, nofollow" />
    {% endblock %}

    {% block administration_favicons %}
        {# Swapped at runtime to the icon of the active module. Must stay the only `rel="icon"` link, browsers
           pick one icon out of all declared ones and a static fallback would win over it. #}
        <link rel="icon" type="image/svg+xml" sizes="any" href="{{ asset('administration/static/img/favicon/favicon.svg', '@Administration') }}" id="dynamic-favicon">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('administration/static/img/favicon/apple-touch-icon.png', '@Administration') }}">
        <link rel="manifest" href="{{ asset('administration/static/img/favicon/site.webmanifest', '@Administration') }}">
        <meta name="theme-color" content="#0870ff">
        <meta name="referrer" content="always">
    {% endblock %}

    {% block administration_head_scripts %}{% endblock %}

    {{ vite_entry_link_tags('app') }}
</head>
<body>

{% block administration_content %}{% endblock %}

</body>
</html>
