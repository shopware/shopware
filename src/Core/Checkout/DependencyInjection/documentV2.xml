<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Shopware\Core\Checkout\DocumentV2\Renderer\InvoiceHtmlRenderer">
            <tag name="shopware.documentV2.renderer" type="invoice" format="html"/>
        </service>

        <service id="Shopware\Core\Checkout\DocumentV2\Renderer\InvoicePdfRenderer">
            <tag name="shopware.documentV2.renderer" type="invoice" format="pdf"/>
        </service>

        <service id="Shopware\Core\Checkout\DocumentV2\Renderer\InvoiceZugferdXmlRenderer">
            <tag name="shopware.documentV2.renderer" type="invoice" format="zugferd_xml"/>
        </service>

        <service id="Shopware\Core\Checkout\DocumentV2\Renderer\InvoiceEmbeddedZugferdRenderer">
            <tag name="shopware.documentV2.renderer" type="invoice" format="embedded_zugferd"/>
        </service>

        <service id="Shopware\Core\Checkout\DocumentV2\DocumentGenerator">
            <argument type="tagged_iterator" tag="shopware.documentV2.renderer"/>
        </service>

    </services>
</container>
