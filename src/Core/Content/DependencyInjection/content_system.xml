<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Entity Definitions -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Entity\ContentLayoutDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Entity\ContentRouteDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Entity\ContentLayoutAssignmentDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Adapter\Entity\ProductContentLayout\ProductContentLayoutDefinition">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Helper\ContentLayoutMetadataDeriver"/>
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Adapter\Entity\CategoryContentLayout\CategoryContentLayoutDefinition">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Helper\ContentLayoutMetadataDeriver"/>
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Adapter\Entity\LandingPageContentLayout\LandingPageContentLayoutDefinition">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Helper\ContentLayoutMetadataDeriver"/>
            <tag name="shopware.entity.definition"/>
        </service>

        <!-- Routing Services -->
        <service id="Shopware\Core\Content\ContentSystem\Routing\Router\RouteCollectionBuilder">
            <argument type="service" id="content_route.repository"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Router\ContentRouteMatcher"/>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Router\ContentRouter">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Router\RouteCollectionBuilder"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Router\ContentRouteMatcher"/>
        </service>

        <!-- Resolver Services -->
        <service id="Shopware\Core\Content\ContentSystem\Routing\IdResolution\ParameterExtractor"/>

        <service id="Shopware\Core\Content\ContentSystem\Routing\IdResolution\EntityIdResolver">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\IdResolution\ParameterExtractor"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\LayoutResolution\LayoutResolver">
            <argument type="service" id="content_layout_assignment.repository"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <!-- Layout Loading -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Loader\LayoutLoader">
            <argument type="service" id="content_layout.repository"/>
        </service>

        <!-- Layout Scaffolding -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Scaffolding\ScaffoldingProcessor">
            <argument type="tagged_iterator" tag="content_system.layout_scaffolder" default-priority-method="getPriority"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Scaffolding\VirtualRootScaffolder">
            <tag name="content_system.layout_scaffolder"/>
        </service>

        <!-- Layout Refinement Services -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Refinery\Refiner\PlaceholderResolutionRefiner">
            <tag name="content_system.layout_refiner" priority="0"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Refinery\LayoutRefinery">
            <argument type="tagged_iterator" tag="content_system.layout_refiner"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Refinery\RefinedLayoutBuilder">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Refinery\LayoutRefinery"/>
        </service>

        <!-- Field Serializers -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Field\DataRequirementsFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Field\ContextProvidersFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Field\ContextConsumersFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Field\ElementSlotsFieldSerializer" lazy="true">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Field\ContentElementFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Field\ContentElementFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Field\DataRequirementsFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Field\ContextProvidersFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Field\ContextConsumersFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Field\ElementSlotsFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\CriteriaFilterFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\CriteriaFilterListFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Field\CriteriaFilterFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\ResolutionConfigFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Field\CriteriaFilterFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\ParameterBindingFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Field\ResolutionConfigFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\ParameterBindingsFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Field\ParameterBindingFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Routing\Field\UrlPatternFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\FieldSerializer\StringFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <!-- Type Registry System -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\ElementType\Registry\ContentElementTypeRegistry"/>

        <!-- Element Type Definition Services -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\ElementType\Schema\SchemaValidator"/>

        <service id="Shopware\Core\Content\ContentSystem\Layout\ElementType\Loader\ElementTypeLoader">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\ElementType\Schema\SchemaValidator"/>
        </service>

        <!-- Content Data Loaders -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoader">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Entity\SalesChannelDefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="content_system.data_loader"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\EntityCollectionLoader\EntityCollectionLoader">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Entity\SalesChannelDefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="content_system.data_loader"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\ProductListingLoader\ProductListingDataLoader">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Listing\ProductListingLoader"/>
            <tag name="content_system.data_loader"/>
        </service>

        <!-- Data Loader Provider with Tagged Locator -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\DataLoaderProvider">
            <argument type="tagged_locator" tag="content_system.data_loader" default-index-method="getRequirementType"/>
        </service>

        <!-- Config Serializers -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoaderConfigSerializer">
            <tag name="content_system.config_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\EntityCollectionLoader\EntityCollectionLoaderConfigSerializer">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoaderConfigSerializer"/>
            <tag name="content_system.config_serializer"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\ProductListingLoader\ProductListingLoaderConfigSerializer">
            <tag name="content_system.config_serializer"/>
        </service>

        <!-- Config Serializer Provider with Tagged Locator -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider">
            <argument type="tagged_locator" tag="content_system.config_serializer" default-index-method="getSource"/>
        </service>

        <!-- Data Context Resolution -->
        <!-- Distribution Strategies -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\Distribution\BroadcastDistributor">
            <tag name="content_system.distribution_strategy"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\Distribution\IndexedDistributor">
            <tag name="content_system.distribution_strategy"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\Distribution\IteratorDistributor">
            <tag name="content_system.distribution_strategy"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\Distribution\KeyedDistributor">
            <tag name="content_system.distribution_strategy"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\Distribution\SlicedDistributor">
            <tag name="content_system.distribution_strategy"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\DataContextResolver">
            <argument type="tagged_iterator" tag="content_system.distribution_strategy"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\ContextPathResolver"/>
        </service>

        <!-- Context Path Resolver -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\ContextPathResolver"/>

        <!-- Hydration Services -->
        <service id="Shopware\Core\Content\ContentSystem\Hydration\ContentElementHydrator">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\DataLoaderProvider"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataContext\DataContextResolver"/>
        </service>

        <!-- Layout Tree Utilities -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Element\TreeUtil\ElementTreeUtil"/>

        <service id="Shopware\Core\Content\ContentSystem\Layout\Element\Context\ContextDependencyAnalyzer"/>

        <!-- Partial Rendering Refiner (Pre-Hydration Pruning) -->
        <service id="Shopware\Core\Content\ContentSystem\Layout\Refinery\Refiner\PartialRenderingRefiner">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Element\TreeUtil\ElementTreeUtil"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Element\Context\ContextDependencyAnalyzer"/>
            <tag name="content_system.layout_refiner" priority="200"/>
        </service>

        <!-- Output Services (Post-Hydration Processing) -->
        <service id="Shopware\Core\Content\ContentSystem\Output\SubTreeExtractor"/>

        <!-- Entity Layout Services -->
        <service id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutResolver"/>
        <service id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutContextFactory">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutResolver"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Helper\RequestParameterExtractor"/>
        </service>

        <!-- Helper Services -->
        <service id="Shopware\Core\Content\ContentSystem\Helper\RequestParameterExtractor"/>
        <service id="Shopware\Core\Content\ContentSystem\Helper\ContentLayoutMetadataDeriver"/>

        <!-- Context Factories -->
        <!-- Entity Adapters - Higher priority -->
        <service id="Shopware\Core\Content\ContentSystem\Adapter\ProductContentLayoutContextFactory">
            <argument type="service" id="product_content_layout.repository"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\Entity\ProductContentLayout\ProductContentLayoutDefinition"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutContextFactory"/>
            <tag name="content_system.context_factory" priority="100"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Adapter\CategoryContentLayoutContextFactory">
            <argument type="service" id="category_content_layout.repository"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\Entity\CategoryContentLayout\CategoryContentLayoutDefinition"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutContextFactory"/>
            <tag name="content_system.context_factory" priority="100"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\Adapter\LandingPageContentLayoutContextFactory">
            <argument type="service" id="landing_page_content_layout.repository"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\Entity\LandingPageContentLayout\LandingPageContentLayoutDefinition"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Adapter\FactoryHelper\EntityLayoutContextFactory"/>
            <tag name="content_system.context_factory" priority="100"/>
        </service>

        <!-- Route-based Context Factory - Fallback with lowest priority -->
        <service id="Shopware\Core\Content\ContentSystem\Routing\RouteBasedContextFactory">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\Router\ContentRouter"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\IdResolution\EntityIdResolver"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Routing\LayoutResolution\LayoutResolver"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Helper\RequestParameterExtractor"/>
            <tag name="content_system.context_factory" priority="0"/>
        </service>

        <!-- Store-API Route -->
        <service id="Shopware\Core\Content\ContentSystem\SalesChannel\ContentRouteLoader" public="true">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Loader\LayoutLoader"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Scaffolding\ScaffoldingProcessor"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Layout\Refinery\RefinedLayoutBuilder"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\ContentElementHydrator"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Output\SubTreeExtractor"/>
        </service>

        <!-- Content Route - Returns full ContentPage for Storefront rendering -->
        <service id="Shopware\Core\Content\ContentSystem\SalesChannel\ContentRoute" public="true">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\SalesChannel\ContentRouteLoader"/>
            <argument type="tagged_iterator" tag="content_system.context_factory"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\SalesChannel\AbstractContentRoute" alias="Shopware\Core\Content\ContentSystem\SalesChannel\ContentRoute"/>

        <!-- Content Decomposed Route - Returns DecomposedContentPage for API consumption -->
        <service id="Shopware\Core\Content\ContentSystem\SalesChannel\ContentDecomposedRoute" public="true">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\SalesChannel\ContentRouteLoader"/>
            <argument type="tagged_iterator" tag="content_system.context_factory"/>
            <argument type="service" id="Shopware\Core\Content\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
        </service>

        <service id="Shopware\Core\Content\ContentSystem\SalesChannel\AbstractContentDecomposedRoute" alias="Shopware\Core\Content\ContentSystem\SalesChannel\ContentDecomposedRoute"/>

        <!-- Storefront Controller -->
        <service id="Shopware\Storefront\Controller\ContentController" public="true">
            <argument type="service" id="Shopware\Core\Content\ContentSystem\SalesChannel\AbstractContentRoute"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
