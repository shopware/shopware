<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Shopware\Core\Content\LegalGuaranteeNotice\LegalGuaranteeNoticeRenderer">
            <argument type="service" id="twig"/>
            <argument type="service" id="Shopware\Core\System\Locale\LanguageLocaleCodeProvider"/>
        </service>

        <service id="Shopware\Core\Content\LegalGuaranteeNotice\LegalGuaranteeNoticeTwigFilter">
            <argument type="service" id="Shopware\Core\Content\LegalGuaranteeNotice\LegalGuaranteeNoticeRenderer"/>
            <tag name="twig.extension"/>
        </service>

        <service id="Shopware\Core\Content\LegalGuaranteeNotice\SalesChannel\LegalGuaranteeNoticeRoute" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Shopware\Core\Content\LegalGuaranteeNotice\LegalGuaranteeNoticeRenderer"/>
        </service>

        <service id="Shopware\Core\Content\LegalGuaranteeNotice\SalesChannel\AbstractLegalGuaranteeNoticeRoute" alias="Shopware\Core\Content\LegalGuaranteeNotice\SalesChannel\LegalGuaranteeNoticeRoute"/>
    </services>
</container>
