<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Shopware\Core\Content\MeasurementSystem\Entity\MeasurementSystemEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Entity\MeasurementDisplayUnitEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Field\MeasurementUnitsFieldSerializer">
            <argument type="service" id="validator"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>

            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\UnitProvider\MeasurementUnitProvider">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\UnitConverter\MeasurementUnitConverter">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\UnitProvider\MeasurementUnitProvider"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\ProductMeasurement\ProductMeasurementUnitBuilder">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\UnitConverter\MeasurementUnitConverter"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\TwigExtension\MeasurementConvertUnitTwigFilter" public="false">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\UnitProvider\MeasurementUnitProvider"/>
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\UnitConverter\MeasurementUnitConverter"/>
            <tag name="twig.extension"/>
        </service>

    </services>
</container>
