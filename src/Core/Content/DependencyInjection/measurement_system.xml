<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Shopware\Core\Content\MeasurementSystem\Entity\MeasurementSystemEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Entity\MeasurementDisplayUnitEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitProvider">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitConverter">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitProvider"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\Service\ProductMeasurementUnitBuilder">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitConverter"/>
        </service>

        <service id="Shopware\Core\Content\MeasurementSystem\TwigExtension\MeasurementConvertTwigFilter" public="false">
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitProvider"/>
            <argument type="service" id="Shopware\Core\Content\MeasurementSystem\Service\MeasurementUnitConverter"/>
            <tag name="twig.extension"/>
        </service>

    </services>
</container>
