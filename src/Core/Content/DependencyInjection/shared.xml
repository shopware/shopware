<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="Shopware\Core\Content\Shared\MailFlow\OrderCriteriaBuilder">
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Shopware\Core\Content\Shared\MailFlow\CustomerCriteriaBuilder">
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Shopware\Core\Content\Shared\MailFlow\CustomerRecoveryCriteriaBuilder">
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Shopware\Core\Content\Shared\MailFlow\UserRecoveryCriteriaBuilder">
            <argument type="service" id="event_dispatcher"/>
        </service>

    </services>
</container>
