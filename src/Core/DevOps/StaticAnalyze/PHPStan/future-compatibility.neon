# Opt-in future-compatibility analysis based on the BC-change attributes
# (Shopware\Core\Framework\Deprecation\BCChange).
#
# Include this file from your project's phpstan.neon to be warned about code that works
# against the current Shopware version but breaks with an announced BC change - so you
# can make it compatible with the current and the next major version ahead of time:
#
#     includes:
#         - vendor/shopware/core/DevOps/StaticAnalyze/PHPStan/future-compatibility.neon
#
# This file is intentionally NOT part of Shopware's own PHPStan configuration: the core
# keeps supporting the current contract until the next major.
services:
    -
        class: Shopware\Core\DevOps\StaticAnalyze\PHPStan\FutureCompatibility\AnnouncedTypeResolver
    -
        class: Shopware\Core\DevOps\StaticAnalyze\PHPStan\FutureCompatibility\FutureCallSiteRule
        tags: [phpstan.rules.rule]
    -
        class: Shopware\Core\DevOps\StaticAnalyze\PHPStan\FutureCompatibility\FutureExtensionRule
        tags: [phpstan.rules.rule]
    -
        class: Shopware\Core\DevOps\StaticAnalyze\PHPStan\FutureCompatibility\FutureReturnTypeExtension
        tags: [phpstan.broker.expressionTypeResolverExtension]
