{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "ContentLayoutDiagnoseResponse": {
                "title": "Content layout diagnose response",
                "type": "object",
                "description": "The response returned by the resolve-and-diagnose route: the per-element property resolutions plus the well-formedness / resolvability report for the supplied draft layout. Never persisted, never cached.",
                "required": ["resolutions", "diagnostics", "applicableBindings"],
                "properties": {
                    "resolutions": {
                        "allOf": [
                            { "$ref": "#/components/schemas/ContentLayoutResolutions" }
                        ],
                        "description": "Per-element property resolutions for the whole tree. Encodes as `{}` when empty.",
                        "readOnly": true
                    },
                    "diagnostics": {
                        "allOf": [
                            { "$ref": "#/components/schemas/ContentLayoutDiagnosticsReport" }
                        ],
                        "description": "The well-formedness / resolvability report. With no source bound (neither `entityType` nor `section`), only intrinsic well-formedness is evaluated and `resolvable` is not meaningful.",
                        "readOnly": true
                    },
                    "applicableBindings": {
                        "type": "object",
                        "description": "Map of element id to the source-qualified binding specification ids (`source:id`) applicable to that element's type, keyed by declared type rather than by the element's actual wiring. Pass an id back as `bindingSpecificationId` to a bind-element action. Encodes as `{}` when no element has an applicable specification; a listed element's own list encodes as `[]` when its type has none.",
                        "additionalProperties": {
                            "type": "array",
                            "items": { "type": "string" }
                        },
                        "readOnly": true,
                        "example": { "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40": ["core:product-title"] }
                    }
                },
                "example": {
                    "resolutions": {
                        "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40": [
                            {
                                "key": "title",
                                "kind": "reference",
                                "required": true,
                                "type": null,
                                "default": null,
                                "fqcn": "Shopware\\Core\\Content\\Product\\SalesChannel\\SalesChannelProductEntity",
                                "resolved": null,
                                "candidates": []
                            }
                        ]
                    },
                    "diagnostics": {
                        "wellFormed": true,
                        "resolvable": false,
                        "violations": [
                            {
                                "code": "unresolved_required",
                                "scope": "binding",
                                "severity": "error",
                                "elementId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40",
                                "key": "title",
                                "message": "Required property \"title\" could not be resolved.",
                                "candidates": []
                            }
                        ]
                    },
                    "applicableBindings": {
                        "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40": ["core:product-title"]
                    }
                }
            }
        }
    }
}
