            "ContentPreviewEntityRequest": {
                "title": "Content preview request",
                "type": "object",
                "description": "An unsaved draft layout plus the real entity and sales-channel context to render it against.",
                "required": ["layout", "entityType", "entityId", "salesChannelId"],
                "properties": {
                    "layout": {
                        "type": "array",
                        "description": "The draft element tree to render. Must be non-empty.",
                        "items": {
                            "$ref": "#/components/schemas/StoredContentElement"
                        },
                        "minItems": 1
                    },
                    "entityType": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The entity type to render against, selected by exact match. One of the values from `GET /api/_info/content-system-entity-types.json`.",
                        "example": "product"
                    },
                    "entityId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Id of the entity to hydrate against; the entity must exist."
                    },
                    "salesChannelId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Sales channel whose context is synthesized for rendering."
                    },
                    "languageId": {
                        "type": ["string", "null"],
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Optional language id overriding the synthesized sales-channel context.",
                        "default": null
                    },
                    "currencyId": {
                        "type": ["string", "null"],
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Optional currency id overriding the synthesized sales-channel context.",
                        "default": null
                    },
                    "domainId": {
                        "type": ["string", "null"],
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Optional domain id overriding the synthesized sales-channel context.",
                        "default": null
                    },
                    "customerId": {
                        "type": ["string", "null"],
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Optional customer id overriding the synthesized sales-channel context.",
                        "default": null
                    },
                    "queryParameters": {
                        "type": "object",
                        "description": "Optional values forwarded as the render request's query parameters; defaults to none. `elementId` selects a single element for partial preview. A member name PHP casts to an integer (`0`, `12`, `-3`) is rejected with 400: the stored envelope is a string-keyed map and cannot carry an integer key.",
                        "additionalProperties": true,
                        "propertyNames": { "pattern": "^(?!-?(0|[1-9][0-9]*)$).+$" },
                        "example": { "elementId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40" }
                    }
                }
            },
            "ContentLayoutDiagnoseRequest": {
                "title": "Content layout diagnose request",
                "type": "object",
                "description": "An unsaved draft layout to resolve and diagnose, plus an optional root source. The whole body is optional; an empty body diagnoses an empty tree.",
                "properties": {
                    "layout": {
                        "type": "array",
                        "description": "The draft element tree to diagnose. Defaults to an empty tree.",
                        "items": {
                            "$ref": "#/components/schemas/StoredContentElement"
                        },
                        "default": []
                    },
                    "rootSource": {
                        "type": ["string", "null"],
                        "description": "Optional root source the draft is resolved against. An entity type (a value from `GET /api/_info/content-system-entity-types.json`), a section (`header`, `footer`), or `none`. With it unset, only intrinsic well-formedness is evaluated.",
                        "default": null,
                        "example": "product"
                    }
                }
            }
        }
    }
