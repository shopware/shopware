                                "type": ["integer", "null"],
                                "minimum": 0,
                                "description": "Zero-based position within the target list. A null, negative, or out-of-range value appends at the end.",
                                "default": null
                            },
                            "bindingSpecificationId": {
                                "type": ["string", "null"],
                                "description": "Optional source-qualified id (`source:id`) of a binding specification to apply onto the inserted element atomically after scaffold, in the same committed edit. A value from the `bindingSpecifications` map on the element's type entry in `GET /api/_info/content-system-element-types.json`. The specification's declared `type` must equal `type` (else `400 bindingTypeMismatch`); an unregistered id is rejected with `400 bindingSpecificationNotFound`. The op throws before the repository write, so nothing is persisted on either failure.",
                                "default": null,
                                "example": "core:Sw:Media:Image"
                            }
                        }
                    }
                ]
            },
