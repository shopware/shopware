{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "ContentPage": {
                "title": "Content page",
                "type": "object",
                "description": "A rendered content page: layout metadata plus the fully hydrated element trees. Returned by the preview route in the full format, the same structure the Store API content routes serve.",
                "required": ["apiAlias", "layoutId", "layoutName", "elements"],
                "properties": {
                    "layoutId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Id of the rendered layout. For a preview this is a synthetic id, since the previewed layout is not persisted.",
                        "readOnly": true,
                        "example": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a3b"
                    },
                    "layoutName": {
                        "type": "string",
                        "description": "Name of the rendered layout. `preview` for a preview render.",
                        "readOnly": true,
                        "example": "preview"
                    },
                    "layoutVersion": {
                        "type": ["string", "null"],
                        "description": "Version of the rendered layout, or `null` when unversioned.",
                        "readOnly": true
                    },
                    "elements": {
                        "type": "array",
                        "description": "The hydrated root elements of the page. After hydration an element's `properties` carry both static values and loaded data merged together.",
                        "items": {
                            "$ref": "#/components/schemas/ContentElement"
                        },
                        "readOnly": true
                    },
                    "apiAlias": {
                        "type": "string",
                        "const": "content_page",
                        "description": "The API alias identifying this object as a content page.",
                        "readOnly": true
                    }
                },
                "example": {
                    "apiAlias": "content_page",
                    "layoutId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a3b",
                    "layoutName": "preview",
                    "layoutVersion": null,
                    "elements": [
                        {
                            "id": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40",
                            "component": "shopware/product-heading",
                            "properties": { "tag": "h1", "title": "Example product" }
                        }
                    ]
                }
            }
        }
    }
}
