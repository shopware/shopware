{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "SalesChannelAnalyticsData": {
                "type": "object",
                "description": "Sales channel analytics configuration",
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "_uniqueIdentifier": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "versionId": {
                        "type": "string",
                        "nullable": true
                    },
                    "translated": {
                        "type": "array",
                        "items": { "type": "object" }
                    },
                    "trackingId": {
                        "type": "string",
                        "description": "Google Analytics tracking ID (e.g., UA-XXXXX-Y or G-XXXXXXXX)"
                    },
                    "active": {
                        "type": "boolean",
                        "description": "Whether Google Analytics tracking is enabled"
                    },
                    "trackOrders": {
                        "type": "boolean",
                        "description": "Track order completions in Google Analytics"
                    },
                    "anonymizeIp": {
                        "type": "boolean",
                        "description": "Anonymize visitor IP addresses for GDPR compliance"
                    },
                    "trackOffcanvasCart": {
                        "type": "boolean",
                        "description": "Track off-canvas cart interactions in Google Analytics"
                    },
                    "salesChannel": {
                        "type": "object",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["sales_channel_analytics"]
                    }
                },
                "required": ["id", "active", "trackOrders", "anonymizeIp", "trackOffcanvasCart", "createdAt", "apiAlias"]
            },
            "SalesChannelAnalyticsListResponse": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SalesChannelAnalyticsData"
                        }
                    },
                    "aggregations": {
                        "type": "array",
                        "items": { "type": "object" }
                    }
                },
                "required": ["total", "data"]
            },
            "SalesChannelAnalyticsSingleResponse": {
                "type": "object",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/SalesChannelAnalyticsData"
                    }
                },
                "required": ["data"]
            }
        }
    }
}
