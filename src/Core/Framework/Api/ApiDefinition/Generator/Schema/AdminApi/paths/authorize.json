{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/oauth/authorize": {
            "get": {
                "tags": ["Authorization & Authentication"],
                "summary": "Start an authorization code flow",
                "description": "Authorization endpoint of the OAuth 2.0 authorization code grant with PKCE for registered public clients (for example `shopware-cli`). Open this URL in the user's browser. The user is forwarded to the Administration, asked to log in if necessary, and shown a consent page. After the decision the browser is redirected to the `redirect_uri` with either `code` and `state` or `error` and `state`. Exchange the code at `/oauth/token` with `grant_type=authorization_code` and the PKCE `code_verifier`.",
                "operationId": "authorize",
                "security": [],
                "parameters": [
                    {
                        "name": "response_type",
                        "in": "query",
                        "required": true,
                        "schema": { "type": "string", "enum": ["code"] }
                    },
                    {
                        "name": "client_id",
                        "in": "query",
                        "description": "Identifier of a public OAuth client registered under `shopware.api.oauth_clients`.",
                        "required": true,
                        "schema": { "type": "string" }
                    },
                    {
                        "name": "redirect_uri",
                        "in": "query",
                        "description": "One of the redirect URIs registered for the client. Loopback URIs (`http://127.0.0.1`, `http://[::1]`) may use any port.",
                        "required": true,
                        "schema": { "type": "string", "format": "uri" }
                    },
                    {
                        "name": "state",
                        "in": "query",
                        "description": "Opaque value that is returned unchanged to the client to bind the response to the request.",
                        "required": false,
                        "schema": { "type": "string" }
                    },
                    {
                        "name": "scope",
                        "in": "query",
                        "required": false,
                        "schema": { "$ref": "#/components/schemas/OAuthScopes" }
                    },
                    {
                        "name": "code_challenge",
                        "in": "query",
                        "description": "PKCE code challenge, the base64url encoded SHA-256 hash of the `code_verifier`.",
                        "required": true,
                        "schema": { "type": "string", "minLength": 43, "maxLength": 128 }
                    },
                    {
                        "name": "code_challenge_method",
                        "in": "query",
                        "required": true,
                        "schema": { "type": "string", "enum": ["S256"] }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the consent page of the Administration, or back to the `redirect_uri` with an `error` parameter when the request is invalid but the redirect URI is registered for the client."
                    },
                    "400": { "$ref": "#/components/responses/400" },
                    "401": { "$ref": "#/components/responses/401" }
                }
            },
            "post": {
                "tags": ["Authorization & Authentication"],
                "summary": "Approve or deny an authorization request",
                "description": "Used by the consent page of the Administration. Completes the authorization request on behalf of the authenticated user and returns the redirect URI for the browser. The URI contains the authorization code, or `error=access_denied` when the user denied the request. Requires a user-bound access token; integration tokens cannot approve requests.",
                "operationId": "approveAuthorization",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    { "$ref": "#/components/schemas/OAuthAuthorizationRequest" },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "approved": {
                                                "description": "Whether the user granted access to the client.",
                                                "type": "boolean"
                                            }
                                        },
                                        "required": ["approved"]
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The authorization request was completed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["redirectUri"],
                                    "properties": {
                                        "redirectUri": {
                                            "description": "URI the browser has to be sent to. Contains `code` and `state`, or `error` and `state`.",
                                            "type": "string",
                                            "format": "uri"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": { "$ref": "#/components/responses/400" },
                    "401": { "$ref": "#/components/responses/401" },
                    "403": { "$ref": "#/components/responses/403" }
                }
            }
        },
        "/oauth/authorize/info": {
            "get": {
                "tags": ["Authorization & Authentication"],
                "summary": "Describe an authorization request",
                "description": "Validates the authorization request and returns the information the consent page displays before the user decides.",
                "operationId": "authorizationInfo",
                "parameters": [
                    { "name": "response_type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["code"] } },
                    { "name": "client_id", "in": "query", "required": true, "schema": { "type": "string" } },
                    { "name": "redirect_uri", "in": "query", "required": true, "schema": { "type": "string", "format": "uri" } },
                    { "name": "state", "in": "query", "required": false, "schema": { "type": "string" } },
                    { "name": "scope", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/OAuthScopes" } },
                    { "name": "code_challenge", "in": "query", "required": true, "schema": { "type": "string" } },
                    { "name": "code_challenge_method", "in": "query", "required": true, "schema": { "type": "string", "enum": ["S256"] } }
                ],
                "responses": {
                    "200": {
                        "description": "The authorization request is valid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["client", "redirectUri", "scopes"],
                                    "properties": {
                                        "client": {
                                            "type": "object",
                                            "required": ["id", "name"],
                                            "properties": {
                                                "id": { "type": "string" },
                                                "name": { "description": "Display name of the client.", "type": "string" }
                                            }
                                        },
                                        "redirectUri": { "type": "string", "format": "uri" },
                                        "scopes": { "type": "array", "items": { "type": "string" } }
                                    }
                                }
                            }
                        }
                    },
                    "400": { "$ref": "#/components/responses/400" },
                    "401": { "$ref": "#/components/responses/401" }
                }
            }
        }
    }
}
