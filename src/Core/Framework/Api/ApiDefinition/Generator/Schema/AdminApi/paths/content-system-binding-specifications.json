{
    "openapi": "3.1.0",
    "info": {
        "title": "Content System Binding Specifications",
        "version": "1.0.0"
    },
    "paths": {
        "\/_info\/content-system-binding-specifications.json": {
            "get": {
                "tags": [
                    "System Info & Health Check"
                ],
                "summary": "Get content system binding specifications",
                "description": "Get all registered content system binding specifications, keyed by their source-qualified id.",
                "operationId": "content-system-binding-specifications",
                "responses": {
                    "200": {
                        "description": "Returns the registered binding specifications keyed by their source-qualified id (`source:id`). Encodes as `{}` when no specification is registered.",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["bindingSpecifications"],
                                    "properties": {
                                        "bindingSpecifications": {
                                            "type": "object",
                                            "description": "Map of source-qualified binding specification id (`source:id`) to its specification. The same id a client receives from an element's `applicableBindings` entry and passes back as `bindingSpecificationId` to the bind-element actions.",
                                            "additionalProperties": {
                                                "type": "object",
                                                "required": ["id", "type", "label", "promoted", "resolves", "inputs"],
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "description": "The bare id declared by the specification (without the source prefix)."
                                                    },
                                                    "type": {
                                                        "type": "string",
                                                        "description": "The element type this specification applies to. A registered type name; see `GET /api/_info/content-system-element-types.json`."
                                                    },
                                                    "label": {
                                                        "type": "string",
                                                        "description": "Human-readable label for the specification."
                                                    },
                                                    "promoted": {
                                                        "type": "boolean",
                                                        "description": "Pure catalog metadata: whether the author promotes this specification as the primary choice for its type. No server behavior reads it; at most one specification is promoted per type across the aggregated registry."
                                                    },
                                                    "resolves": {
                                                        "type": ["object", "array"],
                                                        "description": "Map of reference property key to the loader wiring that fills it. Encodes as `[]` when the specification wires no reference property.",
                                                        "additionalProperties": {
                                                            "type": "object",
                                                            "required": ["loader", "config"],
                                                            "properties": {
                                                                "loader": {
                                                                    "type": "string",
                                                                    "description": "The data loader source that fills the property."
                                                                },
                                                                "config": {
                                                                    "type": ["object", "array"],
                                                                    "description": "The loader's config for this wiring. Encodes as `[]` when the loader takes no config.",
                                                                    "additionalProperties": true
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "inputs": {
                                                        "type": ["object", "array"],
                                                        "description": "Map of primitive property key to its residual input declaration. Encodes as `[]` when the specification declares no residual input. Each entry always carries `required`; `default` is present only when the specification declares one — presence of the key, not its value, distinguishes \"no default\" from \"default is null\".",
                                                        "additionalProperties": {
                                                            "type": "object",
                                                            "required": ["required"],
                                                            "properties": {
                                                                "required": {
                                                                    "type": "boolean",
                                                                    "description": "Whether the target element must carry a value for this property: derived from a specification-required propertyReference config key whose target reference property is declared required:true on the type. Not authorable directly."
                                                                },
                                                                "default": {
                                                                    "description": "The property's seeded default value, applied only when the target element does not already carry the key."
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
