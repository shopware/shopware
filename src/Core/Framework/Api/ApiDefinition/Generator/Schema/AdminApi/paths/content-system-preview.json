{
    "openapi": "3.1.0",
    "info": [],
    "paths": {
        "/_action/content-system/preview/entity": {
            "post": {
                "tags": ["Content System"],
                "summary": "Preview a draft layout against real entity data",
                "operationId": "contentSystemPreviewEntity",
                "description": "Renders an externally supplied, unsaved draft layout against real entity data and returns a fully hydrated `ContentPage` in the full format. The layout is neither persisted nor required to have an assignment; the target entity only needs to exist. A `SalesChannelContext` is synthesized from `salesChannelId` (optionally overridden by `languageId`/`currencyId`/`domainId`/`customerId`), and `queryParameters` are forwarded as the render request's query (where `elementId` selects a single element for partial preview). Requires the `content_layout:read` privilege. The render is always fresh: no persistence, no caching. A missing or invalid envelope field, an `entityType` matching no source, or a layout with an intrinsic defect is rejected with `400`.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/ContentPreviewEntityRequest" },
                            "examples": {
                                "minimal": {
                                    "summary": "Preview a single element against a product",
                                    "value": {
                                        "layout": [
                                            {
                                                "id": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40",
                                                "component": "shopware/product-heading",
                                                "properties": { "tag": "h1" },
                                                "dataRequirements": {
                                                    "product": { "key": "product", "source": "entity", "config": { "entity": "product", "property": "product_id" } }
                                                }
                                            }
                                        ],
                                        "entityType": "product",
                                        "entityId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2b01",
                                        "salesChannelId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2c02"
                                    }
                                },
                                "withContextOverrides": {
                                    "summary": "Preview with language and partial-render selection",
                                    "value": {
                                        "layout": [
                                            { "id": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40", "component": "shopware/product-heading", "properties": { "tag": "h1" } }
                                        ],
                                        "entityType": "product",
                                        "entityId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2b01",
                                        "salesChannelId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2c02",
                                        "languageId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2d03",
                                        "queryParameters": { "elementId": "0188fa1b2c3d4e5f6a7b8c9d0e1f2a40" }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The fully hydrated content page. Not persisted, not cached.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/ContentPage" }
                            }
                        }
                    },
                    "400": { "$ref": "#/components/responses/400" }
                }
            }
        },
        "/_action/content-system/preview/entity/url": {
            "post": {
                "tags": ["Content System"],
                "summary": "Create a shareable preview URL for a draft layout",
                "operationId": "contentSystemPreviewEntityUrl",
                "description": "Stores an externally supplied draft-layout preview payload behind a short-lived token and returns a URL that renders it. Same envelope as the entity preview action. Requires the `content_layout:read` privilege.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": { "$ref": "#/components/schemas/ContentPreviewEntityRequest" }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "A URL that renders the stored draft layout preview.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": { "url": { "type": "string" } },
                                    "required": ["url"]
                                }
                            }
                        }
                    },
                    "400": { "$ref": "#/components/responses/400" }
                }
            }
        }
    }
}
