{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/_action/sales-channel/{salesChannelId}/maintenance-password": {
            "get": {
                "tags": ["Sales Channel"],
                "summary": "Check whether a sales channel maintenance password is set",
                "description": "Returns only whether a maintenance password is set. Neither the password nor its hash is returned.",
                "operationId": "getSalesChannelMaintenancePasswordStatus",
                "parameters": [
                    {
                        "name": "salesChannelId",
                        "in": "path",
                        "required": true,
                        "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Whether a maintenance password is set.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["isSet"],
                                    "properties": {
                                        "isSet": {"type": "boolean"}
                                    }
                                }
                            }
                        }
                    },
                    "403": {"$ref": "#/components/responses/403"},
                    "404": {"$ref": "#/components/responses/404"}
                }
            },
            "post": {
                "tags": ["Sales Channel"],
                "summary": "Set or remove the sales channel maintenance password",
                "description": "Stores a password hash without returning the password or hash. Send an empty password to remove the password gate.",
                "operationId": "saveSalesChannelMaintenancePassword",
                "parameters": [
                    {
                        "name": "salesChannelId",
                        "in": "path",
                        "required": true,
                        "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["password"],
                                "properties": {
                                    "password": {
                                        "type": "string",
                                        "minLength": 0,
                                        "maxLength": 4096,
                                        "description": "An empty string removes the password. Otherwise the password must contain between 12 and 4096 characters."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "204": {"description": "Password saved or removed."},
                    "400": {"$ref": "#/components/responses/400"},
                    "403": {"$ref": "#/components/responses/403"},
                    "404": {"$ref": "#/components/responses/404"}
                }
            }
        }
    }
}
