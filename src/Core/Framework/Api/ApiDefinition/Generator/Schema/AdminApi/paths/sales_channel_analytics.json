{
    "openapi": "3.1.0",
    "info": [],
    "paths": {
        "/sales-channel-analytics": {
            "get": {
                "tags": ["Sales Channel Analytics"],
                "summary": "List sales channel analytics configurations",
                "description": "Returns a list of Google Analytics configurations for sales channels.",
                "operationId": "getSalesChannelAnalyticsList",
                "responses": {
                    "200": {
                        "description": "List of analytics configurations",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SalesChannelAnalyticsListResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/sales-channel-analytics/{id}": {
            "get": {
                "tags": ["Sales Channel Analytics"],
                "summary": "Get a sales channel analytics configuration",
                "description": "Returns a single Google Analytics configuration for a sales channel.",
                "operationId": "getSalesChannelAnalytics",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identifier of the analytics configuration",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Analytics configuration details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SalesChannelAnalyticsSingleResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Analytics configuration not found"
                    }
                }
            }
        }
    }
}
