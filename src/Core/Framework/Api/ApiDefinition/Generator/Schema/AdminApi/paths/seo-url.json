{
    "openapi": "3.1.0",
    "info": [],
    "paths": {
        "\/_action\/seo-url\/store-api-configs": {
            "get": {
                "tags": [
                    "SEO"
                ],
                "summary": "Get the store-api SEO URL route configs",
                "description": "Returns the store-api SEO URL route configs used by headless sales channels. When an id is provided, each config also contains its generated base path info.",
                "operationId": "getStoreApiSeoUrlConfigs",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": false,
                        "description": "Foreign key of the entity. When set, each returned config additionally contains the generated base pathInfo for that id.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The store-api SEO URL route configs.",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "routeName": {
                                                "description": "The store-api route name.",
                                                "type": "string"
                                            },
                                            "entityName": {
                                                "description": "The entity the route belongs to.",
                                                "type": "string"
                                            },
                                            "template": {
                                                "description": "The configured SEO URL template.",
                                                "type": "string"
                                            },
                                            "pathInfo": {
                                                "description": "The generated base path info, only present when an id is provided.",
                                                "type": "string"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
