{
  "openapi": "3.2.0",
  "info": {
    "title": "Shopware Services API",
    "version": "v1"
  },
  "paths": {
    "/services/available": {
      "get": {
        "tags": [
          "App System"
        ],
        "summary": "List the Shopware Services offered by the service registry",
        "description": "Returns the services the service registry offers to this shop, whether they are installed or not. Requires the `system.plugin_maintain` permission.",
        "operationId": "getAvailableServices",
        "responses": {
          "200": {
            "description": "The services offered by the service registry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Technical name of the service, matches the `name` of installed services."
                      }
                    }
                  }
                },
                "example": [
                  {
                    "name": "SwagCopilot"
                  }
                ]
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          }
        }
      }
    }
  }
}
