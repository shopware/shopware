{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "Breadcrumb": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "categoryId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "type": {
                        "$ref": "#/components/schemas/Category/properties/type"
                    },
                    "translated": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                            "customFields": {
                                "type": "object"
                            },
                            "linkType": {
                                "$ref": "#/components/schemas/Category/properties/linkType"
                            },
                            "internalLink": {
                                "type": "string"
                            },
                            "externalLink": {
                                "type": "string"
                            },
                            "linkNewTab": {
                                "type": "boolean"
                            },
                            "description": {
                                "type": "string"
                            },
                            "metaTitle": {
                                "type": "string"
                            },
                            "metaDescription": {
                                "type": "string"
                            },
                            "keywords": {
                                "type": "string"
                            }
                        }
                    },
                    "path": {
                        "type": "string"
                    },
                    "seoUrls": {
                        "description": "Reduced seo url rows of this category; not a full SeoUrl entity.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{32}$"
                                },
                                "categoryId": {
                                    "description": "Only present for the parent categories of the breadcrumb.",
                                    "type": "string",
                                    "pattern": "^[0-9a-f]{32}$"
                                },
                                "pathInfo": {
                                    "type": "string"
                                },
                                "seoPathInfo": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "id",
                                "pathInfo",
                                "seoPathInfo"
                            ]
                        }
                    },
                    "apiAlias": {
                        "type": "string",
                        "const": "breadcrumb"
                    }
                },
                "required": [
                    "name",
                    "categoryId",
                    "type",
                    "translated",
                    "path",
                    "apiAlias"
                ]
            }
        }
    }
}
