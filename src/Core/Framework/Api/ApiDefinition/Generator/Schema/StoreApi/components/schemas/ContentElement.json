{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "ContentSlotContent": {
                "type": "object",
                "description": "Container for content elements within a named slot",
                "properties": {
                    "elements": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ContentElement" }
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["content_element_slot_content"]
                    }
                },
                "required": ["apiAlias", "elements"]
            },
            "ContentElement": {
                "type": "object",
                "description": "Content element node in layout tree",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique element identifier"
                    },
                    "component": {
                        "type": "string",
                        "description": "Element component type (e.g., Sw:Grid, Sw:Content:Text, Sw:Product:Card)"
                    },
                    "properties": {
                        "type": "object",
                        "description": "Element properties keyed by property name. An empty map is serialized as `[]` (consistent with Shopware's JSON-map fields).",
                        "additionalProperties": true
                    },
                    "slots": {
                        "description": "Named slots containing child elements",
                        "oneOf": [
                            {
                                "type": "array",
                                "maxItems": 0
                            },
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "$ref": "#/components/schemas/ContentSlotContent"
                                }
                            }
                        ]
                    },
                    "style": {
                        "type": "object",
                        "description": "Universal presentation options keyed by option wire name. Each value is either a single scalar (a flat option) or an object keyed by breakpoint (xs, sm, md, lg, xl, xxl) for a breakpoint-aware option, per the option's breakpointAware flag in the style-option introspection schema. Omitted when empty.",
                        "additionalProperties": {
                            "oneOf": [
                                { "type": ["string", "integer", "number", "boolean"] },
                                { "type": "object", "additionalProperties": { "type": ["string", "integer", "number", "boolean"] } }
                            ]
                        }
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["content_element"]
                    }
                },
                "required": ["apiAlias", "id", "component"]
            }
        }
    }
}
