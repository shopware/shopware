{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "ContentPage": {
                "type": "object",
                "description": "Layout metadata with fully hydrated element trees.",
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "name": {
                        "type": "string"
                    },
                    "version": {
                        "type": ["string", "null"]
                    },
                    "settings": {
                        "description": "Page-level settings authored on the layout, such as the scroll navigation. Always present; an empty map is serialized as `[]` (consistent with Shopware's JSON-map fields).",
                        "oneOf": [
                            {
                                "type": "array",
                                "maxItems": 0,
                                "description": "The empty settings map, serialized as `[]`."
                            },
                            {
                                "type": "object",
                                "additionalProperties": true
                            }
                        ]
                    },
                    "elements": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ContentElement" }
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["content_page"]
                    }
                },
                "required": ["apiAlias", "id", "name", "version", "settings", "elements"]
            }
        }
    }
}
