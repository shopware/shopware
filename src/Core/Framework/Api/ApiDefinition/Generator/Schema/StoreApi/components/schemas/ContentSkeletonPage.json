                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "name": {
                        "type": "string"
                    },
                    "version": {
                        "type": ["string", "null"]
                    },
                    "elements": {
                        "type": "array",
