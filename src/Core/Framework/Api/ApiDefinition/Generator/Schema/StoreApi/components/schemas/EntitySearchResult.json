{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "EntitySearchResult": {
                "type": "object",
                "properties": {
                    "entity": {
                        "type": "string"
                    },
                    "total": {
                        "type": "integer",
                        "description": "The total number of found entities"
                    },
                    "aggregations": {
                        "description": "Contains aggregated data keyed by the aggregation name. A simple example is the determination of the average price from a product search query. An empty array is returned when no aggregations were requested.",
                        "anyOf": [
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "object"
                                }
                            },
                            {
                                "type": "array",
                                "maxItems": 0
                            }
                        ]
                    },
                    "page": {
                        "type": "integer",
                        "description": "The actual page. This can be used for pagination."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "The actual limit. This is used for pagination and goes together with the page."
                    }
                }
            }
        }
    }
}
