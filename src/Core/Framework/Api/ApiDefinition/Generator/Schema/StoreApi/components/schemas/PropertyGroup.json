{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "PropertyGroup": {
                "description": "Added since version: 6.0.0.0",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "displayType": {
                        "description": "Property groups can be displayed in the form of text, image, dropdown or color.",
                        "type": "string"
                    },
                    "sortingType": {
                        "description": "Sorting the property group by name or position.",
                        "type": "string"
                    },
                    "filterable": {
                        "description": "When set to true, the property will be displayed in the product filter of product lists.",
                        "type": "boolean"
                    },
                    "visibleOnProductDetailPage": {
                        "description": "When set to true, the property groups are displayed on product detail page.",
                        "type": "boolean"
                    },
                    "position": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "customFields": {
                        "type": "object"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "translated": {
                        "type": "object"
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PropertyGroupOption"
                        }
                    }
                },
                "type": "object"
            }
        }
    }
}
