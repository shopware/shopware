{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "SystemConfig": {
                "description": "Added since version: 6.0.0.0",
                "required": [
                    "id",
                    "configurationKey",
                    "configurationValue"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "configurationKey": {
                        "description": "Config key for shop configurations.",
                        "type": "string"
                    },
                    "configurationValue": {
                        "properties": {
                            "_value": {
                                "type": "object"
                            }
                        },
                        "type": "object"
                    },
                    "salesChannelId": {
                        "description": "Unique identity of sales channel.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "salesChannel": {
                        "$ref": "#/components/schemas/SalesChannel"
                    }
                },
                "type": "object"
            }
        }
    }
}
