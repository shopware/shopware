{
    "openapi": "3.1.0",
    "info": [],
    "paths": {
        "/product/{productId}/document/{documentId}/download": {
            "get": {
                "tags": [
                    "Product"
                ],
                "summary": "Download product document",
                "description": "Downloads a document associated with the requested product.",
                "operationId": "downloadProductDocument",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "name": "documentId",
                        "in": "path",
                        "description": "Product document ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "An arbitrary binary file.",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product document not found."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        }
    }
}
