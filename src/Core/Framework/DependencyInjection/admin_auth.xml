<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Shopware\Core\Framework\AdminAuth\Entity\Provider\AdminAuthProviderDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Entity\OauthIdentity\AdminAuthOauthIdentityDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Entity\UserMethod\AdminAuthUserMethodDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <!-- Built-in method settings (enabled / roles / order): YAML gate + runtime system-config layer -->
        <service id="Shopware\Core\Framework\AdminAuth\MethodSettingsService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument>%shopware.admin_auth.mfa.methods%</argument>
            <argument>%shopware.admin_auth.password_login%</argument>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\SecretEncryptor">
            <argument>%kernel.secret%</argument>
        </service>

        <!-- Provider configuration: YAML providers take precedence over admin-UI-managed DB providers -->
        <service id="Shopware\Core\Framework\AdminAuth\Provider\ConfigProviderLoader">
            <argument>%shopware.admin_auth.providers%</argument>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Provider\DalProviderLoader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\SecretEncryptor"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Provider\ProviderRegistry">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Provider\ConfigProviderLoader"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Provider\DalProviderLoader"/>
            <argument>%shopware.admin_auth.admin_ui%</argument>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Provider\ProviderWriteValidator">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Provider\ProviderRegistry"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Encrypts provider client secrets at rest and strips them from Admin API reads -->
        <service id="Shopware\Core\Framework\AdminAuth\Subscriber\ProviderSecretSubscriber">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\SecretEncryptor"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- OIDC authorization code flow -->
        <service id="Shopware\Core\Framework\AdminAuth\Oidc\OidcDiscoveryService">
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Oidc\OidcClient">
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcDiscoveryService"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Oidc\IdTokenValidator">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcClient"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcDiscoveryService"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Oidc\OAuthIdentityMatcher">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="admin_auth_oauth_identity.repository"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <!-- Authoritative OIDC group -> ACL role sync, runs on every OIDC login -->
        <service id="Shopware\Core\Framework\AdminAuth\RoleMapping\SsoRoleSynchronizer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Read access to SSO-managed assignments for the admin UI -->
        <service id="Shopware\Core\Framework\AdminAuth\RoleMapping\SsoRoleAssignmentReader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Oidc\StateService">
            <argument>%kernel.secret%</argument>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <!-- WebAuthn / passkeys: rpId and allowed origin are derived from APP_URL -->
        <service id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnServiceFactory">
            <argument>%env(APP_URL)%</argument>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnService">
            <factory service="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnServiceFactory" method="create"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnChallengeStore">
            <argument>%kernel.secret%</argument>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Controller\AdminAuthController" public="true">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Provider\ProviderRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\MethodSettingsService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcClient"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcDiscoveryService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\StateService"/>
            <argument type="service" id="shopware.api.authorization_server"/>
            <argument type="service" id="Symfony\Bridge\PsrHttpMessage\Factory\PsrHttpFactory"/>
            <argument type="service" id="router"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnChallengeStore"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Self-service MFA enrollment for the profile security tab -->
        <service id="Shopware\Core\Framework\AdminAuth\Controller\AdminAuthMfaController" public="true">
            <argument type="service" id="admin_auth_user_method.repository"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\SecretEncryptor"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnChallengeStore"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\MethodSettingsService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- MFA policy + challenge store + rate limiter -->
        <service id="Shopware\Core\Framework\AdminAuth\Mfa\MfaPolicyService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\MethodSettingsService"/>
            <argument>%shopware.admin_auth.mfa.required%</argument>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Mfa\MfaChallengeStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\Mfa\MfaRateLimiter">
            <argument type="service" id="cache.object"/>
        </service>

        <!-- Primary factor verifiers -->
        <service id="Shopware\Core\Framework\AdminAuth\OAuth\Verifier\OidcVerifier">
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Provider\ProviderRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OidcClient"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\IdTokenValidator"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Oidc\OAuthIdentityMatcher"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\RoleMapping\SsoRoleSynchronizer"/>
            <argument type="service" id="router"/>
            <tag name="shopware.admin_auth.primary_verifier"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\OAuth\Verifier\PasswordVerifier">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\MethodSettingsService"/>
            <tag name="shopware.admin_auth.primary_verifier"/>
        </service>

        <!-- WebAuthn is both a primary factor (discoverable / usernameless passkey login) and a second factor -->
        <service id="Shopware\Core\Framework\AdminAuth\OAuth\Verifier\WebAuthnVerifier">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\WebAuthn\WebAuthnChallengeStore"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\MethodSettingsService"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <argument>%env(APP_URL)%</argument>
            <tag name="shopware.admin_auth.primary_verifier"/>
            <tag name="shopware.admin_auth.second_factor_verifier"/>
        </service>

        <!-- Second factor verifiers -->
        <service id="Shopware\Core\Framework\AdminAuth\OAuth\Verifier\TotpVerifier">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\SecretEncryptor"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <tag name="shopware.admin_auth.second_factor_verifier"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\OAuth\Verifier\RecoveryCodeVerifier">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
            <tag name="shopware.admin_auth.second_factor_verifier"/>
        </service>

        <!-- Builds the admin_primary / admin_second_factor grants for the ApiAuthenticationListener -->
        <service id="Shopware\Core\Framework\AdminAuth\AdminAuthGrantFactory">
            <argument type="tagged_iterator" tag="shopware.admin_auth.primary_verifier"/>
            <argument type="tagged_iterator" tag="shopware.admin_auth.second_factor_verifier"/>
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Mfa\MfaPolicyService"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Mfa\MfaChallengeStore"/>
            <argument type="service" id="shopware.jwt_config"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Mfa\MfaRateLimiter"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <!-- Rejects MFA-pending tokens from every route except the second-factor token exchange -->
        <service id="Shopware\Core\Framework\AdminAuth\PendingTokenGuard">
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Prune expired MFA challenges hourly -->
        <service id="Shopware\Core\Framework\AdminAuth\ScheduledTask\PruneMfaChallengesTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Shopware\Core\Framework\AdminAuth\ScheduledTask\PruneMfaChallengesTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\Framework\AdminAuth\Mfa\MfaChallengeStore"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
