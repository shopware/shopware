<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Entity Definitions -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Entity\ContentLayoutDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <!-- Scaffolding Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Scaffolding\VirtualRootWrapper"/>

        <!-- Output Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Output\PartialRenderer">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Output\ElementTreePruner"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Context\ContextDependencyAnalyzer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Output\SubTreeExtractor"/>
        </service>

        <!-- Event Listeners (Hydration Pipeline) -->
        <!-- Pre-Hydration Listeners -->
        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PreHydration\VirtualRootPreparationSubscriber">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Scaffolding\VirtualRootWrapper"/>
            <tag name="kernel.event_listener"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PreHydration\PlaceholderResolutionSubscriber">
            <tag name="kernel.event_listener"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PreHydration\RedistributeExpansionSubscriber">
            <tag name="kernel.event_listener"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PreHydration\PartialRenderingPreparationSubscriber">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Output\PartialRenderer"/>
            <tag name="kernel.event_listener"/>
        </service>

        <!-- Post-Hydration Listeners -->
        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PostHydration\VirtualRootCleanupSubscriber">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Scaffolding\VirtualRootWrapper"/>
            <tag name="kernel.event_listener"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Event\Listener\PostHydration\PartialRenderingExtractionSubscriber">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Output\PartialRenderer"/>
            <tag name="kernel.event_listener"/>
        </service>

        <!-- Field Serializers -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\DataRequirementsFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContextProvidersFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContextConsumersFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ElementSlotsFieldSerializer" lazy="true">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ElementStyleFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\ContentSystemStyleOptionRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Validation\StyleOptionConstraintDeriver"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\DataRequirementsFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContextProvidersFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContextConsumersFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ElementSlotsFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ElementStyleFieldSerializer"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementListFieldSerializer">
            <argument type="service" id="Symfony\Component\Validator\Validator\ValidatorInterface"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementFieldSerializer"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\LayoutDefaultSeeder"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\AttributionReconciler"/>
            <tag name="shopware.field_serializer"/>
        </service>

        <!-- Write-boundary default seeding (seeds type primitive defaults into every DAL write of the layout field) -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\PrimitiveDefaultProvider"/>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\LayoutDefaultSeeder">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\PrimitiveDefaultProvider"/>
        </service>

        <!-- Content Data Loaders -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoader">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Entity\SalesChannelDefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Cache\EntityCacheTagResolver"/>
            <tag name="content_system.data_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\EntityCollectionLoader\EntityCollectionLoader">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Entity\SalesChannelDefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Cache\EntityCacheTagResolver"/>
            <tag name="content_system.data_loader"/>
        </service>

        <!-- Data Loader Provider with Tagged Locator -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderProvider">
            <argument type="tagged_locator" tag="content_system.data_loader" default-index-method="getRequirementType"/>
        </service>

        <!-- Config Serializers -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoaderConfigSerializer">
            <tag name="content_system.config_serializer"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\EntityCollectionLoader\EntityCollectionLoaderConfigSerializer">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\EntityLoader\EntityLoaderConfigSerializer"/>
            <tag name="content_system.config_serializer"/>
        </service>

        <!-- Config Serializer Provider with Tagged Locator -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider">
            <argument type="tagged_locator" tag="content_system.config_serializer" default-index-method="getSource"/>
        </service>

        <!-- Config canonicalization for structural comparison (dedup hash, attribution reconciliation) -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\ConfigCanonicalizer"/>

        <!-- Data Context Resolution -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataContext\DataContextResolver">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataContext\ContextPathResolver"/>
        </service>

        <!-- Context Path Resolver -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\DataContext\ContextPathResolver"/>

        <!-- Cache Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Cache\EntityCacheTagResolver"/>

        <service id="Shopware\Core\Framework\ContentSystem\Cache\CacheFinalizer">
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheTagCollector"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Cache\CacheInvalidationSubscriber">
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Cache\EntityCacheTagResolver"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>

            <tag name="kernel.event_listener"/>
        </service>

        <!-- Hydration Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Hydration\ContentElementHydrator">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderProvider"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataContext\DataContextResolver"/>
        </service>

        <!-- Layout Context Utilities -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Context\ContextDependencyAnalyzer"/>

        <!-- Output Services (Post-Hydration Processing) -->
        <service id="Shopware\Core\Framework\ContentSystem\Output\ElementTreePruner"/>
        <service id="Shopware\Core\Framework\ContentSystem\Output\SubTreeExtractor"/>

        <!-- Entity Layout Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\FactoryHelper\EntityLayoutResolver"/>
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\FactoryHelper\EntityLayoutContextFactory">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\FactoryHelper\EntityLayoutResolver"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\RootContextMapper"/>
        </service>

        <!-- Domain-Aware Layout Resolution (Header/Footer) -->
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\FactoryHelper\DomainAwareLayoutResolver"/>

        <service id="Shopware\Core\Framework\ContentSystem\Adapter\FactoryHelper\NavigationAliasResolver"/>

        <!-- Helper Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Helper\ContentLayoutMetadataDeriver"/>

        <!-- Content Pipeline -->
        <service id="Shopware\Core\Framework\ContentSystem\ContentPipeline" public="true">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\ContentElementHydrator"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <!-- Rendering Specification Factory -->
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\RenderingSpecificationFactory"/>

        <!-- Section Resolvers -->
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\RenderingSpecificationResolver">
            <argument type="tagged_iterator" tag="content_system.entity_specification_source"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\RenderingSpecificationFactory"/>
            <tag name="content_system.section_resolver" section="main"/>
        </service>

        <!-- Output Format Handlers -->
        <service id="Shopware\Core\Framework\ContentSystem\Output\Format\FullResponseFactory">
            <tag name="content_system.output_format" format="full"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Output\Format\SkeletonResponseFactory">
            <tag name="content_system.output_format" format="skeleton"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Output\Format\DataResponseFactory">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <tag name="content_system.output_format" format="data"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Output\Format\DecomposedResponseFactory">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <tag name="content_system.output_format" format="decomposed"/>
        </service>

        <!-- Schema Services -->
        <service id="Shopware\Core\Framework\ContentSystem\Schema\ContentSystemDataLoaderTypeResolver">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderProvider"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Schema\ContentSystemDataLoaderTypeSchemaGenerator">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Schema\ContentSystemDataLoaderTypeResolver"/>
        </service>

        <!-- Element Type System -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Serialization\ElementTypeSpecificationSerializer"/>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Loader\ElementTypeNameResolver"/>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Validation\ElementTypeCollisionDetector">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Loader\YamlTypeLoader">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Serialization\ElementTypeSpecificationSerializer"/>
            <argument type="service" id="validator"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Loader\ElementTypeNameResolver"/>
            <argument key="$directories" type="collection"/>
            <tag name="content_system.type_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Loader\DatabaseTypeLoader">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Serialization\ElementTypeSpecificationSerializer"/>
            <argument type="service" id="validator"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument>%kernel.environment%</argument>
            <argument type="service" id="logger"/>
            <tag name="content_system.type_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry">
            <argument type="tagged_iterator" tag="content_system.type_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\CachedContentSystemElementTypeRegistry"
                 decorates="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\CachedContentSystemElementTypeRegistry.inner"/>
            <argument type="service" id="cache.system"/>
        </service>

        <!-- Universal Style Option System -->
        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Serialization\StyleOptionSpecificationSerializer"/>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Validation\StyleOptionCollisionDetector">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\ContentSystemStyleOptionRegistry"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Validation\StyleOptionConstraintDeriver"/>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Loader\YamlStyleOptionLoader">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Serialization\StyleOptionSpecificationSerializer"/>
            <argument type="service" id="validator"/>
            <argument key="$directories" type="collection"/>
            <tag name="content_system.style_option_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Loader\DatabaseStyleOptionLoader">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Serialization\StyleOptionSpecificationSerializer"/>
            <argument type="service" id="validator"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument>%kernel.environment%</argument>
            <argument type="service" id="logger"/>
            <tag name="content_system.style_option_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\ContentSystemStyleOptionRegistry">
            <argument type="tagged_iterator" tag="content_system.style_option_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\CachedContentSystemStyleOptionRegistry"
                 decorates="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\ContentSystemStyleOptionRegistry">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Element\Style\Registry\CachedContentSystemStyleOptionRegistry.inner"/>
            <argument type="service" id="cache.system"/>
        </service>

        <!-- Binding Specification System -->
        <service id="Shopware\Core\Framework\ContentSystem\Binding\Serialization\BindingSpecificationSerializer"/>

        <service id="Shopware\Core\Framework\ContentSystem\Binding\Loader\YamlBindingSpecificationLoader">
            <argument key="$directories" type="collection"/>
            <argument key="$serializer" type="service" id="Shopware\Core\Framework\ContentSystem\Binding\Serialization\BindingSpecificationSerializer"/>
            <argument key="$validator" type="service" id="validator"/>
            <tag name="content_system.binding_specification_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Binding\Loader\DatabaseBindingSpecificationLoader">
            <argument>%kernel.environment%</argument>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\Serialization\BindingSpecificationSerializer"/>
            <argument type="service" id="validator"/>
            <tag name="content_system.binding_specification_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Binding\Registry\ContentSystemBindingSpecificationRegistry">
            <argument type="tagged_iterator" tag="content_system.binding_specification_loader"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Binding\Registry\CachedContentSystemBindingSpecificationRegistry"
                 decorates="Shopware\Core\Framework\ContentSystem\Binding\Registry\ContentSystemBindingSpecificationRegistry">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\Registry\CachedContentSystemBindingSpecificationRegistry.inner"/>
            <argument type="service" id="cache.system"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Binding\Validation\TypeConsistentBindingSpecificationValidator">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\RootContextMapper"/>

            <tag name="validator.constraint_validator"/>
        </service>

        <!-- Write-seam attribution reconciliation: keeps a stored attributedSpecifications entry honest against current wiring -->
        <service id="Shopware\Core\Framework\ContentSystem\Binding\AttributionReconciler">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\Registry\ContentSystemBindingSpecificationRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\ConfigCanonicalizer"/>
        </service>

        <!-- Per-element applicable binding specification ids, response-assembly-layer only -->
        <service id="Shopware\Core\Framework\ContentSystem\Binding\ApplicableBindingsResolver">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\Registry\ContentSystemBindingSpecificationRegistry"/>
        </service>

        <!-- Root-source authority: the valid set of root sources (entity types + sections + none) and their resolution -->
        <service id="Shopware\Core\Framework\ContentSystem\Adapter\NoneSpecificationSource"/>

        <service id="Shopware\Core\Framework\ContentSystem\Adapter\RootSourceRegistry">
            <argument key="$entitySources" type="tagged_iterator" tag="content_system.entity_specification_source"/>
            <argument key="$sectionSources" type="tagged_locator" tag="content_system.specification_source" index-by="section"/>
            <!-- $entityTypes set by ContentLayoutAssignableCompilerPass -->
            <argument key="$entityTypes" type="collection"/>
            <argument key="$noneSource" type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\NoneSpecificationSource"/>
        </service>

        <!-- Content Route Loader (arg 0 set by ContentRouteCompilerPass) -->
        <service id="Shopware\Core\Framework\ContentSystem\SalesChannel\Routing\ContentRouteLoader">
            <argument/>
            <tag name="routing.loader"/>
        </service>

        <!-- Resolution & Diagnostics -->
        <service id="Shopware\Core\Framework\ContentSystem\Resolution\AvailableContextResolver" public="true">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Resolution\ElementResolver"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Resolution\ElementResolver">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Schema\ContentSystemDataLoaderTypeResolver"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderConfigSerializerProvider"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderProvider"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Diagnostics\RootContextMapper">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Hydration\DataLoader\DataLoaderProvider"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Diagnostics\LayoutDiagnostics">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Resolution\AvailableContextResolver"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Resolution\ElementResolver"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Type\Registry\ContentSystemElementTypeRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\RootContextMapper"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Validation\LayoutGate">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\LayoutDiagnostics"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Validation\ViolationConstraintMapper"/>

        <service id="Shopware\Core\Framework\ContentSystem\Validation\LayoutTreeDecoder">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Entity\ContentLayoutDefinition"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementListFieldSerializer"/>
        </service>

        <!-- Shared read of a layout's immutable root source (in-flight write batch first, then committed row) -->
        <service id="Shopware\Core\Framework\ContentSystem\Validation\LayoutRootSourceReader">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <!-- Resolvability gate (DAL PreWriteValidationEvent) -->
        <service id="Shopware\Core\Framework\ContentSystem\Validation\ContentLayoutWriteValidator">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Validation\LayoutGate"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Validation\ViolationConstraintMapper"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Validation\LayoutTreeDecoder"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\RootSourceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Validation\LayoutRootSourceReader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Validation\ContentLayoutAssignmentWriteValidator">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Validation\LayoutRootSourceReader"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Shared draft-layout decode (structural gate) for the preview, diagnose and mutation routes -->
        <service id="Shopware\Core\Framework\ContentSystem\Api\DraftLayoutDecoder">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Layout\Field\ContentElementFieldSerializer"/>
        </service>

        <!-- Remaps the serializer's ExtraAttributesException to a content-system 400 for the strict-mapped admin routes -->
        <service id="Shopware\Core\Framework\ContentSystem\Api\UnknownRequestFieldExceptionListener">
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Layout Validation -->
        <service id="Shopware\Core\Framework\ContentSystem\DraftLayoutChecker">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\LayoutDiagnostics"/>
        </service>

        <!-- Resolve-and-diagnose Action (Admin API) -->
        <service id="Shopware\Core\Framework\ContentSystem\Api\ContentDiagnoseController" public="true">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Api\DraftLayoutDecoder"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Diagnostics\LayoutDiagnostics"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\RootSourceRegistry"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Binding\ApplicableBindingsResolver"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Api\ContentPreviewPageBuilder">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextService"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Adapter\RenderingSpecificationResolver"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Api\DraftLayoutDecoder"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\DraftLayoutChecker"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\ContentPipeline"/>
        </service>

        <service id="Shopware\Core\Framework\ContentSystem\Api\ContentPreviewPayloadStore">
            <argument type="service" id="cache.system"/>
        </service>

        <!-- Preview Action (Admin API) -->
        <service id="Shopware\Core\Framework\ContentSystem\Api\ContentPreviewController" public="true">
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Api\ContentPreviewPageBuilder"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Output\Format\FullResponseFactory"/>
            <argument type="service" id="Shopware\Core\Framework\ContentSystem\Api\ContentPreviewPayloadStore"/>
        </service>

        <!-- Mutation Pipeline -->
        <service id="Shopware\Core\Framework\ContentSystem\Mutation\MutationPipeline">
