<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="Shopware\Core\Framework\SystemCheck\Command\SystemCheckCommand">
            <argument type="service" id="Shopware\Core\Framework\SystemCheck\SystemChecker"/>

            <tag name="console.command"/>
        </service>

        <service id="Shopware\Core\Framework\SystemCheck\SystemChecker">
            <argument type="tagged_iterator" tag="shopware.system_check"/>
        </service>

        <service id="Shopware\Core\Framework\SystemCheck\SystemHeartbeat">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="cache.system"/>

            <tag name="shopware.system_check"/>
        </service>

        <service id="Shopware\Core\Framework\SystemCheck\ScheduledTask\SystemCheckTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Shopware\Core\Framework\SystemCheck\ScheduledTask\SystemCheckTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\Framework\SystemCheck\SystemChecker"/>

            <tag name="messenger.message_handler" />
        </service>

    </services>
</container>
