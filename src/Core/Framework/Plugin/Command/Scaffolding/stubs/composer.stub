{
    "name": "{{ composerName }}",
    "description": "{{ composerName }}",
    "type": "shopware-platform-plugin",
    "version": "0.1.0",
    "require": {
        "shopware/core": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "{{ namespace }}\\{{ className }}",
        "label": {
            "de-DE": "{{ className }}",
            "en-GB": "{{ className }}"
        }
    },
    "autoload": {
        "psr-4": {
            "{{ namespace }}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{ namespace }}\\Tests\\": "tests/"
        }
    }
}
