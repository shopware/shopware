<div style="font-family: arial; font-size: 12px;">
    <p>
        We have received your cancellation request for the contract with the number {{ cancellationRequestFormData.contractNumber }}
    </p>
    <p>
        Further information:
        <br/>
        First name: {{ cancellationRequestFormData.firstName }}
        <br/>
        Last name: {{ cancellationRequestFormData.lastName }}
        <br/>
        Email address: {{ cancellationRequestFormData.email }}
        <br/>
        Contract number (order number, subscription number, ...): {{ cancellationRequestFormData.contractNumber }}
        <br/>
        Comment:<br/>
        {{ cancellationRequestFormData.comment }}
    </p>
    <p>
        The form was submitted at {{ cancellationRequestFormData.submitTime|format_datetime('medium', 'short', locale='en-GB') }}
    </p>
</div>