<div style="font-family: arial; font-size: 12px;">
    <p>
        We have received your cancellation request for the contract with the number {{ cancellationFormData.contractNumber }}
    </p>
    <p>
        Further information:
        <br/>
        First name: {{ cancellationFormData.firstName }}
        <br/>
        Last name: {{ cancellationFormData.lastName }}
        <br/>
        Email address: {{ cancellationFormData.email }}
        <br/>
        Contract number (order number, subscription number, ...): {{ cancellationFormData.contractNumber }}
        <br/>
        Comment:<br/>
        {{ cancellationFormData.comment }}
    </p>
    <p>
        The form was submitted at {{ cancellationFormData.submitTime|format_datetime('medium', 'short', locale='en-GB') }}
    </p>
</div>