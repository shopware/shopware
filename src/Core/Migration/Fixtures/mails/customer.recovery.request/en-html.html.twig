{# Shipped text of Migration1570622696CustomerPasswordRecovery, greeting by displayName. Read by Migration1789026910CustomerMailGreetingDisplayName, which rewrites the unedited template from this file. #}
<div style="font-family:arial; font-size:12px;">
    <p>
        Hello {{ customerRecovery.customer.displayName }},<br/>
        <br/>
        You have requested a new password for your {{ shopName }} account.
        Click on the following link to reset your password:<br/>
        <br/>
        <a href="{{ resetUrl }}">{{ resetUrl }}</a><br/>
        <br/>
        This link is valid for the next 2 hours.
        If you don't want to reset your password, ignore this email and no changes will be made.<br/>
        <br/>
        Yours sincerely
        Your {{ shopName }} team
    </p>
</div>