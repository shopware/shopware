<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Shopware\Core\System\Consent\ConsentEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\System\Consent\ConsentHistoryEntity">
            <tag name="shopware.entity"/>
        </service>

        <service id="Shopware\Core\System\Consent\Api\ConsentController">
            <argument type="service" id="Shopware\Core\System\UsageData\Consent\ConsentService"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="Shopware\Core\System\UsageData\Consent\ConsentService">
            <argument type="service" id="consent.repository"/>
        </service>
    </services>
</container>