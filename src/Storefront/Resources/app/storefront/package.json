{
  "name": "sw-next-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Storefront Building Pipeline for Shopware Next",
  "keywords": [
    "next",
    "pipeline",
    "storefront",
    "sw"
  ],
  "license": "MIT",
  "scripts": {
    "dev-server": "node ./build/vite/dev-server.js",
    "development": "vite build --mode development",
    "build": "vite build --mode production",
    "lint": "eslint --report-unused-disable-directives --config .eslintrc.js ./src --cache && stylelint --config stylelint.config.js ./src --cache",
    "lint-fix": "npm run lint:js:fix && npm run lint:scss-fix",
    "lint:js": "eslint --report-unused-disable-directives --config .eslintrc.js ./src ./build",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:scss": "stylelint --config stylelint.config.js ./src/scss --cache",
    "lint:scss-fix": "npm run lint:scss -- --fix",
    "production": "vite build --mode production",
    "unit": "jest --config jest.config.js --ci",
    "unit-watch": "jest --config jest.config.js --watch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@shopware-ag/dive": "2.2.3",
    "autoprefixer": "10.4.13",
    "bootstrap": "5.3.3",
    "browserslist": "^4.24.2",
    "chalk": "^4.1.2",
    "core-js": "3.40.0",
    "deepmerge": "4.3.1",
    "flatpickr": "4.6.13",
    "fs-extra": "11.3.0",
    "hammerjs": "2.0.8",
    "history": "4.10.1",
    "patch-package": "8.0.0",
    "postcss": "^8.4.49",
    "postcss-pxtorem": "6.1.0",
    "qrcode": "^1.5.4",
    "sass": "1.83.4",
    "terser": "^5.37.0",
    "tiny-slider": "2.9.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@babel/cli": "7.23.4",
    "@babel/core": "7.23.7",
    "@babel/eslint-parser": "7.23.3",
    "@babel/plugin-proposal-decorators": "7.23.7",
    "@babel/preset-env": "7.23.7",
    "@babel/preset-typescript": "7.23.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "chokidar": "3.5.3",
    "eslint": "8.56.0",
    "eslint-plugin-jest": "26.6.0",
    "http-proxy-middleware": "^3.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "16.0.0",
    "license-checker-rseidelsohn": "4.3.0",
    "lodash.get": "4.4.2",
    "prettier": "3.5.3",
    "sass-embedded": "^1.83.0",
    "stylelint": "16.16.0",
    "stylelint-config-recommended-scss": "14.1.0",
    "stylelint-junit-formatter": "0.2.2",
    "stylelint-prettier": "5.0.3",
    "vite-plugin-static-copy": "^2.1.0",
    "xml2js": "0.6.2"
  },
  "overrides": {
    "tmp": "0.2.5"
  }
}