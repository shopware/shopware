{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    name = null,
    elements = [],
    maxScopeDepth = 6,
    gridItems = false,
%}

{% if elements is empty and name is not null %}
    {# Recursively search for slots in outerScope chain #}
    {% set currentScope = outerScope %}
    {% set foundElements = null %}

    {% for i in 0..maxScopeDepth %}
        {% if currentScope is defined and currentScope is not null %}
            {% if currentScope.slots is defined and currentScope.slots[name] is defined %}
                {% set foundElements = currentScope.slots[name] %}
                {% set currentScope = null %}
            {% elseif currentScope.outerScope is defined %}
                {% set currentScope = currentScope.outerScope %}
            {% else %}
                {% set currentScope = null %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% if foundElements is not null %}
        {% set elements = foundElements %}
    {% endif %}
{% endif %}

{% if elements is not empty %}
    {% set breakpoints = enum_cases('Shopware\\Core\\Framework\\ContentSystem\\Layout\\Element\\Style\\Breakpoint') %}
    {% set gridItemAlignmentOptions = ['align-self', 'justify-self'] %}
    {% block elements %}
        {% for element in elements %}
            {% set elementProperties = element.properties %}
            {% set elementProperties = elementProperties|merge({ 'data-element-id': element.id }) %}

            {% if activeRoute === 'frontend.content-system.preview' %}
                {% set elementProperties = elementProperties|merge({ preview: true }) %}
            {% endif %}

            {% if element.slots is not empty %}
                {% set elementProperties = elementProperties|merge({ slots: element.slots }) %}
            {% endif %}

            {% set elementStyleClasses = '' %}
            {% set gridItemDisplayClasses = '' %}
            {% set gridItemAlignmentClasses = '' %}

            {% if element.style.values is not empty %}
                {% for optionName, optionValue in element.style.values %}
                    {% if optionName == 'display' and optionValue is mapping %}
                        {% set visibilityClasses = '' %}
                        {% for breakpoint in breakpoints %}
                            {% if breakpoint.resolve(optionValue) %}
                                {% set visibilityClasses = visibilityClasses ~ ' display-' ~ breakpoint.value %}
                            {% endif %}
                        {% endfor %}
                        {% set visibilityClasses = visibilityClasses ?: ' d-none' %}
                        {% if gridItems %}
                            {% set gridItemDisplayClasses = visibilityClasses %}
                        {% else %}
                            {% set elementStyleClasses = elementStyleClasses ~ visibilityClasses %}
                        {% endif %}
                    {% elseif optionValue is mapping or optionValue is not empty %}
                        {% set optionClasses = '' %}
                        {% if optionValue is mapping %}
                            {% for breakpoint in breakpoints %}
                                {% set value = breakpoint.resolve(optionValue) %}
                                {% if value is not empty and value is not null and value is not same as(false) %}
                                    {% set optionClasses = optionClasses ~ ' ' ~ optionName ~ '-' ~ breakpoint.value ~ (value is same as(true) ? '' : '-' ~ value) %}
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            {% set optionClasses = ' ' ~ optionName ~ '-' ~ optionValue %}
                        {% endif %}
                        {% set elementStyleClasses = elementStyleClasses ~ optionClasses %}
                        {% if gridItems and optionName in gridItemAlignmentOptions %}
                            {% set gridItemAlignmentClasses = gridItemAlignmentClasses ~ optionClasses %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if elementStyleClasses is not empty %}
                {% set elementProperties = elementProperties|merge({ 'class': elementStyleClasses|trim }) %}
            {% endif %}

            {% if gridItems %}
                <div class="sw-grid-container__item{{ gridItemDisplayClasses }}{{ gridItemAlignmentClasses }}">{{ component(element.component, elementProperties) }}</div>
            {% else %}
                {{ component(element.component, elementProperties) }}
            {% endif %}
        {% endfor %}
    {% endblock %}
{% else %}
    {% block content %}{% endblock %}
{% endif %}

