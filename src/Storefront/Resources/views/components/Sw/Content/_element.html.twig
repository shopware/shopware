{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{# A partial, not a component: every renderer of a single element uses this and must not drift apart. #}

{% set elementProperties = element.properties %}
{% set elementProperties = elementProperties|merge({ 'data-element-id': element.id }) %}

{% if app.request.attributes.get('_route') === 'frontend.content-system.preview' %}
    {% set elementProperties = elementProperties|merge({ preview: true }) %}
{% endif %}

{% if element.slots is not empty %}
    {% set elementProperties = elementProperties|merge({ slots: element.slots }) %}
{% endif %}

{% set elementStyleClasses = '' %}

{% if element.style.values is not empty %}
    {% for optionName, optionValue in element.style.values %}
        {% if optionValue is mapping %}
            {% for viewport, value in optionValue %}
                {% if value is not empty and value is not null and value is not same as(false) %}
                    {% if value is same as(true) %}
                        {% set elementStyleClasses = elementStyleClasses ~ ' ' ~ optionName ~ '-' ~ viewport %}
                    {% else %}
                        {% set elementStyleClasses = elementStyleClasses ~ ' ' ~ optionName ~ '-' ~ viewport ~ '-' ~ value %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        {% elseif optionValue is not empty %}
            {% set elementStyleClasses = elementStyleClasses ~ ' ' ~ optionName ~ '-' ~ optionValue %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if elementStyleClasses is not empty %}
    {% set elementProperties = elementProperties|merge({ 'class': elementStyleClasses|trim }) %}
{% endif %}

{{ component(element.component, elementProperties) }}
