{% props 
    namespaces = null
%}

<div class="component-library">

    <div class="component-library-header">
        <h1>Component Library</h1>
    </div>

    <div class="component-library-content">

        <div class="component-library-navigation">
            {% for namespace in namespaces %}
                {% if namespace.name !== 'Docs' %}
                    <twig:docs:component-navigation :namespace="namespace" />
                {% endif %}
            {% endfor %}
        </div>

        <div class="component-library-components">
            {% for namespace in namespaces %}
                {% if namespace.name !== 'Docs' %}
                    <twig:docs:component-doc-namespace :namespace="namespace" />
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>