{% props
    namespace = null
%}

<ul class="component-navigation">
    <li>
        <a href="#{{ namespace.name }}">
            {{ namespace.name }}
        </a>
    </li>

    {% if namespace.components is defined %}
        <ul>
            {% for component in namespace.components %}
                <li>
                    <a href="#{{ component.getBaseName() }}">
                        {{ component.getBaseName() }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if namespace.subNamespaces is defined %}
        {% for subNamespace in namespace.subNamespaces %}
            {% if subNamespace.name !== 'Docs' %}
                <twig:docs:component-navigation :namespace="subNamespace" />
            {% endif %}
        {% endfor %}
    {% endif %}
</ul>