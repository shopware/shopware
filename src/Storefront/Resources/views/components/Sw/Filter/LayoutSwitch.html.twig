{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% set attributeDefaults = {
    class: 'sw-layout-switch btn-group',
    'data-component': 'Sw:Filter:LayoutSwitch',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    <twig:Sw:Button
        class="sw-layout-switch__horizontal"
        title="{{ 'listing.layoutSwitchList'|trans|sw_sanitize }}"
        data-layout="horizontal"
        variant="light"
    >
        <twig:Sw:Icon name="view-normal" size="xs" />
    </twig:Sw:Button>

    <twig:Sw:Button
        class="sw-layout-switch__default"
        title="{{ 'listing.layoutSwitchGrid'|trans|sw_sanitize }}"
        data-layout="default"
        variant="light"
    >
        <twig:Sw:Icon name="view-grid" size="xs" />
    </twig:Sw:Button>
</div>
