<div class="sw-filter-layout-toggle btn-group">
    <twig:Sw:Button
        class="sw-listing-options__horizontal-toggle"
        title="List view"
        data-layout="horizontal"
        variant="light"
    >
        <twig:Sw:Icon name="view-normal" size="xs" />
    </twig:Sw:Button>

    <twig:Sw:Button
        class="sw-listing-options__horizontal-toggle"
        title="Grid view"
        data-layout="default"
        variant="light"
    >
        <twig:Sw:Icon name="view-grid" size="xs" />
    </twig:Sw:Button>
</div>
