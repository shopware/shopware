<div
    class="sw-filter-panel container mb-4 d-flex justify-content-between gap-2"
    data-component="FilterPanel"
>
    <div class="sw-filter-panel__filter d-flex flex-wrap gap-2">

        {% for filter in filters %}
            {{ component('Sw:Filter:Type:' ~ filter.type, {
                name: filter.name,
                options: filter.options,
                hidden: filter.hidden
            }) }}
        {% endfor %}

        {# Expand or collapse hidden filters #}
        <button class="d-none d-md-block sw-filter-panel__filter-btn sw-filter-panel__expand btn-light btn">
            <span class="sw-filter-panel__expand-text">More filters</span>
            <twig:Sw:Icon name="sliders-horizontal" size="xs" />
        </button>

        {# Filter toggle for mobile #}
        <button class="d-block d-md-none sw-filter-panel__filter-btn btn-light btn">Filter <twig:Sw:Icon name="sliders-horizontal" size="xs" /></button>
    </div>

    <div class="sw-filter-panel__options d-inline-flex justify-content-end gap-2">
        <span class="sw-filter-panel__counter text-light-emphasis text-nowrap d-none d-lg-inline-block">
            {{ totalCount }} Items
        </span>

        <twig:Sw:Filter:Sort />

        <twig:Sw:Filter:LayoutToggle />
    </div>
</div>
