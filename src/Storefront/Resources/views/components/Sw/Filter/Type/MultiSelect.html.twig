{% props
    name = 'Multi select',
    hidden = false,
    options = []
%}

{% set checkedCount = options|filter(option => attribute(option, 'checked') is defined and attribute(option, 'checked'))|length %}

<div class="sw-filter-multi-select d-none d-md-block dropdown{% if hidden %} is--hidden{% endif %}">
    <button
        class="sw-filter-multi-select__btn sw-filter-panel__filter-btn btn btn-light"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        data-bs-offset="0,0"
        data-bs-auto-close="outside"
    >
        {{ name }}
        {% if checkedCount > 0 %}
            <span class="sw-filter-multi-select__count badge text-bg-secondary">{{ checkedCount }}</span>
        {% endif %}
        <twig:Sw:Icon name="arrow-head-down" size="xs" />
        <twig:Sw:Icon name="arrow-head-up" size="xs" />
    </button>

    <div class="sw-filter-multi-select__dropdown dropdown-menu p-0">

        <input
            type="search"
            class="sw-filter-multi-select__search form-control"
            placeholder="Search {{ name }}..."
            aria-label="Search {{ name }}..."
        >

        <ul class="sw-filter-multi-select__list p-0 m-0">
            {% for filterOption in options %}
                <li class="sw-filter-multi-select__list-item form-check">
                    <input
                        class="form-check-input"
                        type="checkbox"
                        value="{{ filterOption.value }}"
                        id="{{ filterOption.value }}"
                        {% if filterOption.checked %} checked="checked"{% endif %}
                    >

                    <label
                        class="form-check-label"
                        for="{{ filterOption.value }}"
                    >
                        {{ filterOption.name }}
                    </label>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
