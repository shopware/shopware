{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    name,
    id = name,
    label = null,
    ariaLabel = null,
    value = null,
    options = [],
    placeholder = null,
    placeholderDisabled = false,
    description = null,
    autocomplete = null,
    size = null,
    disabled = false,
    validationRules = null,
    violationPath = null,
    violationLabel = null,
    required = validationRules is not empty and 'required' in validationRules,
    formViolations = formViolations|default(null),
    isInvalid = violationPath is not empty and formViolations is not null and formViolations.getViolations(violationPath)|length > 0,
    additionalClass = null,
    additionalInputClass = null,
%}

{% set feedbackId = "#{id}-feedback" %}
{% set descriptionId = "#{id}-description" %}
{% set describedBy = description is not empty ? "#{descriptionId} #{feedbackId}" : feedbackId %}

{% set clientValidationRules = required and 'required' not in validationRules|default('')
    ? (validationRules is empty ? 'required' : "required,#{validationRules}")
    : validationRules %}

{% set groupCVA = cva({
    base: 'sw-form-select sw-form-field form-group',
}) %}

{% set selectCVA = cva({
    base: 'sw-form-select__control sw-form-field__control form-select',
    variants: {
        size: {
            sm: 'form-select-sm',
            lg: 'form-select-lg',
        },
        isInvalid: {
            true: 'is-invalid',
            false: null,
        },
    },
}) %}

{% set attributeDefaults = {
    class: groupCVA.apply({}, additionalClass),
    'data-violation-path': violationPath is not null ? violationPath : false,
} %}

{% set selectAttributeDefaults = {
    class: selectCVA.apply({ size, isInvalid }, additionalInputClass),
    id: id,
    name: name,
    'aria-describedby': describedBy,
    'aria-label': ariaLabel is not null and label is empty ? ariaLabel : false,
    'aria-required': required ? 'true' : false,
    'aria-invalid': isInvalid ? 'true' : false,
    'data-validation': clientValidationRules is not empty ? clientValidationRules : false,
    autocomplete: autocomplete is not null ? autocomplete : false,
    disabled: disabled,
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block label %}
        <twig:Sw:Form:Label
            :fieldId="id"
            :label="label"
            :required="required"
        />
    {% endblock %}

    {% block control %}
        <select {{ attributes.nested('control').defaults(selectAttributeDefaults) }}>
            {% block content %}
                {% if placeholder is not null %}
                    <option value=""{% if value is null or value == '' %} selected="selected"{% endif %}{% if placeholderDisabled %} disabled{% endif %}>{{ placeholder }}</option>
                {% endif %}

                {% for option in options %}
                    {% set optionSelected = option.selected|default(option.value == value) %}

                    <option value="{{ option.value }}"{% if optionSelected %} selected="selected"{% endif %}{% if option.disabled|default(false) %} disabled{% endif %}>{{ option.label }}</option>
                {% endfor %}
            {% endblock %}
        </select>
    {% endblock %}

    {% block description %}
        <twig:Sw:Form:Description
            :id="descriptionId"
            :description="description"
        />
    {% endblock %}

    {% block feedback %}
        <twig:Sw:Form:Feedback
            :id="feedbackId"
            :violationPath="violationPath"
            :violationLabel="violationLabel"
            :formViolations="formViolations"
            :hasViolations="isInvalid"
        />
    {% endblock %}
</div>