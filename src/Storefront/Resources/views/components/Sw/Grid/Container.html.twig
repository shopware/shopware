{# @sw-package framework #}
{# @internal #}

{% props slots = [] %}

{% set grid = this.presentation(attributes.all()['style'] ?? '') %}

{% if grid.placementRules %}
    {# A breakpoint with spanning areas needs an :nth-child() selector with its pattern length and visibility filter. #}
    <style>{{ grid.placementRules|raw }}</style>
{% endif %}

<div {{ attributes.without('style').defaults(grid.outer) }}>
    <div {{ attributes.nested('inner').without('style').defaults(grid.inner) }}>
        {% block content %}
            {% for name, slot in slots %}
                <twig:Slot :name="name" :gridItems="true"></twig:Slot>
            {% endfor %}
        {% endblock %}
    </div>
</div>
