{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    mode = null,
    itemMinWidth = "400px",
    maxWidth = '1400px',
    padding = {
        xs: null,
        sm: null,
        md: null,
        lg: null,
        xl: null,
        xxl: null,
    },
    margin = {
        xs: null,
        sm: null,
        md: null,
        lg: null,
        xl: null,
        xxl: null,
    },
    align = 'normal',
    alignContent = 'normal',
    justify = 'normal',
    justifyContent = 'normal',
    fullWidth = false,
    border = null,
    borderVariant = null,
    borderFullWidth = false,
    backgroundOpacity = 100,
    borderRadius = '0',
    backgroundColor = null,
    backgroundImage = null,
    backgroundImageMode = 'auto',
    backgroundFullWidth = false,
    shadowOffsetX = 0,
    shadowOffsetY = 0,
    shadowSpread = 0,
    shadowBlur = 0,
    shadowOpacity = 100,
    shadowInset = false,
    shadowColor = '#000000',
    slots = [],
%}

{% set mode = mode ?? 'auto-fit' %}

{% set containerCVA = cva({
    base: 'sw-grid-container',
    variants: {
        fullWidth: {
            true: 'full-width',
        },
        borderFullWidth: {
            true: 'border-full-width',
        },
        border: {
            all: 'border',
            top: 'border-top',
            end: 'border-end',
            bottom: 'border-bottom',
            start: 'border-start'
        },
        borderVariant: {
            primary: 'border-primary',
            secondary: 'border-secondary',
            secondarySubtle: 'border-secondary-subtle'
        },
    },
}) %}

{% set gridCVA = cva({
    base: 'sw-grid-container__inner',
    variants: {
        mode: {
            'max-content': 'max-content',
            'auto-fit': 'auto-fit',
            'auto-fill': 'auto-fill',
            'explicit': 'explicit',
        },
        align: {
            start: 'align-start',
            end: 'align-end',
            center: 'align-center',
            stretch: 'align-stretch',
        },
        alignContent: {
            start: 'align-content-start',
            end: 'align-content-end',
            center: 'align-content-center',
            stretch: 'align-content-stretch',
            spaceAround: 'align-content-space-around',
            spaceBetween: 'align-content-space-between',
            spaceEvenly: 'align-content-space-evenly',
        },
        justify: {
            start: 'justify-start',
            end: 'justify-end',
            center: 'justify-center',
            stretch: 'justify-stretch',
        },
        justifyContent: {
            start: 'justify-content-start',
            end: 'justify-content-end',
            center: 'justify-content-center',
            stretch: 'justify-content-stretch',
            spaceAround: 'justify-content-space-around',
            spaceBetween: 'justify-content-space-between',
            spaceEvenly: 'justify-content-space-evenly',
        },
        fullWidth: {
            true: 'full-width',
        },
        border: {
            all: 'border',
            top: 'border-top',
            end: 'border-end',
            bottom: 'border-bottom',
            start: 'border-start'
        },
        borderVariant: {
            primary: 'border-primary',
            secondary: 'border-secondary',
            secondarySubtle: 'border-secondary-subtle'
        },
    }
}) %}

{% set containerDefaults = {
    class: containerCVA.apply({
        fullWidth,
        borderFullWidth,
        border,
        borderVariant,
    }),
} %}

{% set attributeDefaults = {
    class: gridCVA.apply({
        mode,
        align,
        alignContent,
        justify,
        justifyContent,
        fullWidth,
        border,
        borderVariant,
        backgroundColor,
        backgroundImage
    }),
} %}

{% set gridStyle = '' %}
{% set containerStyle = '' %}
{% set backgroundStyle = '' %}
{% set repeatedPattern = mode == 'explicit' %}
{% if repeatedPattern %}
    {% set gridPattern = this.gridPattern %}
    {% set gridStyle = gridStyle ~ gridPattern.style ~ 'grid-template-columns: var(--sw-grid-columns); grid-auto-flow: row dense; ' ~ (justifyContent == 'normal' ? 'justify-content: start; ' : '') %}
    {% set attributeDefaults = attributeDefaults|merge({ class: attributeDefaults.class ~ ' repeated-pattern ' ~ gridPattern.class }) %}
{% endif %}
{% set gridStyle = gap ? gridStyle ~ 'gap: ' ~ gap ~ 'px; ' : gridStyle %}
{% set gridStyle = maxWidth ? gridStyle ~ '--sw-grid-container-max-width: ' ~ maxWidth ~ '; ' : gridStyle %}

{% for spacingName, spacingValue in { padding: padding, margin: margin } %}
    {% if spacingValue is mapping %}
        {% for viewport, value in spacingValue %}
            {% if value is not empty and value is not null %}
                {% set gridStyle = gridStyle ~ '--sw-grid-container-' ~ spacingName ~ '-' ~ viewport ~ ': ' ~ value ~ '; ' %}
                {% set containerStyle = containerStyle ~ '--sw-grid-container-' ~ spacingName ~ '-' ~ viewport ~ ': ' ~ value ~ '; ' %}
            {% endif %}
        {% endfor %}
    {% elseif spacingValue is not empty %}
        {% set gridStyle = gridStyle ~ '--sw-grid-container-' ~ spacingName ~ ': ' ~ spacingValue ~ '; ' %}
        {% set containerStyle = containerStyle ~ '--sw-grid-container-' ~ spacingName ~ ': ' ~ spacingValue ~ '; ' %}
    {% endif %}
{% endfor %}

{% if backgroundColor and backgroundOpacity > 0 %}
    {% set backgroundStyle = backgroundStyle ~ 'background-color: color-mix(in srgb, ' ~ backgroundColor ~ ' ' ~ backgroundOpacity ~ '%, transparent); ' %}
{% endif %}
{% if backgroundImage %}
    {% set backgroundStyle = backgroundStyle ~ 'background-image: url(' ~ backgroundImage|sw_encode_media_url ~ '); ' %}
    {% if backgroundImageMode in ['cover', 'contain'] %}
        {% set backgroundStyle = backgroundStyle ~ 'background-size: ' ~ backgroundImageMode ~ '; background-position: center; background-repeat: no-repeat; ' %}
    {% endif %}
{% endif %}

{% if backgroundFullWidth %}
    {% set containerStyle = containerStyle ~ backgroundStyle %}
{% else %}
    {% set gridStyle = gridStyle ~ backgroundStyle %}
{% endif %}

{% if borderRadius and borderRadius != '0' %}
    {% set gridStyle = gridStyle ~ 'border-radius: ' ~ borderRadius ~ '; ' %}
{% endif %}
{% if shadowColor and shadowOpacity > 0 %}
    {% set shadowInsetValue = shadowInset ? 'inset ' : '' %}
    {% set shadowColorValue = 'color-mix(in srgb, ' ~ shadowColor ~ ' ' ~ shadowOpacity ~ '%, transparent)' %}
    {% set gridStyle = gridStyle ~ 'box-shadow: ' ~ shadowInsetValue ~ shadowOffsetX ~ 'px ' ~ shadowOffsetY ~ 'px ' ~ shadowBlur ~ 'px ' ~ shadowSpread ~ 'px ' ~ shadowColorValue ~ '; ' %}
{% endif %}

{% if mode == 'auto-fit' or mode == 'auto-fill' %}
    {% set gridStyle = gridStyle ~ 'grid-template-columns: repeat(' ~ mode ~ ', minmax(min(' ~ itemMinWidth ~ ', 100%), 1fr));' %}
{% endif %}

{% if gridStyle is not empty %}
    {% set externalStyle = attributes.all()['style'] %}
    {% set gridStyle = gridStyle ~ externalStyle %}

    {% set attributeDefaults = attributeDefaults|merge({ style: gridStyle }) %}
{% endif %}

{% if containerStyle is not empty %}
    {% set containerDefaults = containerDefaults|merge({ style: containerStyle }) %}
{% endif %}

{% if repeatedPattern %}<style>{{ gridPattern.rules|raw }}</style>{% endif %}
<div {{ attributes.without('style').defaults(containerDefaults) }}>
    <div {{ attributes.nested('inner').without('style').defaults(attributeDefaults) }}>

        {% block content %}
            {% for name, slot in slots %}
                <twig:Slot :name="name" :gridItems="repeatedPattern"></twig:Slot>
            {% endfor %}
        {% endblock %}
    </div>
</div>
