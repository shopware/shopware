{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{#
    @prop displayMode - String 'auto' | 'fixedHeight'
    @prop mediaItems - Array of Shopware\Core\Content\Media
    @prop thumbnailSize - Number - The size of the thumbnail in pixels
    @prop thumbnailNavigationPosition - String 'left' | 'underneath'
    @prop showNavigationArrows - Boolean - Show the navigation arrows
    @prop showMagnifier - Boolean - Show the magnifier
    @prop useSchemaMarkup - Boolean - Use itemprop schema markup for SEO
    @prop showFullScreenGallery - Boolean - Show the full screen gallery
#}

{% props
    mediaItems,
    displayMode = 'auto',
    maxHeight = null,
    thumbnailSize = 70,
    thumbnailNavigationPosition = 'left',
    showNavigationArrows = true,
    showMagnifier = true,
    useSchemaMarkup = false,
    showFullScreenGallery = true,
    isLightbox = false,
%}

{% set lightboxId = 'sw-media-gallery-lightbox-' ~ random() %}
{% set singleMedia = mediaItems|length == 1 %}

{% set mediaGalleryCVA = cva({
    base: 'sw-media-gallery',
    variants: {
        thumbnailNavigationPosition: {
            left: 'sw-media-gallery--thumbnail-nav-left',
            bottom: 'sw-media-gallery--thumbnail-nav-bottom',
        },
        displayMode: {
            auto: 'sw-media-gallery--display-mode-auto',
            fixedHeight: 'sw-media-gallery--display-mode-fixed-height',
        },
        singleMedia: {
            true: 'sw-media-gallery--single-media',
        },
        isLightbox: {
            true: 'sw-media-gallery--is-lightbox',
        }
    },
}) %}

{% set mediaGalleryOptions = {
    showMagnifier,
    thumbnailNavigationPosition,
    showNavigationArrows,
    showFullScreenGallery,
    isLightbox,
} %}

{% set defaultAttributes = {
    class: mediaGalleryCVA.apply({ thumbnailNavigationPosition, displayMode, singleMedia, isLightbox }),
    'data-component': 'Sw:Media:Gallery',
    'data-component-options': mediaGalleryOptions|json_encode,
} %}

{% if displayMode == 'fixedHeight' and maxHeight is not null %}
    {% set defaultAttributes = defaultAttributes|merge({
        style: "--sw-media-gallery-max-height: #{maxHeight}px;",
    }) %}
{% endif %}

<div {{ attributes.defaults(defaultAttributes) }}>
    {% if mediaItems|length > 1 %}
        <twig:Sw:Media:ThumbnailNav
            class="sw-media-gallery__thumbnail-nav"
            :mediaItems="mediaItems" 
            :thumbnailSize="thumbnailSize"
            :isHorizontal="thumbnailNavigationPosition == 'bottom'"
        />
    {% endif %}

    <div class="sw-media-gallery__previews-wrapper">
        <div class="sw-media-gallery__previews">
            {% for mediaItem in mediaItems %}
                <div 
                    class="sw-media-gallery__preview-item" 
                    id="sw-media-gallery-preview-{{ loop.index }}"
                    data-media-id="{{ loop.index }}"
                    {% if showFullScreenGallery %}
                        data-bs-toggle="modal"
                        data-bs-target="#{{ lightboxId }}"
                        role="button"
                        tabindex="0"
                        aria-label="Open image {{ loop.index }} in lightbox"
                    {% endif %}
                >
                    <twig:Sw:Media 
                        :media="mediaItem"
                        :title="null"
                        class="sw-media-gallery__preview"
                        :itemprop="useSchemaMarkup ? ('image' ~ (loop.first ? ' primaryImageOfPage' : '')) : null"
                        :autoplay="true"
                    />
                </div>
            {% endfor %}
        </div>

        {% if showNavigationArrows and not singleMedia %}
            <button
                type="button"
                class="sw-media-gallery__nav-button is--backward btn btn-light"
                aria-label="Previous image"
            >
                <twig:Sw:Icon name="arrow-head-left" size="sm" />
            </button>

            <button
                type="button"
                class="sw-media-gallery__nav-button is--forward btn btn-light"
                aria-label="Next image"
            >
                <twig:Sw:Icon name="arrow-head-right" size="sm" />
            </button>
        {% endif %}

        {% if not singleMedia %}
            <span class="sw-media-gallery__preview-item-badge badge">
                1 / {{ mediaItems|length }}
            </span>
        {% endif %}
    </div>
</div>

{% if showFullScreenGallery %}
    <twig:Sw:Media:GalleryLightbox
        class="sw-media-gallery__lightbox"
        id="{{ lightboxId }}"
        :mediaItems="mediaItems"
        :thumbnailSize="thumbnailSize"
    />
{% endif %}