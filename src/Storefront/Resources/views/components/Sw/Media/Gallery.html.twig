{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{#
    @prop displayMode - String 'original' | 'fixedHeight'
    @prop mediaItems - Array of Shopware\Core\Content\Media
    @prop thumbnailSize - Number - The size of the thumbnail in pixels
    @prop thumbnailNavigationPosition - String 'left' | 'underneath'
    @prop showNavigationArrows - Boolean - Show the navigation arrows
    @prop showMagnifier - Boolean - Show the magnifier
    @prop useSchemaMarkup - Boolean - Use itemprop schema markup for SEO
    @prop showFullScreenGallery - Boolean - Show the full screen gallery
#}

{% props
    mediaItems,
    displayMode = 'original',
    thumbnailSize = 70,
    thumbnailNavigationPosition = 'left',
    showNavigationArrows = false,
    showMagnifier = true,
    useSchemaMarkup = false,
    showFullScreenGallery = true,
%}

{% set mediaGalleryCVA = cva({
    base: 'sw-media-gallery',
    variants: {
        thumbnailNavigationPosition: {
            left: 'sw-media-gallery--thumbnail-nav-left',
            underneath: 'sw-media-gallery--thumbnail-nav-underneath',
        },
        displayMode: {
            original: 'sw-media-gallery--display-mode-original',
            fixedHeight: 'sw-media-gallery--display-mode-fixed-height',
        },
    },
}) %}

{% set mediaGalleryOptions = {
    showMagnifier,
    thumbnailNavigationPosition,
} %}

{% set defaultAttributes = {
    class: mediaGalleryCVA.apply({ thumbnailNavigationPosition, displayMode }),
    'data-component': 'Sw:Media:Gallery',
    'data-component-options': mediaGalleryOptions|json_encode,
} %}

<div {{ attributes.defaults(defaultAttributes) }}>
    <twig:Sw:Media:ThumbnailNav
        class="sw-media-gallery__thumbnail-nav"
        :mediaItems="mediaItems" 
        :thumbnailSize="thumbnailSize"
        :isHorizontal="thumbnailNavigationPosition == 'underneath'"
    />

    <div class="sw-media-gallery__previews">
        {% for mediaItem in mediaItems %}
            <twig:Sw:Media
                :hidden="not loop.first"
                :media="mediaItem"
                :title="null"
                class="sw-media-gallery__preview"
                data-media-id="{{ mediaItem.id }}"
                data-bs-toggle="modal"
                data-bs-target="#sw-media-gallery-modal"
                :itemprop="useSchemaMarkup ? ('image' ~ (loop.first ? ' primaryImageOfPage' : '')) : null"
            />
        {% endfor %}
    </div>
</div>

{% if showFullScreenGallery %}
    <twig:Sw:Media:GalleryLightbox
        id="sw-media-gallery-modal"
        :mediaItems="mediaItems"
        :thumbnailSize="thumbnailSize"
    />
{% endif %}
