{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    media,
    mediaHeight = 240,
    lightIntensity = config('core.media.defaultLightIntensity'),
    previewMode = false,
%}

{% set spatialGalleryViewerOptions = {
    modelUrl: media.url,
    lightIntensity: config('core.media.defaultLightIntensity'),
    sliderPosition: 0,
} %}

{% set spatialCVA = cva({
    base: 'sw-media-spatial',
    variants: {
        previewMode: {
            true: 'sw-media-spatial--preview-mode',
            false: 'sw-media-spatial--viewer-mode',
        }
    },
}) %}

{% set defaultAttributes = {
    class: spatialCVA.apply({ previewMode }),
} %}

{% if not previewMode %}
    {% set defaultAttributes = defaultAttributes|merge({
        'data-component': 'Sw:Media:Spatial',
        'data-component-options': spatialGalleryViewerOptions|json_encode,
    }) %}
{% endif %}

<div {{ attributes.defaults(defaultAttributes) }}>
    {% if previewMode %}
        <div class="sw-media-spatial__preview-overlay">
            <strong>3D</strong>
        </div>
    {% else %}
        <canvas 
            data-spatial-base-viewer="true" 
            data-spatial-base-viewer-options='{{spatialGalleryViewerOptions|json_encode}}'
            class="sw-media-spatial__canvas">
        </canvas>
        <div class="sw-media-spatial__loader spinner-border text-primary" role="status">
            <span class="visually-hidden">{{ 'global.default.loading'|trans|striptags }}</span>
        </div>
    {% endif %}
</div>