{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    mediaItems,
    thumbnailSize = 70,
    isHorizontal = false,
%}

{% set thumbnailNavCVA = cva({
    base: 'sw-thumbnail-nav',
    variants: {
        isHorizontal: {
            true: 'sw-thumbnail-nav--horizontal',
        },
    },
}) %}

{% set defaultAttributes = {
    class: thumbnailNavCVA.apply({ isHorizontal }),
} %}

{% set scrollBackwardIcon = isHorizontal ? 'arrow-head-left' : 'arrow-head-up' %}
{% set scrollForwardIcon = isHorizontal ? 'arrow-head-right' : 'arrow-head-down' %}
{% set scrollForwardText = isHorizontal ? 'Scroll right' : 'Scroll down' %}
{% set scrollBackwardText = isHorizontal ? 'Scroll left' : 'Scroll up' %}

<div {{ attributes.defaults(defaultAttributes) }}>
    <button
        type="button" 
        class="sw-thumbnail-nav__scroll-control is--backward btn btn-light"
        aria-label="{{ scrollBackwardText }}"
        hidden="hidden"
    >
        <twig:Sw:Icon 
            :name="scrollBackwardIcon" 
            size="sm" 
        />
    </button>
    <div class="sw-thumbnail-nav__inner">
        {% for mediaItem in mediaItems %}
            <button
                class="sw-thumbnail-nav__button {% if loop.first %}is--active{% endif %}" 
                type="button"
                data-gallery-thumbnail-button="true"
                data-target="{{ loop.index }}"
                aria-label="Show image {{ loop.index }} of {{ mediaItems|length }}"
            >
                <twig:Sw:Media 
                    class="sw-thumbnail-nav__media"
                    :media="mediaItem" 
                    :title="null"
                />
            </button>
        {% endfor %}
    </div>
    <button
        type="button" 
        class="sw-thumbnail-nav__scroll-control is--forward btn btn-light"
        aria-label="{{ scrollForwardText }}"
        hidden="hidden"
    >
        <twig:Sw:Icon 
            :name="scrollForwardIcon" 
            size="sm" 
        />
    </button>
</div>
