{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    videoId = null,
    videoTitle = null,
    previewMedia = null,
    autoplay = false,
    loop = false,
    showControls = true,
    doNotTrack = false,
    needsConfirmation = false,
    showByline = true,
    showTitle = true,
    showPortrait = true,
    color = null,
%}

{# Accept a bare video id or a full Vimeo URL (vimeo.com/… or player.vimeo.com/video/…) and normalize to the id #}
{% set resolvedVideoId = videoId %}
{% if resolvedVideoId is not empty %}
    {% if '/video/' in resolvedVideoId %}
        {% set resolvedVideoId = resolvedVideoId|split('/video/')|last %}
    {% elseif 'vimeo.com/' in resolvedVideoId %}
        {% set resolvedVideoId = resolvedVideoId|split('vimeo.com/')|last %}
    {% endif %}
    {# strip any query string or fragment, then take the id (last path segment) #}
    {% set resolvedVideoId = resolvedVideoId|split('?')|first|split('#')|first|split('/')|last %}
{% endif %}

{% set locale = app.request.locale|default('en-GB') %}

{# initialize with default values #}
{% set queryParams = {
    dnt: doNotTrack ? 'true' : 'false',
    loop: loop ? 'true' : 'false',
    keyboard: 'false',
    texttrack: locale,
    fullscreen: 'true',
} %}

{% if color is not null %}
    {% set queryParams = queryParams|merge({ color: color|replace({'#': ''}) }) %}
{% endif %}

{% if autoplay %}
    {% set queryParams = queryParams|merge({ autoplay: 'true', muted: 'true' }) %}
{% endif %}

{% if not showByline %}
    {% set queryParams = queryParams|merge({ byline: 'false' }) %}
{% endif %}

{% if not showTitle %}
    {% set queryParams = queryParams|merge({ title: 'false' }) %}
{% endif %}

{% if not showPortrait %}
    {% set queryParams = queryParams|merge({ portrait: 'false' }) %}
{% endif %}

{% if not showControls %}
    {% set queryParams = queryParams|merge({ controls: 'false' }) %}
{% endif %}

{% set videoUrl = 'https://player.vimeo.com/video/' ~ resolvedVideoId ~ '?' ~ (queryParams|url_encode) %}

{% set attributeDefaults = {
    class: 'sw-media sw-media-vimeo',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block video %}
        {% if resolvedVideoId is empty %}
            <div class="sw-media-vimeo__empty">
                <twig:Sw:Icon name="video-camera" size="2x" />
            </div>
        {% elseif needsConfirmation %}
            {% set pluginConfiguration = {
                cookieName: 'vimeo-video',
                videoUrl: videoUrl,
                iframeClasses: ['sw-media-vimeo__video'],
                iframeTitle: videoTitle,
                btnClasses: ['btn', 'btn-outline-secondary'],
                backdropClasses: ['sw-media-vimeo__backdrop'],
                confirmButtonText: 'component.cms.vimeo.acceptButtonLabel'|trans,
                overlayText: 'component.cms.vimeo.privacyNoticeText'|trans({
                    '%url%': path('frontend.cms.page', { id: config('core.basicInformation.privacyPage') }),
                    '%platform%': 'Vimeo',
                })|raw,
            } %}

            <div
                class="sw-media-vimeo__placeholder"
                data-cms-gdpr-video-element="true"
                data-cms-gdpr-video-element-options="{{ pluginConfiguration|json_encode }}"
            >
                {% if previewMedia %}
                    <twig:Sw:Media:Image :media="previewMedia" class="sw-media-vimeo__placeholder-image" />
                {% endif %}
            </div>
        {% else %}
            <iframe
                class="sw-media-vimeo__video"
                src="{{ videoUrl }}"
                title="{{ videoTitle }}"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                allowfullscreen="allowfullscreen"
            ></iframe>
        {% endif %}
    {% endblock %}
</div>
