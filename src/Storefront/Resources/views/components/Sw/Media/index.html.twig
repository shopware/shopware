{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    media,
%}

{% set mediaType = media.getMediaType().getName() %}
{% set isSpatial = media.isSpatialObject() %}

{% if isSpatial %}
    <twig:Sw:Media:Spacial :media="media" {{ ...attributes }}></twig:Sw:Media:Spacial>
{% elseif mediaType === 'VIDEO' %}
    {# Video #}
{% else %}
    <twig:Sw:Media:Image :media="media" {{ ...attributes }}></twig:Sw:Media:Image>
{% endif %}