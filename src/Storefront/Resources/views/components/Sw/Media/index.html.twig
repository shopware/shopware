{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    media,
    previewMode = false,
    autoplay = false,
%}

{% if media is not null %}
    {% set mediaType = media.getMediaType().getName() %}
    {% set isSpatial = media.isSpatialObject() %}

    {% if isSpatial %}
        <twig:Sw:Media:Spatial {{ ...attributes }} 
            :previewMode="previewMode"
        >
        </twig:Sw:Media:Spatial>
    {% elseif mediaType === 'VIDEO' %}
        <twig:Sw:Media:Video {{ ...attributes }} 
            :previewMode="previewMode"
            :autoplay="autoplay"
        >
        </twig:Sw:Media:Video>
    {% else %}
        <twig:Sw:Media:Image {{ ...attributes }} 
            :previewMode="previewMode"
        >
        </twig:Sw:Media:Image>
    {% endif %}
{% endif %}