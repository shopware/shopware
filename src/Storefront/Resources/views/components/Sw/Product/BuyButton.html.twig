{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    product = null,
    extraFormData = {},
    jsOptions = {},
    preview = false,
%}

{% set buyButtonCVA = cva({
    base: 'sw-buy-widget d-grid',
    variants: {
        buyable: {
            true: 'is--buyable',
        },
    },
}) %}

{% set buyable = product is not null and product.available and product.childCount <= 0 and product.calculatedMaxPurchase > 0 %}

{% if not buyable %}
    <div {{ attributes.defaults({ class: buyButtonCVA.apply({ buyable: false }) }) }}>
        {% block fallback %}
            {% if preview %}
                {{ 'detail.soldOut'|trans|sw_sanitize }}
            {% endif %}
        {% endblock %}
    </div>
{% else %}
    {% set attributeDefaults = {
        class: buyButtonCVA.apply({ buyable: true }),
        method: 'post',
        action: path('frontend.checkout.line-item.add'),
        id: "product-buy-form-#{product.id}",
        'data-component': 'Sw:Product:BuyButton',
        'data-component-options': jsOptions|json_encode,
    } %}

    {% set formData = {
        redirectTo: 'frontend.detail.page',
        redirectParameters: { productId: product.id }|json_encode,
        ("lineItems[#{product.id}][id]"): product.id,
        ("lineItems[#{product.id}][referencedId]"): product.id,
        ("lineItems[#{product.id}][type]"): 'product',
        ("lineItems[#{product.id}][stackable]"): '1',
        ("lineItems[#{product.id}][removable]"): '1',
        ("lineItems[#{product.id}][product-name]"): product.translated.name
    } %}

    {% if extraFormData %}
        {% set formData = formData|merge(extraFormData) %}
    {% endif %}

    <form {{ attributes.defaults(attributeDefaults) }}>
        {% block form_data_inputs %}
            {% for name, value in formData %}
                <input
                    type="hidden"
                    name="{{ name }}"
                    value="{{ value }}"
                    {% if name == 'redirectParameters' %}
                        data-redirect-parameters="true"
                    {% endif %}
                    >
            {% endfor %}
        {% endblock %}

        {% block buy_button %}
            <twig:Slot name="buy-button">
                <twig:Sw:Button variant="buy" type="submit">
                    {{ 'listing.boxAddProduct'|trans|sw_sanitize }}
                </twig:Sw:Button>
            </twig:Slot>
        {% endblock %}
    </form>
{% endif %}
