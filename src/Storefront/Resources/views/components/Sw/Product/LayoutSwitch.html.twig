{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props horizontal = false %}

{% set attributeDefaults = {
    class: 'sw-product-layout-switch btn-group',
    'data-component': 'Sw:Product:LayoutSwitch',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    <twig:Sw:Button
        class="{{ 'sw-product-layout-switch__horizontal' ~ (horizontal ? ' is--active' : '') }}"
        aria-pressed="{{ horizontal ? 'true' : 'false' }}"
        title="{{ 'listing.layoutSwitchList'|trans|sw_sanitize }}"
        data-layout="horizontal"
        variant="light"
    >
        <twig:Sw:Icon name="view-normal" size="xs" />
    </twig:Sw:Button>

    <twig:Sw:Button
        class="{{ 'sw-product-layout-switch__default' ~ (horizontal ? '' : ' is--active') }}"
        aria-pressed="{{ horizontal ? 'false' : 'true' }}"
        title="{{ 'listing.layoutSwitchGrid'|trans|sw_sanitize }}"
        data-layout="default"
        variant="light"
    >
        <twig:Sw:Icon name="view-grid" size="xs" />
    </twig:Sw:Button>
</div>
