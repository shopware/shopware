{% props
    listing = null,
%}

{% set attributeDefaults = {} %}

{% set listingCVA = cva({
    base: 'product-listing',
}) %}

<div {{ attributes.defaults(attributeDefaults) }} class="{{ listingCVA.apply({}, attributes.render('class')) }}">

    {% set layout = app.request.get('layout') %}

    <twig:Sw:Product:ListingOptions :horizontal="horizontal" />

    {% block content %}

        <twig:Sw:Grid:Container class="product-listing__grid" :columns="horizontal ? '1' : '4'"  :columnsXl="horizontal ? '1' : '3'" :columnsLg="horizontal ? '1' : '2'" :columnsSm="horizontal ? '1' : '2'">
            {% for product in listing.elements %}
                <twig:Sw:Product:Card
                    :product="product"
                    :layout="layout ? layout : 'default'"
                />
            {% endfor %}
        </twig:Sw:Grid:Container>

    {% endblock %}

</div>
