{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    listing = null,
    slots = [],
%}

{% set listingCVA = cva({
    base: 'sw-product-listing',
}) %}

{% set attributeDefaults = {
    class: listingCVA.apply({}),
    'data-component': 'Sw:Product:Listing',
} %}

{% set listingLayout = app.request.get('listingLayout') %}

<div {{ attributes.defaults(attributeDefaults) }}>

    {% block filters %}
        <twig:Slot name="filters-panel">
            <twig:Sw:Grid:Container>
                <twig:Sw:Filter:Panel
                    :totalCount="listing.total"
                    :currentSorting="listing.sorting"
                    :filterAggregations="listing.aggregations"
                    :availableSortings="listing.availableSortings">
                </twig:Sw:Filter:Panel>
            </twig:Sw:Grid:Container>
        </twig:Slot>

        <twig:Slot name="filters-active">
            <twig:Sw:Grid:Container>
                <twig:Sw:Filter:ActiveFilters />
            </twig:Sw:Grid:Container>
        </twig:Slot>
    {% endblock %}

    {% block content %}
        {% if listing.total > 0 %}
            <twig:Slot name="product-grid">
                <twig:Sw:Grid:Container
                    class="sw-product-listing__grid"
                    :margin="{ xs: '0 0 24px 0', sm: '0 0 24px 0', md: '0 0 24px 0', lg: '0 0 24px 0', xl: '0 0 24px 0', xxl: '0 0 24px 0' }"
                    :columns="listingLayout == 'horizontal' ? '1' : { xs: '1', sm: '2', md: '3', lg: '4', xl: '4' }"
                    gap="16">
                    {% for product in listing.entities.elements %}
                        <twig:Sw:Product:Card
                            :product="product"
                            :layout="listingLayout ? listingLayout : 'default'"
                        />
                    {% endfor %}
                </twig:Sw:Grid:Container>
            </twig:Slot>
        {% else %}
            <twig:Sw:Grid:Container class="sw-product-listing__grid">
                <twig:Sw:Alert variant="info">
                    {{ 'listing.emptyResultMessage'|trans|sw_sanitize }}
                </twig:Sw:Alert>
            </twig:Sw:Grid:Container>
        {% endif %}
    {% endblock %}

    {% block pagination %}
        <twig:Slot name="pagination">
            <twig:Sw:Grid:Container>
                <twig:Sw:Content:Pagination
                    class="sw-product-listing__pagination"
                    :page="listing.page"
                    :total="listing.total"
                    :limit="listing.limit"
                    :scope="listing.entity"
                />
            </twig:Sw:Grid:Container>
        </twig:Slot>
    {% endblock %}

</div>
