{% props
    listing = null,
    slots = [],
%}

{% set attributeDefaults = {
    'data-component': 'ProductListing',
} %}

{% set listingCVA = cva({
    base: 'product-listing',
}) %}

{% set layout = app.request.get('layout') %}

<div {{ attributes.defaults(attributeDefaults) }} class="{{ listingCVA.apply({}, attributes.render('class')) }}">

    {% block filters %}
        <twig:Slot name="filters-panel">
            <twig:Sw:Filter:Panel
                :totalCount="listing.total"
                :currentSorting="listing.sorting"
                :filterAggregations="listing.aggregations"
                :availableSortings="listing.availableSortings">
            </twig:Sw:Filter:Panel>
        </twig:Slot>

        <twig:Slot name="filters-active">
            <twig:Sw:Filter:ActiveFilters />
        </twig:Slot>
    {% endblock %}

    {% block content %}
        {% if listing.total > 0 %}
            <twig:Slot name="product-grid">
                <twig:Sw:Grid:Container
                    class="product-listing__grid"
                    :columns="layout == 'horizontal' ? '1' : '4'"
                    :columnsXl="layout == 'horizontal' ? '1' : '3'"
                    :columnsLg="layout == 'horizontal' ? '1' : '2'"
                    :columnsSm="layout == 'horizontal' ? '1' : '2'"
                    gap="20">
                    {% for product in listing.elements %}
                        <twig:Slot name="product-card">
                            <twig:Sw:Product:Card
                                :product="product"
                                :layout="layout ? layout : 'default'"
                            />
                        </twig:Slot>
                    {% endfor %}
                </twig:Sw:Grid:Container>
            </twig:Slot>
        {% else %}
            <div class="container">
                <twig:Sw:Alert type="info">
                    {{ 'listing.emptyResultMessage'|trans|sw_sanitize }}
                </twig:Sw:Alert>
            </div>
        {% endif %}
    {% endblock %}

    {% block pagination %}
        <twig:Slot name="pagination">
            <twig:Sw:Content:Pagination
                :page="listing.page"
                :total="listing.total"
                :limit="listing.limit"
                :scope="listing.entity"
            />
        </twig:Slot>
    {% endblock %}

</div>
