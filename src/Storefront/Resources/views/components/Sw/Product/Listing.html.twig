{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    listing = null,
    showSorting = true,
    showLayoutSwitch = true,
    slots = [],
    navigationId = null,
    limit = null,
    page = null,
    defaultSorting = null,
%}

{% set totalCount = listing.total ?? 0 %}
{% set currentSorting = listing.sorting %}
{% set availableSortings = listing.availableSortings %}

{% set listingCVA = cva({
    base: 'sw-product-listing',
}) %}

{% set attributeDefaults = {
    class: listingCVA.apply({}),
    'data-component': 'Sw:Product:Listing',
} %}

{% set listingLayout = app.request.get('listingLayout') %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block actions %}
        <div class="sw-product-listing__actions container">
            <span class="sw-product-listing__counter text-light-emphasis text-nowrap d-none d-lg-inline-block">
                {{ 'listing.resultCount'|trans({ '%count%': totalCount })|sw_sanitize }}
            </span>

            {% if showSorting and availableSortings and availableSortings.elements and availableSortings.elements|length > 0 %}
                <twig:Sw:Product:Sorting :currentSorting="currentSorting" :sortings="availableSortings.elements" />
            {% endif %}

            {% if showLayoutSwitch %}
                <twig:Sw:Product:LayoutSwitch />
            {% endif %}
        </div>
    {% endblock %}

    {% block content %}
        {% if listing.total > 0 %}
            <twig:Slot name="product-grid">
                <twig:Sw:Grid:Container
                    class="sw-product-listing__grid"
                    :columns="listingLayout == 'horizontal' ? '1' : { xs: '1', sm: '2', md: '3', lg: '4', xl: '4' }"
                    gap="16">
                    {% for product in listing.entities.elements %}
                        <twig:Sw:Product:Card
                            :product="product"
                            :layout="listingLayout ? listingLayout : 'default'"
                        />
                    {% endfor %}
                </twig:Sw:Grid:Container>
            </twig:Slot>
        {% else %}
            <div class="sw-product-listing__grid container">
                <twig:Sw:Alert type="info">
                    {{ 'listing.emptyResultMessage'|trans|sw_sanitize }}
                </twig:Sw:Alert>
            </div>
        {% endif %}
    {% endblock %}

    {% block pagination %}
        <twig:Slot name="pagination">
            <twig:Sw:Content:Pagination
                class="sw-product-listing__pagination"
                :page="listing.page"
                :total="listing.total"
                :limit="listing.limit"
                :scope="listing.entity"
            />
        </twig:Slot>
    {% endblock %}

</div>
