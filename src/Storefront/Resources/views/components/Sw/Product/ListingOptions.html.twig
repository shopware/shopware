{% props
    horizontal = false,
    totalCount = 0
%}

{#
    * Listing
    * Filter Panel
        * TYPES:
            * Sorting
            * Layout Toggle
            * Multi-Select Filter
            * Single-Select Filter (Rating)
            * Boolean-Filter
        * Product count display

    * Product List
        * Grid component defining the layout
        * Product cards
    * Pagination
#}

<div class="sw-listing-options container mb-4" data-listing-options="true">
    <div class="d-flex justify-content-between gap-2">

        <div class="sw-listing-options__filter d-flex flex-wrap gap-2">


            <div class="sw-listing-options__filter-item d-none d-md-block dropdown">
                <button class="sw-listing-options__filter-btn btn btn-light" href="#" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-offset="0,0" data-bs-auto-close="outside">
                    Manufacturer <twig:Sw:Icon name="arrow-head-down" size="xs" /> <twig:Sw:Icon name="arrow-head-up" size="xs" />
                </button>

                <ul class="dropdown-menu p-2">
                    <input type="search" class="form-control mb-2" placeholder="Search..." />

                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Shopware
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            PayPal
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Nike
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Mercedes-Benz
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Airbus
                        </label>
                    </li>
                </ul>
            </div>

            <div class="sw-listing-options__filter-item d-none d-md-block dropdown">
                <button class="sw-listing-options__filter-btn btn btn-light" href="#" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-offset="0,0" data-bs-auto-close="outside">
                    Color <span class="badge text-bg-secondary">2</span> <twig:Sw:Icon name="arrow-head-down" size="xs" /> <twig:Sw:Icon name="arrow-head-up" size="xs" />
                </button>

                <ul class="dropdown-menu p-2">
                    <input type="search" class="form-control mb-2" placeholder="Search..." />

                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" checked value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Red
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" checked value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Blue
                        </label>
                    </li>
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                        <label class="form-check-label" for="checkDefault">
                            Green
                        </label>
                    </li>

                </ul>
            </div>

            <button class="d-none d-md-block sw-listing-options__filter-btn btn-light btn">More filters <twig:Sw:Icon name="sliders-horizontal" size="xs" /></button>
            <button class="d-block d-md-none sw-listing-options__filter-btn btn-light btn">Filter <twig:Sw:Icon name="sliders-horizontal" size="xs" /></button>

        </div>

        <div class="sw-listing-options__options d-inline-flex justify-content-end gap-2">
            <span class="sw-listing-options__counter text-light-emphasis text-nowrap d-none d-lg-inline-block">
                {{ totalCount }} Items
            </span>

            <select class="sw-listing-options__sort" aria-label="Sort products">
                <option value="name-asc" selected>Alphabetically, A-Z</option>
                <option value="name-desc">Alphabetically, Z-A</option>
                <option value="price-asc">Price, low to high</option>
                <option value="price-desc">Price, high to low</option>
                <option value="best-selling">Best selling</option>
            </select>

            <div class="btn-group">
                <twig:Sw:Button
                        class="sw-listing-options__horizontal-toggle"
                        title="List view"
                        data-layout="horizontal"
                        variant="light"
                >
                    <twig:Sw:Icon name="view-normal" size="xs" />
                </twig:Sw:Button>

                <twig:Sw:Button
                        class="sw-listing-options__horizontal-toggle"
                        title="Grid view"
                        data-layout="default"
                        variant="light"
                >
                    <twig:Sw:Icon name="view-grid" size="xs" />
                </twig:Sw:Button>
            </div>
        </div>

    </div>
</div>
