{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    stars,
    maxStars = 5,
    allowHalf = false,
    altText = null,
    size = 'xs',
%}

{% if allowHalf %}
    {% set full = stars|round(0, 'floor') %}
    {% set left = ((stars - full) * 4)|round / 4 %}
    {% set half = left > 0 ? 1 : 0 %}
    {% set blank = maxStars - full - half %}
{% else %}
    {% set full = stars|round %}
    {% set left = 0 %}
    {% set half = 0 %}
    {% set blank = maxStars - full %}
{% endif %}

{% set attributeDefaults = {
    class: 'sw-rating-stars mb-2',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {# Actual rating stars #}
    {% if full > 0 %}
        {% for star in range(1, full) %}
            <twig:Sw:Icon name="star" pack="solid" size="{{ size }}" />
        {% endfor %}
    {% endif %}

    {# Half star, shown as a clipped solid star over an empty one #}
    {% if half %}
        <span class="sw-rating-stars__half" style="--sw-rating-stars-fill: {{ (1 - left) * 100 }}%">
            <span class="sw-rating-stars__half-empty"><twig:Sw:Icon name="star" size="{{ size }}" /></span>
            <span class="sw-rating-stars__half-fill"><twig:Sw:Icon name="star" pack="solid" size="{{ size }}" /></span>
        </span>
    {% endif %}

    {# Remaining stars #}
    {% if blank > 0 %}
        {% for starEmpty in range(1, blank) %}
            <twig:Sw:Icon name="star" size="{{ size }}" />
        {% endfor %}
    {% endif %}

    {% if altText %}
        <span class="sw-rating-stars__alt-text visually-hidden">{{ altText }}</span>
    {% endif %}
</div>
