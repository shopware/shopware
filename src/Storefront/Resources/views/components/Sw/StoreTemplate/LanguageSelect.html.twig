{% props
    languages
%}

{% set attributeDefaultsForm = {
    action: path('frontend.checkout.switch-language'),
    method: 'post',
    class: 'sw-language-select',
} %}

<div class="sw-language-select dropdown">
    <button
        type="button"
        class="btn btn-link text-body btn-sm dropdown-toggle border-0 p-0 link-underline link-underline-opacity-0 fs-5 fw-normal"
        data-bs-toggle="dropdown"
        aria-expanded="false"
    >
        {{ context.languageInfo.name|sw_sanitize }}
    </button>
    <div class="dropdown-menu dropdown-menu-end">
        <form {{ attributes.defaults(attributeDefaultsForm) }}>
            {% for language in languages %}
                {% set isActiveLanguage = language.id is same as(context.context.languageId) %}
                <button
                    name="languageId"
                    class="dropdown-item"
                    value="{{ language.id }}"
                    {% if isActiveLanguage %}{% endif %}
                >
                    {{ language.name }}
                </button>
            {% endfor %}
        </form>
    </div>
</div>
