{% props
    navigationTree,
    homeEnabled = context.salesChannel.translated.homeEnabled,
    homeLabel = context.salesChannel.translated.homeName|default('general.homeLink'|trans),
    homePath = path('frontend.home.page'),
%}

{% set attributeDefaults = {
    class: 'sw-navbar',
    'data-component': 'Sw:StoreTemplate:Navbar',
} %}

<nav {{ attributes.defaults(attributeDefaults) }}>
    <div class="sw-navbar__container container">
        <ul class="sw-navbar__nav nav nav-underline">

            {% if homeEnabled %}
                <li class="sw-navbar__nav-item nav-item">
                    <a
                        class="sw-navbar__nav-link nav-link"
                        href="{{ homePath }}"
                        data-category-id="{{ context.salesChannel.navigationCategoryId }}"
                    >
                        {{ homeLabel|sw_sanitize }}
                    </a>
                </li>
            {% endif %}

            {% for treeItem in navigationTree %}
                {% set hasChildren = treeItem.children|length > 0 %}
                {% set itemSkipped = category.type == 'folder' and not hasChildren %}

                {% if not itemSkipped %}
                    <li class="sw-navbar__nav-item nav-item" tabindex="0">
                        <a
                            class="sw-navbar__nav-link nav-link"
                            href="{{ treeItem.category.seoUrl ?: '#' }}"
                            data-category-id="{{ category.id }}"
                            {% if hasChildren %}tabindex="-1"{% endif %}
                        >
                            {{ treeItem.category.translated.name }}
                            {% if hasChildren %}
                                <twig:Sw:Icon name="arrow-head-down" size="xs" />
                            {% endif %}
                        </a>

                        {% if hasChildren %}
                            <twig:Sw:StoreTemplate:Flyout
                                :category="treeItem.category"
                                :navigationTree="treeItem.children"
                            />
                        {% endif %}
                    </li>
                {% endif %}
            {% endfor %}
        </ul>

        <div class="sw-navbar__scroller" aria-hidden="true">
            <div class="sw-navbar__scroll-button" tabindex="-1">

            </div>
            <div class="sw-navbar__scroll-button" tabindex="-1">

            </div>
        </div>
    </div>
</nav>
