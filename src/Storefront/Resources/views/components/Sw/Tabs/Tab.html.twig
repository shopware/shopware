{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{# `title` is rendered by Sw:Tabs:Panel, but must stay declared here so it does not land on the pane as an HTML title attribute. #}
{% props
    slots = [],
    title = '',
    tabId = null,
%}

{# The content element id pairs this pane with its navigation item in Sw:Tabs:Panel, so no authored ids are needed. A manual usage passes `tabId` instead. #}
{% set elementId = tabId ?? attributes.all()['data-element-id']|default(null) %}

{% set tabCVA = cva({
    base: 'sw-tab-pane tab-pane fade',
}) %}

{% set attributeDefaults = {
    class: tabCVA.apply({}),
    role: 'tabpanel',
    tabindex: '0',
} %}

{% if elementId %}
    {% set attributeDefaults = attributeDefaults|merge({
        id: 'sw-tab-pane-' ~ elementId,
        'aria-labelledby': 'sw-tab-' ~ elementId,
    }) %}
{% endif %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block content %}
        <twig:Slot name="content"></twig:Slot>
    {% endblock %}
</div>
