{% props
    component = null
%}

<div class="component-doc">
    <h3 id="{{ component.getBaseName() }}">{{ component.getTag() }}</h3>

    <div class="component-doc-content">

        {# {{ dump(component) }} #}

        <h5>Example:</h5>
        <div class="component-doc-content-example">
            
            {% if component.getName() %}
                {{ component(component.getName()) }}
            {% endif %}
        </div>

        <h5>Code:</h5>
        <div class="component-doc-content-code">
            {% set properties = [] %}

            {% for property in component.getProperties() %}
                {% set prop = property|replace({' ': ''}) %}
                {% set properties = properties|merge([prop]) %}
            {% endfor %}

            {% set code = "&lt;twig:" ~ component.getTag() ~ " " ~ properties|join(' ') ~ " /&gt;" %}

            <code>{{ code|raw }}</code>
        </div>

        <h5>Properties:</h5>
        <div class="component-doc-content-properties">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Default Value</th>
                    </tr>
                </thead>
                <tbody>
                    {% for key, property in component.getProperties() %}
                        <tr>
                            <td>{{ key }}</td>
                            <td>{{ property|split('=')[1]|trim }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            
        </div>
    </div>
</div>