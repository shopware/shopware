{#
    Product card component
    ========================================
    @experimental

    A bootstrap card that renders prodcut information

    ** Basic usage: **
    To render the card, you need to pass the `product` prop containing a product entity.

    @example
    <twig:product-card:product-card :product="product" />

    ** Customize attributes **
    You can customize attributes while rendering the component. For example to add additional classes.
    This also works with nested attributes. So you can modify child elements from outside.

    If the attribute you want to customize already exists on the element, it will be overriden with your value.

    @example
    <twig:product-card:product-card
        :product="product"
        class= "my-extra-class"          <-- Add an additional class on the root card component element.
        body:class="my-extra-body-class" <-- Add an additional class on the card body element.
        media:id="my-custom-id"          <-- Add an id to the media element.
        media:loading="eager"            <-- Override the default <img loading="lazy"> arrtibute.
    />

    ** Override classes **
    Due to the special CSS class implementation with attributes in symfony UX,
    classes are only additions and the default classes are never overwritten when using e.g. `body:class="let-me-override-uwu"`

    To also have the possibility to override default classes, you can use the prop `classes`,
    and pass an object with classes you would like to override.

    @example
    <twig:product-card:product-card
        :product="product"
        body:class="my-extra-body-class"           <-- Add an additional class on the card body element.
        :classes="{ titleLink: 'my-only-class' }"  <-- Override a default class.
    />

    ** Override HTML via slots (blocks)
    You can pass custom HTML to blocks and override the content, similar to Vue slots.

    @example
    <twig:product-card:product-card :product="product">
        <twig:block name="actions">
            <div>Custom actions!</div>
        </twig:block>
    </twig:product-card:product-card>
#}

{#
    Product card component - props
    ========================================
#}
{# @var product \Shopware\Core\Content\Product\ProductEntity #}
{# @var classes - Override the default classes #}
{# @var mediaHeight - Height of the product media (thumbnail) #}
{# @var defaultRoute - Route to the product detail page #}
{% props
    product,
    classes = {},
    mediaHeight = 240,
    defaultRoute = seoUrl('frontend.detail.page', { productId: product.id }),
    slots = [],
%}

{% set defaultClasses = {
    root: 'card product-card h-100',
    header: 'product-card-header m-2 position-relative overflow-hidden',
    media: 'card-img-top product-card-media object-fit-cover',
    body: 'product-card-body card-body pb-2',
    title: 'product-card-title card-title fw-semibold',
    titleLink: 'product-card-title-link stretched-link',
    footer: 'product-card-footer card-footer border-0 pt-2'
} %}

{% if classes %}
    {% set defaultClasses = defaultClasses | merge(classes) %}
{% endif %}

{% set displayParent = product.variantListingConfig.displayParent and product.parentId === null %}

<div {{ attributes.defaults({ class: defaultClasses.root }) }}>
    <div {{ attributes.nested('header').defaults({ class: defaultClasses.header }) }}>

        <twig:slot name="header-top"></twig:slot>

        {% block media %}
            <twig:slot name="media">
                <twig:media:image
                    {{ ...attributes.nested('media').defaults({
                        media: product.cover.media,
                        height: mediaHeight,
                        class: defaultClasses.media,
                        sizes: '800px',
                        loading: 'lazy'
                    }) }}
                />
            </twig:slot>
        {% endblock %}

        {% block badges %}
            <twig:slot name="badges">
                <twig:product-card:badges :product="product" />
            </twig:slot>
        {% endblock %}

        <twig:slot name="header-bottom"></twig:slot>
    </div>

    <div {{ attributes.nested('body').defaults({ class: defaultClasses.body }) }}>

        <twig:slot name="body-top"></twig:slot>

        {% block title %}
            <twig:slot name="title">
                <h2 {{ attributes.nested('title').defaults({ class: defaultClasses.title }) }}>
                    <a
                        {{ attributes.nested('title-link').defaults({
                            class: defaultClasses.titleLink,
                            href: defaultRoute,
                            style: "--sw-product-card-media-height: #{mediaHeight}px",
                        }) }}
                    >
                        {{ product.translated.name }}
                    </a>
                </h2>
            </twig:slot>
        {% endblock %}

        {% if config('core.listing.showReview') and product.ratingAverage %}
            <twig:slot name="rating">
                <twig:rating:rating :stars="product.ratingAverage" />
            </twig:slot>
        {% endif %}

        {% if not displayParent %}
            <twig:slot name="variants">
                <twig:product-card:variants :variants="product.variation" />
            </twig:slot>
        {% endif %}

        <twig:slot name="body-bottom"></twig:slot>
    </div>

    <div {{ attributes.nested('footer').defaults({ class: defaultClasses.footer }) }}>

        <twig:slot name="footer-top"></twig:slot>

        {% block price %}
            <twig:slot name="price">
                <twig:product-card:price :product="product" />
            </twig:slot>
        {% endblock %}

        {% block actions %}
            <twig:slot name="actions">
                <twig:product-card:actions
                        :product="product"
                        :addToCartExtraFormData="{ 'foo': 'bar' }"
                    />
            </twig:slot>
        {% endblock %}

        <twig:slot name="footer-bottom"></twig:slot>
    </div>

    {% block loading_indicator %}
        <twig:product-card:skeleton-loader />
    {% endblock %}
</div>
