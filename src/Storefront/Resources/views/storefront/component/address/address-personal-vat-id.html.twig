{% block component_account_register_personal_vat_id_field %}
    {% set vatIdValue = activeRoute == 'frontend.account.profile.page' or (activeRoute == 'frontend.account.addressmanager.get' and context.customer.guest) ? vatIds[0] : vatIds.get(0) %}
    {% set violationLabel = null %}
    {% set violationPath = null %}

    {% for violation in formViolations.getViolations('/vatIds') %}
        {% set violationPath = '/vatIds' %}
        {% set violationLabel = 'address.companyVatLabel'|trans|sw_sanitize %}
        {% if violation.code === 'VIOLATION::IS_BLANK_ERROR' %}
            {% set vatIdValue = null %}
        {% elseif formViolations.getInputData()['vatIds'][0] is defined %}
            {% set vatIdValue = formViolations.getInputData()['vatIds'][0] %}
        {% endif %}
    {% endfor %}

    {% set vatIdAttributes = {
        'data-form-validation-pattern-message': 'error.VIOLATION::VAT_ID_FORMAT_NOT_CORRECT'|trans|sw_sanitize,
        'data-vat-id-format-warning': 'address.companyVatFormatWarning'|trans|sw_sanitize,
        'data-eu-vat-id-patterns': sw_eu_vat_id_patterns()|json_encode,
    } %}

    {# Forms without a country select, like the customer profile, pass the country the VAT ID is validated against #}
    {% if billingCountry is defined and billingCountry %}
        {% set vatIdAttributes = vatIdAttributes|merge({
            'data-country-state-select': 'true',
            'data-vat-id-required': billingCountry.vatIdRequired ? '1' : '',
            'data-vat-id-pattern': billingCountry.vatIdPattern,
            'data-check-vat-id-pattern': billingCountry.checkVatIdPattern ? '1' : '',
            'data-is-eu': billingCountry.isEu ? '1' : '',
        }) %}
    {% endif %}

    {% block component_account_register_personal_vat_id_field_input %}
        {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
            label: 'address.companyVatLabel'|trans|sw_sanitize,
            id: 'vatIds',
            name: 'vatIds[]',
            autocomplete: 'off',
            value: vatIdValue,
            violationPath: violationPath,
            validationRules: vatIdRequired ? 'required' : '',
            additionalClass: 'col-md-6',
            attributes: vatIdAttributes,
        } %}
    {% endblock %}
{% endblock %}
