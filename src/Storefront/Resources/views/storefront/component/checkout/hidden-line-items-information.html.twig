{% block component_hidden_line_items_information %}
    <div class="d-none hidden-line-items-information"
         data-currency="{{ context.currency.translated.shortName }}"
         data-shipping="{{ cart.shippingCosts.totalPrice }}"
         data-tax="{{ cart.price.calculatedTaxes.amount }}"
    >
        {% for lineItem in lineItems %}
            {% if lineItem.good %}
                {% set gaPrice = lineItem.price.unitPrice %}

                {% block component_hidden_line_item_information %}
                    {% set categories = lineItem.payload.categoryNames is defined ? lineItem.payload.categoryNames|slice(0, 5) : [] %}
                    {% set categoryAttributes = '' %}
                    {% for name in categories %}
                        {% set categoryAttributes = categoryAttributes ~ ' data-category-' ~ loop.index ~ '="' ~ name ~ '"' %}
                    {% endfor %}
                    {% set productId = lineItem.productId ?? lineItem.referencedId ?? lineItem.id %}
                    <span class="hidden-line-item"
                          data-id="{{ productId }}"
                          data-sku="{{ lineItem.payload.productNumber ?? productId }}"
                          data-name="{{ lineItem.label }}"
                          data-quantity="{{ lineItem.quantity }}"
                          data-price="{{ gaPrice }}"
                          data-brand="{{ lineItem.payload.manufacturerName|default('') }}"
                          {{ categoryAttributes|raw }}
                    >
                    </span>
                {% endblock %}
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}
