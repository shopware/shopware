{% block component_hidden_line_items_information %}
    {# only the analytics script reads these, so a sales channel without analytics renders nothing #}
    {% if storefrontAnalytics and storefrontAnalytics.isActive() %}
        {# `data-value` is the position price: all line items including promotion discounts, without shipping #}
        <div class="d-none hidden-line-items-information"
             data-currency="{{ context.currency.translated.shortName }}"
             data-shipping="{{ cart.shippingCosts.totalPrice }}"
             data-value="{{ cart.price.positionPrice }}"
             data-tax="{{ cart.price.calculatedTaxes.amount }}"
        >
            {% for lineItem in lineItems %}
                {% if lineItem.good %}
                    {% set gaPrice = lineItem.price.unitPrice %}

                    {% block component_hidden_line_item_information %}
                        {% set categories = lineItem.payload.categoryNames is defined ? lineItem.payload.categoryNames|slice(0, 5) : [] %}
                        {% set categoryAttributes = '' %}
                        {% for name in categories %}
                            {% set categoryAttributes = categoryAttributes ~ ' data-category-' ~ loop.index ~ '="' ~ name|e('html_attr') ~ '"' %}
                        {% endfor %}
                        {% set productId = lineItem.productId ?? lineItem.referencedId ?? lineItem.id %}
                        <span class="hidden-line-item"
                              data-id="{{ productId }}"
                              data-line-item-id="{{ lineItem.id }}"
                              data-sku="{{ lineItem.payload.productNumber ?? productId }}"
                              data-name="{{ lineItem.label }}"
                              data-quantity="{{ lineItem.quantity }}"
                              data-price="{{ gaPrice }}"
                              data-brand="{{ lineItem.payload.manufacturerName|default('') }}"
                              {{ categoryAttributes|raw }}
                        >
                        </span>
                    {% endblock %}
                {% elseif lineItem.payload.code|default('') is not empty %}
                    {# Any discount with a code, a promotion or the voucher of an extension, whatever its type. Automatic #}
                    {# promotions have no code, and a promotion with several discounts adds one line item per discount. #}
                    {% block component_hidden_line_item_coupon %}
                        <span class="hidden-line-item-coupon" data-code="{{ lineItem.payload.code }}"></span>
                    {% endblock %}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
