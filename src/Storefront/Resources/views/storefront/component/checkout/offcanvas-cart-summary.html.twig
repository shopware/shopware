{% block component_offcanvas_summary_content %}

    {% set alertAriaJsOptions = {
        contentSelector: '.cart-live-update-content',
    } %}

    {% block component_offcanvas_summary_cart_live_update %}
        <div class="cart-live-update visually-hidden" 
             role="status"
             aria-live="polite"
             data-alert-aria="true"
             data-alert-aria-options="{{ alertAriaJsOptions|json_encode }}">
            <div class="cart-live-update-content">
                {{ 'checkout.cartScreenReaderUpdate'|trans({
                    '%count%': page.cart.lineItems|length,
                    '%total%': page.cart.price.positionPrice|currency,
                })|sw_sanitize }}
            </div>
        </div>
    {% endblock %}

    <div class="offcanvas-summary">
        <dl class="row offcanvas-summary-list" aria-label="{{ 'checkout.summaryOffCanvasLabel'|trans|striptags }}">
            {% block component_offcanvas_summary_total %}
                {% block component_offcanvas_summary_total_label %}
                    <dt class="summary-label summary-total">
                        {{ 'checkout.subtotalAmount'|trans|sw_sanitize }}
                    </dt>
                {% endblock %}

                {% block component_offcanvas_summary_total_value %}
                    <dd class="summary-value summary-total">
                        <strong>{{ page.cart.price.positionPrice|currency }}</strong>
                    </dd>
                {% endblock %}
            {% endblock %}
        </dl>

        {% if page.cart.deliveries is defined %}
            {% for activeShipping in page.cart.deliveries.elements %}
                {% block component_offcanvas_summary_content_info %}
                    <div class="row offcanvas-shipping-info">
                        <span class="shipping-label shipping-cost">
                            <strong>{{ 'checkout.summaryShipping'|trans|sw_sanitize }}</strong>
                            {% if loop.first %}
                                {% if page.shippingMethods|length %}
                                    <button class="btn btn-sm btn-link js-toggle-shipping-selection">
                                        ({{ activeShipping.shippingMethod.translated.name }})
                                    </button>
                                {% else %}
                                    <small>({{ activeShipping.shippingMethod.translated.name }})</small>
                                {% endif %}
                            {% endif %}
                        </span>

                        <span class="pb-2 shipping-value shipping-cost">
                            {% set shippingTotalPrice = activeShipping.shippingCosts.totalPrice ?? 0 %}
                            <strong>{{ shippingTotalPrice < 0 ? '&minus;' : '+' }} {{ shippingTotalPrice|abs|currency }}</strong>
                        </span>
                    </div>
                {% endblock %}
            {% endfor %}

            {% set activeShipping = page.cart.deliveries.elements|first %}

            {% block component_offcanvas_summary_content_shipping %}
                {% if page.shippingMethods|length %}
                    <div class="offcanvas-shipping-preference mb-2 mt-2 offcanvas-shipping-preference--hidden">
                        <form
                            action="{{ path('frontend.checkout.configure') }}"
                            name="confirmShippingForm"
                            method="post">

                            <input type="hidden" name="forwardTo" value="frontend.cart.offcanvas">

                            {% block component_offcanvas_summary_content_shipping_select %}
                                <label class="visually-hidden" for="offcanvasShippingMethodId">{{ 'checkout.shippingMethod'|trans|sw_sanitize }}</label>
                                <select class="form-select mt-2 col-12" name="shippingMethodId" id="offcanvasShippingMethodId">
                                    <option disabled>{{ 'checkout.confirmChangeShipping'|trans|sw_sanitize }}</option>

                                    {% for shippingMethod in page.shippingMethods %}
                                        <option
                                            value="{{ shippingMethod.id }}"
                                            {% if shippingMethod.id is same as(activeShipping.shippingMethod.id) %}selected="selected"{% endif %} >
                                            {{ shippingMethod.translated.name }}
                                        </option>
                                    {% endfor %}
                                </select>

                            {% endblock %}
                        </form>
                    </div>
                {% endif %}
            {% endblock %}
        {% endif %}

        {% block component_offcanvas_summary_price_modifiers %}
            {# Only modifiers activated through PriceModifierIdExtension are removable by the customer --
               having an id alone doesn't make one removable, e.g. a mandatory fee. #}
            {% set removablePriceModifierIds = page.cart.extensions['cart-price-modifier-ids'] ?? null %}

            {% for modifier in page.cart.priceModifiers %}
                {% block component_offcanvas_summary_price_modifier %}
                    <div class="row offcanvas-summary-price-modifier js-cart-item">
                        <span class="summary-label summary-price-modifier">
                            {% if modifier.id is not null and removablePriceModifierIds and removablePriceModifierIds.has(modifier.id) %}
                                {% set loaderOptions = {
                                    skipLoadingIndicator: true
                                } %}

                                <form
                                    action="{{ path('frontend.checkout.price-modifier.delete', { id: modifier.id }) }}"
                                    method="post"
                                    data-form-submit-loader="true"
                                    data-form-submit-loader-options="{{ loaderOptions|json_encode }}"
                                    class="js-offcanvas-cart-remove-product d-inline"
                                >
                                    <input type="hidden" name="redirectTo" value="frontend.cart.offcanvas">
                                    <input
                                        type="submit"
                                        value="&times;"
                                        aria-label="{{ 'global.default.remove'|trans|striptags }}"
                                        title="{{ 'global.default.remove'|trans }}"
                                        class="summary-price-modifier-remove-button"
                                    >
                                </form>
                            {% endif %}

                            {% set modifierLabel = modifier.label %}
                            {% set isLabelTruncated = modifierLabel|length > 20 %}
                            {% if isLabelTruncated %}
                                {% set modifierLabel = modifierLabel|slice(0, 17) ~ '...' %}
                            {% endif %}

                            <span{% if isLabelTruncated %} title="{{ modifier.label|striptags }}"{% endif %}>{{ modifierLabel|sw_sanitize }}</span>

                            {% block component_offcanvas_summary_price_modifier_info %}
                                {% sw_include '@Storefront/storefront/component/checkout/price-modifier-info.html.twig' with {
                                    info: modifier.description
                                } %}
                            {% endblock %}
                        </span>

                        <span class="summary-value summary-price-modifier">
                            {% if modifier.price.totalPrice < 0 %}
                                &minus;
                            {% endif %}

                            {{ modifier.price.totalPrice|abs|currency }}
                        </span>
                    </div>
                {% endblock %}
            {% endfor %}
        {% endblock %}
    </div>

    {% block component_offcanvas_summary_tax_info %}
        <p class="offcanvas-cart-tax">
            <small>
                {% if page.cart.price.taxStatus == 'gross' %}
                    {{ 'general.grossTaxInformation'|trans|sw_sanitize }}
                {% else %}
                    {{ 'general.netTaxInformation'|trans|sw_sanitize }}
                {% endif %}
            </small>
        </p>
    {% endblock %}
{% endblock %}
