{% sw_extends '@Storefront/storefront/component/product/feature/base.html.twig' %}

{% block component_product_feature_list_item_base_content_label %}
    {{ 'component.product.feature.label.%s'|format(label)|sw_sanitize|trans }}
{% endblock %}

{% block component_product_feature_list_item_base_content_value %}
    {% set isDimension = label in ['height', 'width', 'length'] %}
    {% set isWeight = label == 'weight' %}
    {% set usesMeasurementUnit = isDimension or isWeight %}

    {% if label == 'releaseDate' %}
        {{ value|sw_sanitize|date('Y-m-d') }}
    {% elseif isDimension or isWeight %}
        {% if measurementUnits and measurementUnits[label] is defined %}
            {% set unit = measurementUnits[label].unit %}
            {% set value = measurementUnits[label].value %}
        {% else %}
            {% set unit = isWeight ? 'kg' : 'mm' %}
        {% endif %}
        {{ value|sw_sanitize }} {{ unit }}
    {% else %}
        {{ value|sw_sanitize }}
    {% endif %}
{% endblock %}
