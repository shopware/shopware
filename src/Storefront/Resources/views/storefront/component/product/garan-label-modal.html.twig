{% block component_product_garan_label_modal %}
    {# Same lookup as the nested label on the line item, so a label that is shown there can always be opened #}
    {% set garanLabel = productId|sw_garan_label(context.context) %}

    {% block component_product_garan_label_modal_title %}
        <div class="js-pseudo-modal-template-title-element">
            {{ 'detail.garanLabelTitle'|trans|sw_sanitize }}
        </div>
    {% endblock %}

    {% block component_product_garan_label_modal_body %}
        {% if garanLabel %}
            <a href="{{ 'detail.garanLabelYourEuropeUrl'|trans|striptags }}"
               class="garan-label-modal-link"
               target="_blank"
               rel="noopener">
                {# The product detail page can already contain a hidden full label with the same clip path ids #}
                {{ garanLabel|replace({ 'label-clippath': 'garan-label-modal-clippath' })|raw }}
                <span>{{ 'detail.garanLabelYourEuropeLink'|trans|sw_sanitize }}</span>
            </a>
        {% endif %}
    {% endblock %}
{% endblock %}
