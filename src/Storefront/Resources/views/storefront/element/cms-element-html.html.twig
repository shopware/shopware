{% block element_html %}
    {% set ludtwigOpeningTag = 'div' %}
    {% set ludtwigClosingTag = 'div' %}

    <{{ ludtwigOpeningTag }} class="cms-element-{{ element.type }}">
        {% block element_html_inner %}
            {{ element.data.content|raw }}
        {% endblock %}
    </{{ ludtwigClosingTag }}>
{% endblock %}
