{# @sw-package framework #}

{% if child.cookie is not empty and child.hidden is not same as(true) %}
    {% set cookie = child.cookie %}
    {% set childName = child.name|default(null) %}
    {% set childDescription = child.description|default(null) %}

    {% if not feature('v6.8.0.0') and childName is null and child.snippet_name|default(null) is not null %}
        {# @deprecated tag:v6.8.0 - Use `child.name` instead of `child.snippet_name`. Support for `child.snippet_name` will be removed. #}
        {% do sw_trigger_deprecation('v6.8.0.0', 'The "child.snippet_name" Twig input is deprecated. Use "child.name" instead.') %}
        {% set childName = child.snippet_name %}
    {% endif %}
    {% if not feature('v6.8.0.0') and childDescription is null and child.snippet_description|default(null) is not null %}
        {# @deprecated tag:v6.8.0 - Use `child.description` instead of `child.snippet_description`. Support for `child.snippet_description` will be removed. #}
        {% do sw_trigger_deprecation('v6.8.0.0', 'The "child.snippet_description" Twig input is deprecated. Use "child.description" instead.') %}
        {% set childDescription = child.snippet_description %}
    {% endif %}
    <div class="offcanvas-cookie-entry form-check form-switch">
        <input
            type="checkbox"
            role="switch"
            class="form-check-input"
            id="cookie_{{ cookie }}"
            {% if isRequired %}
                checked="checked"
                disabled="disabled"
                aria-disabled="true"
                data-cookie-required="true"
            {% endif %}
            {% if cookie %}
                data-cookie="{{ cookie }}"
            {% endif %}
            {% if child.value %}
                data-cookie-value="{{ child.value }}"
            {% endif %}
            {% if child.expiration %}
                data-cookie-expiration="{{ child.expiration }}"
            {% endif %}>
        <label
            for="cookie_{{ cookie }}"
            class="custom-control-label">
            {{ childName ? childName|trans|sw_sanitize : cookie }}
        </label>

        {% if childDescription %}
            <p>{{ childDescription|trans|sw_sanitize }}</p>
        {% endif %}
    </div>
{% endif %}
