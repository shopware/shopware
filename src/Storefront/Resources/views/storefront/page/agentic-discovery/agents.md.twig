{% block agentic_discovery_agents_md %}{% autoescape false %}{% apply remove_leading_spaces %}
    {% set manifest = page.manifest %}
    {% block agentic_discovery_agents_md_header %}
        # Agent Operating Manual — {{ manifest.storeName }}

        {% if manifest.storeDescription is not empty %}
            > {{ manifest.storeDescription }}
        {% endif %}

        This store runs on Shopware. AI shopping agents can interact with this
        storefront programmatically via the documented endpoints below. Read this
        document before issuing transactional calls.

    {% endblock %}

    {% block agentic_discovery_agents_md_custom_intro %}
        {% if manifest.customIntro is not empty %}
            ## Merchant note

            {{ manifest.customIntro }}

        {% endif %}
    {% endblock %}

    {% block agentic_discovery_agents_md_flow %}
        ## Typical Agent Flow

        {% for step in manifest.agentFlow %}
            {{ loop.index }}. **{{ step.title }}.** {{ step.description }}
        {% endfor %}

    {% endblock %}

    {% block agentic_discovery_agents_md_endpoints %}
        ## Read-only browsing

        {% for endpoint in manifest.catalogEndpoints %}
            - {{ endpoint.label }}: `{{ endpoint.path }}`
        {% endfor %}

    {% endblock %}

    {% block agentic_discovery_agents_md_rules %}
        ## Rules

        {% for rule in manifest.rules %}
            - {{ rule }}
        {% endfor %}

    {% endblock %}

    {% block agentic_discovery_agents_md_context %}
        ## Context headers

        Pass these on every request that should reflect the buyer's region:

        - `sw-language-id`: language UUID matching the buyer locale
        - `sw-currency-id`: currency UUID matching the buyer currency
        - Accept-Language: standard locale fallback when no Shopware id is known

        Storefront defaults for this domain: `{{ manifest.languageCode }}`, `{{ manifest.currencyCode }}`.

    {% endblock %}

    {% block agentic_discovery_agents_md_discovery %}
        ## Discovery

        {% for endpoint in manifest.endpoints %}
            - {{ endpoint.label }}: `{{ endpoint.path }}`
        {% endfor %}
        {% if manifest.ucpAvailable and manifest.ucpProfileUrl %}

            UCP profile is served at `{{ manifest.ucpProfileUrl }}`. Capability
            negotiation, transports (REST, MCP, A2A, Embedded) and signing keys
            are described there. Agents SHOULD prefer UCP when available.
        {% else %}

            UCP profile is not exposed on this storefront. Use the Store API
            paths listed under "Read-only browsing" instead.
        {% endif %}

    {% endblock %}

    {% block agentic_discovery_agents_md_contact %}
        {% if manifest.contactEmail %}
            ## Contact

            - Operator email: `{{ manifest.contactEmail }}`

        {% endif %}
    {% endblock %}

    {% block agentic_discovery_agents_md_custom_sections %}
        {% for section in manifest.customSections %}
            ## {{ section.title }}

            {{ section.body }}

        {% endfor %}
    {% endblock %}

    {% block agentic_discovery_agents_md_footer %}
        ---

        Generated by Shopware. This document is regenerated automatically when
        the merchant updates discovery settings. Cache lifetime is short — agents
        SHOULD refetch periodically.
    {% endblock %}
{% endapply %}{% endautoescape %}
{% endblock %}
