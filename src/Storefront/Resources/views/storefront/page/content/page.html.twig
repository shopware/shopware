{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_esi_header %}
    {% set headerParameters = headerParameters|merge({ isNewContentStructure: true }) %}
    {{ parent() }}
{% endblock %}

{% block base_main_inner %}
    {% if feature('STOREFRONT_COMPONENTS') and contentPage %}
        <div class="container-main">
            <twig:Sw:Content:Page :page="contentPage"/>
        </div>
    {% endif %}
{% endblock %}
