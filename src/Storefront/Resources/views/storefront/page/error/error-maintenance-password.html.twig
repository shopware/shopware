{% sw_extends '@Storefront/storefront/page/error/error-maintenance.html.twig' %}

{% block error_maintenance_main_content %}
    {% set maintenancePasswordErrors = app.flashes('danger') %}

    <div class="container">
        <div class="maintenance-password mx-auto">
            {% block error_maintenance_password_page_header %}
                <h1 class="maintenance-password-header h5 text-center">
                    {{ 'general.maintenancePasswordHeader'|trans|sw_sanitize }}
                </h1>
                <p class="maintenance-password-description text-center">
                    {{ 'general.maintenancePasswordDescription'|trans|sw_sanitize }}
                </p>
            {% endblock %}

            {% block error_maintenance_password_page_form %}
                <form method="post" action="{{ path('frontend.maintenance.password') }}">
                    {% block error_maintenance_password_page_label %}
                        <label class="visually-hidden" for="maintenance-password">
                            {{ 'general.maintenancePasswordLabel'|trans|sw_sanitize }}
                        </label>
                    {% endblock %}

                    <div class="d-flex align-items-start gap-3">
                        {% block error_maintenance_password_page_input %}
                            <div class="flex-grow-1">
                                <input type="password"
                                       class="form-control{% if maintenancePasswordErrors is not empty %} is-invalid{% endif %}"
                                       id="maintenance-password"
                                       name="password"
                                       placeholder="{{ 'general.maintenancePasswordPlaceholder'|trans|striptags }}"
                                       autocomplete="current-password"
                                       aria-describedby="maintenance-password-feedback"
                                       {% if maintenancePasswordErrors is not empty %}aria-invalid="true"{% endif %}
                                       required
                                       autofocus>

                                <div id="maintenance-password-feedback" class="form-field-feedback">
                                    {% for message in maintenancePasswordErrors %}
                                        <div class="invalid-feedback">{{ message|trans|sw_sanitize }}</div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endblock %}

                        {% block error_maintenance_password_page_submit %}
                            <button type="submit" class="btn btn-primary flex-shrink-0">
                                {{ 'general.maintenancePasswordSubmit'|trans|sw_sanitize }}
                            </button>
                        {% endblock %}
                    </div>
                </form>
            {% endblock %}
        </div>
    </div>
{% endblock %}

{# Reloading would discard a typed password and the error message #}
{% block error_maintenance_script_reload %}{% endblock %}
