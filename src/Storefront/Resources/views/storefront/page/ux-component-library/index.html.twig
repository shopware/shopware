{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css" rel="stylesheet">
    <style>
        code[class*=language-] {
            font-family: monospace;
        }

        :not(pre)>code[class*=language-], pre[class*=language-] {
            background: transparent;
            padding: 0;
        }
    </style>
{% endblock %}

{% block base_esi_header %}
    {% embed '@Storefront/storefront/layout/header/header-minimal.html.twig' %}
        {% block layout_header_minimal_contact %}{% endblock %}
    {% endembed %}
    <div class="bg-light pt-4 pb-4 mb-5 border-bottom border-top border-dark-subtle">
        <div class="container">
            <h1 class="display-5">UX component library</h1>
            <p class="mb-0">A collection of reusable e-commerce components using symfony UX components and Bootstrap</p>
        </div>
    </div>
{% endblock %}

{% block base_navigation %}{% endblock %}

{% block base_content %}
    {% set bootstrapVariants = ['primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'] %}
    {% set bootstrapOutlineVariants = bootstrapVariants|map(value => "outline-#{value}") %}

    {% set componentDemoData = {
        'alert:alert': {
            showPreview: true,
            bootstrapVariants,
            props: {
                variant: 'primary',
                size: 'text-md',
            },
            content: 'Example alert',
        },
        'button:button': {
            showPreview: true,
            bootstrapVariants: bootstrapVariants|merge(bootstrapOutlineVariants),
            props: {
                variant: 'primary',
            },
            content: 'Example button'
        },
        'icon:icon': {
            showPreview: true,
            props: {
                name: 'bag'
            }
        },
        'rating:rating': {
            showPreview: true,
            props: {
                stars: 4,
            }
        }
    } %}

<div class="row">
    <div class="col-3">
        <nav id="component-nav" class="nav sticky-top flex-column nav-pills me-3">
            {% for component in components|sort %}
                {% set id = component.name|replace({':': '-'}) %}
                <a href="#{{ id }}" class="nav-link">
                    {% set componentNames = component.name|split(':') %}
                    {% if componentNames[0] == componentNames[1] %}{{ component.baseName|capitalize }}{% else %}{{ component.name|capitalize }}{% endif %}
                </a>
            {% endfor %}
        </nav>
    </div>
    <div class="col-9">
        <div data-bs-spy="scroll" data-bs-target="#component-nav" data-bs-offset="0" data-bs-smooth-scroll="true" class="scrollspy" tabindex="0">
            {% for component in components|sort %}
                {% set id = component.name|replace({':': '-'}) %}
                <div id="{{ id }}">
                    <h2>
                        {% set componentNames = component.name|split(':') %}
                        {% if componentNames[0] == componentNames[1] %}{{ component.baseName|capitalize }}{% else %}{{ component.name|capitalize }}{% endif %}
                    </h2>

                    <h3 class="h5">Preview:</h3>
                    <div class="border border-secondary-subtle p-3 mb-3">
                        {% set demoData = componentDemoData[component.name] %}
                        {% if demoData.showPreview %}
                            {% if demoData.bootstrapVariants %}
                                {% for variant in demoData.bootstrapVariants %}
                                    <div class="mb-2 position-relative">
                                        {{ component(component.name, { ...demoData.props, variant }) }}
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="mb-2 position-relative">
                                    {{ component(component.name, { ...demoData.props }) }}
                                </div>
                            {% endif %}
                        {% else %}
                            No preview available.
                        {% endif %}
                    </div>

                    <h3 class="h5">Usage:</h3>
                    <div class="border-secondary-subtle border px-3 py-1 mb-3 bg-light">
                        {% set demoProps = demoData.props %}
                        {% set demoPropAttributes %}{% for key, val in demoData.props %} {{ key }}="{{ val }}"{% endfor %}{% endset %}
                        <pre><code class="language-html"><script type="text/template"><{{ component.tag }}{{ demoPropAttributes }}>{{ demoData.content }}</{{ component.tag }}></script></code></pre>
                    </div>

                    <h3 class="h5">Directory:</h3>
                    <code>{{ component.directory }}</code>
                    <hr class="mb-5">
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
