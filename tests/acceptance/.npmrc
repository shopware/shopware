# Install file:-protocol dependencies (the local acceptance-test-suite checkout) as
# packed copies instead of symlinks. A symlink would resolve @playwright/test from the
# checkout's own node_modules, loading a second copy of Playwright and failing with
# "Requiring @playwright/test second time". After changing the checkout, re-sync with:
#   (cd ../../../../acceptance-test-suite && npm run build) && npm install
install-links=true
