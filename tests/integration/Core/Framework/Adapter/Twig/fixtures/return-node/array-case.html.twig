{% apply spaceless %}
    {% macro foo(index = null) %}
        {% set arr = [1, 2] %}
        {% if index is not null %}
            {{ arr[index] }}
        {% else %}
            {{ arr|join(', ') }}
        {% endif %}
    {% endmacro %}

    {% if _self.foo(1) is empty %}
        should not be empty
    {% endif %}
    {{ _self.foo(1) }}
{% endapply %}
