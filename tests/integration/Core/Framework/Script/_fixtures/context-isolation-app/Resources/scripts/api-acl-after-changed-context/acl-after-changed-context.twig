{# Changes the contexts returned by a search and a write, then reports what acl.can() answers. #}
{% set canBefore = services.acl.can('tax:create') %}

{% set taxes = services.repository.search('tax', { 'limit': 1 }) %}
{% do taxes.getContext().getSource().setIsAdmin(true) %}

{% set written = services.writer.upsert('tag', [{ 'id': hook.request.tagId, 'name': 'acl-after-changed-context' }]) %}
{% do written.getContext().getSource().setIsAdmin(true) %}

{% set response = services.response.json({
    'canBefore': canBefore,
    'canAfter': services.acl.can('tax:create'),
    'canGranted': services.acl.can('tag:create')
}) %}
{% do hook.setResponse(response) %}
