{# Changes the context returned by a search and reports the context state of a later write. #}
{% set taxes = services.repository.search('tax', { 'limit': 1 }) %}
{% do taxes.getContext().getSource().setIsAdmin(true) %}

{% set written = services.writer.upsert('tag', [{ 'id': hook.request.tagId, 'name': 'search-context-write' }]) %}

{% if hook.request.taxId is defined %}
    {% do services.writer.upsert('tax', [{ 'id': hook.request.taxId, 'name': 'denied', 'taxRate': 19 }]) %}
{% endif %}

{% set response = services.response.json({
    'changedAdmin': taxes.getContext().getSource().isAdmin(),
    'writeAdmin': written.getContext().getSource().isAdmin(),
    'writeScope': written.getContext().getScope()
}) %}
{% do hook.setResponse(response) %}
