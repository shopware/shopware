{# Changes the context returned by one search and reports the source state of a later search. #}
{% set first = services.repository.search('tax', { 'limit': 1 }) %}
{% do first.getContext().getSource().setIsAdmin(true) %}

{% set second = services.repository.search('tax', { 'limit': 1 }) %}

{% set response = services.response.json({
    'firstAdmin': first.getContext().getSource().isAdmin(),
    'secondAdmin': second.getContext().getSource().isAdmin()
}) %}
{% do hook.setResponse(response) %}
