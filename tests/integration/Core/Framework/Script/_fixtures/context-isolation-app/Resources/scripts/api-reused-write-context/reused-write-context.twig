{# Changes the contexts returned by a search and a write, then writes again. #}
{% set taxes = services.repository.search('tax', { 'limit': 1 }) %}
{% set source = taxes.getContext().getSource() %}
{% do source.setIsAdmin(true) %}

{% set written = services.writer.upsert('tax', [{
    'id': hook.request.taxId,
    'name': hook.request.taxName,
    'taxRate': 19
}]) %}

{% set writeContext = written.getContext() %}
{% do writeContext.scope('system', (scoped) => services.writer.upsert(hook.request.systemEntity, [hook.request.systemPayload])) %}

{% set response = services.response.json({ 'done': true }) %}
{% do hook.setResponse(response) %}
