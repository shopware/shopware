{# Changes the context returned by a write and reports the context state of a later write. #}
{% set first = services.writer.upsert('tag', [{ 'id': hook.request.firstTagId, 'name': 'first-write' }]) %}
{% set initialAdmin = first.getContext().getSource().isAdmin() %}
{% do first.getContext().getSource().setIsAdmin(true) %}

{% set second = services.writer.upsert('tag', [{ 'id': hook.request.secondTagId, 'name': 'second-write' }]) %}

{% if hook.request.taxId is defined %}
    {% do services.writer.upsert('tax', [{ 'id': hook.request.taxId, 'name': 'denied', 'taxRate': 19 }]) %}
{% endif %}

{% set response = services.response.json({
    'initialAdmin': initialAdmin,
    'changedAdmin': first.getContext().getSource().isAdmin(),
    'writeAdmin': second.getContext().getSource().isAdmin(),
    'writeScope': second.getContext().getScope()
}) %}
{% do hook.setResponse(response) %}
