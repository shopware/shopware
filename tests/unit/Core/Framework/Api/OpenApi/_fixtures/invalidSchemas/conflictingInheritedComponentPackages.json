{
    "openapi": "3.0.0",
    "info": {
        "title": "Conflicting inherited component packages",
        "version": "1.0.0"
    },
    "paths": {
        "/store-order": {
            "get": {
                "operationId": "readStoreOrder",
                "x-dto-package": "checkout",
                "responses": {
                    "200": {
                        "description": "Store order",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin-order": {
            "get": {
                "operationId": "readAdminOrder",
                "x-dto-package": "framework",
                "responses": {
                    "200": {
                        "description": "Admin order",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
