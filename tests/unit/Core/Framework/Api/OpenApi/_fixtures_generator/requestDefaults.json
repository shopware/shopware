{
    "openapi": "3.1.0",
    "info": {
        "title": "Request default presence",
        "version": "1.0.0"
    },
    "paths": {
        "/defaults": {
            "post": {
                "operationId": "createDefaults",
                "x-dto-package": "framework",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DefaultsInput"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Accepted"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DefaultsInput": {
                "x-dto-inline": true,
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "default": "fallback"
                    },
                    "count": {
                        "type": "integer",
                        "default": 10
                    },
                    "active": {
                        "type": "boolean",
                        "default": true
                    },
                    "comment": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "default": "fallback"
                    },
                    "source": {
                        "type": "string",
                        "enum": [
                            "api"
                        ]
                    },
                    "nested": {
                        "type": "object",
                        "properties": {
                            "count": {
                                "type": "integer",
                                "default": 10
                            }
                        }
                    },
                    "shared": {
                        "$ref": "#/components/schemas/SharedDefaults"
                    }
                }
            },
            "SharedDefaults": {
                "x-dto-namespace": "App\\Shared",
                "type": "object",
                "properties": {
                    "count": {
                        "type": "integer",
                        "default": 10
                    },
                    "nested": {
                        "type": "object",
                        "properties": {
                            "active": {
                                "type": "boolean",
                                "default": true
                            }
                        }
                    },
                    "mode": {
                        "$ref": "#/components/schemas/DefaultMode"
                    }
                }
            },
            "DefaultMode": {
                "type": "string",
                "enum": [
                    "none",
                    "exact"
                ],
                "default": "none"
            }
        }
    }
}
