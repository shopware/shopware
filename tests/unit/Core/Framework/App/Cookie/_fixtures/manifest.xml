<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>cookie-app</name>
        <label>Cookie App</label>
        <author>shopware AG</author>
        <copyright>(c) by shopware AG</copyright>
        <version>1.0.0</version>
        <license>MIT</license>
    </meta>
    <cookies>
        <cookie>
            <snippet-name>swag.analytics.name</snippet-name>
            <cookie>swag-analytics</cookie>
            <value></value>
            <expiration>30</expiration>
        </cookie>
        <group>
            <snippet-name>app.cookies.group</snippet-name>
            <snippet-description>app.cookies.group.description</snippet-description>
            <entries>
                <cookie>
                    <snippet-name>first.cookie</snippet-name>
                    <cookie>swag-app-something</cookie>
                    <value>test</value>
                    <expiration>30</expiration>
                </cookie>
                <cookie>
                    <snippet-name>second.cookie</snippet-name>
                    <cookie>swag-app-lorem-ipsum</cookie>
                </cookie>
            </entries>
        </group>
    </cookies>
</manifest>
