<?xml version="1.0" encoding="UTF-8"?>
<mcp xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <mcp-tools>
        <mcp-tool name="sync-orders" url="https://app.example.com/mcp/sync-orders">
            <label>Sync Orders</label>
            <label lang="de-DE">Bestellungen synchronisieren</label>
            <description>Imports new orders from the ERP</description>
            <description lang="de-DE">Importiert neue Bestellungen aus dem ERP</description>
            <input-schema>
                <property name="since" type="string" description="ISO date" required="true"/>
                <property name="limit" type="integer"/>
                <property name=""/>
            </input-schema>
            <required-privileges>
                <privilege>order:read</privilege>
                <privilege>order:update</privilege>
            </required-privileges>
        </mcp-tool>
        <mcp-tool name="stock-check" url="https://app.example.com/mcp/stock-check">
            <label>Stock Check</label>
        </mcp-tool>
    </mcp-tools>
    <mcp-prompts>
        <mcp-prompt name="order-context" url="https://app.example.com/mcp/prompt/order-context">
            <label>Order Context</label>
            <description>Context for orders</description>
        </mcp-prompt>
        <mcp-prompt name="product-context" url="https://app.example.com/mcp/prompt/product-context">
            <label>Product Context</label>
        </mcp-prompt>
    </mcp-prompts>
    <mcp-resources>
        <mcp-resource name="order-stats" uri="app-example://order-stats" url="https://app.example.com/mcp/resource/order-stats" mime-type="application/json">
            <label>Order Stats</label>
            <description>Live order statistics</description>
        </mcp-resource>
        <mcp-resource name="product-list" uri="app-example://product-list" url="https://app.example.com/mcp/resource/product-list">
            <label>Product List</label>
        </mcp-resource>
    </mcp-resources>
</mcp>
