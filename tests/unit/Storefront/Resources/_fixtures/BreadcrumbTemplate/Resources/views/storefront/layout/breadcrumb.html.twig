{% extends '@Storefront/storefront/layout/breadcrumb.html.twig' %}

{# Mimics an extension overriding the list item, and exposes the variables the override can see. #}
{% block layout_breadcrumb_list_item %}
    <li class="test-breadcrumb-item"
        data-variables="{{ test_context_variables() }}"
        data-name="{{ name }}"
        data-category-id="{{ categoryId }}"
        data-active-id="{{ activeId }}"
        data-is-active="{{ isActive ? 'true' : 'false' }}"
        data-url="{{ categoryUrl }}"></li>
{% endblock %}
