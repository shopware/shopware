{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["flue.config.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
