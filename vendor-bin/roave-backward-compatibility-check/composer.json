{
    "bin": [
        "bin/bc-check"
    ],
    "autoload": {
        "psr-4": {
            "Shopware\\RoaveBackwardCompatibility\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "ocramius/package-versions": true,
            "cweagans/composer-patches": true,
            "bamarni/composer-bin-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "roave/backward-compatibility-check": "8.16.x-dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/shopwareLabs/BackwardCompatibilityCheck.git"
        }
    ]
}
