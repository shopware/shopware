+     */
+    private function canonicalize(array $ancestors, array $classAliases, string $className): array
+    {
+        $canonicalAncestors = [];
+
+        foreach ($ancestors as $ancestor) {
+            $canonical = $classAliases[strtolower($ancestor)] ?? $ancestor;
