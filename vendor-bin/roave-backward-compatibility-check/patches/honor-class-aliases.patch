+     */
+    private function canonicalize(array $ancestors, string $className): array
+    {
+        $canonicalAncestors = [];
+
+        foreach ($ancestors as $ancestor) {
+            $canonical = $this->classAliases[strtolower($ancestor)] ?? $ancestor;
