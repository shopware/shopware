#!/usr/bin/env php
<?php declare(strict_types=1);

use Shopware\Tests\DevOps\Core\DevOps\StaticAnalyse\TwigStan\RenderEventDataPreparation;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

require dirname(__DIR__) . '/bootstrap.php';
$input = new ArgvInput();
if (!$input->hasParameterOption(['--help', '-h', '--version', '-V']) && !\in_array($input->getFirstArgument(), ['help', 'list', 'completion'], true)) {
    RenderEventDataPreparation::prepare(dirname(__DIR__, 3), new ConsoleOutput());
}
$_composer_autoload_path = dirname(__DIR__) . '/vendor/autoload.php';
require dirname(__DIR__) . '/vendor/twigstan/twigstan/bin/twigstan';
