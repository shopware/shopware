parameters:
    level: 8
    phpVersion: 80400
    paths:
        - src
        - tests
        - bootstrap.php
        - bin/report.php
        - ../../twigstan.php
        - ../../twigstan-loader.php
    bootstrapFiles:
        - bootstrap.php
    symfony:
        containerXmlPath: ../../var/cache/static_phpstan_dev/Shopware_Core_DevOps_StaticAnalyze_StaticAnalyzeKernelPhpstan_devDebugContainer.xml
services:
    -
        class: Shopware\Tests\DevOps\Core\DevOps\StaticAnalyse\TwigStan\StructGetVarsReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
